      "Last candidate / update: " + CC.last.candidate + " / " + CC.last.update,
      "Operation outcome / drain: " + (CC.last.operationOutcome || "None") + " / " + (CC.last.operationDrainChange || "None"),
      "Last Name: " + (CC.last.lastName || "None"),
      "Last Relationship / change: " + (CC.last.lastRelationship || "None") + " / " + (CC.last.relationshipChange || "None"),
      "Last Turning Point / change: " + (CC.last.lastTurningPoint || "None") + " / " + (CC.last.turningPointChange || "None")
    ];
    const repeatedPriorityLabels = [
      "Error:", "CCO parse:", "Last task / owner:", "Last candidate / update:", "Operation outcome / drain:",
      "Last Name:", "Last Relationship / change:", "Last Turning Point / change:"
    ];
    writeDebugPages(priorityDebugRows.concat(debugRows.filter(row =>
      !repeatedPriorityLabels.some(label => textOf(row).startsWith(label))
    )));
  }

  if (hook === "input") {
    beginInput(originalText);
    writeAllStateCards();
    writeStatusCard();
    return finish(originalText);
  }

  if (hook === "context" || hook === "contextAppend") {
    let result = buildContext();
    if (appendOnlyContext && !textOf(result).startsWith(textOf(originalText))) {
      CC.last.context = "Cache-compatible append guard preserved the original platform context.";
      CC.last.error = "The context result was not append-only, so its continuity addition was withheld.";
      result = originalText;
    }
    writeAllStateCards();
    writeStatusCard();
    return finish(result);
  }

  if (hook === "output") {
    const result = processOutput(originalText);
    writeAllStateCards();
    writeStatusCard();
    return finish(result);
  }

  writeStatusCard();
  return finish(originalText);
}
