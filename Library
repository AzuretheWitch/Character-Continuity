  }

  function recordGenuineOutputResolution(plan) {
    const record = ensureGenuineOperationRecordForPlan(plan);
    if (!record) return;
    record.phase = "output processed";
    record.task = line(plan.task, 40) || record.task;
    record.taskDelivered = plan.taskDelivered === true;
    const owner = characters.find(character => character.key === plan.ownerKey) || null;
    record.ownerKey = normalizedTargetKey(plan.ownerKey) || record.ownerKey;
    record.ownerName = owner ? owner.name : record.ownerName;
    record.operationKind = keyOf(plan.selectedOperationKind) || record.operationKind;
    record.ownerOpportunity = Math.max(0, Math.floor(Number(plan.ownerOpportunity) || record.ownerOpportunity || 0));
    record.selectionFrozen = plan.operationSelectionFrozen === true || record.selectionFrozen;
    record.selectedGain = Math.max(0, Math.floor(Number(plan.selectedGain) || record.selectedGain || 0));
    record.selectedDrain = Math.max(0, Math.floor(Number(plan.selectedDrain) || record.selectedDrain || 0));
    record.selectedNet = Number.isFinite(Number(plan.selectedNet))
      ? Math.floor(Number(plan.selectedNet))
      : record.selectedNet;
    record.evidenceIds = unique(Array.isArray(plan.evidenceIds) ? plan.evidenceIds : record.evidenceIds, 40).slice(0, 12);
    record.selectedCandidate = recordedOperationCandidate(plan.selectedCandidate) || record.selectedCandidate;
    record.parserResult = line(CC.last.protocol, 700) || "No parser result";
    record.candidateResult = line(CC.last.candidate, 200) || "not requested";
    record.mutationResult = line(CC.last.update, 700) || "None";
    record.outcome = line(CC.last.operationOutcome, 200) || "None";
    record.drainChange = line(CC.last.operationDrainChange, 700) || "No drain change";
    record.outputRawChars = Math.max(0, Number(CC.last.outputRawChars) || 0);
    record.outputStoryChars = Math.max(0, Number(CC.last.outputStoryChars) || 0);
    record.outputRecordChars = Math.max(0, Number(CC.last.outputRecordChars) || 0);
    record.outputRecordPosition = line(CC.last.outputRecordPosition, 40) || "none";
    record.resolution = record.outcome !== "None"
      ? record.outcome
      : (!plan.taskDelivered
        ? (record.deferredReason ? "Not delivered — " + record.deferredReason : "No operation scheduled")
        : (record.candidateResult === "not requested" ? "No operation scheduled" : record.candidateResult));
    CC.lastGenuineOperation = normalizeLastGenuineOperation(record);
  }

  function beginInput(inputValue) {
    const discardedPlan = CC.currentPlan && typeof CC.currentPlan === "object" ? clone(CC.currentPlan) : null;
    const observedActionCount = platformActionCount();
    const discardedActionCount = discardedPlan && Number.isFinite(Number(discardedPlan.actionCount))
      ? Math.max(0, Math.floor(Number(discardedPlan.actionCount)))
      : null;
    const unfinishedNewerAction = !!(
      discardedPlan && discardedPlan.completed !== true && discardedPlan.kind !== "preview"
      && observedActionCount !== null && discardedActionCount !== null
      && observedActionCount > discardedActionCount
    );
    const unfinishedRestored = unfinishedNewerAction && CC.preGenerationSnapshot
      ? restoreDiscardedGeneration()
      : true;
    const inputSignature = actionTextSignature(inputValue);
    const priorInputSignature = textOf(CC.lastInputSignature)
      || actionTextSignature(CC.lastInput);
    const sameInput = !!inputSignature && inputSignature === priorInputSignature;
    const replacementAction = observedActionCount === null
      || observedActionCount <= CC.lastCompletedActionCount;
    const replacedOutput = !!(
      discardedPlan && discardedPlan.completed && CC.preGenerationSnapshot
      && replacementAction && CC.lastVisibleOutputAnchor && !outputAnchorPresent("")
    );
    const retry = replacedOutput && sameInput;
    const discardedRestored = replacedOutput ? restoreDiscardedGeneration() : true;

    const opening = retry ? !!(discardedPlan && discardedPlan.opening) : isOpeningInput(inputValue);
    CC.lastInput = clean(inputValue, 5000);
    CC.lastInputSignature = inputSignature;
    CC.last.retry = retry;
    CC.last.continue = false;
    CC.last.error = "";
    CC.last.warning = "";
    CC.last.task = "none";
    CC.last.owner = "";
    CC.last.protocol = "None";
    CC.last.operationOutcome = "None";
    CC.last.operationDrainChange = "No drain change";
    CC.last.outputRawChars = 0;
    CC.last.outputStoryChars = 0;
    CC.last.outputRecordChars = 0;
    CC.last.outputRecordPosition = "none";
    if (!unfinishedRestored) {
      CC.last.warning = "An unfinished prior action could not be rolled back exactly before the new input action.";
    }
    if (retry) {
      CC.last.candidate = "rolled back";
      CC.last.update = "None";
      CC.last.output = "Retry restored the pre-generation snapshot, including provenance, operation meters, drains, Names, Relationships, Turning Points, and consumed evidence.";
      if (!discardedRestored) {
        CC.last.warning = "Retry rollback was incomplete; one or more managed Story Cards could not be restored exactly.";
        CC.last.output += " One or more managed Story Cards could not be restored exactly.";
      }
    }

    if (opening) {
      let openingEvidence = retry && discardedPlan ? evidenceForId(discardedPlan.openingEvidenceId) : null;
      if (!retry) {
        CC.openingSeen = true;
        openingEvidence = addEvidence("opening", inputValue);
        CC.openingEvidenceId = openingEvidence ? openingEvidence.id : "";
        CC.preGenerationSnapshot = captureSnapshot();
      }
      CC.currentPlan = {
        kind: "opening", retry, opening: true, genuine: false, opportunity: false,
        task: "none", taskDelivered: false, completed: false, castProgressApplied: false,
        openingEvidenceId: openingEvidence ? openingEvidence.id : CC.openingEvidenceId,
        retryFocusKey: retry && discardedPlan ? discardedPlan.ownerKey || discardedPlan.focusKey || "" : "",
        retryActiveKeys: retry && discardedPlan ? clone(discardedPlan.activeKeys || []) : []
      };
      CC.last.context = "Opening automatic generation detected; its model output will be suppressed.";
      return;
    }

    let inputEvidence = retry && discardedPlan ? evidenceForId(discardedPlan.inputEvidenceId) : null;
    if (!retry) {
      CC.inputCount += 1;
      inputEvidence = addEvidence("input", inputValue);
      beginGenuineOperationRecord(inputEvidence, platformActionCount());
      if (TIME_JUMP.test(inputValue)) CC.pendingOperationRetry = blankPendingOperationRetry();
      CC.preGenerationSnapshot = captureSnapshot();
    }
    CC.currentPlan = {
      kind: "input", retry, opening: false, genuine: !retry, opportunity: true,
      actionCount: platformActionCount(),
      genuineInputCount: retry && discardedPlan
        ? Math.max(0, Math.floor(Number(discardedPlan.genuineInputCount) || Number(CC.inputCount) || 0))
        : Math.max(0, Number(CC.inputCount) || 0),
      task: "none", taskDelivered: false, completed: false, castProgressApplied: false,
      inputEvidenceId: inputEvidence ? inputEvidence.id : (discardedPlan && discardedPlan.inputEvidenceId || ""),
      retryFocusKey: retry && discardedPlan ? discardedPlan.ownerKey || discardedPlan.focusKey || "" : "",
      retryActiveKeys: retry && discardedPlan ? clone(discardedPlan.activeKeys || []) : [],
      retryTargets: retry && discardedPlan ? clone(discardedPlan.targets || []) : [],
      retryEvidenceIds: retry && discardedPlan ? clone(discardedPlan.evidenceIds || []) : [],
      retryEvidenceEligibility: retry && discardedPlan ? clone(discardedPlan.evidenceEligibility || {}) : {},
      retrySourcePacket: retry && discardedPlan ? clone(discardedPlan.sourcePacket || []) : [],
      retrySourcePacketText: retry && discardedPlan ? textOf(discardedPlan.sourcePacketText) : "",
      retryOperationTaskText: retry && discardedPlan ? textOf(discardedPlan.operationTaskText) : "",
      retryOperationTaskKind: retry && discardedPlan ? line(discardedPlan.operationTaskKind, 40) : "",
      relationshipPace: retry && discardedPlan && discardedPlan.relationshipPace
        ? clone(discardedPlan.relationshipPace)
        : clone(runtime.relationshipPace),
      ...(retry ? frozenOperationSelectionFrom(discardedPlan) : {})
    };
    if (!retry && CC.pendingOperationRetry && CC.pendingOperationRetry.active) {
      applyPendingOperationRetry(CC.currentPlan, CC.pendingOperationRetry);
    }
    if (retry && discardedPlan && discardedPlan.pendingOperationRetry === true) {
      CC.currentPlan.pendingOperationRetry = true;
      CC.currentPlan.pendingRetrySourceInputCount = Math.max(
        0, Math.floor(Number(discardedPlan.pendingRetrySourceInputCount) || 0)
      );
      CC.currentPlan.pendingRetrySourceActionCount = Number.isFinite(Number(discardedPlan.pendingRetrySourceActionCount))
        ? Math.max(0, Math.floor(Number(discardedPlan.pendingRetrySourceActionCount)))
        : -1;
      CC.currentPlan.pendingRetrySourceKind = line(discardedPlan.pendingRetrySourceKind, 40);
    }
    CC.last.context = retry
      ? "Retry restored the prior turn position and reused its operation opportunity."
      : "Portrayal input and one fixed-owner operation opportunity are ready.";
  }

  function beginContinueIfNeeded(contextValue) {
    const observedActionCount = platformActionCount();
    let discardedPlan = CC.currentPlan && typeof CC.currentPlan === "object" ? clone(CC.currentPlan) : null;
    if (CC.currentPlan && !CC.currentPlan.completed) {
      const currentActionCount = Number.isFinite(Number(CC.currentPlan.actionCount))
        ? Math.max(0, Math.floor(Number(CC.currentPlan.actionCount)))
        : null;
      const aNewerActionArrived = observedActionCount !== null && currentActionCount !== null
        && observedActionCount > currentActionCount;
      const previewRevision = CC.currentPlan.kind === "preview"
        && CC.currentPlan.revisionSourcePlan
        && CC.lastVisibleOutputAnchor
        && !outputAnchorPresent(contextValue);
      if (previewRevision) discardedPlan = clone(CC.currentPlan.revisionSourcePlan);
      else if (!aNewerActionArrived) return CC.currentPlan;
      if (CC.currentPlan.kind !== "preview" && CC.preGenerationSnapshot) {
        const restored = restoreDiscardedGeneration();
        if (!restored) {
          CC.last.warning = "An unfinished prior action could not be rolled back exactly before the new action.";
        }
      }
    }
    const clearlyNewAction = observedActionCount !== null
      && observedActionCount > CC.lastCompletedActionCount;
    if (!clearlyNewAction && discardedPlan && discardedPlan.completed
      && CC.preGenerationSnapshot && CC.lastVisibleOutputAnchor && !outputAnchorPresent(contextValue)) {
      const discardedRestored = restoreDiscardedGeneration();
      const retryOpportunity = discardedPlan.opportunity === true;
      CC.currentPlan = {
        kind: "retry", retry: true, opening: false,
        genuine: false, opportunity: retryOpportunity,
        actionCount: Number.isFinite(Number(discardedPlan.actionCount))
          ? Math.max(0, Math.floor(Number(discardedPlan.actionCount)))
          : observedActionCount,
        genuineInputCount: Math.max(0, Math.floor(Number(discardedPlan.genuineInputCount) || Number(CC.inputCount) || 0)),
        task: "none", taskDelivered: false, completed: false, castProgressApplied: false,
        inputEvidenceId: discardedPlan.inputEvidenceId || "",
        retryFocusKey: discardedPlan.ownerKey || discardedPlan.focusKey || "",
        retryActiveKeys: clone(discardedPlan.activeKeys || []),
        relationshipPace: clone(discardedPlan.relationshipPace || runtime.relationshipPace),
