    });
    const frontTag = new RegExp(
      "<\\s*\\/?\\s*CC_(?:FRONT_MEMORY|CONTEXT_PACKET)\\s*>",
      "gi"
    );
    source = source.replace(frontTag, tag => {
      removed.push(line(tag, 220));
      return "";
    });
    return { text: source, removed };
  }

  function stripTurningPointControlEchoes(value) {
    let source = textOf(value).replace(/\r/g, "");
    let count = 0;
    let sample = "";
    const remove = matched => {
      count += 1;
      if (!sample) sample = line(matched, 220);
      return " ";
    };
    const removeWrapped = (matched, prefix) => {
      remove(matched);
      return prefix || "";
    };
    source = source.replace(
      /(^|\n)[ \t]*(```|~~~)[A-Za-z0-9_-]*[ \t]*\n(?:[ \t]*\n)*[ \t]*TP STAGE\s+TP-[0-9A-F]{16}\s+REV-[0-9A-F]{16}\s+BEGIN(?=\s|$)[\s\S]*?\n[ \t]*\2[ \t]*(?=\n|$)/gi,
      removeWrapped
    );
    source = source.replace(
      /(^|\n)[ \t]*(?:```|~~~)[A-Za-z0-9_-]*[ \t]*\n(?:[ \t]*\n)*[ \t]*TP STAGE\s+TP-[0-9A-F]{16}\s+REV-[0-9A-F]{16}\s+BEGIN(?=\s|$)[\s\S]*$/gi,
      removeWrapped
    );
    source = source.replace(
      /TP STAGE\s+(TP-[0-9A-F]{16})\s+(REV-[0-9A-F]{16})\s+BEGIN(?=\s|$)[\s\S]*?TP STAGE\s+\1\s+\2\s+END(?=\s|$)/gi,
      remove
    );
    source = source.replace(
      /TP STAGE\s+TP-[0-9A-F]{16}\s+REV-[0-9A-F]{16}\s+BEGIN(?=\s|$)[\s\S]*$/gi,
      remove
    );
    const rule = turningPointPortrayalAuthorityRule();
    if (rule) source = source.replace(new RegExp(escapeRegExp(rule), "gi"), remove);
    const ownerForms = characters.reduce((forms, character) =>
      forms.concat([character.name]).concat(character.aliases || []), []);
    catalogPagedLabel(settings.NAMES_LABEL).records.forEach(item => {
      if (!characters.some(character => sameNameForm(character.name, item.owner))) return;
      entryOf(item.card).replace(/\r/g, "").split("\n").forEach(row => {
        const match = row.match(/^[ \t]*Alias[ \t]*:[ \t]*(.*?)[ \t]*$/i);
        const alias = match ? line(match[1], 160) : "";
        if (alias && !/[{}\[\]|]/.test(alias)) ownerForms.push(alias);
      });
    });
    const ownerPattern = uniqueNameForms(ownerForms, 160)
      .sort((left, right) => right.length - left.length)
      .map(value => value.split(/\s+/).map(escapeRegExp).join("\\s+"))
      .join("|");
    if (ownerPattern) {
      source = source.replace(new RegExp(
        "CURRENT TP\\s+TP-[0-9A-F]{16}\\s+REV-[0-9A-F]{8,16}\\s+(?:—|–|-)\\s+(?:" + ownerPattern + ")"
          + "(?=$|[^A-Za-z0-9])"
          + "(?:\\s+(?:—|–|-)\\s+REF\\s+\"(?:[^\"\\\\]|\\\\.)*\")?",
        "gi"
      ), remove);
    }
    source = source.replace(
      /TP STAGE\s+TP-[0-9A-F]{16}\s+REV-[0-9A-F]{16}\s+(?:BEGIN|END)(?=\s|$)/gi,
      remove
    );
    if (count > 0) {
      source = source.replace(
        /(^|\n)[ \t]*(```|~~~)[A-Za-z0-9_-]*[ \t]*\n(?:[ \t]*\n)*[ \t]*\2[ \t]*(?=\n|$)/g,
        (matched, prefix) => prefix
      );
      source = source.replace(/(^|\n)[ \t]*(?:>\s*|[-+*]\s*)(?=\n|$)/g, "$1");
      source = source.replace(/(^|\n)[ \t]*(?:\*{2,}|_{2,}|`+)(?:[ \t]+(?:\*{2,}|_{2,}|`+))?[ \t]*(?=\n|$)/g, "$1");
    }
    return {
      text: source.replace(/[ \t]{2,}/g, " ").replace(/[ \t]+\n/g, "\n").replace(/\n[ \t]+/g, "\n"),
      count,
      sample
    };
  }

  function stripControlCodeFences(value, plan) {
    const lines = textOf(value).replace(/\r/g, "").split("\n");
    const removed = [];
    const result = [];
    let index = 0;
    const fenceMarker = value => {
      const match = controlPresentationText(value).match(/^(```|~~~)[A-Za-z0-9_-]*\s*$/);
      return match ? match[1] : "";
    };
    while (index < lines.length) {
      const marker = fenceMarker(lines[index]);
      if (!marker) {
        result.push(lines[index]);
        index += 1;
        continue;
      }
      let closing = index + 1;
      while (closing < lines.length
        && controlPresentationText(lines[closing]) !== marker) closing += 1;
      const end = closing < lines.length ? closing : lines.length;
      const inside = lines.slice(index + 1, end);
      const containsControl = inside.some(item =>
        ccoPresentation(item).protocolLike || operationInstructionEchoLine(item, plan)
      );
      if (!containsControl) {
        result.push(...lines.slice(index, closing < lines.length ? closing + 1 : lines.length));
        index = closing < lines.length ? closing + 1 : lines.length;
        continue;
      }
      removed.push(line(lines[index], 220));
      result.push(...inside);
      if (closing < lines.length) removed.push(line(lines[closing], 220));
      index = closing < lines.length ? closing + 1 : lines.length;
    }
    return { text: result.join("\n"), removed };
  }

  function operationTriggerInstruction(value) {
    const source = textOf(value).replace(/\r/g, "");
    const match = /(?:Use|Copy)\s+1\s*[-‐‑‒–—―]\s*3\s+(?:of(?:\s+the\s+following)?(?:\s+triggers?)?|triggers?|trigger codes?)(?:\s+from)?\s*:/i
      .exec(source);
    if (!match) return null;
    const trailing = source.slice(match.index + match[0].length).trim();
    let prefix = source.slice(0, match.index)
      .replace(/[ \t]*[.\-:]+[ \t]*$/, "")
      .trimEnd();
    const metaPrefix = /^(?:Here(?:'s| is)|Below is)\s+(?:the\s+)?(?:requested\s+)?(?:command|continuity|CCO|record|operation)\b.*:?$/i
      .test(prefix);
    if (metaPrefix) {
      prefix = "";
    }
    if (trailing) {
      const listText = trailing.split(/\b(?:Situation|Thought)\s*:/i)[0];
      const recognized = unique(
        (listText.match(/[A-Za-z_]+/g) || [])
          .map(item => item.toLowerCase())
          .filter(item => TRIGGER_CODES.includes(item)),
        20
      );
      if (recognized.length < 2) return null;
    } else if (prefix && !metaPrefix) {
      return null;
    }
    return {
      prefix,
      removed: source.slice(match.index).trim()
    };
  }

  function operationTriggerListEchoLine(value) {
    const source = controlPresentationText(value)
      .replace(/[.!?;:]+$/g, "")
      .trim();
    if (!source || !source.includes(",")) return false;
    const supplied = source.split(/\s*,\s*/).map(item => item.trim().toLowerCase()).filter(Boolean);
    return supplied.length >= 2 && supplied.every(item => TRIGGER_CODES.includes(item));
  }

  function operationMetaPrefaceLine(value) {
    const source = controlPresentationText(value)
      .replace(/[“”]/g, '"')
      .replace(/[‘’‛]/g, "'")
      .trim();
    return /^(?:Here(?:'s| is)|Below is)\s+(?:the\s+)?(?:requested\s+)?(?:continuity\s+)?(?:command|CCO record|record|operation)\s*:?\s*$/i
      .test(source);
  }

  function operationReasoningEchoLine(value) {
    const source = controlPresentationText(value)
      .replace(/[“”]/g, '"')
      .replace(/[‘’‛]/g, "'")
      .trim();
    return /^(?:I|We)\s+(?:need|must|should|will)\s+to\s+(?:perform|complete|produce|write|return)\s+(?:the\s+)?(?:State|Name|Relationship|View|Turning Point|CCO)\s+(?:operation|record)\b.*\b(?:evidence|target|CCO|record)\b.*[.!?]?$/i
      .test(source);
  }

  function inlineOperationMetaEchoLine(value) {
    const source = controlPresentationText(value);
    return /^(?:Here(?:'s| is)|Below is)\s+(?:the\s+)?(?:requested\s+)?(?:continuity\s+)?(?:command|CCO record|record|operation)\s*:\s*(?:Record\s*:\s*)?\(CCO\|/i
      .test(source);
  }

  function stripOperationInstructionEchoes(value, plan) {
    const systemBlocks = stripSystemControlBlocks(value);
    const fences = stripControlCodeFences(systemBlocks.text, plan);
    const removed = systemBlocks.removed.concat(fences.removed);
    const kept = [];
    const lines = fences.text.split("\n");
    let continuationFields = 0;
    lines.forEach((rawLine, index) => {
      const triggerInstruction = plan && plan.task === "operation" && plan.taskDelivered
        ? operationTriggerInstruction(rawLine)
        : null;
      if (triggerInstruction) {
        removed.push(line(triggerInstruction.removed || rawLine, 220));
        if (triggerInstruction.prefix) kept.push(triggerInstruction.prefix);
        continuationFields = 3;
        return;
      }
      if (continuationFields > 0) {
        const normalized = controlPresentationText(rawLine);
        if (!normalized) return;
        if (operationTriggerListEchoLine(rawLine)
          || /^(?:Situation|Thought)\s*:/i.test(normalized)) {
          removed.push(line(rawLine, 220));
          continuationFields -= 1;
          return;
        }
        continuationFields = 0;
      }
      const nextLine = lines[index + 1] || "";
      if ((operationMetaPrefaceLine(rawLine) || operationReasoningEchoLine(rawLine))
        && (operationInstructionEchoLine(nextLine, plan)
          || standaloneOperationHeadingEchoLine(nextLine, plan)
          || ccoPresentation(nextLine).protocolLike
          || !!operationTriggerInstruction(nextLine))) {
        removed.push(line(rawLine, 220));
        return;
      }
      if (inlineOperationMetaEchoLine(rawLine)
        || (plan && plan.task === "operation" && plan.taskDelivered
          && operationReasoningEchoLine(rawLine))) {
        removed.push(line(rawLine, 220));
        return;
      }
      if (standaloneOperationHeadingEchoLine(rawLine, plan)
        || operationInstructionEchoLine(rawLine, plan)) removed.push(line(rawLine, 220));
      else kept.push(rawLine);
    });
    const cleaned = kept.filter(rawLine =>
      !(removed.length && /^\s*(?:[-*>]|&gt;)\s*$/.test(rawLine))
    );
    return {
      text: cleaned.join("\n").replace(/\n{3,}/g, "\n\n").trim(),
      count: removed.length,
      sample: removed[0] || ""
    };
  }

  function operationFallbackLabel(value, kind) {
    const label = keyOf(value);
    const common = {
      evidence: ["cite", "citation", "citations", "citations used", "cited evidence", "evidence", "evidence id", "evidence ids", "evidenceids", "source", "source id", "source ids"],
      target: ["about", "about code", "aboutcode", "target", "target code", "targetcode", "subject", "subject code", "subjectcode"],
      explanation: ["explanation", "reason", "reasoning"],
      operationcode: ["operation", "operation code", "kind", "kind code"]
    };
    const specific = {
      state: {
        trigger: ["trigger", "triggers", "trigger list", "triggerlist", "trigger code", "trigger codes", "state triggers"],
        situation: ["situation", "current situation", "event phrase", "context", "scene"],
        thought: ["thought", "inner thought", "private thought", "inner speech", "inner voice", "internal", "reaction"],
        feeling: ["feeling", "feelings"],
        goal: ["goal", "goals"],
        tension: ["tension", "tensions"]
      },
      name: {
        alias: ["alias", "name", "nickname", "observed alias"],
        transition: ["transition", "status", "name status", "lifecycle"],
        use: ["use", "uses", "permission", "permissions", "scope"],
        oldalias: ["old alias", "replaced alias", "replacement"]
      },
      relationship: {
        field: ["field", "relationship field", "axis"],
        event: ["event", "event kind", "change", "change kind", "movement", "a d", "ad"],
        destination: ["destination", "value", "stage"],
        axisvalue: RELATIONSHIP_FIELDS.map(keyOf)
      },
      view: {
        destination: ["destination", "category", "view category", "judgment", "judgement", "view"],
        severity: ["severity", "mode", "change", "o m", "om"]
      },
      turning: {
        turningpointid: ["id", "turning point id", "turningpointid", "milestone id"],
        movement: ["mode", "movement", "movement mode", "phase", "change"]
      }
    };
    const groups = { ...common, ...(specific[keyOf(kind)] || {}) };
    return Object.keys(groups).find(name => groups[name].includes(label)) || "";
  }

  function operationFallbackScalar(value) {
    const source = textOf(value).trim()
      .replace(/^[\s"'`]+|[\s"'`,.]+$/g, "")
      .replace(/^\[\s*|\s*\]$/g, "")
      .trim();
    return source;
  }

  function operationFallbackFieldEntries(value, kind) {
    let source = controlPresentationText(value).replace(/\r/g, "").trim();
    if (!source) return [];
    source = source.replace(/\*\*|__/g, "").trim();
    if (source.startsWith("{") && source.endsWith("}")) {
      try {
        const parsed = JSON.parse(source);
        if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
          const entries = Object.keys(parsed).map(rawLabel => {
            const label = operationFallbackLabel(rawLabel, kind);
            const rawValue = Array.isArray(parsed[rawLabel])
              ? parsed[rawLabel].join(", ")
              : textOf(parsed[rawLabel]);
            return label && rawValue.trim()
              ? { label, value: rawValue.trim(), rawLabel: keyOf(rawLabel) }
              : null;
          }).filter(Boolean);
          if (entries.length === Object.keys(parsed).length && entries.length >= 2) return entries;
        }
      } catch (error) {
        debug("Operation fallback JSON presentation was not exact JSON: " + error.message);
      }
    }

    const parseSegment = rawSegment => {
      const segment = textOf(rawSegment).trim()
        .replace(/^[{[]\s*/, "")
        .replace(/\s*[}\]],?\s*$/, "")
        .trim();
      const table = segment.match(/^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|$/);
      if (table) {
        const label = operationFallbackLabel(table[1], kind);
        return label && table[2].trim()
          ? { label, value: table[2].trim(), rawLabel: keyOf(table[1]) }
          : null;
      }
      const match = segment.match(/^["'`]?([A-Za-z][A-Za-z0-9 _/()'-]{0,48})["'`]?\s*(?::|=|\s+[-–—]\s+)\s*(\S[\s\S]*?)\s*$/);
      if (!match) return null;
      const label = operationFallbackLabel(match[1], kind);
      return label
        ? { label, value: match[2].trim().replace(/,\s*$/, ""), rawLabel: keyOf(match[1]) }
        : null;
    };
    const segments = source.split(/\s*[|;]\s*/);
    if (segments.length > 1) {
      const inline = segments.map(parseSegment).filter(Boolean);
      if (inline.length === segments.length && inline.length >= 2) return inline;
    }
    const single = parseSegment(source);
    return single ? [single] : [];
  }

  function operationFallbackWrapperLine(value) {
    const source = controlPresentationText(value).trim();
    return /^(?:```[A-Za-z0-9_-]*|~~~[A-Za-z0-9_-]*|```|~~~|[{}\[\]()]\,?)$/.test(source)
      || /^\|\s*(?:field|label|key)\s*\|\s*(?:value|content)\s*\|$/i.test(source)
      || /^\|\s*:?-{3,}:?\s*\|\s*:?-{3,}:?\s*\|$/.test(source);
  }

  function operationFallbackHeaderLine(value, kind, owner) {
    const source = controlPresentationText(value)
      .replace(/\*\*|__/g, "")
      .replace(/[‘’‛]/g, "'")
      .replace(/[‐‑‒–—―]/g, "-")
      .trim();
    if (!source || !owner) return null;
    const ownerName = textOf(owner.name).replace(/[‘’‛]/g, "'");
    const ownerPattern = escapeRegExp(ownerName);
    const kindName = operationKindLabel(kind);
    const kindPattern = escapeRegExp(kindName);
    const headerKindPattern = kindPattern
      + (["name", "relationship", "view"].includes(keyOf(kind)) ? "s?" : "");
    if (new RegExp("^" + ownerPattern + "\\s*:?\\s*$", "i").test(source)) {
      return { owner: true, generic: false };
    }
    if (new RegExp(
      "^" + ownerPattern + "(?:'s)?\\s+(?:current\\s+)?(?:private\\s+)?"
        + headerKindPattern + "\\b(?:\\s+(?:operation|record|update))?\\s*(?::|-).*$",
      "i"
    ).test(source)) {
      return { owner: true, generic: false };
    }
    if (new RegExp(
      "^(?:current\\s+|private\\s+)?" + headerKindPattern
        + "(?:\\s+(?:operation|record|update))?\\s+(?:for|of|owner)\\s*:?[\\s]*"
        + ownerPattern + "\\b(?:\\s*(?::|-).*)?$",
      "i"
    ).test(source)) {
      return { owner: true, generic: false };
    }
    if (new RegExp(
      "^(?:owner|character|" + headerKindPattern + "\\s+owner)\\s*:\\s*" + ownerPattern + "\\s*$",
      "i"
    ).test(source)) {
      return { owner: true, generic: false };
    }
    if (new RegExp(
      "^(?:Here(?:'s| is)|Below is)\\s+(?:the\\s+)?(?:requested\\s+)?(?:continuity\\s+)?"
        + headerKindPattern + "(?:\\s+(?:operation|record|update|fallback))?\\s*:?\\s*$",
      "i"
    ).test(source)) {
      return { owner: false, generic: true };
    }
    if (operationMetaPrefaceLine(value)) {
      return { owner: false, generic: true };
    }
    if (new RegExp(
      "^" + headerKindPattern + "\\s+(?:operation|record|update|fallback)(?:\\s+result)?\\s*:?\\s*$",
      "i"
    ).test(source)) {
      return { owner: false, generic: true };
    }
    if (keyOf(kind) === "state"
      && new RegExp("^" + kindPattern + "\\s*:\\s*\\S.*$", "i").test(source)) {
      return { owner: false, generic: true };
    }
    return null;
  }

  function operationFallbackRouteLine(value) {
    const source = controlPresentationText(value).replace(/\*\*|__/g, "").trim();
    const match = source.match(/^(S|P|N[1-5])\s*:\s*(\S.*)$/i);
    return match ? { code: match[1].toUpperCase(), value: match[2].trim() } : null;
  }

  function frozenOperationEvidenceIds(plan, kind) {
    const supplied = {};
    (Array.isArray(plan && plan.sourcePacket) ? plan.sourcePacket : []).forEach(sourceItem => {
      const id = continuitySourceId(sourceItem && sourceItem.id);
      if (id) supplied[id] = sourceItem;
    });
    const eligibilityKey = keyOf(kind);
    return new Set((Array.isArray(plan && plan.evidenceIds) ? plan.evidenceIds : [])
      .map(continuitySourceId)
      .filter(id => {
        const sourceItem = supplied[id];
        const eligibility = plan && plan.evidenceEligibility && plan.evidenceEligibility[id];
        return id && sourceIdLegalForOperation(eligibilityKey, id)
          && sourceItem && sourceItem[eligibilityKey] === true
          && eligibility && eligibility[eligibilityKey] === true;
      }));
  }

  function operationFallbackEvidenceIds(value, frozenIds) {
    const source = textOf(value).toUpperCase();
    const ids = source.match(/[ESXRV]\d+/g) || [];
    const residue = source
      .replace(/[ESXRV]\d+/g, " ")
      .replace(/\bAND\b/g, " ")
      .replace(/[\s,;:[\]{}"'`()!?._+-]+/g, "");
    return ids.length > 0 && !residue
      && new Set(ids).size === ids.length
      && ids.every(id => frozenIds.has(id))
      ? ids
      : [];
  }

  function operationFallbackTargetValid(value, owner, target) {
    if (!target) return false;
    const source = operationFallbackScalar(value);
    const code = textOf(target.code).trim().toUpperCase();
    const leadingCode = source.match(/^(S|P|N[1-5])\b/i);
    if (leadingCode && leadingCode[1].toUpperCase() === code) return true;
    return frozenTargetDisplayNames(owner, target)
      .some(name => sameNameForm(source, name));
  }

  function operationFallbackTriggerCodes(value) {
    const supplied = textOf(value).match(/[A-Za-z_]+/g) || [];
    const triggers = supplied.map(normalizeTriggerCode);
    return supplied.length >= 1
      && supplied.length <= settings.MAX_STATE_TRIGGERS
      && triggers.every(Boolean)
      && new Set(triggers).size === triggers.length
      ? triggers
      : [];
  }

  function operationFallbackRecordValue(value) {
    let source = textOf(value).replace(/\r/g, "").trim().replace(/,\s*$/, "").trim();
    const pair = source.length >= 2
      && ((source.startsWith('"') && source.endsWith('"'))
        || (source.startsWith("'") && source.endsWith("'"))
        || (source.startsWith("`") && source.endsWith("`")));
    if (pair) source = source.slice(1, -1).trim();
    let prior = "";
    while (source && source !== prior) {
      prior = source;
      if ((source.startsWith("**") && source.endsWith("**"))
        || (source.startsWith("__") && source.endsWith("__"))) {
        source = source.slice(2, -2).trim();
      } else if ((source.startsWith("*") && source.endsWith("*"))
        || (source.startsWith("_") && source.endsWith("_"))
        || (source.startsWith("`") && source.endsWith("`"))) {
        source = source.slice(1, -1).trim();
      }
    }
    return source;
  }

  function operationFallbackSingleField(fields, label) {
    const matching = fields.filter(field => field.label === label);
    return matching.length === 1 ? matching[0] : null;
  }

  function operationFallbackRecoveryRecord(block, kind, owner, plan) {
    if (!block || block.routes.length) return null;
    const normalizedKind = keyOf(kind);
    const frozenTarget = frozenSelectedOperationTarget(plan);
    if (!owner || !frozenTarget || !textOf(frozenTarget.code).trim()) return null;
    const frozenIds = frozenOperationEvidenceIds(plan, normalizedKind);
    const evidenceField = operationFallbackSingleField(block.fields, "evidence");
    if (block.fields.filter(field => field.label === "evidence").length > 1) return null;
    let evidenceIds = evidenceField
      ? operationFallbackEvidenceIds(evidenceField.value, frozenIds)
      : [];
    let inferredEvidence = false;
    if (!evidenceIds.length && !evidenceField && frozenIds.size === 1) {
      evidenceIds = [...frozenIds];
      inferredEvidence = true;
    }
    if (!evidenceIds.length) return null;

    const allowed = {
      state: new Set(["evidence", "target", "operationcode", "trigger", "situation", "thought"]),
      name: new Set(["evidence", "target", "operationcode", "alias", "transition", "use", "oldalias", "explanation"]),
      relationship: new Set(["evidence", "target", "operationcode", "field", "event", "destination", "axisvalue", "explanation"]),
      view: new Set(["evidence", "target", "operationcode", "destination", "severity", "explanation"]),
      turning: new Set(["evidence", "target", "operationcode", "turningpointid", "movement", "explanation"])
    }[normalizedKind];
    if (!allowed || block.fields.some(field => !allowed.has(field.label))) return null;
    const targetFields = block.fields.filter(field => field.label === "target");
    if (targetFields.length > 1
      || (targetFields.length === 1
        && !operationFallbackTargetValid(targetFields[0].value, owner, frozenTarget))) return null;
    const operationFields = block.fields.filter(field => field.label === "operationcode");
    const expectedCode = authorizedOperationCodeFromKind(normalizedKind);
    if (operationFields.length > 1
      || (operationFields.length === 1
        && operationFallbackScalar(operationFields[0].value).toUpperCase() !== expectedCode
        && keyOf(operationFallbackScalar(operationFields[0].value)) !== normalizedKind)) return null;
    const valueFor = label => {
      const field = operationFallbackSingleField(block.fields, label);
      return field ? operationFallbackRecordValue(field.value) : "";
    };
    const safeRecordValues = values => values.every(value =>
      value && !/[{}|()*_`\r\n]/.test(value)
    );
    const targetCode = textOf(frozenTarget.code).trim().toUpperCase();
    const evidence = evidenceIds.join(",");

    if (normalizedKind === "state") {
      const triggerField = operationFallbackSingleField(block.fields, "trigger");
      const situation = valueFor("situation");
      const thought = valueFor("thought");
      if (!triggerField || !situation || !thought) return null;
      const triggers = operationFallbackTriggerCodes(triggerField.value);
      if (!triggers.length || !safeRecordValues([situation, thought])) return null;
      const selected = plan && plan.selectedCandidate && typeof plan.selectedCandidate === "object"
        ? plan.selectedCandidate
        : {};
      const confirmationSituation = situationPhrase(selected.confirmSituation);
      const confirmation = keyOf(selected.stateMode) === "confirm"
        && normalizedTargetKey(selected.targetKey) === normalizedTargetKey(frozenTarget.key)
        && (keyOf(situation) === "keep"
          || (!!confirmationSituation && keyOf(situation) === keyOf(confirmationSituation)));
      const firstPersonThought = /\b(?:I|me|my|mine|myself|we|us|our|ours|ourselves)\b/i.test(thought);
      if (!confirmation && !operationFallbackStateOwnerAnchored(owner, situation)) return null;
      if (!firstPersonThought || !directPrivateThought(thought, owner)) return null;
      return {
        record: "(CCO|S|" + targetCode + "|" + evidence + "|" + triggers.join(",")
          + "|" + situation + "|" + thought + ")",
        inferredEvidence
      };
    }

    if (normalizedKind === "name") {
      const alias = valueFor("alias");
      let transition = valueFor("transition");
      const use = valueFor("use");
      const explanation = valueFor("explanation");
      const oldAlias = valueFor("oldalias");
      if (keyOf(transition) === "replace" && oldAlias) transition = "Replace=" + oldAlias;
      if (!safeRecordValues([alias, transition, use, explanation])) return null;
      return {
        record: "(CCO|N|" + targetCode + "|" + evidence + "|" + alias + "|"
          + transition + "|" + use + "|" + explanation + ")",
        inferredEvidence
      };
    }

    if (normalizedKind === "relationship") {
      const fieldEntry = operationFallbackSingleField(block.fields, "field");
      const axisEntry = operationFallbackSingleField(block.fields, "axisvalue");
      if (!!fieldEntry === !!axisEntry) return null;
      const field = fieldEntry
        ? RELATIONSHIP_FIELDS.find(item => keyOf(item) === keyOf(operationFallbackRecordValue(fieldEntry.value)))
        : RELATIONSHIP_FIELDS.find(item => keyOf(item) === axisEntry.rawLabel);
      const destinationSource = axisEntry
        ? operationFallbackRecordValue(axisEntry.value)
        : valueFor("destination");
      const destination = field ? relationshipDestination(field, destinationSource) : null;
      const rawEvent = valueFor("event");
      const event = ({ a: "A", accumulated: "A", d: "D", direct: "D" })[keyOf(rawEvent)] || rawEvent.toUpperCase();
      const explanation = valueFor("explanation");
      if (!field || !destination || !["A", "D"].includes(event)
        || !safeRecordValues([explanation])) return null;
      return {
        record: "(CCO|R|" + targetCode + "|" + evidence + "|" + field + "|"
          + event + "|" + destination.label + "|" + explanation + ")",
        inferredEvidence
      };
    }

    if (normalizedKind === "view") {
      const destinationSource = valueFor("destination");
      const destination = canonicalViewDestination(destinationSource);
      const rawSeverity = valueFor("severity");
      const severity = ({ o: "O", ordinary: "O", m: "M", major: "M" })[keyOf(rawSeverity)]
        || rawSeverity.toUpperCase();
      const explanation = valueFor("explanation");
      if (!destination || !["O", "M"].includes(severity)
        || !safeRecordValues([explanation])) return null;
      return {
        record: "(CCO|V|" + targetCode + "|" + evidence + "|" + destination + "|"
          + severity + "|" + explanation + ")",
        inferredEvidence
      };
    }
    if (normalizedKind === "turning") {
      const selected = plan && plan.selectedCandidate && typeof plan.selectedCandidate === "object"
        ? plan.selectedCandidate
        : {};
      const id = canonicalTurningPointId(valueFor("turningpointid") || selected.field);
      const mode = ["Support", "Breakthrough", "Integration"].find(value =>
        keyOf(value) === keyOf(valueFor("movement") || selected.destination)
      ) || "";
      const explanation = valueFor("explanation");
      if (!id || !mode || !explanation || /[{}|()*`\r\n]/.test(explanation)) return null;
      return {
        record: "(CCO|T|" + targetCode + "|" + evidence + "|" + id + "|" + mode + "|" + explanation + ")",
        inferredEvidence
      };
    }
    return null;
  }

  function operationFallbackBlockSignature(block, kind, owner, plan) {
    const fields = block.fields;
    const labels = new Set(fields.map(field => field.label));
    const frozenTarget = frozenSelectedOperationTarget(plan);
    const operationFields = fields.filter(field => field.label === "operationcode");

    if (keyOf(kind) === "state" && block.routes.length) {
      if (!frozenTarget) return "";
      const targetCode = textOf(frozenTarget.code).trim().toUpperCase();
      if (!/^(?:S|P|N[1-5])$/.test(targetCode)
        || block.routes.length < 2 || block.routes.length > 4) return "";
      const permitted = new Set(["S", targetCode]);
      const codes = block.routes.map(route => route.code);
      const targetPresent = targetCode === "S"
        ? codes.filter(code => code === "S").length >= 2
        : codes.includes(targetCode);
      if (!codes.includes("S") || !targetPresent
        || codes.some(code => !permitted.has(code))) return "";
      return "routing";
    }
    if (block.header && block.header.owner && operationFields.length) return "routing";

    if (keyOf(kind) === "state") {
      const completeCore = labels.has("situation") && labels.has("thought");
      const partialCore = labels.has("situation") || labels.has("thought");
      const strongAnchor = labels.has("trigger") || labels.has("evidence")
        || labels.has("target") || labels.has("feeling") || labels.has("goal")
        || labels.has("tension") || fields.length >= 4;
      const ownerStructured = block.header && block.header.owner
        && partialCore && fields.length >= 2;
      const labeledStructured = completeCore && strongAnchor;
      const anchoredPartial = partialCore && labels.has("trigger") && fields.length >= 2;
      if (ownerStructured || labeledStructured || anchoredPartial) {
        return block.header && block.header.owner ? "owner-fields" : "labeled";
      }
      return "";
    }
    if (keyOf(kind) === "name") {
      const core = labels.has("alias") && labels.has("transition");
      const supporting = labels.has("use") || labels.has("explanation") || labels.has("oldalias");
      if (core && ((block.header && block.header.owner) || (supporting && fields.length >= 3))) {
        return block.header && block.header.owner ? "owner-fields" : "labeled";
      }
      return "";
    }
    if (keyOf(kind) === "relationship") {
      const explicit = labels.has("field") && labels.has("event") && labels.has("destination")
        && (labels.has("explanation") || labels.has("evidence") || labels.has("target") || !!block.header);
      const axis = labels.has("axisvalue")
        && (labels.has("event") || labels.has("explanation"))
        && (labels.has("target") || labels.has("evidence") || !!block.header);
      const ownerStructured = block.header && block.header.owner
        && (labels.has("field") || labels.has("axisvalue"))
        && fields.length >= 2;
      if (explicit || axis || ownerStructured) {
        return block.header && block.header.owner ? "owner-fields" : "labeled";
      }
      return "";
    }
    if (keyOf(kind) === "view") {
      const core = labels.has("destination")
        && (labels.has("severity") || labels.has("explanation"))
        && (labels.has("explanation") || labels.has("evidence") || labels.has("target") || !!block.header);
      if (core && (block.header || fields.length >= 3)) {
        return block.header && block.header.owner ? "owner-fields" : "labeled";
      }
    }
    if (keyOf(kind) === "turning") {
      const core = (labels.has("turningpointid") || labels.has("movement")) && labels.has("explanation");
      if (core && (block.header || labels.has("evidence") || labels.has("target") || fields.length >= 3)) {
        return block.header && block.header.owner ? "owner-fields" : "labeled";
      }
    }
    return "";
  }

  function operationFallbackLine(value, kind, owner) {
    if (!textOf(value).trim()) return { blank: true };
    if (operationFallbackWrapperLine(value)) return { wrapper: true };
    const header = operationFallbackHeaderLine(value, kind, owner);
    if (header) return { header };
    const fields = operationFallbackFieldEntries(value, kind);
    if (fields.length) return { fields };
    const route = keyOf(kind) === "state" ? operationFallbackRouteLine(value) : null;
    return route ? { route } : null;
  }

  function operationFallbackEdgeBlock(lines, edge, kind, owner, plan) {
    const maxLines = 24;
    let first = 0;
    while (first < lines.length && !lines[first].trim()) first += 1;
    let last = lines.length - 1;
    while (last >= 0 && !lines[last].trim()) last -= 1;
    if (first > last) return null;

    if (edge === "leading" && ccoPresentation(lines[first]).record) {
      first += 1;
      while (first <= last && !lines[first].trim()) first += 1;
    } else if (edge === "terminal" && operationFallbackTerminalProtocolStart(lines, last) >= first) {
      last = operationFallbackTerminalProtocolStart(lines, last) - 1;
      while (last >= first && !lines[last].trim()) last -= 1;
    }
    if (first > last) return null;
    let start = first;
    let end = last;
    const parsedLines = new Map();
    const parsedAt = index => {
      if (!parsedLines.has(index)) {
        parsedLines.set(index, operationFallbackLine(lines[index], kind, owner));
      }
      return parsedLines.get(index);
    };
    if (edge === "leading") {
      end = first - 1;
      for (let index = first; index <= last && index < first + maxLines; index += 1) {
        if (!parsedAt(index)) break;
        end = index;
      }
      if (end < start) return null;
    } else {
      start = last + 1;
      for (let index = last; index >= first && index > last - maxLines; index -= 1) {
        if (!parsedAt(index)) break;
        start = index;
      }
      if (start > end) return null;
    }

    const block = { header: null, fields: [], routes: [] };
    let nonblank = 0;
    for (let index = start; index <= end; index += 1) {
      const parsed = parsedAt(index);
      if (!parsed) return null;
      if (!parsed.blank) nonblank += 1;
      if (parsed.header) {
        if (block.header && block.header.owner && parsed.header.owner) return null;
        block.header = {
          owner: !!((block.header && block.header.owner) || parsed.header.owner),
          generic: !!((block.header && block.header.generic) || parsed.header.generic)
        };
      }
      if (parsed.fields) block.fields.push(...parsed.fields);
      if (parsed.route) block.routes.push(parsed.route);
    }
    if (!nonblank || block.fields.length > 10) return null;
    const signature = operationFallbackBlockSignature(block, kind, owner, plan);
    if (!signature) return null;
    return {
      start,
      end,
      count: nonblank,
      signature,
      edge,
      recovery: operationFallbackRecoveryRecord(block, kind, owner, plan)
    };
  }

  function operationFallbackInlineCandidateLabel(value, owner) {
    let source = controlPresentationText(value)
      .replace(/\*\*|__|`/g, "")
      .replace(/[‘’‛]/g, "'")
      .trim();
    if (source.startsWith("[") && source.endsWith("]")) {
      source = source.slice(1, -1).trim();
    }
    const evidence = source.match(/^(?:(?:evidence|source)\s*)?#?\s*([ESXRV]\d+)$/i);
    if (evidence) return { kind: "evidence", value: evidence[1].toUpperCase() };
    const named = source.replace(/^(?:owner|character)\s*(?::|=|-)\s*/i, "").trim();
    if (operationOwnerAliases(owner).some(alias => sameNameForm(named, alias))) {
      return { kind: "owner", value: named };
    }
    return null;
  }

  function operationFallbackInlineTriggerTuple(value, explicit = false) {
    let source = controlPresentationText(value).replace(/\*\*|__|`/g, "").trim();
    const wrapped = source.length >= 2
      && ((source.startsWith("(") && source.endsWith(")"))
        || (source.startsWith("[") && source.endsWith("]"))
        || (source.startsWith("{") && source.endsWith("}")));
    if (wrapped) source = source.slice(1, -1).trim();
    const labeled = /^(?:trigger|triggers|triggerlist|trigger list|trigger codes?)\s*(?::|=)\s*/i
      .test(source);
    source = source
      .replace(/^(?:trigger|triggers|triggerlist|trigger list|trigger codes?)\s*(?::|=)\s*/i, "")
      .trim();
    if (!source || source.length > 300) return null;
    const rawItems = source.split(/[,;/]/);
    const items = rawItems.map(item => item.trim()).filter(Boolean);
    if (!items.length || items.length > 16) return null;
    const recognized = items.map(normalizeTriggerCode).filter(Boolean);
    const hasUnderscore = items.some(item => item.includes("_"));
    if (!recognized.length
      || (!explicit && !labeled && items.length < 2 && !hasUnderscore)) return null;
    const uniqueRecognized = new Set(recognized);
    return {
      items,
      recognized,
      hasUnderscore,
      invalid: rawItems.some(item => !item.trim()) || recognized.length !== items.length,
      duplicate: uniqueRecognized.size !== recognized.length,
      tooMany: items.length > settings.MAX_STATE_TRIGGERS
    };
  }

  function operationFallbackInlineCandidateLine(value, owner) {
    if (!textOf(value).trim()) return { blank: true };
    if (operationFallbackWrapperLine(value)) return { wrapper: true };
    const source = controlPresentationText(value).replace(/\*\*|__|`/g, "").trim();
    if (/^(?:(?:state|operation)\s+)?(?:candidate|candidates|option|options|draft|drafts|update|updates)(?:\s+packet)?\s*:?\s*$/i
      .test(source)) {
      return { wrapper: true };
    }

    const rawTable = textOf(value).replace(/\r/g, "").trim();
    if (rawTable.startsWith("|") && rawTable.endsWith("|")) {
      const cells = rawTable.slice(1, -1).split("|")
        .map(cell => cell.replace(/\*\*|__|`/g, "").trim());
      if (cells.length >= 2 && cells.every(cell => /^:?-{3,}:?$/.test(cell))) {
        return { wrapper: true };
      }
      const headerKeys = cells.map(keyOf);
      if (cells.length >= 3
        && /^(?:owner|character|source|evidence|candidate)$/.test(headerKeys[0])
        && /^(?:trigger|triggers|triggerlist|trigger codes?)$/.test(headerKeys[1])) {
        return { wrapper: true };
      }
      if (cells.length >= 3) {
        const label = operationFallbackInlineCandidateLabel(cells[0], owner);
        const triggers = operationFallbackInlineTriggerTuple(cells[1], true);
        const prose = cells.slice(2).join(" | ").trim();
        if (label && triggers && prose) {
          return {
            candidate: {
              label,
              triggers,
              prose,
              firstPerson: /\b(?:I|me|my|mine|myself|we|us|our|ours|ourselves)\b/i.test(prose),
              table: true
            }
          };
        }
      }
      return null;
    }

    const tuplePattern = "(\\([^()\\r\\n]{1,300}\\)|\\[[^\\[\\]\\r\\n]{1,300}\\]|\\{[^{}\\r\\n]{1,300}\\})";
    const bracketed = new RegExp(
      "^\\[\\s*([^\\]\\r\\n]{1,160})\\s*\\]\\s*(?:(?::|=)|[-–—|])?\\s*"
        + tuplePattern + "\\s*(?:(?::|=)|[-–—|])?\\s*(\\S[\\s\\S]*)$",
      "i"
    ).exec(source);
    const plain = bracketed ? null : new RegExp(
      "^(.{1,160}?)(?:\\s*:\\s*|\\s+[-–—=|]\\s+|\\s+)"
        + tuplePattern + "\\s*(?:(?::|=)|[-–—|])?\\s*(\\S[\\s\\S]*)$",
      "i"
    ).exec(source);
    const match = bracketed || plain;
    if (!match) return null;
    const label = operationFallbackInlineCandidateLabel(match[1], owner);
    const triggers = operationFallbackInlineTriggerTuple(
      match[2],
      !!label && label.kind === "evidence"
    );
    const prose = textOf(match[3]).trim();
    if (!label || !triggers || !prose) return null;
    return {
      candidate: {
        label,
        triggers,
        prose,
        firstPerson: /\b(?:I|me|my|mine|myself|we|us|our|ours|ourselves)\b/i.test(prose),
        table: false
      }
    };
  }

  function operationFallbackInlineCandidateBlock(lines, edge, kind, owner) {
    if (keyOf(kind) !== "state" || !owner) return null;
    let first = 0;
    while (first < lines.length && !lines[first].trim()) first += 1;
    let last = lines.length - 1;
    while (last >= 0 && !lines[last].trim()) last -= 1;
    if (first > last) return null;

    if (edge === "leading" && ccoPresentation(lines[first]).record) {
      first += 1;
      while (first <= last && !lines[first].trim()) first += 1;
    } else if (edge === "terminal" && operationFallbackTerminalProtocolStart(lines, last) >= first) {
      last = operationFallbackTerminalProtocolStart(lines, last) - 1;
      while (last >= first && !lines[last].trim()) last -= 1;
    }
    if (first > last) return null;

    const maxLines = 20;
    const parsedLines = new Map();
    const parsedAt = index => {
      if (!parsedLines.has(index)) {
        parsedLines.set(index, operationFallbackInlineCandidateLine(lines[index], owner));
      }
      return parsedLines.get(index);
    };
    let start = first;
    let end = last;
    if (edge === "leading") {
      end = first - 1;
      for (let index = first; index <= last && index < first + maxLines; index += 1) {
        if (!parsedAt(index)) break;
        end = index;
      }
      if (end < start) return null;
    } else {
      start = last + 1;
      for (let index = last; index >= first && index > last - maxLines; index -= 1) {
        if (!parsedAt(index)) break;
        start = index;
      }
      if (start > end) return null;
    }

    const candidates = [];
    let nonblank = 0;
    for (let index = start; index <= end; index += 1) {
      const parsed = parsedAt(index);
      if (!parsed) return null;
      if (!parsed.blank) nonblank += 1;
      if (parsed.candidate) candidates.push(parsed.candidate);
    }
    if (!candidates.length) return null;
    const evidenceLabeled = candidates.some(candidate => candidate.label.kind === "evidence");
    const operationalTuple = candidates.some(candidate =>
      candidate.triggers.hasUnderscore
        || candidate.triggers.invalid
        || candidate.triggers.duplicate
        || candidate.triggers.tooMany
    );
    const privateOwnerCandidate = candidates.some(candidate =>
      candidate.label.kind === "owner"
        && candidate.firstPerson
        && candidate.triggers.recognized.length >= 2
    );
    const tablePacket = candidates.some(candidate => candidate.table);
    if (!evidenceLabeled && candidates.length < 2
      && !operationalTuple && !privateOwnerCandidate && !tablePacket) return null;
    return {
      start,
      end,
      count: nonblank,
      signature: "inline-candidates",
      edge,
      recovery: null
    };
  }

  function operationFallbackSplitProtocolBlock(lines, edge) {
    let first = 0;
    while (first < lines.length && !lines[first].trim()) first += 1;
    let last = lines.length - 1;
    while (last >= 0 && !lines[last].trim()) last -= 1;
    if (first > last) return null;
    const opener = value => {
      const source = controlPresentationText(value)
        .replace(/^(?:Record|State|Name|Relationship|View|Turning Point|CCO record)\s*:\s*/i, "")
        .trim();
      return /^(?:\(\s*)?(?:CCO\s*\||[SNRVT]\s*\|)/i.test(source);
    };
    const closer = value => /\)\s*(?:[*_`}\]]*)\s*$/.test(textOf(value).trim());
    const recoveryFor = (start, end) => {
      const joined = lines.slice(start, end + 1)
        .map(value => controlPresentationText(value).trim())
        .join(" ")
        .replace(/\s*\|\s*/g, "|")
        .replace(/\(\s+/g, "(")
        .replace(/\s+\)/g, ")")
        .trim();
      const presented = ccoPresentation(joined);
      return presented.record && /^\(CCO\|/.test(presented.record)
        ? { record: presented.record, inferredEvidence: false }
        : null;
    };
    const maxLines = 12;
    if (edge === "leading") {
      if (!opener(lines[first]) || closer(lines[first])) return null;
      const limit = Math.min(last, first + maxLines - 1);
      for (let end = first + 1; end <= limit; end += 1) {
        if (!closer(lines[end])) continue;
        return {
          start: first,
          end,
          count: lines.slice(first, end + 1).filter(lineValue => lineValue.trim()).length,
          signature: "split-protocol",
          edge,
          recovery: recoveryFor(first, end)
        };
      }
      return null;
    }
    if (!closer(lines[last])) return null;
    const limit = Math.max(first, last - maxLines + 1);
    let fallbackStart = -1;
    for (let start = last - 1; start >= limit; start -= 1) {
      if (!opener(lines[start]) || closer(lines[start])) continue;
      const recovery = recoveryFor(start, last);
      if (!recovery) {
        if (fallbackStart < 0) fallbackStart = start;
        continue;
      }
      return {
        start,
        end: last,
        count: lines.slice(start, last + 1).filter(lineValue => lineValue.trim()).length,
        signature: "split-protocol",
        edge,
        recovery
      };
    }
    if (fallbackStart >= 0) return {
      start: fallbackStart,
      end: last,
      count: lines.slice(fallbackStart, last + 1).filter(lineValue => lineValue.trim()).length,
      signature: "split-protocol",
      edge,
      recovery: null
    };
    return null;
  }

  function stripOperationFallbackBlocks(value, plan, allowRecovery = true) {
    let source = textOf(value).replace(/\r/g, "");
    const unchanged = () => ({
      text: source,
      count: 0,
      sample: "",
      pattern: "",
      kind: "",
      recoveredRecord: "",
      inferredEvidence: false
    });
    const kind = keyOf(plan && plan.selectedOperationKind);
    if (!plan || plan.task !== "operation" || !plan.taskDelivered
      || !MODEL_OPERATION_KINDS.includes(kind)) return unchanged();
    const owner = characters.find(character => character.key === plan.ownerKey) || null;
    if (!owner) return unchanged();

    let total = 0;
    let sample = "";
    const patterns = [];
    const recoveries = [];
    ["leading", "terminal"].forEach(edge => {
      for (let pass = 0; pass < 2; pass += 1) {
        const lines = source.split("\n");
        const block = operationFallbackSplitProtocolBlock(lines, edge)
          || operationFallbackInlineCandidateBlock(lines, edge, kind, owner)
          || operationFallbackEdgeBlock(lines, edge, kind, owner, plan);
        if (!block) break;
        const removed = lines.slice(block.start, block.end + 1);
        if (!sample) sample = line(removed.join(" "), 300);
        total += block.count;
        patterns.push(edge + " " + block.signature);
        if (allowRecovery && block.recovery && block.recovery.record) {
          recoveries.push(block.recovery);
        }
        source = lines.slice(0, block.start).concat(lines.slice(block.end + 1))
          .join("\n").replace(/\n{3,}/g, "\n\n").trim();
      }
    });
    return {
      text: source,
      count: total,
      sample,
      pattern: patterns.join(" and "),
      kind,
      recoveredRecord: recoveries.length === 1 ? recoveries[0].record : "",
      inferredEvidence: recoveries.length === 1 && recoveries[0].inferredEvidence === true
    };
  }

  function authorizedOperationKindFromCode(code) {
    return { N: "name", S: "state", R: "relationship", V: "view", T: "turning" }[textOf(code).toUpperCase()] || "";
  }

  function authorizedOperationCodeFromKind(kind) {
    return { name: "N", state: "S", relationship: "R", view: "V", turning: "T" }[keyOf(kind)] || "";
  }

  function frozenSelectedOperationTarget(plan) {
    const selectedKey = normalizedTargetKey(plan && plan.selectedCandidate && plan.selectedCandidate.targetKey);
    if (!selectedKey) return null;
    return (Array.isArray(plan && plan.targets) ? plan.targets : []).find(target =>
      normalizedTargetKey(target && target.key) === selectedKey
    ) || null;
  }

  function frozenTargetDisplayNames(owner, target) {
    if (!target) return [];
    const names = [target.name];
    if (target.key === "self") names.push("Self", owner && owner.name);
    else if (target.key === "player") names.push(player.name);
    else if (target.key && target.key.startsWith("npc:")) {
      const character = characters.find(item => "npc:" + item.key === target.key);
      if (character) names.push(character.name);
    }
    return uniqueNameForms(names, 160);
  }

  function canonicalizeFrozenOperationRouting(parts, plan) {
    const result = Array.isArray(parts) ? parts.slice() : [];
    const changed = [];
    let ownerNameInTarget = false;
    let expandedOwnerTargetRouting = "";
    let duplicatedTargetRouting = "";
    const turningTransportCanonicalized = [];
    const frozenKindCode = authorizedOperationCodeFromKind(plan && plan.selectedOperationKind);
    const owner = characters.find(character => character.key === (plan && plan.ownerKey)) || null;
    if (frozenKindCode && owner
      && textOf(result[1]).trim().toUpperCase() !== frozenKindCode
      && sameNameForm(result[1], owner.name)) {
      result[1] = frozenKindCode;
      changed.push("owner");
    }
