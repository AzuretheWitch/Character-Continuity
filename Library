    record.selectedGain = Math.max(0, Math.floor(Number(plan.selectedGain) || 0));
    record.selectedDrain = Math.max(0, Math.floor(Number(plan.selectedDrain) || 0));
    record.selectedNet = Math.floor(Number(plan.selectedNet) || 0);
    record.evidenceIds = unique(Array.isArray(plan.evidenceIds) ? plan.evidenceIds : [], 40).slice(0, 12);
    record.selectedCandidate = recordedOperationCandidate(plan.selectedCandidate);
    record.deferredReason = line(deferredReason, 500);
    record.parserResult = "Not processed";
    record.candidateResult = plan.taskDelivered ? "awaiting output" : "not requested";
    record.mutationResult = "None";
    record.outcome = "None";
    record.drainChange = "No drain change";
    record.outputRawChars = 0;
    record.outputStoryChars = 0;
    record.outputRecordChars = 0;
    record.outputRecordPosition = "none";
    record.resolution = plan.taskDelivered
      ? "Awaiting model resolution"
      : (record.deferredReason ? "Not delivered — " + record.deferredReason : "No operation scheduled");
