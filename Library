function CharacterContinuity(hook, incomingText) {
  const settings = CHARACTER_CONTINUITY_STABLE_SETTINGS;
  const originalText = incomingText;
  const appendOnlyContext = hook === "contextAppend";
  const inputHook = hook === "input";
  const contextHook = hook === "context" || hook === "contextAppend";
  const outputHook = hook === "output";
  const rootState = state;
  const historyList = history;
  const cards = storyCards;
  const STORE_KINDS = ["names", "views", "relationships", "turningpoints", "experiences"];
  const storeSession = STORE_KINDS.reduce((result, kind) => {
    result[kind] = {
      loaded: false,
      dirty: false,
      repaired: false,
      projected: false,
      parses: 0,
      writes: 0,
      invalidations: 0,
      lastWrite: "",
      verifying: false,
      verificationFailed: false
    };
    return result;
  }, {});
  const cardTitleCache = new Map();
  const namedTitlePartsCache = new Map();
  const namedCardOwnerCache = new Map();
  const canonicalOutputCache = new Map();
  const canonicalHashCache = new Map();
  const recentStoryCache = new Map();
  const anchorMatchCache = new WeakMap();
  const maintenanceSession = {
    mode: contextHook ? "context-pending" : (inputHook ? "state-sync" : (outputHook ? "lazy-output" : "status-only")),
    structure: "deferred",
    stores: "deferred",
    stateSync: false,
    repaired: [],
    recorded: false
  };
  let cardCatalog = null;

  function finish(value) {
    return typeof value === "string" && value.length ? value : " ";
  }

  function debug(message) {
    if (settings.DEBUG_LOGS === true) {
      log("[Character Continuity Stable] " + message);
    }
  }

  function textOf(value) {
    return value === null || value === undefined ? "" : String(value);
  }

  function clean(value, limit) {
    const result = textOf(value)
      .replace(/\r/g, "")
      .replace(/[ \t]+/g, " ")
      .replace(/\n{3,}/g, "\n\n")
      .trim()
      .slice(0, Math.max(1, Number(limit) || 10000));
    return /[\uD800-\uDBFF]$/.test(result) ? result.slice(0, -1) : result;
  }

  function line(value, limit) {
    const result = clean(value, Math.max(limit * 3, limit))
      .replace(/\s*\n\s*/g, " ")
      .trim()
      .slice(0, Math.max(1, Number(limit) || 500));
    return /[\uD800-\uDBFF]$/.test(result) ? result.slice(0, -1) : result;
  }

  function wrappedLine(value, limit) {
    const max = Math.max(4, Number(limit) || 500);
    const source = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (source.length <= max) return source;
    const closing = source[0] === "{" && source.endsWith("}")
      ? "}"
      : (source[0] === "[" && source.endsWith("]") ? "]" : "");
    return closing
      ? source.slice(0, max - 2).trimEnd() + " " + closing
      : source.slice(0, max);
  }

  function wholeLine(value, max) {
    const result = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (!result) return "";
    const limit = Math.max(0, Number(max) || 0);
    return limit > 0 && result.length > limit ? "" : result;
  }

  function compactLineAtBoundary(value, limit) {
    const supplied = Math.floor(Number(limit) || 0);
    if (supplied <= 0) return "";
    const maximum = Math.max(1, supplied);
    const source = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (!source || source.length <= maximum) return source;
    if (maximum === 1) return "…";
    const contentLimit = maximum - 1;
    let clipped = "";
    let segmenterUsed = false;
    try {
      if (typeof Intl === "object" && typeof Intl.Segmenter === "function") {
        segmenterUsed = true;
        const segmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" });
        for (const item of segmenter.segment(source)) {
          if (clipped.length + item.segment.length > contentLimit) break;
          clipped += item.segment;
        }
      }
    } catch { segmenterUsed = false; }
    if (!clipped && !segmenterUsed) {
      for (const point of Array.from(source)) {
        if (clipped.length + point.length > contentLimit) break;
        clipped += point;
      }
    }
    if (!clipped) return "…";
    const minimumBoundary = Math.max(1, Math.floor(contentLimit * 0.55));
    let boundary = -1;
    for (let index = clipped.length - 1; index >= minimumBoundary; index -= 1) {
      if (/\s/.test(clipped[index])) {
        boundary = index;
        break;
      }
    }
    if (boundary > 0) clipped = clipped.slice(0, boundary);
    clipped = clipped.replace(/[\s,;:–—-]+$/g, "").trim();
    return clipped + "…";
  }

  function keyOf(value) {
    return textOf(value)
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function nameKeyOf(value) {
    return textOf(value)
      .normalize("NFKC")
      .toLowerCase()
      .replace(/[‘’‛]/g, "'")
      .replace(/[‐‑‒–—―]/g, "-")
      .replace(/[ \t\r\n]+/g, " ")
      .trim();
  }

  function sameNameForm(left, right) {
    const leftKey = nameKeyOf(left);
    return !!leftKey && leftKey === nameKeyOf(right);
  }

  function escapeRegExp(value) {
    return textOf(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function clone(value) {
    try { return JSON.parse(JSON.stringify(value)); } catch { return null; }
  }

  function unique(values, limit) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(value => {
      const item = line(value, limit);
      if (item && !result.some(existing => keyOf(existing) === keyOf(item))) result.push(item);
    });
    return result;
  }

  function uniqueNameForms(values, limit) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(value => {
      const item = line(value, limit);
      if (item && !result.some(existing => sameNameForm(existing, item))) result.push(item);
    });
    return result;
  }

  function boolValue(value, fallback) {
    const normalized = keyOf(value);
    if (["true", "yes", "on", "1", "enabled"].includes(normalized)) return true;
    if (["false", "no", "off", "0", "disabled"].includes(normalized)) return false;
    return fallback;
  }

  function numberValue(value, fallback, min, max) {
    const parsed = parseInt(value, 10);
    if (!Number.isFinite(parsed)) return fallback;
    return Math.max(min, Math.min(max, parsed));
  }

  function positiveWhole(value, fallback) {
    const source = textOf(value).trim();
    if (!/^\d+$/.test(source)) return fallback;
    const parsed = Number(source);
    return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback;
  }

  function estimateTokens(value) {
    const source = textOf(value).trim();
    if (!source) return 0;
    const structural = (source.match(/[{}[\]<>\":,\\]/g) || []).length;
    return Math.ceil((Math.max(0, source.length - structural) / 3.25) + (structural / 1.8));
  }

  function hashString(value) {
    const source = textOf(value);
    let hash = 2166136261;
    for (let index = 0; index < source.length; index++) {
      hash ^= source.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return (hash >>> 0).toString(16);
  }

  function storeSessionFor(kind) {
    return storeSession[keyOf(kind)] || null;
  }

  function storeIsFresh(kind, value) {
    const session = storeSessionFor(kind);
    return !!(session && session.loaded && !session.dirty && value);
  }

  function recordStoreParse(kind, writesAtStart) {
    const session = storeSessionFor(kind);
    if (!session) return;
    session.loaded = true;
    session.parses += 1;
    session.dirty = session.writes > Math.max(0, Number(writesAtStart) || 0);
  }

  function verifiedStoreAfterParse(kind, currentStore, refresh) {
    const session = storeSessionFor(kind);
    if (!session || !session.dirty || typeof refresh !== "function") return currentStore;
    if (session.verifying) {
      session.verificationFailed = true;
      session.dirty = false;
      return currentStore;
    }
    session.verifying = true;
    const verified = refresh() || currentStore;
    session.verifying = false;
    return verified;
  }

  function markStoreDirty(kind, reason) {
    const session = storeSessionFor(kind);
    if (!session) return;
    session.dirty = true;
    session.repaired = false;
    session.projected = false;
    session.writes += 1;
    session.invalidations += 1;
    session.lastWrite = line(reason, 240);
  }

  function storeKindForManagedTitle(value) {
    const parts = ownedCardTitleParts(value);
    if (!parts) return "";
    if (keyOf(parts.label) === keyOf(settings.NAMES_LABEL)) return "names";
    if ([settings.BURIED_VIEWS_LABEL, settings.VIEWS_LABEL]
      .some(label => keyOf(parts.label) === keyOf(label))) return "views";
    if (keyOf(parts.label) === keyOf(settings.RELATIONSHIPS_LABEL)) return "relationships";
    if (keyOf(parts.label) === keyOf(settings.TURNING_POINTS_LABEL)) return "turningpoints";
    if (keyOf(parts.label) === keyOf(settings.EXPERIENCES_LABEL)) return "experiences";
    return "";
  }

  function markManagedTitlesDirty(values, reason) {
    const kinds = new Set((Array.isArray(values) ? values : [values])
      .map(storeKindForManagedTitle)
      .filter(Boolean));
    kinds.forEach(kind => markStoreDirty(kind, reason));
  }

  function storeSessionSummary() {
    return STORE_KINDS.map(kind => {
      const session = storeSession[kind];
      const unexpected = session.parses > session.writes + 1;
      return kind.charAt(0).toUpperCase() + ":" + session.parses + "p/"
        + session.writes + "w" + (unexpected ? "!" : (session.verificationFailed ? "?" : ""));
    }).join(", ");
  }

  function storeSessionWarnings() {
    return STORE_KINDS.flatMap(kind => {
      const session = storeSession[kind];
      const warnings = [];
      if (session.parses > session.writes + 1) {
        warnings.push(kind + " parsed " + session.parses + " times after " + session.writes
          + " managed write" + (session.writes === 1 ? "" : "s") + " in one " + hook + " hook");
      }
      if (session.verificationFailed) {
        warnings.push(kind + " could not settle its latest managed write after one verification reread; "
          + "the reread state was used for the rest of this " + hook + " hook");
      }
      return warnings;
    }).filter(Boolean);
  }

  function visibleTitleOf(card) {
    if (!card) return "";
    return line(typeof card.title === "string" ? card.title : "", 220);
  }

  function entryOf(card) {
    return card && typeof card.entry === "string" ? card.entry : "";
  }

  function encodedManagedTitle(value) {
    return line(value, 220)
      .replace(/%/g, "%25")
      .replace(/,/g, "%2C");
  }

  function decodedManagedTitle(value) {
    return line(value, 1000)
      .replace(/%2C/gi, ",")
      .replace(/%25/gi, "%")
      .slice(0, 220);
  }

  function managedCardKey(title) {
    const logicalTitle = line(title, 220);
    return logicalTitle ? settings.CARD_KEY_PREFIX + encodedManagedTitle(logicalTitle) : "";
  }

  function managedTitleFromKey(value) {
    const source = textOf(value).trim();
    if (!source.startsWith(settings.CARD_KEY_PREFIX)) return "";
    return decodedManagedTitle(source.slice(settings.CARD_KEY_PREFIX.length));
  }

  function defaultScriptCardTitle(value) {
    return keyOf(value) === keyOf(settings.SCRIPT_CARD_TITLE);
  }

  const OWNED_CARD_LABELS = [
    settings.OUTER_CHARACTER_LABEL,
    settings.INNER_CHARACTER_LABEL,
    settings.NAMES_LABEL,
    settings.STATE_LABEL,
    settings.RELATIONSHIPS_LABEL,
    settings.TURNING_POINTS_LABEL,
    settings.BURIED_VIEWS_LABEL,
    settings.VIEWS_LABEL,
    settings.EXPERIENCES_LABEL,
    "Identity"
  ];
  const PAGED_OWNED_CARD_LABELS = new Set([
    settings.NAMES_LABEL,
    settings.RELATIONSHIPS_LABEL,
    settings.TURNING_POINTS_LABEL,
    settings.BURIED_VIEWS_LABEL,
    settings.VIEWS_LABEL,
    settings.EXPERIENCES_LABEL
  ].map(keyOf));
  const OWNED_CARD_LABEL_PATTERN = OWNED_CARD_LABELS
    .slice()
    .sort((left, right) => right.length - left.length)
    .map(escapeRegExp)
    .join("|");
  const POSSESSIVE_OWNED_TITLE = new RegExp(
    "^(.+?)['’]s\\s+(" + OWNED_CARD_LABEL_PATTERN + ")(?:\\s+(\\d+))?$",
    "i"
  );
  const LEGACY_OWNED_TITLE = new RegExp(
    "^(.+?)\\s+(?:—|–|-)\\s+(" + OWNED_CARD_LABEL_PATTERN + ")(?:\\s+(\\d+))?$",
    "i"
  );

  function canonicalOwnedLabel(value) {
    const normalized = keyOf(value);
    return OWNED_CARD_LABELS.find(label => keyOf(label) === normalized) || "";
  }

  function ownedCardTitle(name, label, page = 1) {
    const owner = line(name, 120);
    const canonicalLabel = canonicalOwnedLabel(label);
    const pageNumber = Number(page) || 1;
    if (!owner || !canonicalLabel || !Number.isSafeInteger(pageNumber) || pageNumber < 1) return "";
    if (pageNumber > 1 && !PAGED_OWNED_CARD_LABELS.has(keyOf(canonicalLabel))) return "";
    if (keyOf(canonicalLabel) === "identity" && !sameNameForm(owner, "Player")) return "";
    return owner + "'s " + canonicalLabel + (pageNumber > 1 ? " " + pageNumber : "");
  }

  function ownedCardTitleParts(value) {
    const source = line(value, 260);
    const possessive = source.match(POSSESSIVE_OWNED_TITLE);
    const legacy = possessive ? null : source.match(LEGACY_OWNED_TITLE);
    const match = possessive || legacy;
    if (!match) return null;
    const owner = line(match[1], 120);
    const label = canonicalOwnedLabel(match[2]);
    const suppliedPage = !!match[3];
    const page = suppliedPage ? Number(match[3]) : 1;
    if (!owner || !label || !Number.isSafeInteger(page) || page < 1
      || (suppliedPage && page === 1)
      || (suppliedPage && !PAGED_OWNED_CARD_LABELS.has(keyOf(label)))
      || (keyOf(label) === "identity" && !sameNameForm(owner, "Player"))) {
      return null;
    }
    return {
      owner,
      label,
      page,
      legacy: !!legacy,
      title: ownedCardTitle(owner, label, page)
    };
  }

  function canonicalOwnedCardTitle(value) {
    const parts = ownedCardTitleParts(value);
    return parts ? parts.title : "";
  }

  function managedTitleFromEntry(card) {
    const source = entryOf(card).replace(/\r/g, "");
    if (!source.trim()) return "";

    const profile = source.match(
      /^\s*\{\s*(.+?)['’]s\s+(Outer|Inner)\s*:/i
    );
    if (profile) {
      const label = keyOf(profile[2]) === "outer"
        ? settings.OUTER_CHARACTER_LABEL
        : settings.INNER_CHARACTER_LABEL;
      return ownedCardTitle(profile[1], label);
    }

    const stateProfile = source.match(
      /^\s*\{\s*(.+?)['’]s\s+current\s+private\s+State\s*:/i
    );
    if (stateProfile) {
      return ownedCardTitle(stateProfile[1], settings.STATE_LABEL);
    }

    const headers = source.split("\n")
      .map(row => row.trim())
      .filter(row => row && row !== "{" && row !== "}")
      .slice(0, 4);
    if (headers.includes("Active NPC slots:")) return settings.ACTIVE_NPCS_TITLE;

    for (const header of headers) {
      const paged = header.match(
        /^(.+?)['’]s\s+(Buried Views|Views|Names|Relationships|Turning Points)(?:\s+(\d+))?\s*:\s*$/i
      );
      if (paged) {
        const owner = line(paged[1], 120);
        const normalizedLabel = keyOf(paged[2]);
        const label = normalizedLabel === "buried views"
          ? settings.BURIED_VIEWS_LABEL
          : (normalizedLabel === "views"
            ? settings.VIEWS_LABEL
            : (normalizedLabel === "names"
              ? settings.NAMES_LABEL
              : (normalizedLabel === "turning points"
                ? settings.TURNING_POINTS_LABEL
                : settings.RELATIONSHIPS_LABEL)));
        const page = paged[3] ? Number(paged[3]) : 1;
        return ownedCardTitle(owner, label, page);
      }

      const experiences = header.match(
        /^(.+?)['’]s\s+Experiences(?:\s+(\d+))?\s*:\s*$/i
      );
      if (experiences) {
        const page = experiences[2] ? Number(experiences[2]) : 1;
        return ownedCardTitle(experiences[1], settings.EXPERIENCES_LABEL, page);
      }
    }

    if (hasSettingsField(source, "Enabled")
      && hasSettingsField(source, "Continuity budget")
      && hasSettingsField(source, "State lifetime")) {
      return settings.SETTINGS_TITLE;
    }
    return "";
  }

  function titleOf(card) {
    if (!card) return "";
    const rawKeys = card.keys;
    const rawTitle = card.title;
    const rawEntry = card.entry;
    const cached = cardTitleCache.get(card);
    if (cached
      && cached.keys === rawKeys
      && cached.title === rawTitle
      && cached.entry === rawEntry) {
      return cached.value;
    }
    const managedTitle = managedTitleFromKey(card.keys);
    const visibleTitle = managedTitle ? "" : visibleTitleOf(card);
    const entryTitle = managedTitle || (visibleTitle && !defaultScriptCardTitle(visibleTitle))
      ? ""
      : managedTitleFromEntry(card);
    const resolved = managedTitle
      || (visibleTitle && !defaultScriptCardTitle(visibleTitle) ? visibleTitle : "")
      || entryTitle
      || line(card.keys, 220)
      || visibleTitle;
    const value = canonicalOwnedCardTitle(resolved) || resolved;
    cardTitleCache.set(card, {
      keys: rawKeys,
      title: rawTitle,
      entry: rawEntry,
      value
    });
    return value;
  }

  function invalidateCardCatalog() {
    cardCatalog = null;
  }

  function catalogAppend(map, key, value) {
    if (!key) return;
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(value);
  }

  function currentCardCatalog() {
    if (cardCatalog) return cardCatalog;
    const catalog = {
      records: [],
      indexByCard: new Map(),
      byTitle: new Map(),
      byRawKey: new Map(),
      byId: new Map(),
      namedLabels: new Map(),
      pagedLabels: new Map(),
      experienceOwners: null
    };
    cards.forEach((card, index) => {
      if (!card) return;
      const title = titleOf(card);
      const record = {
        card,
        index,
        title,
        titleKey: keyOf(title),
        rawKey: textOf(card.keys).trim(),
        id: card.id === null || card.id === undefined ? "" : textOf(card.id)
      };
      catalog.records.push(record);
      catalog.indexByCard.set(card, index);
      catalogAppend(catalog.byTitle, record.titleKey, record);
      catalogAppend(catalog.byRawKey, record.rawKey, record);
      catalogAppend(catalog.byId, record.id, record);
    });
    cardCatalog = catalog;
    return catalog;
  }

  function catalogRecordsByTitle(title) {
    return (currentCardCatalog().byTitle.get(keyOf(title)) || []).slice();
  }

  function catalogRecordsByRawKey(value) {
    return (currentCardCatalog().byRawKey.get(textOf(value).trim()) || []).slice();
  }

  function firstCatalogCard(records) {
    const ordered = (Array.isArray(records) ? records : [])
      .filter(record => record && record.card)
      .sort((left, right) => left.index - right.index);
    return ordered.length ? ordered[0].card : null;
  }

  function catalogNamedLabel(label) {
    const catalog = currentCardCatalog();
    const labelKey = keyOf(label);
    if (catalog.namedLabels.has(labelKey)) return catalog.namedLabels.get(labelKey);
    const index = { records: [], byOwner: new Map() };
    catalog.records.forEach(record => {
      const owner = nameFromNamedTitle(record.title, label);
      if (!owner) return;
      const item = { ...record, owner, ownerKey: nameKeyOf(owner) };
      index.records.push(item);
      catalogAppend(index.byOwner, item.ownerKey, item);
    });
    catalog.namedLabels.set(labelKey, index);
    return index;
  }

  function catalogNamedCards(name, label) {
    const records = catalogNamedLabel(label).byOwner.get(nameKeyOf(name)) || [];
    return records.map(record => record.card);
  }

  function catalogNamedOwners(label) {
    return catalogNamedLabel(label).records.map(record => record.owner);
  }

  function catalogPagedLabel(label) {
    const catalog = currentCardCatalog();
    const labelKey = keyOf(label);
    if (catalog.pagedLabels.has(labelKey)) return catalog.pagedLabels.get(labelKey);
    const index = { records: [], byOwner: new Map() };
    catalog.records.forEach(record => {
      const parts = numberedNamedTitleParts(record.title, label);
      if (!parts) return;
      const item = {
        ...record,
        owner: parts.owner,
        ownerKey: nameKeyOf(parts.owner),
        page: parts.page
      };
      index.records.push(item);
      catalogAppend(index.byOwner, item.ownerKey, item);
    });
    index.records.sort((left, right) => left.index - right.index);
    index.byOwner.forEach(records => records.sort((left, right) =>
      left.page - right.page || left.index - right.index
    ));
    catalog.pagedLabels.set(labelKey, index);
    return index;
  }

  function catalogPagedCards(name, label) {
    return (catalogPagedLabel(label).byOwner.get(nameKeyOf(name)) || [])
      .map(record => ({ card: record.card, page: record.page }));
  }

  function catalogCardOrder(card) {
    const index = currentCardCatalog().indexByCard.get(card);
    return Number.isInteger(index) ? index : -1;
  }

  function restoreVisibleCardTitle(card, intendedTitle) {
    const logicalTitle = line(intendedTitle, 220);
    if (!card || !logicalTitle) return card;
    try {
      const priorTitle = card.title;
      card.title = logicalTitle;
      if (priorTitle !== card.title) invalidateCardCatalog();
    } catch (error) {
      debug("Could not restore the visible Story Card title " + logicalTitle + ": " + error.message);
    }
    return card;
  }

  function managedCardIdentityMatches(card, intendedTitle) {
    const logicalTitle = line(intendedTitle || titleOf(card), 220);
    return !!(card && logicalTitle
      && textOf(card.keys).trim() === managedCardKey(logicalTitle)
      && keyOf(visibleTitleOf(card)) === keyOf(logicalTitle));
  }

  function findCard(title) {
    const wantedKey = managedCardKey(title);
    const matches = catalogRecordsByTitle(title)
      .concat(wantedKey ? catalogRecordsByRawKey(wantedKey) : []);
    return firstCatalogCard(matches);
  }

  function cardIndex(card) {
    if (!card) return -1;
    const catalog = currentCardCatalog();
    const direct = catalog.indexByCard.get(card);
    if (Number.isInteger(direct)) return direct;
    const id = card.id === null || card.id === undefined ? "" : textOf(card.id);
    const match = id ? firstCatalogCard(catalog.byId.get(id) || []) : null;
    return match ? catalog.indexByCard.get(match) : -1;
  }

  function extractLine(source, label) {
    const match = textOf(source).match(new RegExp(
      "^[ \\t]*(?:[\\{\\[][ \\t]*)?" + escapeRegExp(label)
      + "[ \\t]*:[ \\t]*([^\\r\\n]*?)[ \\t]*(?:[\\}\\]][ \\t]*)?$",
      "im"
    ));
    return match ? line(match[1], 2000) : "";
  }

  function updateCardAt(index, keys, entry, type, intendedTitle) {
    if (!Number.isInteger(index) || index < 0 || index >= cards.length) return null;
    const current = cards[index];
    const priorTitle = line(titleOf(current), 220);
    const logicalTitle = line(intendedTitle || priorTitle, 220);
    const nextKeys = textOf(keys).trim()
      ? textOf(keys)
      : (textOf(current && current.keys).trim()
        ? textOf(current.keys)
        : managedCardKey(logicalTitle));
    const nextEntry = typeof entry === "string" ? entry : entryOf(current);
    const nextType = textOf(type).trim()
      ? textOf(type)
      : (textOf(current && current.type).trim() ? textOf(current.type) : settings.CARD_TYPE);
    if (textOf(current && current.keys) === nextKeys
      && entryOf(current) === nextEntry
      && textOf(current && current.type) === nextType) {
      return restoreVisibleCardTitle(current, logicalTitle);
    }
    try {
      updateStoryCard(index, nextKeys, nextEntry, nextType);
      invalidateCardCatalog();
      const updated = restoreVisibleCardTitle(cards[index] || current, logicalTitle);
      markManagedTitlesDirty(
        [priorTitle, logicalTitle],
        "Updated " + (logicalTitle || priorTitle || "managed Story Card")
      );
      return updated;
    } catch (error) {
      debug("Could not update " + (titleOf(current) || nextKeys) + " through the Story Card API: " + error.message);
      return null;
    }
  }

  function saveCard(card, entry, intendedTitle) {
    const index = cardIndex(card);
    if (index < 0) return null;
    const current = cards[index] || card;
    const logicalTitle = line(intendedTitle || titleOf(current), 220);
    if (!logicalTitle) return null;
    return updateCardAt(
      index,
      managedCardKey(logicalTitle),
      entry,
      settings.CARD_TYPE,
      logicalTitle
    );
  }

  function addCard(title, entry) {
    const cardTitle = line(title, 220);
    if (!cardTitle) return null;
    const cardKey = managedCardKey(cardTitle);
    const existing = firstCatalogCard(catalogRecordsByRawKey(cardKey))
      || findCard(cardTitle);
    if (existing) return restoreVisibleCardTitle(existing, cardTitle);
    const before = cards.length;
    let created = null;
    try {
      const result = addStoryCard(
        cardKey,
        typeof entry === "string" ? entry : "",
        settings.CARD_TYPE
      );
      invalidateCardCatalog();
      created = firstCatalogCard(catalogRecordsByRawKey(cardKey));
      if (!created && Number.isInteger(result)) {
        created = cards[result] || cards[result - 1] || null;
      } else if (!created && cards.length > before) {
        created = cards[cards.length - 1];
      } else if (!created && result === false) {
        created = findCard(cardTitle);
      }
    } catch (error) {
      debug("Could not create " + cardTitle + ": " + error.message);
    }
    const added = cards.length > before;
    created = created || (cards.length > before ? cards[cards.length - 1] : null);
    created = restoreVisibleCardTitle(created, cardTitle);
    if (added && created) markManagedTitlesDirty(cardTitle, "Added " + cardTitle);
    return created;
  }

  function upsertCard(title, entry) {
    const card = findCard(title);
    return card ? saveCard(card, entry) : addCard(title, entry);
  }

  function removeCard(card) {
    const index = cardIndex(card);
    if (index < 0) return false;
    const removedTitle = titleOf(cards[index] || card);
    try {
      removeStoryCard(index);
      invalidateCardCatalog();
      markManagedTitlesDirty(removedTitle, "Removed " + (removedTitle || "managed Story Card"));
      return true;
    } catch (error) {
      debug("Could not remove " + (titleOf(card) || "Story Card") + ": " + error.message);
      return false;
    }
  }

  function removeCards(cardList) {
    const indices = unique((Array.isArray(cardList) ? cardList : [])
      .map(cardIndex)
      .filter(index => index >= 0)
      .map(String), 20)
      .map(Number)
      .sort((left, right) => right - left);
    if (!indices.length) return true;
    let removed = true;
    indices.forEach(index => {
      const removedTitle = titleOf(cards[index]);
      try {
        removeStoryCard(index);
        invalidateCardCatalog();
        markManagedTitlesDirty(removedTitle, "Removed " + (removedTitle || "managed Story Card"));
      } catch (error) {
        debug("Could not remove Story Card at index " + index + ": " + error.message);
        removed = false;
      }
    });
    return removed;
  }

  function namedTitle(name, label) {
    return ownedCardTitle(name, label);
  }

  function nameFromNamedTitle(title, label) {
    const cacheKey = textOf(label) + "\u241f" + textOf(title);
    if (namedCardOwnerCache.has(cacheKey)) return namedCardOwnerCache.get(cacheKey);
    const parts = ownedCardTitleParts(title);
    const owner = parts && parts.page === 1 && keyOf(parts.label) === keyOf(label)
      ? parts.owner
      : "";
    namedCardOwnerCache.set(cacheKey, owner);
    return owner;
  }

  function namedCards(name, label) {
    return catalogNamedCards(name, label);
  }

  function namedCard(name, label) {
    return catalogNamedCards(name, label)[0] || null;
  }

  const titleMigrationDiagnostics = [];
  const wrapperMigrationDiagnostics = [];

  function ownedEntryWrapperInfo(value, owner, headerLabel) {
    const source = textOf(value).replace(/\r/g, "");
    const rows = source.split("\n");
    const nonempty = rows.map((row, index) => ({ index, value: row.trim() }))
      .filter(item => item.value);
    const result = {
      source,
      rows,
      valid: false,
      combined: false,
      openingIndex: -1,
      headerIndex: -1,
      closingIndex: -1
    };
    if (nonempty.length < 3 || nonempty[nonempty.length - 1].value !== "}") return result;
    const wantedOwner = line(owner, 120);
    const wantedLabel = line(headerLabel, 120);
    if (!wantedOwner || !wantedLabel) return result;
    const combined = nonempty[0].value.match(
      /^\{\s*(.+?)['’]s\s+(.+?)\s*:\s*$/i
    );
    if (combined
      && sameNameForm(combined[1], wantedOwner)
      && keyOf(combined[2]) === keyOf(wantedLabel)) {
      return {
        ...result,
        valid: true,
        combined: true,
        openingIndex: nonempty[0].index,
        headerIndex: nonempty[0].index,
        closingIndex: nonempty[nonempty.length - 1].index
      };
    }
    if (nonempty[0].value !== "{") return result;
    const split = nonempty[1].value.match(
      /^(.+?)['’]s\s+(.+?)\s*:\s*$/i
    );
    if (!split
      || !sameNameForm(split[1], wantedOwner)
      || keyOf(split[2]) !== keyOf(wantedLabel)) {
      return result;
    }
    return {
      ...result,
      valid: true,
      combined: false,
      openingIndex: nonempty[0].index,
      headerIndex: nonempty[1].index,
      closingIndex: nonempty[nonempty.length - 1].index
    };
  }

  function canonicalOwnedEntryWrapper(value, owner, headerLabel) {
    const info = ownedEntryWrapperInfo(value, owner, headerLabel);
    if (!info.valid) {
      return { valid: false, changed: false, entry: info.source };
    }
    const bodyStart = info.combined ? info.openingIndex + 1 : info.headerIndex + 1;
    const body = info.rows.slice(bodyStart, info.closingIndex);
    const entry = [
      "{",
      line(owner, 120) + "'s " + line(headerLabel, 120) + ":",
      ...body,
      "}"
    ].join("\n");
    return {
      valid: true,
      changed: entry !== info.source,
      entry
    };
  }

  function physicalLogicalCardTitle(card) {
    const managed = managedTitleFromKey(card && card.keys);
    if (managed) return managed;
    const visible = visibleTitleOf(card);
    if (visible && !defaultScriptCardTitle(visible)) return visible;
    return managedTitleFromEntry(card);
  }

  function migrateOwnedCardTitles() {
    let migrated = 0;
    let failed = 0;
    cards.slice().forEach(card => {
      const physical = physicalLogicalCardTitle(card);
      const intended = canonicalOwnedCardTitle(physical);
      const intendedParts = ownedCardTitleParts(intended);
      // Turning Point routers intentionally retain creator-authored trigger keys
      // and card types. Their exact possessive titles are required instead of
      // converting them into ordinary non-triggered CC cards.
      if (intendedParts && keyOf(intendedParts.label) === keyOf(settings.TURNING_POINTS_LABEL)) return;
      if (!intended || managedCardIdentityMatches(card, intended)) return;
      const saved = saveCard(card, entryOf(card), intended);
      if (saved && managedCardIdentityMatches(saved, intended)) migrated += 1;
      else failed += 1;
    });
    if (migrated) {
      titleMigrationDiagnostics.push(
        "Migrated " + migrated + " character-owned card title"
          + (migrated === 1 ? "" : "s") + " to the possessive format in place."
      );
    }
    if (failed) {
      titleMigrationDiagnostics.push(
        failed + " character-owned card title" + (failed === 1 ? "" : "s")
          + " could not be migrated and remains readable through legacy-title compatibility."
      );
    }
  }

  function migrateOwnedEntryWrappers() {
    let migrated = 0;
    let failed = 0;
    cards.slice().forEach(card => {
      const parts = ownedCardTitleParts(physicalLogicalCardTitle(card));
      if (!parts || parts.page !== 1) return;
      const labelKey = keyOf(parts.label);
      const headerLabel = labelKey === keyOf(settings.OUTER_CHARACTER_LABEL)
        ? settings.OUTER_CHARACTER_LABEL
        : (labelKey === keyOf(settings.INNER_CHARACTER_LABEL)
          ? settings.INNER_CHARACTER_LABEL
          : (labelKey === keyOf(settings.STATE_LABEL) ? "current private State" : ""));
      if (!headerLabel) return;
      const normalized = canonicalOwnedEntryWrapper(entryOf(card), parts.owner, headerLabel);
      if (!normalized.valid || !normalized.changed) return;
      const saved = saveCard(card, normalized.entry, parts.title);
      if (saved && entryOf(saved) === normalized.entry) migrated += 1;
      else failed += 1;
    });
    if (migrated) {
      wrapperMigrationDiagnostics.push(
        "Migrated " + migrated + " Outer, Inner, or State entry wrapper"
          + (migrated === 1 ? "" : "s") + " to the split format in place."
      );
    }
    if (failed) {
      wrapperMigrationDiagnostics.push(
        failed + " legacy entry wrapper" + (failed === 1 ? "" : "s")
          + " could not be migrated and remains readable through compatibility parsing."
      );
    }
  }

  function ownedStructureMaintenanceSignature() {
    const rows = [];
    cards.forEach((card, index) => {
      if (!card) return;
      const physical = physicalLogicalCardTitle(card);
      const intended = canonicalOwnedCardTitle(physical);
      const parts = ownedCardTitleParts(intended);
      if (!intended || !parts) return;
      const label = keyOf(parts.label);
      let boundary = "";
      if ([settings.OUTER_CHARACTER_LABEL, settings.INNER_CHARACTER_LABEL, settings.STATE_LABEL]
        .some(value => keyOf(value) === label)) {
        const nonempty = entryOf(card).replace(/\r/g, "").split("\n")
          .map(row => row.trim()).filter(Boolean);
        boundary = hashString([
          nonempty[0] || "",
          nonempty[1] || "",
          nonempty[nonempty.length - 1] || ""
        ].join("\n"));
      }
      rows.push([
        index,
        intended,
        textOf(card.keys).trim(),
        visibleTitleOf(card),
        textOf(card.type).trim(),
        boundary
      ].join("\u241f"));
    });
    const joined = rows.join("\u241e");
    return rows.length + ":" + joined.length + ":" + hashString(joined)
      + ":" + hashString(rows.slice().reverse().join("\u241e"));
  }

  function managedStoreMaintenanceSignature() {
    const rows = currentCardCatalog().records.map(record => {
      const kind = storeKindForManagedTitle(record.title);
      if (!kind) return "";
      const entry = entryOf(record.card);
      return [
        record.index,
        kind,
        record.title,
        record.rawKey,
        textOf(record.card.type).trim(),
        entry.length,
        hashString(entry)
      ].join("\u241f");
    }).filter(Boolean);
    const joined = rows.join("\u241e");
    return rows.length + ":" + joined.length + ":" + hashString(joined)
      + ":" + hashString(rows.slice().reverse().join("\u241e"));
  }

  function duplicateCardEntrySignature(card) {
    return entryOf(card)
      .replace(/\r/g, "")
      .replace(/[ \t]+$/gm, "")
      .trim();
  }

  function strictBoundedWhole(value, fallback, minimum, maximum) {
    const source = textOf(value).trim();
    if (!/^\d+$/.test(source)) return { value: fallback, valid: false };
    const parsed = Number(source);
    if (!Number.isSafeInteger(parsed) || parsed < minimum || parsed > maximum) {
      return { value: fallback, valid: false };
    }
    return { value: parsed, valid: true };
  }

  function relationshipPaceSettings(source) {
    const presets = {
      slowburn: { name: "Slowburn", accumulated: 1, direct: 10, maxStages: 1 },
      balanced: { name: "Balanced", accumulated: 2, direct: 10, maxStages: 1 },
      fast: { name: "Fast", accumulated: 6, direct: 20, maxStages: 2 }
    };
    const rawPace = extractLine(source, "Relationship pace");
    const paceKey = keyOf(rawPace || settings.DEFAULT_RELATIONSHIP_PACE);
    const customAccumulated = strictBoundedWhole(
      extractLine(source, "Custom accumulated event value"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED,
      0,
      50
    );
    const customDirect = strictBoundedWhole(
      extractLine(source, "Custom direct event value"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT,
      0,
      50
    );
    const customMaxStages = strictBoundedWhole(
      extractLine(source, "Custom maximum stages per operation"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES,
      1,
      6
    );
    const warnings = [];
    let pace;
    if (paceKey === "custom") {
      if (!customAccumulated.valid || !customDirect.valid || !customMaxStages.valid) {
        pace = { ...presets.balanced };
        warnings.push("Invalid Custom relationship values fell back to Balanced.");
      } else {
        pace = {
          name: "Custom",
          accumulated: customAccumulated.value,
          direct: customDirect.value,
          maxStages: customMaxStages.value
        };
      }
    } else if (presets[paceKey]) {
      pace = { ...presets[paceKey] };
    } else {
      pace = { ...presets.balanced };
      warnings.push("Relationship pace was missing or invalid and fell back to Balanced.");
    }
    return { pace, warning: warnings.join(" ") };
  }

  function turningPointModeSetting(source) {
    const supplied = keyOf(extractLine(source, "Turning Point mode") || settings.DEFAULT_TURNING_POINT_MODE);
    if (["growth only", "growthonly"].includes(supplied)) {
      return { mode: "growth-only", warning: "" };
    }
    if (["all directions", "all direction", "all"].includes(supplied)) {
      return { mode: "all-directions", warning: "" };
    }
    if (["disabled", "off", "none"].includes(supplied)) {
      return { mode: "disabled", warning: "" };
    }
    return {
      mode: "growth-only",
      warning: "Turning Point mode was missing or invalid and fell back to Growth-only."
    };
  }

  function settingsTemplate() {
    return [
      "Enabled: " + (settings.DEFAULT_ENABLED !== false),
      "Continuity budget: " + settings.DEFAULT_CONTINUITY_BUDGET,
      "State lifetime: " + settings.DEFAULT_STATE_LIFETIME,
      "Maximum active NPCs: " + settings.DEFAULT_MAX_ACTIVE_NPCS,
      "Dynamic cast: " + (settings.DEFAULT_DYNAMIC_CAST !== false),
      "Side promotion interactions: " + settings.DEFAULT_SIDE_PROMOTION_INTERACTIONS,
      "Main inactivity limit: " + settings.DEFAULT_MAIN_INACTIVITY_LIMIT,
      "Relationship pace: " + settings.DEFAULT_RELATIONSHIP_PACE,
      "Custom accumulated event value: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED,
      "Custom direct event value: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT,
      "Custom maximum stages per operation: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES,
      "Turning Point mode: " + settings.DEFAULT_TURNING_POINT_MODE,
      "Debug: " + (settings.DEFAULT_DEBUG === true)
    ].join("\n");
  }

  function hasSettingsField(source, label) {
    return new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:", "im").test(textOf(source));
  }

  function ensureRelationshipSettings(card) {
    if (!card) return { card: null, warning: "" };
    const source = entryOf(card);
    const additions = [
      ["Relationship pace", settings.DEFAULT_RELATIONSHIP_PACE],
      ["Custom accumulated event value", settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED],
      ["Custom direct event value", settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT],
      ["Custom maximum stages per operation", settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES],
      ["Turning Point mode", settings.DEFAULT_TURNING_POINT_MODE]
    ].filter(([label]) => !hasSettingsField(source, label))
      .map(([label, value]) => label + ": " + value);
    if (!additions.length) return { card, warning: "" };
    const entry = [source.trimEnd(), additions.join("\n")].filter(Boolean).join("\n");
    const saved = saveCard(card, entry);
    return saved
      ? { card: saved, warning: "Added the missing Relationship and Turning Point controls to CC — Settings." }
      : { card, warning: "The missing Relationship or Turning Point controls could not be added to CC — Settings." };
  }

  function readRuntime() {
    const title = settings.SETTINGS_TITLE;
    let card = findCard(title);
    if (!card) {
      card = addCard(title, settingsTemplate());
    }
    if (card) card = saveCard(card, entryOf(card), title) || card;
    const settingsUpgrade = ensureRelationshipSettings(card);
    card = settingsUpgrade.card || card;
    const source = card ? entryOf(card) : "";
    const rawContinuityBudget = extractLine(source, "Continuity budget");
    const defaultContinuityBudget = settings.DEFAULT_CONTINUITY_BUDGET;
    const minimumContinuityBudget = settings.MIN_CONTINUITY_BUDGET;
    const parsedContinuityBudget = positiveWhole(rawContinuityBudget, defaultContinuityBudget);
    const continuityBudget = Math.max(minimumContinuityBudget, parsedContinuityBudget);
    const budgetWarning = rawContinuityBudget && parsedContinuityBudget !== Number(rawContinuityBudget)
      ? "Continuity budget was invalid and defaulted to " + defaultContinuityBudget + "."
      : (rawContinuityBudget && parsedContinuityBudget < minimumContinuityBudget
        ? "Continuity budget was raised to the required " + minimumContinuityBudget + "-token minimum."
      : (!rawContinuityBudget && card
        ? "Continuity budget was missing and defaulted to " + defaultContinuityBudget + "."
        : ""));
    const relationshipPace = relationshipPaceSettings(source);
    const turningPointMode = turningPointModeSetting(source);
    return {
      enabled: boolValue(extractLine(source, "Enabled"), settings.DEFAULT_ENABLED !== false),
      continuityBudget,
      stateLifetime: numberValue(
        extractLine(source, "State lifetime"),
        settings.DEFAULT_STATE_LIFETIME,
        1,
        12
      ),
      maxActive: numberValue(
        extractLine(source, "Maximum active NPCs"),
        settings.DEFAULT_MAX_ACTIVE_NPCS,
        1,
        settings.MAX_ACTIVE_NPCS
      ),
      dynamicCast: boolValue(
        extractLine(source, "Dynamic cast"),
        settings.DEFAULT_DYNAMIC_CAST !== false
      ),
      sidePromotionInteractions: numberValue(
        extractLine(source, "Side promotion interactions"),
        settings.DEFAULT_SIDE_PROMOTION_INTERACTIONS,
        1,
        999
      ),
      mainInactivityLimit: numberValue(
        extractLine(source, "Main inactivity limit"),
        settings.DEFAULT_MAIN_INACTIVITY_LIMIT,
        1,
        999
      ),
      debug: boolValue(extractLine(source, "Debug"), settings.DEFAULT_DEBUG === true),
      relationshipPace: relationshipPace.pace,
      turningPointMode: turningPointMode.mode,
      warning: [card ? "" : "The Settings card could not be created.", settingsUpgrade.warning, budgetWarning, relationshipPace.warning, turningPointMode.warning]
        .filter(Boolean).join(" ")
    };
  }

  const runtime = readRuntime();
  if (!runtime.enabled) return finish(originalText);

  function playerProfile() {
    let card = findCard(settings.PLAYER_TITLE);
    if (card) card = saveCard(card, entryOf(card), settings.PLAYER_TITLE) || card;
    const source = card ? entryOf(card) : "";
    const name = extractLine(source, "Name") || "the player";
    const raw = (extractLine(source, "Pronouns") || "they/them").split(/[\/|,;\s]+/).filter(Boolean);
    let forms;
    if (raw.length >= 5) forms = raw.slice(0, 5);
    else {
      const subject = keyOf(raw[0] || "they");
      if (subject === "she") forms = ["she", "her", "her", "hers", "herself"];
      else if (subject === "he") forms = ["he", "him", "his", "his", "himself"];
      else forms = ["they", "them", "their", "theirs", "themselves"];
    }
    return {
      name,
      aliases: [name],
      emergingAliases: [],
      subject: forms[0], object: forms[1], possessiveAdjective: forms[2],
      possessivePronoun: forms[3], reflexive: forms[4],
      agreement: keyOf(forms[0]) === "they" ? "plural" : "singular"
    };
  }

  const player = playerProfile();

  function resolvePlayerTokens(value) {
    const forms = {
      name: player.name,
      subject: player.subject,
      object: player.object,
      possessive_adjective: player.possessiveAdjective,
      possessiveadjective: player.possessiveAdjective,
      possessive_pronoun: player.possessivePronoun,
      possessivepronoun: player.possessivePronoun,
      reflexive: player.reflexive,
      is: player.agreement === "plural" ? "are" : "is",
      has: player.agreement === "plural" ? "have" : "has",
      does: player.agreement === "plural" ? "do" : "does",
      was: player.agreement === "plural" ? "were" : "was",
      s: player.agreement === "plural" ? "" : "s"
    };
    return textOf(value).replace(/{{\s*(player|Player|PLAYER)\.([a-zA-Z_]+)\s*}}/g, (match, owner, field) => {
      const replacement = forms[keyOf(field).replace(/\s+/g, "_")];
      if (replacement === undefined) return match;
      if (owner === "PLAYER") return textOf(replacement).toUpperCase();
      if (owner === "Player") return replacement ? replacement.charAt(0).toUpperCase() + replacement.slice(1) : replacement;
      return replacement;
    });
  }

  function normalizeCastStatus(value, fallback) {
    const normalized = keyOf(value);
    if (normalized === "main" || normalized === "side") return normalized;
    return fallback;
  }

  function parseOuterPronouns(source) {
    const parts = textOf(extractLine(source, "Name, age, gender, pronouns"))
      .split(",")
      .map(value => value.trim());
    let pronouns = "";
    if (parts.length >= 4) {
      pronouns = line(parts.pop(), 120);
    } else {
      parts.shift();
      parts.shift();
      parts.shift();
      pronouns = line(parts.join(","), 120);
    }
    return pronouns;
  }

  function shortenProfileValue(value, maximum) {
    const source = line(value, 20000);
    const max = Math.max(1, Number(maximum) || 1);
    if (source.length <= max) return source;
    if (max === 1) return "…";
    const candidate = source.slice(0, max - 1).trimEnd();
    const wordBreak = candidate.lastIndexOf(" ");
    const kept = wordBreak >= Math.floor(max * 0.55)
      ? candidate.slice(0, wordBreak)
      : candidate;
    return kept.replace(/[,:;\-/]+$/g, "").trimEnd() + "…";
  }

  function renderOuterBlock(name, fields) {
    return [
      "{",
      name + "'s Outer:",
      ...fields.map(field => field.label + ": " + field.value),
      "}"
    ].join("\n");
  }

  function outerWrapperStatus(source) {
    const trimmed = textOf(source).replace(/\r/g, "").trim();
    return {
      opening: trimmed.startsWith("{"),
      closing: trimmed.endsWith("}")
    };
  }

  function buildOuterProfile(name, source) {
    const resolved = resolvePlayerTokens(source);
    const fields = [
      { label: "Name, age, gender, pronouns", value: extractLine(resolved, "Name, age, gender, pronouns") },
      { label: "Race/Species", value: extractLine(resolved, "Race/Species") },
      { label: "Physical attributes", value: extractLine(resolved, "Physical attributes") },
      { label: "Clothing style", value: extractLine(resolved, "Clothing style") }
    ].map(field => ({ label: field.label, value: line(field.value, 20000) }));
    const original = renderOuterBlock(name, fields);
    const maximum = settings.MAX_OUTER_CARD_CHARS;
    const fitted = fields.map(field => ({ label: field.label, value: field.value }));
    let rendered = original;
    let guard = 0;
    while (rendered.length > maximum && guard < 40) {
      guard += 1;
      const candidates = fitted.map((field, index) => ({
        index,
        reducible: Math.max(0, field.value.length - 24)
      })).filter(item => item.reducible > 0)
        .sort((left, right) => right.reducible - left.reducible || left.index - right.index);
      if (!candidates.length) break;
      const selected = candidates[0];
      const overflow = rendered.length - maximum;
      const reduction = Math.min(selected.reducible, Math.max(1, overflow));
      fitted[selected.index].value = shortenProfileValue(
        fitted[selected.index].value,
        fitted[selected.index].value.length - reduction
      );
      rendered = renderOuterBlock(name, fitted);
    }
    if (rendered.length > maximum) rendered = wrappedLine(rendered, maximum);
    return {
      text: rendered,
      originalChars: original.length,
      retainedChars: rendered.length,
      truncated: original.length > rendered.length,
      missing: fields.filter(field => !field.value).map(field => field.label)
    };
  }

  function renderInnerBlock(name, fields) {
    return [
      "{",
      name + "'s Inner:",
      ...fields.map(field => field.label + ": " + field.value),
      "}"
    ].join("\n");
  }

  function buildInnerProfile(name, source) {
    const resolved = resolvePlayerTokens(source);

    const fields = [
      { label: "Personality", value: extractLine(resolved, "Personality") },
      { label: "Mannerisms", value: extractLine(resolved, "Mannerisms") },
      { label: "Wants", value: extractLine(resolved, "Wants") },
      { label: "Fears", value: extractLine(resolved, "Fears") },
      { label: "Mental wounds", value: extractLine(resolved, "Mental wounds") },
      { label: "Principles", value: extractLine(resolved, "Principles") }
    ].map(field => ({ label: field.label, value: line(field.value, 20000) }));
    const original = renderInnerBlock(name, fields);
    const maximum = settings.MAX_INNER_CARD_CHARS;
    const fitted = fields.map(field => ({ label: field.label, value: field.value }));
    let rendered = original;
    let guard = 0;
    while (rendered.length > maximum && guard < 60) {
      guard += 1;
      const candidates = fitted.map((field, index) => ({
        index,
        reducible: Math.max(0, field.value.length - 24)
      })).filter(item => item.reducible > 0)
        .sort((left, right) => right.reducible - left.reducible || left.index - right.index);
      if (!candidates.length) break;
      const selected = candidates[0];
      const overflow = rendered.length - maximum;
      const reduction = Math.min(selected.reducible, Math.max(1, overflow));
      fitted[selected.index].value = shortenProfileValue(
        fitted[selected.index].value,
        fitted[selected.index].value.length - reduction
      );
      rendered = renderInnerBlock(name, fitted);
    }
    if (rendered.length > maximum) rendered = wrappedLine(rendered, maximum);
    return {
      text: rendered,
      originalChars: original.length,
      retainedChars: rendered.length,
      truncated: original.length > rendered.length,
      missing: fields.filter(field => !field.value).map(field => field.label)
    };
  }

  const activeRosterDiagnostics = [];

  function activeNpcSlotCode(number) {
    const slot = Number(number);
    return Number.isSafeInteger(slot) && slot >= 1 && slot <= settings.MAX_ACTIVE_NPCS
      ? "N" + slot
      : "";
  }

  function activeNpcRosterEntry(slotNames) {
    const names = Array.isArray(slotNames) ? slotNames : [];
    const rows = ["{", "Active NPC slots:"];
    for (let index = 0; index < settings.MAX_ACTIVE_NPCS; index++) {
      rows.push(activeNpcSlotCode(index + 1) + ": " + line(names[index], 120));
    }
    rows.push("}");
    return rows.join("\n");
  }

  function activeNpcRosterName(value) {
    const source = textOf(value).trim();
    if (!source || source.length > 120 || /[{}\[\]|\r\n]/.test(source)) return "";
    return line(source, 120);
  }

  function readActiveNpcRoster() {
    const matching = catalogRecordsByTitle(settings.ACTIVE_NPCS_TITLE)
      .map(record => record.card);
    let card = matching[0] || null;
    const slots = Array.from({ length: settings.MAX_ACTIVE_NPCS }, (_, index) => ({
      number: index + 1,
      code: activeNpcSlotCode(index + 1),
      name: "",
      valid: true
    }));
    if (!card) return { card: null, slots, source: "", wrapperValid: true };
    if (matching.length > 1) {
      activeRosterDiagnostics.push("Multiple CC — Active NPCs cards were found; only the first is authoritative.");
    }
    if (textOf(card.type) !== settings.CARD_TYPE
      || !managedCardIdentityMatches(card, settings.ACTIVE_NPCS_TITLE)) {
      const updated = saveCard(card, entryOf(card), settings.ACTIVE_NPCS_TITLE);
      if (updated) card = updated;
      else activeRosterDiagnostics.push("CC — Active NPCs could not be internalized as a Continuity card.");
    }
    const source = entryOf(card);
    const trimmed = textOf(source).replace(/\r/g, "").trim();
    const wrapperValid = trimmed.startsWith("{") && trimmed.endsWith("}");
    if (!wrapperValid) activeRosterDiagnostics.push("CC — Active NPCs wrapper { } is incomplete.");
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    slots.forEach(slot => {
      const pattern = new RegExp("^[ \\t]*" + escapeRegExp(slot.code) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i");
      const matches = rows.map(row => row.match(pattern)).filter(Boolean);
      if (matches.length !== 1) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " must appear exactly once in CC — Active NPCs.");
        return;
      }
      const supplied = textOf(matches[0][1]).trim();
      if (!supplied) return;
      const name = activeNpcRosterName(supplied);
      if (!name || name !== supplied) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " contained an invalid or overlong canonical NPC name.");
        return;
      }
      slot.name = name;
    });
    rows.forEach(row => {
      const match = row.match(/^[ \\t]*N(\d+)[ \\t]*:/i);
      if (match && !activeNpcSlotCode(Number(match[1]))) {
        activeRosterDiagnostics.push("Unsupported active NPC slot N" + Number(match[1]) + " was ignored.");
      }
    });
    const seen = {};
    slots.forEach(slot => {
      if (!slot.valid || !slot.name) return;
      const key = nameKeyOf(slot.name);
      if (seen[key]) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " duplicated " + seen[key] + " and was ignored without compacting the roster.");
      } else seen[key] = slot.code;
    });
    return { card, slots, source, wrapperValid };
  }

  function onboardingMarkerPresent(source) {
    return /^[ \\t]*Onboarding[ \\t]*:[ \\t]*Pending[ \\t]*$/im.test(textOf(source));
  }

  const ONBOARDING_VIEW_CATEGORIES = ["Loves", "Likes", "Neutrals", "Dislikes", "Hates"];
  const ONBOARDING_RELATIONSHIP_FIELDS = ["Role", "Trust", "Closeness", "Boundaries", "Conflict"];
  const ONBOARDING_RELATIONSHIP_STAGES = {
