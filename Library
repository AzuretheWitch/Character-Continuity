            ),
            pendingRetrySourceActionCount: Number.isFinite(Number(discardedPlan.pendingRetrySourceActionCount))
              ? Math.max(0, Math.floor(Number(discardedPlan.pendingRetrySourceActionCount)))
              : -1,
            pendingRetrySourceKind: line(discardedPlan.pendingRetrySourceKind, 40)
          } : {})
        } : {})
      };
      CC.last.retry = true;
      CC.last.continue = false;
      CC.last.warning = "";
      if (!discardedRestored) {
        CC.last.warning = "Action revision rollback was incomplete; one or more managed Story Cards could not be restored exactly.";
      }
      CC.last.candidate = "rolled back";
      CC.last.update = "None";
      CC.last.output = "Retry/revision restored the pre-generation snapshot, including provenance, operation meters, drains, Names, Relationships, Turning Points, and consumed evidence.";
      if (!discardedRestored) {
        CC.last.output += " One or more managed Story Cards could not be restored exactly.";
      }
      return CC.currentPlan;
    }

    const actionOpportunity = observedActionCount === null || clearlyNewAction;
    if (!actionOpportunity) {
      CC.currentPlan = {
        kind: "preview", retry: false, opening: false, genuine: false, opportunity: false,
        actionCount: observedActionCount,
        revisionSourcePlan: discardedPlan && discardedPlan.completed ? clone(discardedPlan) : null,
        task: "none", taskDelivered: false, completed: false, castProgressApplied: false
      };
      CC.last.retry = false;
      CC.last.continue = false;
      return CC.currentPlan;
    }

    CC.preGenerationSnapshot = captureSnapshot();
    CC.currentPlan = {
      kind: "action", retry: false, opening: false, genuine: false, opportunity: true,
      actionCount: observedActionCount,
      genuineInputCount: Math.max(0, Number(CC.inputCount) || 0),
      task: "none", taskDelivered: false, completed: false, castProgressApplied: false
    };
    if (CC.pendingOperationRetry && CC.pendingOperationRetry.active) {
      applyPendingOperationRetry(CC.currentPlan, CC.pendingOperationRetry);
    }
    CC.last.retry = false;
    CC.last.continue = true;
    return CC.currentPlan;
  }

  function markActionCompleted(plan) {
    const observed = platformActionCount();
    const planned = plan && Number.isFinite(Number(plan.actionCount))
      ? Math.max(0, Math.floor(Number(plan.actionCount)))
      : null;
    const completed = observed === null ? planned : (planned === null ? observed : Math.max(observed, planned));
    if (completed !== null) CC.lastCompletedActionCount = Math.max(CC.lastCompletedActionCount, completed);
  }

  function commitDeliveredOperationOpportunity(plan) {
    if (!plan || plan.opportunity !== true || plan.opportunityCounted === true) return false;
    const owner = characters.find(character => character.key === plan.ownerKey) || null;
    if (!owner) return false;
    const current = Math.max(0, Number(CC.ownerOpportunities[owner.key]) || 0);
    const prepared = Math.max(0, Number(plan.ownerOpportunity) || 0);
    const committed = Math.max(current + 1, prepared);
    CC.ownerOpportunities[owner.key] = committed;
    plan.opportunityPrepared = true;
    plan.opportunityCounted = true;
    plan.ownerOpportunity = committed;
    const decay = materializeOwnerDrainDecay(owner.key, committed);
    plan.operationDecay = clone(decay);
    CC.last.operationDecay = decay.summary;
    return true;
  }

  function outerAnchor(character) {
