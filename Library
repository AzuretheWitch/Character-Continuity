    return parts.length
      ? ["{", character.name + "'s current private State:", ...parts, "}"].join("\n")
      : "";
  }

  const EXPERIENCE_STOP_WORDS = new Set([
    "about", "after", "again", "against", "being", "during", "from", "getting", "having",
    "into", "their", "there", "these", "they", "this", "through", "under", "with"
  ]);

  function experienceStem(value) {
    const word = keyOf(value).replace(/\s+/g, "");
    if (word.length <= 4) return word;
    if (word.endsWith("ies")) return word.slice(0, -3) + "y";
    if (word.endsWith("ing")) return word.slice(0, -3);
    if (word.endsWith("ion")) return word.slice(0, -3);
    if (word.endsWith("ed")) return word.slice(0, -2);
    if (word.endsWith("es")) return word.slice(0, -2);
    if (word.endsWith("s")) return word.slice(0, -1);
    return word;
  }

  function experienceSituationMentioned(record, source) {
    const haystack = keyOf(source);
    const phrase = keyOf(record && record.situation);
    if (!haystack || !phrase) return false;
    if (haystack.includes(phrase)) return true;
    const terms = unique(phrase.split(" ")
      .filter(word => word.length >= 4 && !EXPERIENCE_STOP_WORDS.has(word))
      .map(experienceStem)
      .filter(Boolean), 60);
    if (!terms.length) return false;
    const haystackTerms = new Set(haystack.split(" ").map(experienceStem).filter(Boolean));
    const matches = terms.filter(word => haystackTerms.has(word)).length;
    return matches >= Math.min(2, terms.length);
  }

  function experienceMentioned(record, owner, source) {
    return targetReferenceMentioned(record, owner, source)
      || experienceSituationMentioned(record, source);
  }

  function relevantExperienceRecords(owner, currentInput, recent, evidenceCandidates) {
    const ownerData = experiencesForOwner(owner.key);
    const records = ownerData ? ownerData.contextRecords : [];
    const evidenceText = (Array.isArray(evidenceCandidates) ? evidenceCandidates : [])
      .map(candidate => candidate.item.text)
      .join("\n");
    const state = normalizeState(CC.npcs[owner.key] && CC.npcs[owner.key].state, CC.stateClock);
    return records.map(record => {
      let score = 0;
      if (experienceMentioned(record, owner, currentInput)) {
        score = Math.max(score, 1000);
      }
      if (experienceMentioned(record, owner, evidenceText)) {
        score = Math.max(score, 900);
      }
      if (record.targetKey === state.situation.targetKey || record.targetKey === state.target.key) {
        score = Math.max(score, 850);
      }
      if (keyOf(record.situation) === keyOf(state.situation.value) && state.situation.value) {
        score = Math.max(score, 875);
      }
      if (experienceMentioned(record, owner, textOf(recent).slice(-2500))) {
        score = Math.max(score, 700);
      }
      return { record, score };
    }).filter(item => item.score > 0)
      .sort((left, right) => right.score - left.score || left.record.page - right.record.page || left.record.line - right.record.line);
  }

  function renderRelevantExperienceBlock(owner, selection) {
    const record = selection && (selection.record || selection);
    if (!record) return "";
    return [
      "{",
      owner.name + "'s relevant Experience:",
      "About: " + modelTargetName(record.targetKey, record.targetName),
      "Experience: " + shortenProfileValue(
        experiencePhrase(record.situation),
        settings.MAX_MODEL_EXPERIENCE_CHARS
      ),
      "}"
    ].join("\n");
  }

  function recoveringViewKey(ownerKey, targetKey) {
    return ownerKey + "|" + targetKey;
  }

  function recoveringMarker(ownerKey, targetKey) {
    return CC.recoveringViews[recoveringViewKey(ownerKey, targetKey)] || null;
  }

  function availableEvidence(owner, recent, currentInputId = "", frozenIds = [], opportunityOverride = null, frozenEligibility = null) {
    const frozen = Array.isArray(frozenIds) && frozenIds.length ? new Set(frozenIds) : null;
    const order = frozen ? new Map(frozenIds.map((id, index) => [id, index])) : null;
    return CC.evidence.map(item => {
      const saved = frozenEligibility && typeof frozenEligibility[item.id] === "object"
        ? frozenEligibility[item.id]
        : null;
      return {
        item,
        stateEligible: saved ? saved.state === true : stateEvidenceEligible(item, owner, recent),
        viewEligible: saved ? saved.view === true : viewEvidenceEligible(item, owner, recent, "", opportunityOverride),
        relationshipEligible: saved
          ? saved.relationship === true
          : relationshipEvidenceEligible(item, owner, recent, "", opportunityOverride),
        turningEligible: saved
          ? saved.turning === true
          : turningPointEvidenceEligible(item, owner, recent, "", opportunityOverride),
        nameEligible: saved
          ? saved.name === true
          : nameEvidenceEligible(item, owner, recent, "", "", opportunityOverride),
        age: saved && Number.isFinite(Number(saved.age))
          ? Math.max(0, Number(saved.age))
          : viewEvidenceAge(item, owner, opportunityOverride)
      };
    }).filter(candidate => (candidate.stateEligible || candidate.viewEligible || candidate.relationshipEligible
      || candidate.turningEligible || candidate.nameEligible)
      && (!frozen || frozen.has(candidate.item.id)))
      .sort((left, right) => {
        if (order) return (order.get(left.item.id) ?? Number.MAX_SAFE_INTEGER) - (order.get(right.item.id) ?? Number.MAX_SAFE_INTEGER);
        const leftCurrent = left.item.id === currentInputId ? 1 : 0;
        const rightCurrent = right.item.id === currentInputId ? 1 : 0;
        if (rightCurrent !== leftCurrent) return rightCurrent - leftCurrent;
        const leftRecent = anchorInText(left.item.anchor, recent) ? 1 : 0;
        const rightRecent = anchorInText(right.item.anchor, recent) ? 1 : 0;
        if (rightRecent !== leftRecent) return rightRecent - leftRecent;
        if (right.age !== left.age) return right.age - left.age;
        return right.item.number - left.item.number;
      });
  }

  function semanticAssessmentEvidence(owner, recent, currentInputId = "", frozenIds = [], opportunityOverride = null) {
    if (!owner) return [];
    const frozen = Array.isArray(frozenIds) && frozenIds.length ? new Set(frozenIds) : null;
    const order = frozen ? new Map(frozenIds.map((id, index) => [id, index])) : null;
    const maximumAge = Math.max(
      settings.VIEW_EVIDENCE_OPPORTUNITIES,
      settings.RELATIONSHIP_EVIDENCE_OPPORTUNITIES,
      settings.TURNING_POINT_EVIDENCE_OPPORTUNITIES,
      settings.NAME_EVIDENCE_OPPORTUNITIES
    );
    return CC.evidence
      .filter(item => item && /^E\d+$/.test(item.id) && (!frozen || frozen.has(item.id)))
      .filter(item => openingEvidenceEligible(item, recent))
      .filter(item => viewEvidenceAge(item, owner, opportunityOverride) < maximumAge)
      .filter(item => !(item.assessedNoChangeBy && item.assessedNoChangeBy[owner.key]))
      .map(item => ({
        item,
        // Raw E# rows carry no scripted semantic classification. Every direct
        // operation form may cite them; the model supplies the meaning.
        nameEligible: true,
        stateEligible: true,
        relationshipEligible: true,
        viewEligible: true,
        turningEligible: true,
        age: viewEvidenceAge(item, owner, opportunityOverride)
      }))
      .sort((left, right) => {
        if (order) return (order.get(left.item.id) ?? Number.MAX_SAFE_INTEGER)
          - (order.get(right.item.id) ?? Number.MAX_SAFE_INTEGER);
        const leftCurrent = left.item.id === currentInputId ? 1 : 0;
        const rightCurrent = right.item.id === currentInputId ? 1 : 0;
        if (rightCurrent !== leftCurrent) return rightCurrent - leftCurrent;
        const leftRecent = anchorInText(left.item.anchor, recent) ? 1 : 0;
        const rightRecent = anchorInText(right.item.anchor, recent) ? 1 : 0;
        if (rightRecent !== leftRecent) return rightRecent - leftRecent;
        return right.item.number - left.item.number;
      });
  }

  function targetReferenceMentioned(record, owner, source) {
    if (!record) return false;
    if (record.targetKey === "self") {
      const identity = owner ? nameIdentityForKey("npc:" + owner.key) : null;
      return aliasMentioned(source, "Self")
        || !!(identity && identityMentioned(source, identity, false, CC.activeKeys));
    }
    if (record.targetKey === "player") {
      const identity = nameIdentityForKey("player");
      return ["Player", "the player", "you"].some(alias => aliasMentioned(source, alias))
        || !!(identity && identityMentioned(source, identity, false, CC.activeKeys));
    }
    if (record.targetKey.startsWith("npc:")) {
      const identity = nameIdentityForKey(record.targetKey);
      return !!(identity && identityMentioned(source, identity, false, CC.activeKeys));
    }
    return viewTargetAliases(record, owner).some(alias => aliasMentioned(source, alias));
  }

  function recordMentioned(record, owner, source) {
    return targetReferenceMentioned(record, owner, source);
  }

  function stateViewTargetKey(character) {
    const state = normalizeState(CC.npcs[character.key] && CC.npcs[character.key].state, CC.stateClock);
    if (state.target.key === "self" || state.target.key === "player") return state.target.key;
    const direct = characters.find(item => "npc:" + item.key === state.target.key || item.key === state.target.key);
    const identity = direct ? null : unambiguousIdentityForm(state.target.name, false);
    const npc = direct || (identity && identity.character ? identity.character : null);
    return npc ? "npc:" + npc.key : (state.target.name ? "target:" + keyOf(state.target.name) : "");
  }

  function relevantViewRecords(owner, active, currentInput, recent, evidenceCandidates, buried) {
    const ownerData = viewsForOwner(owner.key);
    const records = ownerData ? (buried ? ownerData.buriedRecords : ownerData.activeRecords) : [];
    const evidenceText = evidenceCandidates.map(candidate => candidate.item.text).join("\n");
    const currentStateTarget = stateViewTargetKey(owner);
    const activeTargetKeys = new Set(active.filter(character => character.key !== owner.key).map(character => "npc:" + character.key));
    return records.map(record => {
      let score = 0;
      if (recordMentioned(record, owner, currentInput)) score = Math.max(score, 1000);
      if (recordMentioned(record, owner, evidenceText)) score = Math.max(score, 900);
      if (record.targetKey === "player" && (interactionScore(owner, currentInput) > 0 || CC.conversationKey === owner.key)) {
        score = Math.max(score, 800);
      }
      if (activeTargetKeys.has(record.targetKey) && recordMentioned(record, owner, currentInput + "\n" + recent)) {
        score = Math.max(score, 700);
      }
      if (record.targetKey === currentStateTarget) score = Math.max(score, 600);
      if (recordMentioned(record, owner, textOf(recent).slice(-2500))) score = Math.max(score, 500);
      return { record, score };
    }).filter(item => item.score > 0)
      .sort((left, right) => right.score - left.score || left.record.page - right.record.page || left.record.line - right.record.line);
  }

  function modelViewTargetName(record) {
    return record.targetKey === "player" ? player.name : record.targetName;
  }

  function safeModelViewText(value) {
    return line(value, 2000).replace(/\{/g, "⦃").replace(/\}/g, "⦄");
  }

  function renderRelevantViewsBlock(owner, selections) {
    const records = (Array.isArray(selections) ? selections : []).map(item => item.record || item);
    if (!records.length) return "";
    const rows = ["{", owner.name + "'s relevant Views:"];
    VIEW_CATEGORIES.forEach(category => {
      const categoryRecords = records.filter(record => record.category === category);
      if (!categoryRecords.length) return;
      rows.push(category + ":");
      categoryRecords.forEach(record => rows.push(
        modelViewTargetName(record) + " — " + safeModelViewText(record.explanation)
      ));
    });
    rows.push("}");
    return rows.join("\n");
  }

  function relevantRecoveredBlocks(owner, activeSelections, buriedSelections) {
    const activeByTarget = {};
    const buriedByTarget = {};
    activeSelections.forEach(item => { activeByTarget[item.record.targetKey] = item.record; });
    buriedSelections.forEach(item => { buriedByTarget[item.record.targetKey] = item.record; });
    return Object.keys(CC.recoveringViews).map(key => {
      const marker = CC.recoveringViews[key];
      if (!marker || marker.ownerKey !== owner.key) return null;
      const active = activeByTarget[marker.targetKey];
      const buried = buriedByTarget[marker.targetKey];
      if (!active || !buried) return null;
      return {
        targetKey: marker.targetKey,
        text: [
          "{",
          owner.name + "'s recovered Views of " + modelViewTargetName(active) + ":",
          "Earlier View: " + buried.category + " — " + safeModelViewText(buried.explanation),
          "Current View: " + active.category + " — " + safeModelViewText(active.explanation),
          "}"
        ].join("\n")
      };
    }).filter(Boolean);
  }

  function nameRecordMentioned(record, source) {
    return !!(record && aliasMentioned(source, record.alias));
  }

  function nameUseModelText(record) {
    const permissions = record && record.use && record.use.permissions || [];
    return permissions.map(permission => permission.name).join(", ") || textOf(record && record.values && record.values.Use);
  }

  function relevantNameRecords(identity, currentInput, recent, active) {
    const identityData = namesForIdentity(identity.key);
    const records = identityData ? identityData.contextRecords : [];
    const recentTail = textOf(recent).slice(-2500);
    const activePermissionKeys = new Set(["general", "player"].concat(
      (Array.isArray(active) ? active : []).map(character => "npc:" + character.key)
    ));
    return records.map(record => {
      let score = 0;
      if (nameRecordMentioned(record, currentInput)) score = 1000;
      else if (nameRecordMentioned(record, recentTail)) score = 900;
      else if (record.status === "Rejected") score = 800;
      else if (record.status === "Emerging") score = 750;
      else if (record.status === "Active" && (record.use.permissions || []).some(permission => activePermissionKeys.has(permission.key))) score = 650;
      else if (record.status === "Active") score = 550;
      else if (record.status === "Retired") score = 450;
      return { record, score };
    }).filter(item => item.score > 0)
      .sort((left, right) => right.score - left.score
        || left.record.page - right.record.page || left.record.line - right.record.line);
  }

  function renderRelevantNamesBlock(identity, selections) {
    const records = (Array.isArray(selections) ? selections : []).map(item => item.record || item).filter(Boolean);
    if (!records.length) return "";
    const rows = ["{", identity.headerOwner + "'s relevant Names:", "Canonical: " + identity.canonical];
    records.forEach(record => {
      rows.push("");
      rows.push("Alias: " + record.alias);
      rows.push("Status: " + record.status);
      rows.push("Use: " + nameUseModelText(record));
      rows.push("Reason: " + safeModelViewText(record.reason));
    });
    rows.push("}");
    return rows.join("\n");
  }

  function relationshipRecordMentioned(record, owner, source) {
    return targetReferenceMentioned(record, owner, source);
  }

  function modelRelationshipTargetName(record) {
    return record.targetKey === "player" ? player.name : record.targetName;
  }

  function modelRelationshipFields(record) {
    const result = [];
    RELATIONSHIP_FIELDS.forEach(field => {
      const parsed = record && record.parsedFields && record.parsedFields[field];
      if (!parsed || !parsed.safe || parsed.blank) return;
      if (field === "Conflict" && keyOf(parsed.stage) === "clear") return;
      const stage = parsed.special || parsed.stage;
      if (!stage) return;
      const description = safeModelViewText(parsed.description);
      result.push({ field, text: stage + (description ? " — " + description : "") });
    });
    return result;
  }

  function relevantRelationshipRecords(owner, active, currentInput, recent) {
    const ownerData = relationshipsForOwner(owner.key);
    const records = ownerData ? ownerData.contextRecords : [];
    const stateTarget = stateViewTargetKey(owner);
    const activeTargetKeys = new Set(active.filter(character => character.key !== owner.key)
      .map(character => "npc:" + character.key));
    const latestStory = textOf(recent).slice(-2500);
    const combined = currentInput + "\n" + latestStory;
    return records.map(record => {
      let score = 0;
      if (relationshipRecordMentioned(record, owner, currentInput)) score = 1000;
      else if (record.targetKey === "player"
        && (interactionScore(owner, currentInput) > 0 || CC.conversationKey === owner.key)) score = 900;
      else if (record.targetKey === stateTarget) score = 800;
      else if (activeTargetKeys.has(record.targetKey) && relationshipRecordMentioned(record, owner, latestStory)) score = 700;
      else if (relationshipRecordMentioned(record, owner, latestStory)) score = 600;
      else if (record.targetKey === "player") score = 550;
      else if (activeTargetKeys.has(record.targetKey)) score = 500;
      const aliases = relationshipTargetAliases(record, owner);
      let newestMention = -1;
      if (targetReferenceMentioned(record, owner, combined)) {
        aliases.forEach(alias => {
          const normalizedAlias = keyOf(alias);
          if (!normalizedAlias) return;
          newestMention = Math.max(newestMention, keyOf(combined).lastIndexOf(normalizedAlias));
        });
      }
      return { record, score, newestMention, fields: modelRelationshipFields(record) };
    }).filter(item => item.score > 0 && item.fields.length)
      .sort((left, right) => right.score - left.score
        || right.newestMention - left.newestMention
        || left.record.page - right.record.page
        || left.record.line - right.record.line);
  }

  function renderRelevantRelationshipsBlock(owner, selections) {
    const chosen = (Array.isArray(selections) ? selections : []).map(item => ({
      record: item.record || item,
      fields: item.fields || modelRelationshipFields(item.record || item)
    })).filter(item => item.record && item.fields.length);
    if (!chosen.length) return "";
    const rows = ["{", owner.name + "'s relevant Relationships:"];
    chosen.forEach((item, index) => {
      if (index > 0) rows.push("");
      rows.push("About: " + modelRelationshipTargetName(item.record));
      item.fields.forEach(field => rows.push(field.field + ": " + field.text));
    });
    rows.push("}");
    return rows.join("\n");
  }

  function operationTargetMap(owner, active, activeSelections, buriedSelections, relationshipSelections, currentInput, evidenceCandidates, recent) {
    const result = [];
    const usedKeys = new Set();
    const add = target => {
      const signature = target.code + "|" + target.key + "|" + target.mode;
      if (!usedKeys.has(signature)) {
        usedKeys.add(signature);
        result.push(target);
      }
    };
    const activeByTarget = {};
    activeSelections.forEach(item => { activeByTarget[item.record.targetKey] = item.record; });
    const buriedByTarget = {};
    buriedSelections.forEach(item => { buriedByTarget[item.record.targetKey] = item.record; });
    const relationshipByTarget = {};
    (Array.isArray(relationshipSelections) ? relationshipSelections : []).forEach(item => {
      relationshipByTarget[item.record.targetKey] = item.record;
    });
    const targetSource = [currentInput, textOf(recent).slice(-2500)]
      .concat(evidenceCandidates.map(candidate => candidate.item.text))
      .join("\n");

    const special = [
      { code: "S", key: "self", name: "Self", mode: "known", relationship: false, nameSubject: true },
      { code: "P", key: "player", name: player.name, mode: "known", relationship: true, nameSubject: true }
    ];
    special.forEach(target => {
      const relevant = target.key === "self" || target.key === "player"
        || (!!activeByTarget.player || !!buriedByTarget.player || !!relationshipByTarget.player
          || interactionScore(owner, currentInput) > 0
          || CC.conversationKey === owner.key
          || operationTargetMentioned(owner, target, targetSource));
      if (!relevant) return;
      const marker = recoveringMarker(owner.key, target.key);
      add(target);
      if (marker) add({
        code: "R" + (result.filter(item => item.code.startsWith("R")).length + 1),
        key: target.key, name: target.name, mode: "recovering", relationship: false, nameSubject: false
      });
    });

    activeNpcRosterCharacterSlots(false).forEach(slot => {
      const character = slot.character;
      if (character.key === owner.key) return;
      const targetKey = "npc:" + character.key;
      const relevant = !!activeByTarget[targetKey] || !!buriedByTarget[targetKey]
        || !!relationshipByTarget[targetKey]
        || characterMentioned(targetSource, character, false, active.map(item => item.key));
      if (!relevant) return;
      const marker = recoveringMarker(owner.key, targetKey);
      add({ code: slot.code, key: targetKey, name: character.name, mode: "known", relationship: true, nameSubject: true });
      if (marker) add({
        code: "R" + (result.filter(item => item.code.startsWith("R")).length + 1),
        key: targetKey, name: character.name, mode: "recovering", relationship: false, nameSubject: false
      });
    });

    let viewNumber = 1;
    activeSelections.forEach(item => {
      const record = item.record;
      if (result.some(target => target.key === record.targetKey)) return;
      const marker = recoveringMarker(owner.key, record.targetKey);
      add(marker
        ? { code: "R" + (result.filter(target => target.code.startsWith("R")).length + 1), key: record.targetKey, name: modelViewTargetName(record), mode: "recovering", relationship: false, nameSubject: false }
        : { code: "V" + viewNumber++, key: record.targetKey, name: modelViewTargetName(record), mode: "active", relationship: false, nameSubject: false });
    });

    let buriedNumber = 1;
    buriedSelections.forEach(item => {
      const record = item.record;
      if (recoveringMarker(owner.key, record.targetKey)) return;
      add({ code: "B" + buriedNumber++, key: record.targetKey, name: modelViewTargetName(record), mode: "buried", relationship: false, nameSubject: false });
    });
    return result;
  }


  function operationKindLabel(kind) {
    const normalized = keyOf(kind);
    if (normalized === "turning") return "Turning Point";
    return normalized ? normalized.charAt(0).toUpperCase() + normalized.slice(1) : "None";
  }

  function operationTargetAliases(owner, target) {
    if (!target) return [];
    if (target.key === "self") {
      return uniqueNameForms([owner && owner.name].concat(owner && owner.aliases || []), 160);
    }
    if (target.key === "player") {
      return uniqueNameForms(["Player", "the player", "you", player.name].concat(player.aliases || []), 160);
    }
    if (target.key && target.key.startsWith("npc:")) {
      const character = characters.find(item => "npc:" + item.key === target.key);
      return character
        ? uniqueNameForms([character.name].concat(character.aliases || []), 160)
        : uniqueNameForms([target.name], 160);
    }
    return uniqueNameForms([target.name], 160);
  }

  function operationOwnerMentioned(owner, source) {
    return !!owner && uniqueNameForms([owner.name].concat(owner.aliases || []), 160)
      .some(alias => aliasMentioned(source, alias));
  }

  function operationOwnerAliases(owner) {
    return uniqueNameForms([owner && owner.name].concat(owner && owner.aliases || []), 160);
  }

  function operationAliasRegExp(alias) {
    const wanted = line(alias, 160).split(/\s+/).map(escapeRegExp).join("\\s+");
    return wanted ? "(?:" + wanted + ")" : "";
  }

  function operationFallbackMentionIndex(source, aliases) {
    const text = textOf(source);
    let earliest = -1;
    (Array.isArray(aliases) ? aliases : []).forEach(alias => {
      const wanted = operationAliasRegExp(alias);
      if (!wanted) return;
      const match = new RegExp(
        "(^|[^A-Za-z0-9])" + wanted + "(?=$|[^A-Za-z0-9])",
        "i"
      ).exec(text);
      if (!match) return;
      const index = match.index + textOf(match[1]).length;
      if (earliest < 0 || index < earliest) earliest = index;
    });
    return earliest;
  }

  function operationFallbackStateOwnerAnchored(owner, source) {
    if (!owner) return false;
    const text = textOf(source).trim();
    const ownerIndex = operationFallbackMentionIndex(text, operationOwnerAliases(owner));
    if (ownerIndex < 0 || ownerIndex > 96) return false;
    if (ownerIndex === 0) return true;
    const prefix = text.slice(0, ownerIndex);
    return /^(?:at|in|on|near|inside|outside|beside|by|behind|before|after|across|under|over|within|amid|among|from|through)\b[^.!?…\n]{0,80},\s*$/i
      .test(prefix);
  }

  function ownerSpeechAttributed(owner, source, statementPattern) {
    const text = textOf(source);
    if (!owner || !text || !(statementPattern instanceof RegExp)) return false;
    const flags = statementPattern.flags.includes("i") ? "ig" : "g";
    const matcher = new RegExp(statementPattern.source, flags);
    let match;
    while ((match = matcher.exec(text))) {
      const before = text.slice(Math.max(0, match.index - 180), match.index);
      const after = text.slice(match.index + match[0].length, match.index + match[0].length + 180);
      const attributed = operationOwnerAliases(owner).some(alias => {
        const wanted = operationAliasRegExp(alias);
        if (!wanted) return false;
        const beforeSpeaker = new RegExp(
          wanted + "[^.!?…\\n]{0,50}\\b(?:says?|said|asks?|asked|answers?|answered|replies?|replied|tells?|told|admits?|admitted|declares?|declared|insists?|insisted|whispers?|whispered|shouts?|shouted|murmurs?|murmured)\\b[^.!?…\\n]{0,90}$",
          "i"
        );
        const beforeLabel = new RegExp(wanted + "\\s*[:—-]\\s*[^.!?…\\n]{0,40}$", "i");
        const beforeQuotedSpeaker = new RegExp(
          wanted + "[^\"“”‘’\\n]{0,50}\\b(?:says?|said|asks?|asked|answers?|answered|replies?|replied|tells?|told|admits?|admitted|declares?|declared|insists?|insisted|whispers?|whispered|shouts?|shouted|murmurs?|murmured)\\b"
            + "[^\"“”‘’\\n]{0,25}[\"“‘][^\"”’\\n]{0,165}$",
          "i"
        );
        const beforeQuotedLabel = new RegExp(
          wanted + "\\s*[:—-]\\s*[\"“‘][^\"”’\\n]{0,165}$",
          "i"
        );
        const afterSpeaker = new RegExp(
          "^[^.!?…\\n]{0,90}(?:" + wanted
            + "[^.!?…\\n]{0,40}\\b(?:says?|said|asks?|asked|answers?|answered|replies?|replied|admits?|admitted|declares?|declared|insists?|insisted|whispers?|whispered|shouts?|shouted|murmurs?|murmured)\\b"
            + "|\\b(?:says?|said|asks?|asked|answers?|answered|replies?|replied|admits?|admitted|declares?|declared|insists?|insisted|whispers?|whispered|shouts?|shouted|murmurs?|murmured)\\b[^.!?…\\n]{0,20}" + wanted + ")",
          "i"
        );
        return beforeSpeaker.test(before)
          || beforeLabel.test(before)
          || beforeQuotedSpeaker.test(before)
          || beforeQuotedLabel.test(before)
          || afterSpeaker.test(after);
      });
      if (attributed) return true;
      if (match[0].length === 0) matcher.lastIndex += 1;
    }
    return false;
  }

  function ownerPredicateMatches(owner, source, predicatePattern) {
    const text = textOf(source);
    if (!owner || !text || !predicatePattern) return false;
    return operationOwnerAliases(owner).some(alias => {
      const wanted = operationAliasRegExp(alias);
      return !!wanted && new RegExp(
        "(?:^|[^A-Za-z0-9])" + wanted + "[^.!?…\\n]{0,55}(?:" + predicatePattern + ")",
        "i"
      ).test(text);
    });
  }

  function ownerNearEvent(owner, source, eventPattern, maximum = 120) {
    const text = textOf(source);
    if (!owner || !text || !eventPattern) return false;
    const distance = Math.max(20, Math.min(240, Number(maximum) || 120));
    return operationOwnerAliases(owner).some(alias => {
      const wanted = operationAliasRegExp(alias);
      if (!wanted) return false;
      return new RegExp(
        "(?:" + wanted + "[^.!?…\\n]{0," + distance + "}(?:" + eventPattern + ")"
          + "|(?:" + eventPattern + ")[^.!?…\\n]{0," + distance + "}" + wanted + ")",
        "i"
      ).test(text);
    });
  }

  function ownerTargetSentenceMatches(owner, target, source, eventPattern) {
    if (!owner || !target || !eventPattern) return false;
    return textOf(source).split(/[.!?…\n]+/).some(sentence => {
      if (!operationOwnerMentioned(owner, sentence) || !operationTargetMentioned(owner, target, sentence)) return false;
      return new RegExp(eventPattern, "i").test(sentence);
    });
  }

  function operationTargetMentioned(owner, target, source) {
    if (!target) return false;
    if (target.key === "player" && /\byou\b/i.test(textOf(source))) return true;
    if (target.key === "self" && operationOwnerMentioned(owner, source)) return true;
    return operationTargetAliases(owner, target).some(alias => aliasMentioned(source, alias));
  }

  function operationCurrentRelevance(item, currentInputId, recent) {
    if (!item) return 0;
    if (item.id === currentInputId) return 4;
    if (item.source === "provenance") return Math.max(1, Math.min(3, Number(item.relevance) || 1));
    if (item.source === "story" && anchorInText(item.anchor, recent)) return 3;
    if (item.source === "opening" && anchorInText(item.anchor, recent)) return 2;
    return item.source === "story" ? 1 : 0;
  }

  const RELATIONSHIP_TRIGGER_FIELDS = {
    affection: ["Closeness"],
    anger: ["Conflict"],
    reconnect: ["Closeness"],
    withdraw: ["Closeness"],
    responsibility: ["Role"],
    conflict: ["Conflict"],
    trust_gain: ["Trust"],
    trust_loss: ["Trust"],
    closeness_gain: ["Closeness"],
    closeness_loss: ["Closeness"],
    boundary_respected: ["Boundaries"],
    boundary_crossed: ["Boundaries", "Conflict"],
    repair: ["Trust", "Conflict"],
    betrayal: ["Trust", "Conflict"]
  };

  function relationshipLineageTriggers(record, seen = new Set()) {
    if (!record || seen.has(record.id)) return [];
    seen.add(record.id);
    const result = triggerList(record.triggers);
    (record.sourceIds || []).filter(id => /^[SX]\d+$/.test(id)).forEach(id => {
      relationshipLineageTriggers(provenanceRecordById(id), seen).forEach(trigger => {
        if (!result.includes(trigger)) result.push(trigger);
      });
    });
    return result.slice(0, 20);
  }

  function relationshipGroundedFields(triggers, content) {
    const fields = [];
    const add = field => {
      if (RELATIONSHIP_FIELDS.includes(field) && !fields.includes(field)) fields.push(field);
    };
    triggerList(triggers).forEach(trigger => {
      (RELATIONSHIP_TRIGGER_FIELDS[trigger] || []).forEach(add);
    });
    const source = keyOf(content);
    if (/\b(?:trust\w*|distrust\w*|betray\w*|reliab\w*|dependab\w*|deceiv\w*|dishonest\w*|lied|lying|repair\w*)\b/.test(source)) add("Trust");
    if (/\b(?:affection\w*|reconnect\w*|closeness|close|distant|distance|bond\w*|friendship|shared connection|intimacy|intimate|withdraw\w*)\b/.test(source)) add("Closeness");
    if (/\b(?:boundary|boundaries|consent\w*|permission|limit\w*|crossed|respected|reinforced|released)\b/.test(source)) add("Boundaries");
    if (/\b(?:conflict\w*|argument\w*|fight\w*|anger|angry|hostil\w*|rupture\w*|friction|strain\w*|betray\w*|repair\w*)\b/.test(source)) add("Conflict");
    if (/\b(?:accepted responsibility|responsibility|employ\w*|hired|job|position|role|partnership|partnered|marriage|married|spouse|promotion|promoted|in charge|duty)\b/.test(source)) add("Role");
    return fields;
  }

  function relationshipGroundedFieldsForRecord(record) {
    if (!record) return [];
    const rawLineage = storyLineageForSources((record.sourceIds || []).concat(record.storyEvidenceIds || []));
    const lineageText = rawLineage.map(id => evidenceForId(id)?.text || "").join(" ");
    const managedContent = record.kind === "state"
      ? [record.value, record.thought, lineageText]
      : [record.value, record.explanation, lineageText];
    return relationshipGroundedFields(
      relationshipLineageTriggers(record),
      managedContent.filter(Boolean).join(" ")
    );
  }

  function relationshipDerivedDestinationForRecord(record, field) {
    if (!record || !RELATIONSHIP_FIELDS.includes(field)) return "";
    const triggers = relationshipLineageTriggers(record);
    const lineage = storyLineageForSources((record.sourceIds || []).concat(record.storyEvidenceIds || []))
      .map(id => evidenceForId(id)?.text || "").join(" ");
    const source = keyOf([
      record.value,
      record.thought,
      record.explanation,
      lineage
    ].filter(Boolean).join(" "));
    const hasTrigger = values => values.some(value => triggers.includes(value));
    const choose = (positive, negative, positiveDestination, negativeDestination) => {
      if (positive === negative) return "";
      return positive ? positiveDestination : negativeDestination;
    };
    if (field === "Trust") {
      const severe = hasTrigger(["betrayal"]) || /\b(?:betray\w*|treacher\w*)\b/.test(source);
      const negative = severe || hasTrigger(["trust_loss"])
        || /\b(?:distrust\w*|dishonest\w*|unreliab\w*|cannot rely|can't rely|could not rely|deceiv\w*|lied|lying|broken promise)\b/.test(source);
      const positive = hasTrigger(["trust_gain", "repair"])
        || /\b(?:trust\w*|reliab\w*|dependab\w*|can rely|could rely|kept (?:a|the|his|her|their) promise)\b/.test(source);
      return choose(positive, negative, "Trust", severe ? "Severe distrust" : "Distrust");
    }
    if (field === "Closeness") {
      const negative = hasTrigger(["closeness_loss", "withdraw"])
        || /\b(?:distant|distance|disconnect\w*|withdraw\w*|pull\w* away)\b/.test(source);
      const positive = hasTrigger(["closeness_gain", "affection", "reconnect"])
        || /\b(?:close|closeness|bond\w*|affection\w*|reconnect\w*|intimacy|intimate)\b/.test(source);
      return choose(positive, negative, "Close", "Distant");
    }
    if (field === "Conflict") {
      const repaired = hasTrigger(["repair"])
        || /\b(?:resolved|made peace|reconcil\w*|repair\w*)\b/.test(source);
      const ruptured = hasTrigger(["betrayal"])
        || /\b(?:rupture\w*|severed ties|cut ties|irreparable|betray\w*)\b/.test(source);
      const conflict = ruptured || hasTrigger(["conflict", "anger", "boundary_crossed"])
        || /\b(?:conflict\w*|fight\w*|argument\w*|anger|angry|hostil\w*|friction|strain)\b/.test(source);
      return choose(repaired, conflict, "Clear", ruptured ? "Rupture" : "Open conflict");
    }
    if (field === "Boundaries") {
      const respected = hasTrigger(["boundary_respected"])
        || /\b(?:respected|reinforced|enforced|reasserted|restated)\b[^.!?]{0,40}\bboundar/.test(source);
      const explicit = /\b(?:explicit|set|stated|established|clear)\b[^.!?]{0,40}\bboundar/.test(source);
      return respected ? "Reinforced" : (explicit ? "Explicit" : "");
    }
    if (field === "Role") {
      const established = hasTrigger(["responsibility"])
        || /\b(?:responsib\w*|employ\w*|hired|job|position|role|partnership|partnered|marriage|married|spouse|promotion|promoted|in charge|duty)\b/.test(source);
      return established ? "Established" : "";
    }
    return "";
  }

  function relationshipDerivedSourceText(record, allowedFields, rawLineage) {
    const targetName = modelTargetName(record.targetKey, record.targetName);
    const fields = (allowedFields || []).join(", ");
    if (record.kind === "state") {
      const triggers = relationshipLineageTriggers(record);
      return line(
        "Accepted State confirmation about " + targetName
          + ": Situation " + (record.value || "unspecified")
          + (triggers.length ? "; triggers " + triggers.join(", ") : "")
          + (record.thought ? "; private meaning " + record.thought : "")
          + "; allowed Relationship fields " + fields
          + (rawLineage.length ? "; raw lineage " + rawLineage.join(",") : ""),
        settings.MAX_EVIDENCE_ITEM_CHARS
      );
    }
    return line(
      "Promoted Experience about " + targetName
        + ": " + (record.value || record.explanation || "unspecified")
        + "; allowed Relationship fields " + fields
        + (rawLineage.length ? "; raw lineage " + rawLineage.join(",") : ""),
      settings.MAX_EVIDENCE_ITEM_CHARS
    );
  }

  function relationshipDerivedEvidenceCandidates(owner, targets, opportunityOverride = null, frozenPacket = null) {
    const legalTargets = new Map((Array.isArray(targets) ? targets : [])
      .filter(target => target.relationship === true && target.key !== "self")
      .map(target => [target.key, target]));
    const currentOpportunity = opportunityOverride === null
      ? Math.max(0, Number(CC.ownerOpportunities[owner.key]) || 0)
      : Math.max(0, Number(opportunityOverride) || 0);
    const frozenById = {};
    const frozenOrder = [];
    (Array.isArray(frozenPacket) ? frozenPacket : []).forEach(source => {
      const id = provenanceId(source && source.id);
      if (!id || !["S", "X"].includes(id.charAt(0))) return;
      frozenById[id] = source;
      frozenOrder.push(id);
    });
    refreshProvenanceActivity();
    const records = CC.provenance.records.filter(record =>
      ["state", "experience"].includes(record.kind)
      && record.ownerKey === owner.key
      && legalTargets.has(record.targetKey)
    );
    const ordered = frozenOrder.length
      ? frozenOrder.map(id => records.find(record => record.id === id)).filter(Boolean)
      : records.slice().sort((left, right) =>
        right.ownerOpportunity - left.ownerOpportunity
          || right.createdClock - left.createdClock
          || right.id.localeCompare(left.id)
      );
    const diagnostics = [];
    const candidates = [];
    ordered.forEach(record => {
      const frozen = frozenById[record.id] || null;
      const prefix = record.id.charAt(0);
      const expectedGain = prefix === "S"
        ? settings.OPERATION_POINTS.STATE_CONFIRMATION_GAIN
        : settings.OPERATION_POINTS.EXPERIENCE_PATTERN_GAIN;
      const age = Math.max(0, currentOpportunity - Math.max(0, Number(record.ownerOpportunity) || 0));
      const expectedManagedIdentity = record.kind === "state"
        ? stateSituationSignature(record.ownerKey, record.targetKey, record.value)
        : experienceSignature(record.ownerKey, record.targetKey, record.value);
      if (!record.active || !managedSignatureStillValid(record)
        || !expectedManagedIdentity || record.managedSignature !== expectedManagedIdentity) {
        diagnostics.push(record.id + " excluded: inactive, managed signature stale, or owner-target identity inconsistent.");
        return;
      }
      if (age >= settings.RELATIONSHIP_EVIDENCE_OPPORTUNITIES) {
        diagnostics.push(record.id + " excluded: age " + age + " reached the Relationship evidence window.");
        return;
      }
      const rawLineage = storyLineageForSources(record.sourceIds.concat(record.storyEvidenceIds || []));
      const grounded = relationshipGroundedFieldsForRecord(record)
        .filter(field => !!relationshipDerivedDestinationForRecord(record, field));
      const frozenFields = frozen && Array.isArray(frozen.allowedFields)
        ? frozen.allowedFields.filter(field => RELATIONSHIP_FIELDS.includes(field))
        : null;
      const allowedFields = (frozenFields || grounded).filter(field => grounded.includes(field));
      const fieldUseSignatures = {};
      allowedFields.forEach(field => {
        const recomputed = relationshipUseSignatureForRecord(record, owner.key, record.targetKey, field);
        const frozenSignature = frozen && frozen.useSignatures && frozen.useSignatures[field];
        if (!recomputed || (frozenSignature && frozenSignature !== recomputed)) return;
        if (!provenanceUseCommitted(record, recomputed)) fieldUseSignatures[field] = recomputed;
      });
      const unusedFields = allowedFields.filter(field => fieldUseSignatures[field]);
      if (!unusedFields.length) {
        diagnostics.push(record.id + " excluded: no grounded unused Relationship field remained.");
        return;
      }
      const target = legalTargets.get(record.targetKey);
      const text = frozen && frozen.text
        ? line(frozen.text, settings.MAX_EVIDENCE_ITEM_CHARS)
        : relationshipDerivedSourceText(record, unusedFields, rawLineage);
      const itemNumber = 1000000 + Math.max(0, Number(record.createdClock) || 0) * 1000
        + Math.max(0, Number(record.id.slice(1)) || 0);
      candidates.push({
        item: {
          id: record.id,
          number: itemNumber,
          source: "provenance",
          text,
          anchor: null,
          relevance: age === 0 ? 3 : (age <= 2 ? 2 : 1)
        },
        stateEligible: false,
        viewEligible: false,
        relationshipEligible: true,
        nameEligible: false,
        age: frozen && Number.isFinite(Number(frozen.age)) ? Math.max(0, Number(frozen.age)) : age,
        derived: true,
        prefix,
        ownerKey: record.ownerKey,
        targetKey: record.targetKey,
        targetName: target && target.name || record.targetName,
        allowedFields: unusedFields,
        allowedDestinations: unique(unusedFields.map(field =>
          relationshipDerivedDestinationForRecord(record, field)
        ).filter(Boolean), 80),
        managedSignature: record.managedSignature,
        rawLineage,
        gain: frozen && Number.isFinite(Number(frozen.gain))
          ? Math.max(0, Number(frozen.gain))
          : expectedGain,
        useSignatures: fieldUseSignatures,
        directAllowed: false,
        eligibilityReason: record.id + " active, target-compatible, signature-valid, age " + age
          + ", allowed " + unusedFields.join(", ")
      });
      diagnostics.push(record.id + " eligible: " + unusedFields.join(", ")
        + "; gain " + expectedGain + "; raw " + (rawLineage.join(",") || "None") + ".");
    });
    CC.last.relationshipSourceDiagnostics = unique(diagnostics, 500).slice(-40);
    return candidates;
  }

  function viewInterpretationsForTarget(owner, targetKey, targets) {
    const legalModes = (Array.isArray(targets) ? targets : [])
      .filter(target => target && target.key === targetKey)
      .map(target => target.mode);
    if (!legalModes.length) return [];
    refreshViewsStore(false);
    const ownerData = viewsForOwner(owner.key);
    const activeRecord = ownerData && ownerData.activeRecords.find(record => record.targetKey === targetKey);
    const buriedRecord = ownerData && ownerData.buriedRecords.find(record => record.targetKey === targetKey);
    const recovering = !!recoveringMarker(owner.key, targetKey);
    const interpretations = [];
    const add = (destination, operationMode, targetMode) => {
      const normalizedDestination = canonicalViewDestination(destination);
      const normalizedMode = canonicalViewOperationMode(operationMode);
      if (!normalizedDestination || !normalizedMode) return;
      const key = [normalizedDestination, normalizedMode, targetMode || ""].join("|");
      if (!interpretations.some(item => item.key === key)) {
        interpretations.push({ key, destination: normalizedDestination, operationMode: normalizedMode, targetMode: targetMode || "" });
      }
    };
    if (legalModes.includes("known")) {
      VIEW_CATEGORIES.forEach(destination => {
        add(destination, "O", "known");
        add(destination, "M", "known");
      });
      if (activeRecord && !buriedRecord && !recovering) add("Buried", "Buried", "known");
    }
    if (legalModes.includes("buried") && buriedRecord) add("Recovered", "Recovered", "buried");
    if (legalModes.includes("recovering") && activeRecord && buriedRecord && recovering) {
      VIEW_CATEGORIES.forEach(destination => add(destination, "Reconciled", "recovering"));
    }
    return interpretations;
  }

  const DERIVED_VIEW_BURIAL_PATTERN = /\b(?:forgot|forgets|forgotten|no longer remembers?|memory (?:of|about).{0,40}(?:faded|is gone|was gone)|ceased to remember)\b/i;
  const DERIVED_VIEW_RECOVERY_PATTERN = /\b(?:remembered|remembers|recalled|recalls|recognized|recognizes|memory returned|memories returned)\b/i;
  const DERIVED_VIEW_MAJOR_PATTERN = /\b(?:betrayal|betrayed|saved (?:his|her|their|the) life|life[- ]threatening|sacrificed|sacrifice|murdered|murder|abused|abuse|assaulted|assault|tortured|torture|married|marriage|divorced|divorce|death|died|severed ties|cut ties|irreparable|ruined everything)\b/i;
  function provenanceViewSemanticTexts(record) {
    if (!record) return [];
    return unique([
      record.explanation,
      record.value,
      record.priorValue,
      record.resultingValue,
      record.priorViewState,
      record.resultingViewState
    ], 2000).filter(Boolean);
  }

  function provenanceViewOwnerTarget(record) {
    if (!record) return null;
    const owner = characters.find(character => character.key === record.ownerKey) || null;
    const targetKey = normalizedTargetKey(record.targetKey);
    if (!owner || !targetKey) return null;
    if (targetKey === "self") {
      return { owner, target: { key: "self", name: owner.name } };
    }
    if (targetKey === "player") {
      return { owner, target: { key: "player", name: player.name } };
    }
    if (targetKey.startsWith("npc:")) {
      const character = characters.find(item => "npc:" + item.key === targetKey) || null;
      if (character) return { owner, target: { key: targetKey, name: character.name } };
    }
    return null;
  }

  function derivedViewDestinationSupported(record, destination) {
    const normalizedDestination = canonicalViewDestination(destination);
    const source = provenanceViewSemanticTexts(record).join(" ");
    if (!normalizedDestination || !source) return false;
    if (VIEW_CATEGORIES.includes(normalizedDestination)) {
      const identities = provenanceViewOwnerTarget(record);
      if (!identities) return false;
      const explicit = explicitViewSignal(identities.owner, identities.target, {
        item: { id: record.id, text: source },
        viewEligible: true
      });
      if (explicit && explicit.destination === normalizedDestination) return true;
      if (normalizedDestination !== "Neutrals") return false;
      const neutralThirdPerson = ownerTargetSentenceMatches(
        identities.owner,
        identities.target,
        source,
        "\\b(?:is|was|became|remained|felt|feels)\\s+(?:emotionally\\s+)?(?:neutral|indifferent|unmoved)\\b|\\b(?:has|had)\\s+no\\s+(?:strong\\s+)?opinion\\b"
      );
      const neutralFirstPerson = operationTargetAliases(identities.owner, identities.target)
        .some(alias => {
          const wanted = operationAliasRegExp(alias);
          return !!wanted && ownerSpeechAttributed(identities.owner, source, new RegExp(
            "\\bi\\s+(?:feel\\s+)?(?:neutral|indifferent|nothing)\\s+(?:about|toward|towards|for)\\s+" + wanted + "\\b",
            "i"
          ));
        });
      return neutralThirdPerson || neutralFirstPerson;
    }
    if (normalizedDestination === "Buried") return DERIVED_VIEW_BURIAL_PATTERN.test(source);
    if (normalizedDestination === "Recovered") return DERIVED_VIEW_RECOVERY_PATTERN.test(source);
    return false;
  }

  function derivedViewModeSupported(record, destination, operationMode) {
    const normalizedMode = canonicalViewOperationMode(operationMode);
    if (!normalizedMode) return false;
    if (!derivedViewDestinationSupported(record, destination)) return false;
    if (normalizedMode !== "M") return true;
    const source = provenanceViewSemanticTexts(record).join(" ");
    return DERIVED_VIEW_MAJOR_PATTERN.test(source)
      || (record.kind === "relationship" && record.eventKind === "D"
        && Math.abs(Number(record.actualChange) || 0) >= 10);
  }

  function derivedViewInterpretationsForRecord(record, owner, targetKey, targets) {
    return viewInterpretationsForTarget(owner, targetKey, targets).filter(item =>
      derivedViewModeSupported(record, item.destination, item.operationMode)
    );
  }

  function viewDerivedSourceText(record, interpretations, rawLineage) {
    const targetName = modelTargetName(record.targetKey, record.targetName);
    const modes = unique((interpretations || []).map(item => item.operationMode), 40).join(", ");
    if (record.kind === "relationship") {
      const movement = [record.field, record.actualChange ? ((record.actualChange > 0 ? "+" : "") + record.actualChange) : "",
        record.resultingStage || record.resultingValue].filter(Boolean).join(" ");
      return line(
        "Accepted Relationship movement about " + targetName + ": " + (movement || record.explanation || "relationship changed")
          + "; this source makes View review eligible but selects no View category"
          + (modes ? "; legal operation modes " + modes : "")
          + (rawLineage.length ? "; raw lineage " + rawLineage.join(",") : ""),
        settings.MAX_EVIDENCE_ITEM_CHARS
      );
    }
    return line(
      "Promoted Experience about " + targetName + ": " + (record.value || record.explanation || "unspecified")
        + "; this source makes View review eligible but selects no View category"
        + (modes ? "; legal operation modes " + modes : "")
        + (rawLineage.length ? "; raw lineage " + rawLineage.join(",") : ""),
      settings.MAX_EVIDENCE_ITEM_CHARS
    );
  }

  function viewDerivedEvidenceCandidates(owner, targets, opportunityOverride = null, frozenPacket = null) {
    const targetLists = new Map();
    (Array.isArray(targets) ? targets : []).forEach(target => {
      if (!target || !target.key || /^NEW=/i.test(target.code || "")) return;
      if (!targetLists.has(target.key)) targetLists.set(target.key, []);
      targetLists.get(target.key).push(target);
    });
    const currentOpportunity = opportunityOverride === null
      ? Math.max(0, Number(CC.ownerOpportunities[owner.key]) || 0)
      : Math.max(0, Number(opportunityOverride) || 0);
    const frozenById = {};
    const frozenOrder = [];
    (Array.isArray(frozenPacket) ? frozenPacket : []).forEach(source => {
      const id = provenanceId(source && source.id);
      if (!id || !["R", "X"].includes(id.charAt(0))) return;
      frozenById[id] = source;
      frozenOrder.push(id);
    });
    refreshProvenanceActivity();
    const records = CC.provenance.records.filter(record =>
      ["relationship", "experience"].includes(record.kind)
      && record.ownerKey === owner.key
      && targetLists.has(record.targetKey)
    );
    const ordered = frozenOrder.length
      ? frozenOrder.map(id => records.find(record => record.id === id)).filter(Boolean)
      : records.slice().sort((left, right) =>
        right.ownerOpportunity - left.ownerOpportunity
          || right.createdClock - left.createdClock
          || right.id.localeCompare(left.id)
      );
    const diagnostics = [];
    const candidates = [];
    ordered.forEach(record => {
      const frozen = frozenById[record.id] || null;
      const prefix = record.id.charAt(0);
      const age = Math.max(0, currentOpportunity - Math.max(0, Number(record.ownerOpportunity) || 0));
      const expectedManagedIdentity = record.kind === "relationship"
        ? currentRelationshipManagedSignature(record.ownerKey, record.targetKey, record.field)
        : experienceSignature(record.ownerKey, record.targetKey, record.value);
      if (!record.active || !managedSignatureStillValid(record)
        || !expectedManagedIdentity || record.managedSignature !== expectedManagedIdentity) {
        diagnostics.push(record.id + " excluded: inactive, managed signature stale, or owner-target identity inconsistent.");
        return;
      }
      if (age >= settings.VIEW_EVIDENCE_OPPORTUNITIES) {
        diagnostics.push(record.id + " excluded: age " + age + " reached the View evidence window.");
        return;
      }
      const targetOptions = targetLists.get(record.targetKey) || [];
      const currentInterpretations = derivedViewInterpretationsForRecord(record, owner, record.targetKey, targetOptions);
      const frozenInterpretations = frozen && Array.isArray(frozen.interpretations)
        ? frozen.interpretations.map(item => {
          const destination = canonicalViewDestination(item && item.destination);
          const operationMode = canonicalViewOperationMode(item && item.operationMode);
          const targetMode = line(item && item.targetMode, 40);
          return {
            key: [destination, operationMode, targetMode || ""].join("|"),
            destination,
            operationMode,
            targetMode
          };
        }).filter(item => item.destination && item.operationMode)
        : null;
      const allowedInterpretations = (frozenInterpretations || currentInterpretations).filter(item =>
        currentInterpretations.some(current => current.destination === item.destination
          && current.operationMode === item.operationMode && current.targetMode === item.targetMode)
      );
      const rawLineage = storyLineageForSources(record.sourceIds.concat(record.storyEvidenceIds || []));
      const useSignatures = {};
      const unusedInterpretations = [];
      allowedInterpretations.forEach(item => {
        const key = [item.destination, item.operationMode, item.targetMode || ""].join("|");
        const recomputed = viewUseSignatureForRecord(
          record, owner.key, record.targetKey, item.destination, item.operationMode
        );
        const frozenSignature = frozen && frozen.useSignatures && frozen.useSignatures[key];
        if (!recomputed || (frozenSignature && frozenSignature !== recomputed)) return;
        if (!provenanceUseCommitted(record, recomputed)) {
          useSignatures[key] = recomputed;
          unusedInterpretations.push({ ...item, key });
        }
      });
      if (!unusedInterpretations.length) {
        diagnostics.push(record.id + " excluded: no unused legal View interpretation remained.");
        return;
      }
      const target = targetOptions[0];
      const text = frozen && frozen.text
        ? line(frozen.text, settings.MAX_EVIDENCE_ITEM_CHARS)
        : viewDerivedSourceText(record, unusedInterpretations, rawLineage);
      const itemNumber = 2000000 + Math.max(0, Number(record.createdClock) || 0) * 1000
        + Math.max(0, Number(record.id.slice(1)) || 0);
      const gain = frozen && Number.isFinite(Number(frozen.gain))
        ? Math.max(0, Number(frozen.gain))
        : (record.kind === "relationship"
          ? settings.OPERATION_POINTS.RELATIONSHIP_TO_VIEW_GAIN
          : settings.OPERATION_POINTS.EXPERIENCE_PATTERN_GAIN);
      candidates.push({
        item: {
          id: record.id,
          number: itemNumber,
          source: "provenance",
          text,
          anchor: null,
          relevance: age === 0 ? 3 : (age <= 2 ? 2 : 1)
        },
        stateEligible: false,
        viewEligible: true,
        relationshipEligible: false,
        nameEligible: false,
        age: frozen && Number.isFinite(Number(frozen.age)) ? Math.max(0, Number(frozen.age)) : age,
        derived: true,
        prefix,
        ownerKey: record.ownerKey,
        targetKey: record.targetKey,
        targetName: target && target.name || record.targetName,
        allowedFields: [],
        allowedDestinations: unique(unusedInterpretations.map(item => item.destination), 80),
        allowedModes: unique(unusedInterpretations.map(item => item.operationMode), 40),
        interpretations: unusedInterpretations,
        managedSignature: record.managedSignature,
        rawLineage,
        gain,
        useSignatures,
        directAllowed: false,
        eligibilityReason: record.id + " active, target-compatible, signature-valid, age " + age
          + "; the scripted rules will freeze one legal View destination and mode if this source is selected"
      });
      diagnostics.push(record.id + " eligible for View review; gain " + gain
        + "; target " + record.targetKey + "; interpretations " + unusedInterpretations.length
        + "; raw " + (rawLineage.join(",") || "None") + ".");
    });
    CC.last.viewSourceDiagnostics = unique(diagnostics, 500).slice(-40);
    return candidates;
  }

  function operationPhraseIndex(values) {
    const result = new Map();
    const seen = new Set();
    (Array.isArray(values) ? values : []).forEach(value => {
      const normalized = keyOf(line(value, 160));
      if (!normalized || seen.has(normalized)) return;
      seen.add(normalized);
      const words = normalized.split(" ");
      const bucket = result.get(words[0]) || [];
      bucket.push(words);
      result.set(words[0], bucket);
    });
    return result;
  }

  function operationVerbForms(verbs) {
    const result = new Set();
    (Array.isArray(verbs) ? verbs : []).forEach(value => {
      const source = textOf(value).trim().toLowerCase();
      const optionalS = source.match(/^([a-z0-9]+)s\?$/);
      if (optionalS) {
        result.add(optionalS[1]);
        result.add(optionalS[1] + "s");
        return;
      }
      const normalized = keyOf(source);
      if (normalized && !normalized.includes(" ")) result.add(normalized);
    });
    return result;
  }

  function operationWordsMatch(words, start, phrase) {
    if (start < 0 || start + phrase.length > words.length) return false;
    for (let index = 0; index < phrase.length; index++) {
      if (words[start + index] !== phrase[index]) return false;
    }
    return true;
  }

  function orderedOperationStatement(source, subjects, verbs, objects) {
    const normalized = keyOf(source);
    if (!normalized) return false;
    const words = normalized.split(" ");
    const subjectIndex = operationPhraseIndex(subjects);
    const objectIndex = operationPhraseIndex(objects);
    const verbForms = operationVerbForms(verbs);
    if (!subjectIndex.size || !objectIndex.size || !verbForms.size) return false;
    const emphases = new Set(["really", "fully", "completely", "deeply"]);

    // Match the same subject → optional emphasis → verb → object order as the
    // former dynamic regex, but scan the normalized words once. This avoids
    // compiling and testing every subject/object/verb combination each turn.
    for (let start = 0; start < words.length; start++) {
      const subjectsAtStart = subjectIndex.get(words[start]);
      if (!subjectsAtStart) continue;
      for (const subject of subjectsAtStart) {
        if (!operationWordsMatch(words, start, subject)) continue;
        let verbIndex = start + subject.length;
        if (emphases.has(words[verbIndex])) verbIndex += 1;
        if (!verbForms.has(words[verbIndex])) continue;
        const objectStart = verbIndex + 1;
        const objectsAtStart = objectIndex.get(words[objectStart]);
        if (objectsAtStart && objectsAtStart.some(object =>
          operationWordsMatch(words, objectStart, object)
        )) return true;
      }
    }
    return false;
  }

  function safeCapturedAlias(value) {
    const alias = line(textOf(value).replace(/^[\s"“”'’]+|[\s"“”'’]+$/g, ""), 160);
    if (!alias || /[{}\[\]|()\r\n]/.test(alias)) return "";
    const words = alias.match(/[\p{L}\p{N}'’.-]+/gu) || [];
    return words.length >= 1 && words.length <= 8 ? alias : "";
  }

  function directNameInterpretation(owner, target, item) {
    if (!owner || !target || !item) return null;
    const source = textOf(item.text);
    const identityKey = target.key === "self" ? "npc:" + owner.key : target.key;
    const identity = nameIdentityForKey(identityKey);
    if (!identity) return null;
    const firstPersonCue = /\b(?:call me|address me as|refer to me as|i go by|my name is|i am now called|i'm now called|from now on[, ]+call me|do not call me|don't call me|never call me|no longer call me)\b/i;
    const ownerFirstPerson = target.key === "self" && ownerSpeechAttributed(owner, source, firstPersonCue);
    const playerFirstPerson = target.key === "player"
      && (item.source === "input" || item.source === "opening")
      && firstPersonCue.test(source)
      && !ownerSpeechAttributed(owner, source, firstPersonCue);
    if (!ownerFirstPerson && !playerFirstPerson) return null;

    const patterns = [
      { transition: "Retired", use: "None", pattern: /\bno longer\s+(?:call|address|refer to)\s+me\s+(?:as\s+)?["“]?([^"”\n.!?;,]{1,120})/i },
      { transition: "Rejected", use: "None", pattern: /\b(?:do not|don't|never)\s+(?:call|address|refer to)\s+me\s+(?:as\s+)?["“]?([^"”\n.!?;,]{1,120})/i },
      { transition: "Adopted", use: "General", pattern: /\b(?:from now on[, ]+)?(?:call|address|refer to)\s+me\s+(?:as\s+)?["“]?([^"”\n.!?;,]{1,120})/i },
      { transition: "Adopted", use: "General", pattern: /\bi\s+(?:now\s+)?go by\s+["“]?([^"”\n.!?;,]{1,120})/i },
      { transition: "Adopted", use: "General", pattern: /\bmy name is\s+["“]?([^"”\n.!?;,]{1,120})/i },
      { transition: "Adopted", use: "General", pattern: /\bi(?:\s+am|'m)\s+now called\s+["“]?([^"”\n.!?;,]{1,120})/i }
    ];
    const matched = patterns.map(rule => ({ rule, match: source.match(rule.pattern) }))
      .find(itemValue => itemValue.match);
    if (!matched) return null;
    const alias = safeCapturedAlias(matched.match[1]);
    if (!alias || sameNameForm(alias, identity.canonical)) return null;
    const identityData = namesForIdentity(identity.key);
    const existing = identityData && identityData.contextRecords.find(record => sameNameForm(record.alias, alias));
    let transition = matched.rule.transition;
    if (transition === "Adopted" && existing && ["Retired", "Rejected"].includes(existing.status)) {
      transition = "Reactivated";
    }
    if (transition === "Adopted" && existing && existing.status === "Active") return null;
    if (transition === "Retired" && (!existing || ["Retired", "Rejected"].includes(existing.status))) return null;
    return {
      alias,
      transition,
      replacedAlias: "",
      use: transition === "Retired" || transition === "Rejected" ? "None" : matched.rule.use
    };
  }

  function observedNameInterpretation(owner, target, item) {
    if (!owner || !target || !item || target.key === "player") return null;
    const identityKey = target.key === "self" ? "npc:" + owner.key : target.key;
    const identity = nameIdentityForKey(identityKey);
    const emerging = identity && identity.player
      ? (player.emergingAliases || [])
      : (identity && identity.character ? identity.character.emergingAliases || [] : []);
    const matches = emerging.filter(alias => aliasMentioned(item.text, alias));
    if (matches.length !== 1) return null;
    const use = (item.source === "input" || item.source === "opening") ? "P"
      : (operationOwnerMentioned(owner, item.text) ? "S" : "");
    return use ? { alias: matches[0], transition: "Observed", replacedAlias: "", use } : null;
  }

  function nameSignal(owner, target, evidenceCandidate) {
    const item = evidenceCandidate && evidenceCandidate.item;
    if (!item || evidenceCandidate.nameEligible !== true || !target || target.nameSubject !== true) return null;
    const source = textOf(item.text);
    const direct = directNameInterpretation(owner, target, item);
    if (direct) {
      return {
        kind: "name",
        targetKey: target.key,
        field: direct.alias,
        destination: direct.transition,
        nameAlias: direct.alias,
        nameTransition: direct.transition,
        nameReplacedAlias: direct.replacedAlias,
        nameUse: direct.use,
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit frozen Name transition in " + item.id + "."
      };
    }
    const observed = observedNameInterpretation(owner, target, item);
    if (observed) {
      return {
        kind: "name",
        targetKey: target.key,
        field: observed.alias,
        destination: observed.transition,
        nameAlias: observed.alias,
        nameTransition: observed.transition,
        nameReplacedAlias: "",
        nameUse: observed.use,
        gain: settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN,
        direct: false,
        reason: "Distinct frozen use of an Emerging Name in " + item.id + "."
      };
    }
    return null;
  }

  function stateTriggersForSignal(source, categories, currentTriggers) {
    const value = textOf(source);
    const result = [];
    const add = code => { if (normalizeTriggerCode(code) && !result.includes(code)) result.push(code); };
    if (/\b(?:(?:breaks?|broke|broken) (?:a|the|his|her|their)? ?promise|unreliab\w*|dishonest\w*|distrust\w*|betray\w*|deceiv\w*|lied|lying)\b/i.test(value)) add("trust_loss");
    if (/\b(?:protect\w*|defend\w*|guard\w*|save\w*|assassin\w*|attack\w*|danger\w*|threat\w*|weapon\w*|blade\w*)\b/i.test(value)) add("protect");
    if (/\b(?:decid\w*|choos\w*|vow\w*|swear\w*|commit\w*|intend\w*|resolv\w*)\b/i.test(value)) add("resolve");
    if (/\b(?:anxious|worried|afraid|fearful|terrified|uncertain|hesitat\w*)\b/i.test(value)) add("anxiety");
    if (/\b(?:angry|furious|rage|enraged)\b/i.test(value)) add("anger");
    if (/\b(?:grief|grieving|mourn\w*|bereav\w*|loss)\b/i.test(value)) add("grief");
    if (/\b(?:hurt|wounded|pained)\b/i.test(value)) add("hurt");
    if (/\b(?:relieved|relief)\b/i.test(value)) add("relief");
    if (/\b(?:hopeful|hope\w*)\b/i.test(value)) add("hope");
    if (/\b(?:reconnect\w*|reconcil\w*)\b/i.test(value)) add("reconnect");
    if (/\b(?:withdraw\w*|pulls? away|creates? distance)\b/i.test(value)) add("withdraw");
    if (/\b(?:responsib\w*|in charge|duty|promot\w*)\b/i.test(value)) add("responsibility");
    if (/\b(?:conflict\w*|fight\w*|argument\w*|hostil\w*)\b/i.test(value)) add("conflict");
    if (/\b(?:trusts?|trusted|reliab\w*|dependab\w*)\b/i.test(value) && !result.includes("trust_loss")) add("trust_gain");
    if (/\b(?:boundary|boundaries|consent|permission)\b/i.test(value)) {
      add(/\b(?:crossed|violat\w*|without permission)\b/i.test(value) ? "boundary_crossed" : "boundary_respected");
    }
    const categoryList = Array.isArray(categories) ? categories : [];
    if (!result.length) triggerList(currentTriggers || []).forEach(add);
    return result.slice(0, settings.MAX_STATE_TRIGGERS);
  }

  function stateActingTarget(owner, targets, source) {
    if (!owner) return null;
    const action = "(?:offers?|offered|signs?|signed|gives?|gave|hands?|handed|entrusts?|entrusted"
      + "|transfers?|transferred|grants?|granted|invites?|invited|asks?|asked|tells?|told"
      + "|promises?|promised|proposes?|proposed|reveals?|revealed|admits?|admitted"
      + "|confesses?|confessed|announces?|announced|agrees?|agreed|accepts?|accepted"
      + "|refuses?|refused|helps?|helped|saves?|saved|protects?|protected|threatens?|threatened"
      + "|attacks?|attacked|betrays?|betrayed|hurts?|hurt|surprises?|surprised|shocks?|shocked"
      + "|reassures?|reassured|comforts?|comforted|embraces?|embraced|kisses?|kissed"
      + "|leaves?|left|returns?|returned|chooses?|chose|decides?|decided|vows?|vowed)";
    const ownerAliases = operationOwnerAliases(owner);
    const acting = (Array.isArray(targets) ? targets : []).filter(target => {
      if (!target || target.key === "self" || !operationTargetMentioned(owner, target, source)) return false;
      const targetAliases = operationTargetAliases(owner, target)
        .filter(alias => keyOf(alias) !== "you");
      return targetAliases.some(targetAlias => ownerAliases.some(ownerAlias => {
        const targetPattern = operationAliasRegExp(targetAlias);
        const ownerPattern = operationAliasRegExp(ownerAlias);
        if (!targetPattern || !ownerPattern) return false;
        return new RegExp(
          "(?:^|[^A-Za-z0-9])" + targetPattern
            + "[^.!?…\\n]{0,55}\\b" + action + "\\b"
            + "[^.!?…\\n]{0,120}" + ownerPattern + "(?=$|[^A-Za-z0-9])",
          "i"
        ).test(textOf(source));
      }));
    });
    return acting.length === 1 ? acting[0] : null;
  }

  function stateSignal(owner, targets, evidenceCandidate, currentInputId, recent) {
    const item = evidenceCandidate && evidenceCandidate.item;
    if (!item || evidenceCandidate.stateEligible !== true) return null;
    const source = textOf(item.text);
    const ownerMentioned = operationOwnerMentioned(owner, source);
    const current = item.id === currentInputId || (item.source === "story" && anchorInText(item.anchor, recent));
    const focusedSoloOwner = current
      && CC.focusKey === owner.key
      && Array.isArray(CC.activeKeys)
      && CC.activeKeys.length === 1
      && CC.activeKeys[0] === owner.key;
    if ((!ownerMentioned && !focusedSoloOwner) || !current) return null;

    const dangerPattern = "\\b(?:danger|threat|threatens?|attack(?:s|ed)?|ambush|explosion|fire|flames?|collaps(?:e|es|ed|ing)|falling beam|beam (?:falls|fell)|crash(?:es|ed|ing)?|lung(?:e|es|ed|ing)|weapon|blade|gun|arrow|injured|bleeding|trapped|poisoned|drowning)\\b";
    const emotionPredicate = "\\b(?:(?:looks?|seems?|appears?|feels?|became|turns?)\\s+(?:visibly |suddenly )?(?:afraid|angry|anxious|ashamed|confused|devastated|frightened|furious|grieving|hopeful|hurt|relieved|shocked|stunned|terrified|uncertain|upset|worried)|flinches?|freezes?|gasps?|recoils?|trembles?|hesitates?|stiffens?|breaks down|bursts into tears)\\b";
    const firstPersonEmotion = /\b(?:i am|i'm|i feel|i felt|i became)\s+(?:afraid|angry|anxious|ashamed|confused|devastated|frightened|furious|grieving|hopeful|hurt|relieved|shocked|stunned|terrified|uncertain|upset|worried)\b/i;
    const revelationPattern = "\\b(?:confess(?:es|ed|ing)?|reveal(?:s|ed|ing)?|admit(?:s|ted|ting)?|discover(?:s|ed|ing)?|learn(?:s|ed|ing)?|realiz(?:e|es|ed|ing)|truth|secret|identity revealed|revelation)\\b";
    const decisionPredicate = "\\b(?:decides?|decided|chooses?|chose|vows?|vowed|swears?|swore|commits?|committed|intends?|resolved to|makes? (?:a )?decision)\\b";
    const firstPersonDecision = /\bi\s+(?:decide|choose|vow|swear|commit|intend|resolve|will|must)\b/i;
    const tensionPredicate = "\\b(?:is |was |became |seems? |looks? )?(?:torn|conflicted|under tension|strained|at odds)|\\b(?:struggles? between|hesitates? between)\\b";
    const situationPredicate = "\\b(?:is|was|became|has become|must now|now has to|is now|was now)\\b[^.!?…\\n]{0,40}\\b(?:trapped|alone|responsible|in charge|leaving|staying|fired|promoted|moving|married|separated)\\b";
    const firstPersonSituation = /\bi\s+(?:am now|was now|must now|have become|am|was)\s+(?:trapped|alone|responsible|in charge|leaving|staying|fired|promoted|moving|married|separated)\b/i;

    const categories = [];
    if (ownerNearEvent(owner, source, dangerPattern, 120)) categories.push("immediate danger");
    if (ownerPredicateMatches(owner, source, emotionPredicate)
      || ownerSpeechAttributed(owner, source, firstPersonEmotion)) {
      categories.push("explicit emotional reaction");
    }
    if (ownerNearEvent(owner, source, revelationPattern, 120)) categories.push("revelation");
    if (ownerPredicateMatches(owner, source, decisionPredicate)
      || ownerSpeechAttributed(owner, source, firstPersonDecision)) {
      categories.push("immediate decision or goal");
    }
    if (ownerPredicateMatches(owner, source, tensionPredicate)) categories.push("active tension");
    if (ownerPredicateMatches(owner, source, situationPredicate)
      || ownerSpeechAttributed(owner, source, firstPersonSituation)) {
      categories.push("materially changed Situation");
    }
    const npc = CC.npcs[owner.key];
    const currentState = normalizeState(npc && npc.state, CC.stateClock);
    const currentSituationTargetKey = normalizedTargetKey(
      currentState.situation.targetKey || currentState.target.key
    );
    const currentSituationTarget = currentSituationTargetKey
      ? (Array.isArray(targets) ? targets : []).find(target =>
        normalizedTargetKey(target && target.key) === currentSituationTargetKey
      ) || null
      : null;
    const continuationSource = currentSituationTarget
      ? source + " " + modelTargetName(currentSituationTarget.key, currentSituationTarget.name)
      : source;
    const confirmationState = !categories.length
      && !!currentState.situation.value
      && !!currentSituationTarget
      && experienceSituationMentioned(
        { situation: currentState.situation.value },
        continuationSource
      );

    if (!categories.length && !confirmationState) return null;

    let targetKey = "self";
    if (confirmationState) {
      targetKey = currentSituationTarget.key;
    } else {
      const mentioned = (Array.isArray(targets) ? targets : [])
        .filter(target => target.key !== "self" && operationTargetMentioned(owner, target, source));
      if (mentioned.length === 1) targetKey = mentioned[0].key;
      else {
        const actingTarget = mentioned.length > 1
          ? stateActingTarget(owner, mentioned, source)
          : null;
        if (actingTarget) targetKey = actingTarget.key;
        else if ((item.source === "input" || item.source === "opening")
          && (Array.isArray(targets) ? targets : []).some(target => target.key === "player")) {
          targetKey = "player";
        }
      }
    }
    const frozenTriggers = stateTriggersForSignal(
      source,
      categories,
      confirmationState ? currentState.triggers.value : []
    );
    if (!frozenTriggers.length) return null;
    return {
      kind: "state",
      targetKey,
      field: "",
      destination: "",
      stateMode: confirmationState ? "confirm" : "strong",
      confirmSituation: confirmationState ? currentState.situation.value : "",
      stateTriggers: frozenTriggers,
      gain: confirmationState
        ? settings.OPERATION_POINTS.STATE_CONFIRMATION_GAIN
        : settings.OPERATION_POINTS.STRONG_STATE_GAIN,
      direct: false,
      reason: confirmationState
        ? "Fresh evidence continues the active Situation in " + item.id + "."
        : "Strong current State signal (" + categories.join(", ") + ") in " + item.id + "."
    };
  }

  function explicitRelationshipSignal(owner, target, evidenceCandidate) {
    const item = evidenceCandidate && evidenceCandidate.item;
    if (!item || evidenceCandidate.relationshipEligible !== true || !target || target.relationship !== true || target.key === "self") return null;
    const source = textOf(item.text);
    const ownerMentioned = operationOwnerMentioned(owner, source);
    const targetMentioned = operationTargetMentioned(owner, target, source);
    if (!ownerMentioned || !targetMentioned) return null;

    const targetObjects = target.key === "player"
      ? ["you", player.name].concat(player.aliases || [])
      : operationTargetAliases(owner, target);
    const ownerSubjects = [owner.name].concat(owner.aliases || []);
    const attributedTrust = targetObjects.some(targetAlias => {
      const wanted = operationAliasRegExp(targetAlias);
      return !!wanted && ownerSpeechAttributed(owner, source, new RegExp(
        "\\bi (?:really |fully |completely |deeply )?trust\\s+" + wanted + "\\b",
        "i"
      ));
    });
    const attributedDistrust = targetObjects.some(targetAlias => {
      const wanted = operationAliasRegExp(targetAlias);
      return !!wanted && ownerSpeechAttributed(owner, source, new RegExp(
        "\\bi (?:do not|don't|cannot|can't|never) trust\\s+" + wanted + "\\b",
        "i"
      ));
    });
    const positiveTrust = orderedOperationStatement(source, ownerSubjects, ["trusts?", "trusted"], targetObjects)
      || attributedTrust;
    const negativeTrust = orderedOperationStatement(source, ownerSubjects, ["distrusts?", "distrusted"], targetObjects)
      || attributedDistrust;
    if (positiveTrust || negativeTrust) {
      return {
        kind: "relationship",
        targetKey: target.key,
        field: "Trust",
        destination: negativeTrust ? "Distrust" : "Trust",
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit completed Trust fact in " + item.id + "."
      };
    }

    if (ownerTargetSentenceMatches(owner, target, source, "\\b(?:betrayed|betrayal)\\b")) {
      return {
        kind: "relationship",
        targetKey: target.key,
        field: "Trust",
        destination: "Severe distrust",
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit completed betrayal in " + item.id + "."
      };
    }
    if (ownerTargetSentenceMatches(owner, target, source, "\\b(?:got married|are married|is married|became (?:friends|partners)|are (?:friends|partners)|accepted (?:the )?(?:job|position|employment)|was hired|were hired|is employed|are employed|agreed to (?:work|partner)|formed (?:a )?partnership)\\b")) {
      return {
        kind: "relationship",
        targetKey: target.key,
        field: "Role",
        destination: "Established",
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit completed Role establishment in " + item.id + "."
      };
    }
    if (ownerTargetSentenceMatches(owner, target, source, "\\b(?:broke up|breakup|divorced|separated|ended (?:their|our|the) relationship|partnership ended|employment ended|was fired|were fired)\\b")) {
      return {
        kind: "relationship",
        targetKey: target.key,
        field: "Role",
        destination: "Former",
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit completed Role ending in " + item.id + "."
      };
    }
    if (ownerTargetSentenceMatches(owner, target, source, "\\b(?:explicit boundary|set (?:a|the) boundary|my boundary is|do not touch me|don't touch me|without my permission|not allowed to|must ask permission|consent required)\\b")) {
      return {
        kind: "relationship",
        targetKey: target.key,
        field: "Boundaries",
        destination: "Explicit",
        gain: settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
        direct: true,
        reason: "Explicit completed boundary fact in " + item.id + "."
      };
    }
    return null;
  }

  function explicitViewSignal(owner, target, evidenceCandidate) {
    const item = evidenceCandidate && evidenceCandidate.item;
    if (!item || evidenceCandidate.viewEligible !== true || !target) return null;
    const source = textOf(item.text);
    const ownerMentioned = operationOwnerMentioned(owner, source);
    const targetMentioned = operationTargetMentioned(owner, target, source);
    if (!ownerMentioned || !targetMentioned) return null;

    const targetObjects = target.key === "player"
      ? ["you", player.name].concat(player.aliases || [])
      : operationTargetAliases(owner, target);
    const ownerSubjects = [owner.name].concat(owner.aliases || []);
    const checks = [
      { destination: "Hates", verbs: ["hates?", "hated", "despises?", "despised", "loathes?", "loathed"], firstVerbs: "(?:hate|despise|loathe)", emphasis: "(?:truly |absolutely )?", label: "hatred" },
      { destination: "Loves", verbs: ["loves?", "loved", "adores?", "adored"], firstVerbs: "(?:love|adore)", emphasis: "(?:truly |deeply )?", label: "love" },
      { destination: "Likes", verbs: ["admires?", "admired", "respects?", "respected", "likes?", "liked"], firstVerbs: "(?:admire|respect|like)", emphasis: "(?:deeply |really )?", label: "admiration" },
      { destination: "Dislikes", verbs: ["dislikes?", "disliked", "resents?", "resented"], firstVerbs: "(?:dislike|resent)", emphasis: "(?:really )?", label: "dislike" }
    ];
    for (const check of checks) {
      const attributedFirstPerson = targetObjects.some(targetAlias => {
        const wanted = operationAliasRegExp(targetAlias);
        return !!wanted && ownerSpeechAttributed(owner, source, new RegExp(
          "\\bi " + check.emphasis + check.firstVerbs + "\\s+" + wanted + "\\b",
          "i"
        ));
      });
      const matched = orderedOperationStatement(source, ownerSubjects, check.verbs, targetObjects)
        || attributedFirstPerson;
      if (!matched) continue;
      return {
        kind: "view",
        targetKey: target.key,
        field: "Category",
        destination: check.destination,
        allowedModes: ["O"],
        gain: settings.OPERATION_POINTS.EXPLICIT_VIEW_GAIN,
        direct: true,
        reason: "Explicit durable " + check.label + " judgement in " + item.id + "."
      };
    }
    return null;
  }

  const TURNING_POINT_STOP_WORDS = new Set([
    "about", "after", "again", "against", "being", "could", "during", "every", "from", "having",
    "into", "itself", "other", "their", "there", "these", "they", "this", "through", "toward", "with",
    "would", "stage", "turning", "point"
  ]);
  const TURNING_POINT_GENERIC_OVERLAP_TERMS = new Set([
    "begin", "start", "practice", "work", "allow", "risk", "speak", "use", "face", "admit",
    "recognize", "reconsider", "finally", "success", "master", "learn", "control", "manage",
    "prove", "complete", "finish", "breakthrough", "support", "progress", "movement"
  ].map(experienceStem));
  const TURNING_POINT_COMPLETION_CUE = /\b(?:finally|successfully|master(?:s|ed)|learn(?:s|ed)?\s+how|gain(?:s|ed)?\s+control|(?:take(?:s|n)?|took)\s+control|manag(?:e|es|ed)\s+to|prov(?:e|es|ed)\s+able|breakthrough|(?:openly|directly|explicitly|clearly|deliberately)\s+(?:chooses?|commits?|declares?|offers?|accepts?|states?|tells?)|(?:makes?|made)\s+(?:a|the)\s+(?:(?:definitive|lasting|concrete|vulnerable)\s+)?(?:choice|commitment|offer))\b/i;
  const TURNING_POINT_MOVEMENT_CUE = /\b(?:begin(?:s|ning)?|start(?:s|ed)?|practi[cs](?:e|es|ed|ing)?|works? on|allows?|risks?|speaks?|uses?|faces?|admits?|recognizes?|reconsiders?)\b/i;
  const TURNING_POINT_INCOMPLETE_CUE = /\b(?:tries?|tried|attempts?|attempted|plans?|planned|hopes?|hoped|wants?|wanted|intends?|intended|almost|nearly|fails?|failed|cannot|can't|could not|by accident|accidentally|unintentionally|involuntarily|loses? control|lost control)\b/i;
  const TURNING_POINT_SUPPORT_SUCCESS_CUE = /\b(?:successfully|manages? to|proves? able|completes?|completed|finishes?|finished)\b/i;
  const TURNING_POINT_INTEGRATION_CUE = /\b(?:regularly|routinely|usually|consistently|habit|habitual|normally|no longer|over time|each day|every day|with ease|without hesitation|part of (?:his|her|their) life|sustained|settles? into|lives? with)\b/i;

  function turningPointSemanticTerms(value) {
    return unique(keyOf(value).split(" ")
      .map(experienceStem)
      .filter(term => term.length >= 4 && !TURNING_POINT_STOP_WORDS.has(term)), 80);
  }

  function turningPointIgnoredOverlapTerms(owner) {
    const identityForms = [owner && owner.name]
      .concat(owner && owner.aliases || [])
      .concat([player && player.name])
      .concat(player && player.aliases || [])
      .concat(characters.flatMap(character => [character && character.name].concat(character && character.aliases || [])))
      .filter(Boolean);
    return new Set(identityForms.flatMap(turningPointSemanticTerms)
      .concat(Array.from(TURNING_POINT_GENERIC_OVERLAP_TERMS)));
  }

  function turningPointTextOverlap(source, reference, owner) {
    if (!reference) return 0;
    const sourceTerms = new Set(turningPointSemanticTerms(source));
    const ignored = turningPointIgnoredOverlapTerms(owner);
    return turningPointSemanticTerms(reference)
      .filter(term => !ignored.has(term) && sourceTerms.has(term)).length;
  }

  function turningPointRequiredSemanticOverlap(owner, reference, maximum = 2) {
    const ignored = turningPointIgnoredOverlapTerms(owner);
    const terms = unique(turningPointSemanticTerms(reference)
      .filter(term => !ignored.has(term)), 80);
    return terms.length ? Math.min(Math.max(1, Number(maximum) || 1), terms.length) : 0;
  }

  function turningPointTermOverlap(source, card, owner) {
    return card ? turningPointTextOverlap(source, entryOf(card), owner) : 0;
  }

  function turningPointBreakthroughSupport(source, owner, condition, strict) {
    const reference = line(condition && condition.text, settings.MAX_TURNING_POINT_STAGE_CARD_CHARS);
    if (!reference || condition && condition.invalid) {
      return { ok: false, overlap: 0, clauses: [], required: 0 };
    }
    const ignored = new Set(turningPointSemanticTerms(owner && owner.name || ""));
    const referenceTerms = turningPointSemanticTerms(reference).filter(term => !ignored.has(term));
    const overlap = turningPointTextOverlap(source, reference, owner);
    const required = condition && condition.explicit && strict
      ? Math.min(4, Math.max(1, referenceTerms.length))
      : Math.min(2, Math.max(1, referenceTerms.length));
    const clauses = reference.split(/\s*;\s*/).map(value => value.trim()).filter(Boolean);
    const clauseOverlaps = clauses.map(value => turningPointTextOverlap(source, value, owner));
    const clauseSupported = !(condition && condition.explicit && strict && clauses.length > 1)
      || clauseOverlaps.every(value => value >= 1);
    return {
      ok: overlap >= required && clauseSupported,
      overlap,
      clauses: clauseOverlaps,
      required
    };
  }

  function turningPointDirectionAllowed(record) {
    if (!record || runtime.turningPointMode === "disabled") return false;
    return runtime.turningPointMode === "all-directions" || record.direction === "Growth";
  }

  function turningPointNextStage(record) {
    const score = record && record.progress ? record.progress.score : 0;
    if (score < 10) return TURNING_POINT_STAGES[1];
    if (score < 20) return TURNING_POINT_STAGES[2];
    if (score < 30) return TURNING_POINT_STAGES[3];
    return TURNING_POINT_STAGES[4];
  }

  function turningPointSignals(owner, evidenceCandidate, currentInputId, recent) {
    const item = evidenceCandidate && evidenceCandidate.item;
    if (!item || evidenceCandidate.turningEligible !== true || !/^E\d+$/.test(item.id)) return [];
    refreshTurningPointsStore();
    const ownerData = turningPointsForOwner(owner.key);
    if (!ownerData || !ownerData.contextRecords.length) return [];
    const source = textOf(item.text);
    const current = item.id === currentInputId
      || (item.source === "story" && anchorInText(item.anchor, recent))
      || (item.source === "opening" && anchorInText(item.anchor, recent));
    const focusedSoloOwner = current
      && CC.focusKey === owner.key
      && Array.isArray(CC.activeKeys)
      && CC.activeKeys.length === 1
      && CC.activeKeys[0] === owner.key;
    if (!current || (!operationOwnerMentioned(owner, source) && !focusedSoloOwner)) return [];
    const achievedStage = TURNING_POINT_STAGES[3];
    const integratingStage = TURNING_POINT_STAGES[4];
    return ownerData.contextRecords.map(record => {
      if (!turningPointDirectionAllowed(record)
        || !turningPointEvidenceEligible(item, owner, recent, record.id, null)) return null;
      const currentStage = record.progress.stageRecord;
      const nextStage = turningPointNextStage(record);
      if (!turningPointStageCardValid(record, owner, currentStage)
        || !turningPointStageCardValid(record, owner, nextStage)) return null;
      const nextCard = turningPointStageCard(record, nextStage);
      const nextOverlap = turningPointTermOverlap(source, nextCard, owner);
      const nextRequiredOverlap = turningPointRequiredSemanticOverlap(owner, entryOf(nextCard), 2);
      const achievedOverlap = turningPointTermOverlap(source, turningPointStageCard(record, achievedStage), owner);
      const integratingOverlap = turningPointTermOverlap(source, turningPointStageCard(record, integratingStage), owner);
      const breakthroughCondition = turningPointBreakthroughCondition(record);
      const breakthroughSource = [record.progress.description, source].filter(Boolean).join("\n");
      const breakthroughSupport = turningPointBreakthroughSupport(
        breakthroughSource,
        owner,
        breakthroughCondition,
        false
      );
      const strictBreakthroughSupport = breakthroughCondition.explicit
        ? turningPointBreakthroughSupport(breakthroughSource, owner, breakthroughCondition, true)
        : null;
      const breakthroughCompleted = TURNING_POINT_COMPLETION_CUE.test(source)
        || !!(strictBreakthroughSupport && strictBreakthroughSupport.ok);
      let mode = "";
      let gain = 0;
      let direct = false;
      let reason = "";
      if (record.progress.score < 30 && turningPointStageCardValid(record, owner, achievedStage)
        && breakthroughCompleted && achievedOverlap >= 2
        && breakthroughSupport.ok) {
        mode = "Breakthrough";
        gain = settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN;
        direct = true;
        reason = item.id + " potentially completes the Achieved stage and its "
          + (breakthroughCondition.explicit ? "creator-written breakthrough condition." : "legacy Achieved fallback condition.");
      } else if (record.progress.score >= 30
        && record.progress.score < integratingStage.maximum
        && TURNING_POINT_INTEGRATION_CUE.test(source) && integratingOverlap >= 2) {
        mode = "Integration";
        gain = settings.OPERATION_POINTS.STRONG_STATE_GAIN;
        direct = true;
        reason = item.id + " overlaps the creator-written Integrating stage and contains sustained-change evidence.";
      } else if (record.progress.score < TURNING_POINT_STAGES[2].maximum
        && nextRequiredOverlap > 0 && nextOverlap >= nextRequiredOverlap
        && TURNING_POINT_MOVEMENT_CUE.test(source)
        && (!TURNING_POINT_INCOMPLETE_CUE.test(source) || TURNING_POINT_SUPPORT_SUCCESS_CUE.test(source))) {
        mode = "Support";
        gain = nextOverlap >= 2
          ? settings.OPERATION_POINTS.EXPERIENCE_PATTERN_GAIN
          : settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN;
        reason = item.id + " contains movement toward the next creator-written stage.";
      }
      if (!mode || gain <= 0) return null;
      return {
        kind: "turning",
        targetKey: "self",
        field: record.id,
        destination: mode,
        gain,
        direct,
        managedSignature: turningPointManagedSignature(owner.key, record),
        reason
      };
    }).filter(Boolean);
  }

  function operationEvidenceSignature(candidate, evidenceItems) {
    const items = (Array.isArray(evidenceItems) ? evidenceItems : []).filter(item => item && item.id);
    if (!items.length) return "";
    const ordered = items.slice().sort((left, right) => left.number - right.number || left.id.localeCompare(right.id));
    const lineage = ordered.map(item => item.id + ":" + hashString(keyOf(item.text))).join(",");
    return line(lineage + "@" + hashString([
      candidate.kind,
      candidate.ownerKey,
      candidate.targetKey,
      candidate.field,
      candidate.destination,
      (candidate.stateTriggers || []).join(","),
      candidate.nameAlias || "",
      candidate.nameTransition || "",
      candidate.nameReplacedAlias || "",
      candidate.nameUse || "",
      (candidate.allowedModes || []).join(","),
      lineage
    ].join("|")), 500);
  }

  function operationDrainForCandidate(candidate, ownerOpportunity) {
    if (!candidate || candidate.gain <= 0 || !candidate.evidenceSignature) return 0;
    const ownerKey = line(candidate.ownerKey, 160);
    const kind = keyOf(candidate.kind);
    const targetKey = normalizedTargetKey(candidate.targetKey);
    const field = keyOf(candidate.field);
    const destination = keyOf(candidate.destination);
    const matching = (Array.isArray(CC.operationState.drains) ? CC.operationState.drains : [])
      .map(normalizeOperationDrainRecord)
      .filter(record => record
        && record.ownerKey === ownerKey
        && record.kind === kind
        && record.evidenceSignature === candidate.evidenceSignature
        && (!targetKey || record.targetKey === targetKey)
        && (!field || keyOf(record.field) === field)
        && (!destination || keyOf(record.destination) === destination));
    if (!matching.length) return 0;
    const latest = matching.slice().sort((left, right) => right.updatedOpportunity - left.updatedOpportunity)[0];
    if (keyOf(latest.lastResult) === "omitted") {
      if (latest.attempts >= 2) {
        return Math.min(settings.OPERATION_DRAIN_CAP, Math.max(0, Number(candidate.gain) || 0));
      }
      return Math.max(
        Math.max(...matching.map(record => effectiveOperationDrainValue(record, ownerOpportunity))),
        Math.max(0, (Number(candidate.gain) || 0) - 1)
      );
    }
    if (keyOf(latest.lastResult) === "cutoff") {
      if (latest.attempts >= 2) {
        return Math.min(settings.OPERATION_DRAIN_CAP, Math.max(0, Number(candidate.gain) || 0));
      }
      return Math.max(
        Math.max(...matching.map(record => effectiveOperationDrainValue(record, ownerOpportunity))),
        Math.max(0, (Number(candidate.gain) || 0) - 1)
      );
    }
    if (keyOf(latest.lastResult) === "declined") {
      return Math.min(settings.OPERATION_DRAIN_CAP, Math.max(0, Number(candidate.gain) || 0));
    }
    return Math.max(...matching.map(record => effectiveOperationDrainValue(record, ownerOpportunity)));
  }

  function blankScoringCandidate(kind, owner) {
    const ownerState = CC.operationState.owners[owner.key] || blankOwnerOperationState();
    const meter = ownerState[kind] || blankOperationMeter();
    return {
      kind,
      ownerKey: owner.key,
      targetKey: "",
      field: "",
      destination: "",
      sourceIds: [],
      storyEvidenceIds: [],
      sourceMetadata: {},
      evidenceSignature: "",
      gain: 0,
      drain: 0,
      net: 0,
      currentRelevance: 0,
      lastServedOpportunity: meter.lastServedOpportunity,
      oldestEvidenceOrder: 0,
      direct: false,
      derived: false,
      allowedFields: [],
      managedSignature: "",
      reasons: ["No positive grounded " + operationKindLabel(kind) + " signal."]
    };
  }

  function operationCandidateGroups(owner, signals, currentInputId, recent, scoringOpportunity) {
    const groups = {};
    (Array.isArray(signals) ? signals : []).forEach(entry => {
      const signal = entry && entry.signal;
      const sourceCandidate = entry && (entry.sourceCandidate || (entry.item ? { item: entry.item } : null));
      const item = sourceCandidate && sourceCandidate.item;
      if (!signal || !item || signal.gain <= 0) return;
      const key = [
        signal.kind,
        signal.targetKey || "",
        signal.field || "",
        signal.destination || "",
        line(signal.stateMode, 40),
        signal.kind === "state" ? "" : triggerList(signal.stateTriggers || []).join(","),
        line(signal.nameAlias, 160),
        line(signal.nameTransition, 40),
        line(signal.nameReplacedAlias, 160),
        line(signal.nameUse, 1000),
        unique(signal.allowedModes || [], 20).join(",")
      ].join("|");
      if (!groups[key]) groups[key] = [];
      groups[key].push({ signal, sourceCandidate, item, relevance: operationCurrentRelevance(item, currentInputId, recent) });
    });
    return Object.values(groups).map(entries => {
      const best = entries.slice().sort((left, right) => right.signal.gain - left.signal.gain
        || Number(right.signal.direct) - Number(left.signal.direct)
        || right.relevance - left.relevance
        || left.item.number - right.item.number)[0];
      const kind = best.signal.kind;
      let contributing = entries.slice();
      let gain = best.signal.gain;
      if (kind === "name" && !best.signal.direct) {
        contributing = entries.slice().sort((left, right) => right.relevance - left.relevance || left.item.number - right.item.number)
          .slice(0, Math.ceil(settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN / settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN));
        gain = Math.min(settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
          contributing.length * settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN);
      } else if (kind === "state") {
        contributing = entries.slice().sort((left, right) => right.signal.gain - left.signal.gain
          || right.relevance - left.relevance || left.item.number - right.item.number).slice(0, 2);
        gain = Math.min(
          settings.OPERATION_POINTS.STRONG_STATE_GAIN + settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN,
          Math.max(0, Number(best.signal.gain) || 0)
            + (contributing.length > 1 ? settings.OPERATION_POINTS.SUPPORTING_EVIDENCE_GAIN : 0)
        );
      } else if (kind === "relationship") {
        contributing = entries.slice().sort((left, right) => right.signal.gain - left.signal.gain
          || Number(right.signal.direct) - Number(left.signal.direct)
          || right.relevance - left.relevance
          || left.item.number - right.item.number).slice(0, 2);
        gain = Math.min(settings.OPERATION_POINTS.EXPLICIT_DIRECT_GAIN,
          contributing.reduce((total, entry) => total + Math.max(0, Number(entry.signal.gain) || 0), 0));
      } else if (kind === "view" && !best.signal.destination) {
        contributing = entries.slice().sort((left, right) => right.signal.gain - left.signal.gain
          || right.relevance - left.relevance || left.item.number - right.item.number).slice(0, 2);
        gain = Math.min(
          settings.OPERATION_POINTS.RELATIONSHIP_TO_VIEW_GAIN + settings.OPERATION_POINTS.EXPERIENCE_PATTERN_GAIN,
          contributing.reduce((total, entry) => total + Math.max(0, Number(entry.signal.gain) || 0), 0)
        );
      } else {
        contributing = entries.slice().sort((left, right) => right.relevance - left.relevance || left.item.number - right.item.number).slice(0, 2);
      }
      const evidenceItems = contributing.map(entry => entry.item);
      const sourceCandidates = contributing.map(entry => entry.sourceCandidate);
      const sourceMetadata = {};
      sourceCandidates.forEach(source => {
        if (!source || !source.item) return;
        sourceMetadata[source.item.id] = {
          prefix: source.item.id.charAt(0),
          ownerKey: source.ownerKey || owner.key,
          targetKey: source.targetKey || best.signal.targetKey || "",
          targetName: source.targetName || "",
          allowedFields: clone(source.allowedFields || []),
          allowedDestinations: clone(source.allowedDestinations || []),
          allowedModes: clone(source.allowedModes || []),
          interpretations: clone(source.interpretations || []),
          managedSignature: source.managedSignature || "",
          rawLineage: clone(source.rawLineage || (/^E\d+$/.test(source.item.id) ? [source.item.id] : [])),
          gain: Math.max(0, Number(source.gain) || Number(
            contributing.find(entry => entry.sourceCandidate === source)?.signal.gain
          ) || 0),
          useSignatures: clone(source.useSignatures || {}),
          directAllowed: source.directAllowed !== false && /^E\d+$/.test(source.item.id),
          age: Math.max(0, Number(source.age) || 0),
          reason: source.eligibilityReason || ""
        };
      });
      const ownerState = CC.operationState.owners[owner.key] || blankOwnerOperationState();
      const meter = ownerState[kind] || blankOperationMeter();
      const candidate = {
        kind,
        ownerKey: owner.key,
        targetKey: best.signal.targetKey || "",
        field: best.signal.field || "",
        destination: best.signal.destination || "",
        stateMode: kind === "state" ? line(best.signal.stateMode, 40) : "",
        confirmSituation: kind === "state"
          ? line(best.signal.confirmSituation, settings.MAX_STATE_VALUE_CHARS)
          : "",
        stateTriggers: kind === "state"
          ? unique(contributing.flatMap(entry => triggerList(entry.signal && entry.signal.stateTriggers || [])), 40)
            .slice(0, settings.MAX_STATE_TRIGGERS)
          : [],
        nameAlias: kind === "name" ? line(best.signal.nameAlias, 160) : "",
        nameTransition: kind === "name" ? line(best.signal.nameTransition, 40) : "",
        nameReplacedAlias: kind === "name" ? line(best.signal.nameReplacedAlias, 160) : "",
        nameUse: kind === "name" ? line(best.signal.nameUse, 1000) : "",
        sourceIds: evidenceItems.map(item => item.id),
        storyEvidenceIds: unique(sourceCandidates.flatMap(source =>
          source && Array.isArray(source.rawLineage)
            ? source.rawLineage
            : (source && source.item && /^E\d+$/.test(source.item.id) ? [source.item.id] : [])
        ), 40),
        sourceMetadata,
        evidenceSignature: "",
        gain,
        drain: 0,
        net: gain,
        currentRelevance: Math.max(0, ...contributing.map(entry => entry.relevance)),
        lastServedOpportunity: meter.lastServedOpportunity,
        oldestEvidenceOrder: Math.min(...evidenceItems.map(item => item.number)),
        direct: contributing.some(entry => entry.signal.direct),
        derived: sourceCandidates.some(source => source && source.derived === true),
        allowedFields: unique(sourceCandidates.flatMap(source => source && source.allowedFields || []), 80),
        allowedDestinations: unique(sourceCandidates.flatMap(source => source && source.allowedDestinations || []), 80),
        allowedModes: unique(
          contributing.flatMap(entry => entry.signal && entry.signal.allowedModes || [])
            .concat(sourceCandidates.flatMap(source => source && source.allowedModes || [])),
          40
        ),
        managedSignature: line(best.signal.managedSignature, 500),
        reasons: unique(contributing.map(entry => entry.signal.reason), 500)
      };
      candidate.evidenceSignature = operationEvidenceSignature(candidate, evidenceItems);
      candidate.drain = operationDrainForCandidate(candidate, scoringOpportunity);
      candidate.ownerOpportunity = Math.max(0, Number(scoringOpportunity) || 0);
      candidate.net = candidate.gain - candidate.drain;
      return candidate;
    });
  }

  function operationCandidateFallbackRank(kind) {
    const index = MODEL_OPERATION_KINDS.indexOf(keyOf(kind));
    return index >= 0 ? index : MODEL_OPERATION_KINDS.length;
  }

  function compareOperationCandidates(left, right) {
    if (right.net !== left.net) return right.net - left.net;
    if (right.currentRelevance !== left.currentRelevance) return right.currentRelevance - left.currentRelevance;
    if (left.lastServedOpportunity !== right.lastServedOpportunity) {
      return left.lastServedOpportunity - right.lastServedOpportunity;
    }
    const leftOldest = left.oldestEvidenceOrder > 0 ? left.oldestEvidenceOrder : Number.MAX_SAFE_INTEGER;
    const rightOldest = right.oldestEvidenceOrder > 0 ? right.oldestEvidenceOrder : Number.MAX_SAFE_INTEGER;
    if (leftOldest !== rightOldest) return leftOldest - rightOldest;
    const kindDifference = operationCandidateFallbackRank(left.kind) - operationCandidateFallbackRank(right.kind);
    if (kindDifference) return kindDifference;
    return [left.targetKey, left.field, left.destination, left.evidenceSignature].join("|")
      .localeCompare([right.targetKey, right.field, right.destination, right.evidenceSignature].join("|"));
  }

  function operationSelectionCriterion(selected, runnerUp) {
    if (!selected) return "No candidate had positive grounded net.";
    if (!runnerUp) return "Only one candidate with positive grounded net was available.";
    if (selected.net !== runnerUp.net) return "Highest positive net determined the operation.";
    if (selected.currentRelevance !== runnerUp.currentRelevance) return "Strongest current relevance broke the tie.";
    if (selected.lastServedOpportunity !== runnerUp.lastServedOpportunity) return "Longest time since last served broke the tie.";
    const selectedOldest = selected.oldestEvidenceOrder > 0 ? selected.oldestEvidenceOrder : Number.MAX_SAFE_INTEGER;
    const runnerOldest = runnerUp.oldestEvidenceOrder > 0 ? runnerUp.oldestEvidenceOrder : Number.MAX_SAFE_INTEGER;
    if (selectedOldest !== runnerOldest) return "Oldest still-valid supporting evidence broke the tie.";
    if (selected.kind !== runnerUp.kind) return "Stable fallback Name → State → Relationship → View → Turning Point broke the final tie.";
    return "Stable lexical fallback broke the final same-kind tie.";
  }

  function operationCandidatesForOwner(owner, targets, evidenceCandidates, currentInputId, recent, scoringOpportunity) {
    const signals = [];
    const legalTargets = Array.isArray(targets) ? targets : [];
    (Array.isArray(evidenceCandidates) ? evidenceCandidates : []).forEach(evidenceCandidate => {
      const item = evidenceCandidate && evidenceCandidate.item;
      if (!item) return;
      if (/^E\d+$/.test(item.id)) {
        legalTargets.filter(target => target.nameSubject === true).forEach(target => {
          const signal = nameSignal(owner, target, evidenceCandidate);
          if (signal) signals.push({ signal, sourceCandidate: evidenceCandidate });
        });
        const state = stateSignal(owner, legalTargets, evidenceCandidate, currentInputId, recent);
        if (state) signals.push({ signal: state, sourceCandidate: evidenceCandidate });
        legalTargets.filter(target => target.relationship === true).forEach(target => {
          const signal = explicitRelationshipSignal(owner, target, evidenceCandidate);
          if (signal) signals.push({ signal, sourceCandidate: evidenceCandidate });
        });
        legalTargets.forEach(target => {
          const signal = explicitViewSignal(owner, target, evidenceCandidate);
          if (signal) signals.push({ signal, sourceCandidate: evidenceCandidate });
        });
        turningPointSignals(owner, evidenceCandidate, currentInputId, recent).forEach(signal => {
          signals.push({ signal, sourceCandidate: evidenceCandidate });
        });
        return;
      }
      if (["S", "X"].includes(item.id.charAt(0)) && evidenceCandidate.relationshipEligible === true) {
        const target = legalTargets.find(candidate =>
          candidate.relationship === true && candidate.key === evidenceCandidate.targetKey
        );
        if (!target) return;
        (evidenceCandidate.allowedFields || []).forEach(field => {
          const record = provenanceRecordById(item.id);
          const destination = relationshipDerivedDestinationForRecord(record, field);
          if (!destination) return;
          signals.push({
            signal: {
              kind: "relationship",
              targetKey: target.key,
              field,
              destination,
              gain: evidenceCandidate.gain,
              direct: false,
              reason: item.id + " supplied grounded accumulated " + field + " meaning."
            },
            sourceCandidate: evidenceCandidate
          });
        });
        return;
      }
      if (["R", "X"].includes(item.id.charAt(0)) && evidenceCandidate.viewEligible === true) {
        const target = legalTargets.find(candidate => candidate.key === evidenceCandidate.targetKey);
        if (!target) return;
        const interpretations = (evidenceCandidate.interpretations || []).slice()
          .sort((left, right) => {
            const leftMode = canonicalViewOperationMode(left && left.operationMode) === "O" ? 0 : 1;
            const rightMode = canonicalViewOperationMode(right && right.operationMode) === "O" ? 0 : 1;
            return leftMode - rightMode
              || VIEW_CATEGORIES.indexOf(canonicalViewDestination(left && left.destination))
                - VIEW_CATEGORIES.indexOf(canonicalViewDestination(right && right.destination));
          });
        const interpretation = interpretations[0];
        if (!interpretation) return;
        signals.push({
          signal: {
            kind: "view",
            targetKey: target.key,
            field: "Category",
            destination: canonicalViewDestination(interpretation.destination),
            allowedModes: [canonicalViewOperationMode(interpretation.operationMode)],
            gain: evidenceCandidate.gain,
            direct: false,
            reason: item.id + " supplies one frozen owner-target View interpretation."
          },
          sourceCandidate: evidenceCandidate
        });
      }
    });

    const candidates = operationCandidateGroups(owner, signals, currentInputId, recent, scoringOpportunity);
    MODEL_OPERATION_KINDS.forEach(kind => {
      if (!candidates.some(candidate => candidate.kind === kind)) candidates.push(blankScoringCandidate(kind, owner));
    });
    return candidates.sort((left, right) => operationCandidateFallbackRank(left.kind) - operationCandidateFallbackRank(right.kind)
      || left.targetKey.localeCompare(right.targetKey)
      || left.field.localeCompare(right.field)
      || left.destination.localeCompare(right.destination));
  }

  function selectOperationCandidate(candidates) {
    const positive = (Array.isArray(candidates) ? candidates : []).filter(candidate => candidate.net > 0)
      .slice().sort(compareOperationCandidates);
    const selected = positive[0] || null;
    const runnerUp = positive[1] || null;
    const tieBreak = operationSelectionCriterion(selected, runnerUp);
    const reasons = selected
      ? [
        "Selected " + operationKindLabel(selected.kind) + " with gain " + selected.gain
          + ", drain " + selected.drain + ", and net " + selected.net + ".",
        tieBreak
      ].concat(selected.reasons || [])
      : [tieBreak];
    return { selected, tieBreak, reasons };
  }

  function experienceReadinessGain(owner) {
    const state = normalizeState(CC.npcs[owner.key] && CC.npcs[owner.key].state, CC.stateClock);
    if (!state.situation.value || state.situation.promotedSignature) return 0;
    return Math.max(0, state.situation.confirmations) * settings.OPERATION_POINTS.EXPERIENCE_PATTERN_GAIN;
  }

  function syncOperationMeters(owner, candidates) {
    if (!owner) return;
    if (!CC.operationState.owners[owner.key]) CC.operationState.owners[owner.key] = blankOwnerOperationState();
    const ownerState = CC.operationState.owners[owner.key];
    MODEL_OPERATION_KINDS.forEach(kind => {
      const matching = (Array.isArray(candidates) ? candidates : []).filter(candidate => candidate.kind === kind)
        .slice().sort(compareOperationCandidates);
      const best = matching[0] || blankScoringCandidate(kind, owner);
      ownerState[kind].gain = Math.max(0, best.gain);
      ownerState[kind].drain = Math.max(0, Math.min(settings.OPERATION_DRAIN_CAP, best.drain));
    });
    ownerState.experience.gain = experienceReadinessGain(owner);
    ownerState.experience.drain = 0;
  }

  function pendingRetryPacketCandidates(plan, kind) {
    const source = plan && typeof plan === "object" && !Array.isArray(plan) ? plan : {};
    const packet = Array.isArray(source.retrySourcePacket) ? source.retrySourcePacket : [];
    const eligibility = source.retryEvidenceEligibility
      && typeof source.retryEvidenceEligibility === "object"
      && !Array.isArray(source.retryEvidenceEligibility)
      ? source.retryEvidenceEligibility
      : {};
    const wanted = operationPacketSourceIds(kind, source.selectedCandidate, source.retryEvidenceIds);
    return wanted.map(id => {
      const frozen = packet.find(item => continuitySourceId(item && item.id) === id) || null;
      if (!frozen || !textOf(frozen.text).trim()) return null;
      const flags = eligibility[id] && typeof eligibility[id] === "object" ? eligibility[id] : {};
      return {
        item: {
          id,
          number: Math.max(0, Math.floor(Number(id.replace(/\D+/g, "")) || 0)),
          text: textOf(frozen.text),
          source: line(frozen.source, 40) || (id.charAt(0) === "E" ? "story" : "provenance")
        },
        nameEligible: frozen.name === true || flags.name === true,
        stateEligible: frozen.state === true || flags.state === true,
        relationshipEligible: frozen.relationship === true || flags.relationship === true,
        viewEligible: frozen.view === true || flags.view === true,
        turningEligible: frozen.turning === true || flags.turning === true,
        age: Math.max(0, Number(frozen.age) || Number(flags.age) || 0),
        ownerKey: normalizedTargetKey(frozen.ownerKey),
        targetKey: normalizedTargetKey(frozen.targetKey),
        targetName: line(frozen.targetName, 160),
        allowedFields: clone(Array.isArray(frozen.allowedFields) ? frozen.allowedFields : []),
        allowedDestinations: clone(Array.isArray(frozen.allowedDestinations) ? frozen.allowedDestinations : []),
        allowedModes: clone(Array.isArray(frozen.allowedModes) ? frozen.allowedModes : []),
        interpretations: clone(Array.isArray(frozen.interpretations) ? frozen.interpretations : []),
        managedSignature: line(frozen.managedSignature, 500),
        rawLineage: clone(Array.isArray(frozen.rawLineage) ? frozen.rawLineage : []),
        gain: Math.max(0, Number(frozen.gain) || 0),
        useSignatures: clone(frozen.useSignatures && typeof frozen.useSignatures === "object"
          ? frozen.useSignatures
          : {}),
        directAllowed: frozen.directAllowed !== false,
        eligibilityReason: line(frozen.reason, 500)
      };
    }).filter(Boolean);
  }

  function modelAnswerTaskForCandidate(owner, targets, evidenceCandidates, currentInputId, recent,
    frozenPace, candidate, frozenIds) {
    if (!owner || !candidate || typeof candidate !== "object" || Array.isArray(candidate)) return "";
    const kind = keyOf(candidate.kind);
    const targetKey = normalizedTargetKey(candidate.targetKey);
    if (!MODEL_OPERATION_KINDS.includes(kind) || !targetKey) return "";
    const legalTargets = operationTargetsForKind(kind, targets)
      .filter(target => normalizedTargetKey(target.key) === targetKey);
    if (!legalTargets.length) return "";
    const requestedIds = operationPacketSourceIds(kind, candidate, frozenIds);
    if (!requestedIds.length) return "";
    const requiredEvidence = operationEvidenceCandidatesForKind(
      kind, evidenceCandidates, candidate, requestedIds
    );
    if (requiredEvidence.length !== requestedIds.length) return "";
    return operationTaskForKind(
      kind,
      owner,
      legalTargets,
      requiredEvidence,
      currentInputId,
      recent,
      frozenPace || runtime.relationshipPace,
      candidate
    );
  }

  function freezeOperationSelection(plan, owner, targets, evidenceCandidates, currentInputId, recent) {
    if (!plan || !owner) return;
    if (plan.operationSelectionFrozen === true) {
      if (!Array.isArray(plan.routingTargets) || !plan.routingTargets.length) {
        plan.routingTargets = clone(Array.isArray(targets) ? targets : []);
      }
      return;
    }
    const scoringOpportunity = Math.max(0, Number(CC.ownerOpportunities[owner.key]) || 0) + 1;
    const diagnosticCandidates = MODEL_OPERATION_KINDS.map(kind => ({
      ...blankScoringCandidate(kind, owner),
      diagnosticOnly: true,
      ownerOpportunity: scoringOpportunity,
      reasons: ["Semantic detection is delegated to the model-authored assessment."]
    }));
    const reviewable = (Array.isArray(evidenceCandidates) ? evidenceCandidates : [])
      .filter(candidate => candidate && candidate.item && /^E\d+$/.test(candidate.item.id))
      .filter(candidate => !(candidate.item.assessedNoChangeBy
        && candidate.item.assessedNoChangeBy[owner.key]))
      .slice(0, Math.max(1, Number(settings.MAX_ASSESSMENT_EVIDENCE_ITEMS) || 1));
    const sourceIds = reviewable.map(candidate => candidate.item.id);
    const selected = sourceIds.length ? {
      kind: ASSESSMENT_OPERATION_KIND,
      ownerKey: owner.key,
      targetKey: "self",
      field: "",
      destination: "",
      sourceIds,
      storyEvidenceIds: sourceIds.slice(),
      sourceMetadata: {},
      evidenceSignature: "",
      gain: 0,
      drain: 0,
      net: 0,
      currentRelevance: reviewable.length
        ? Math.max(...reviewable.map(candidate => operationCurrentRelevance(
          candidate.item, currentInputId, recent
        )))
        : 0,
      lastServedOpportunity: -1,
      oldestEvidenceOrder: reviewable.length
        ? Math.min(...reviewable.map(candidate => candidate.item.number))
        : 0,
      direct: true,
      derived: false,
      allowedFields: [],
      allowedDestinations: [],
      allowedModes: [],
      managedSignature: "",
      reasons: ["Fresh completed evidence is ready for model-authored semantic assessment."]
    } : null;
    if (selected) selected.evidenceSignature = operationEvidenceSignature(
      selected,
      reviewable.map(candidate => candidate.item)
    );
    plan.operationSelectionFrozen = true;
    plan.semanticAssessment = !!selected;
    plan.selectedOperationKind = selected ? ASSESSMENT_OPERATION_KIND : "";
    plan.selectedCandidate = selected ? clone(selected) : null;
    plan.operationCandidates = clone(diagnosticCandidates);
    plan.selectedEvidenceSignature = selected ? selected.evidenceSignature : "";
    plan.selectedGain = 0;
    plan.selectedDrain = 0;
    plan.selectedNet = 0;
    plan.routingTargets = selected ? clone(Array.isArray(targets) ? targets : []) : [];
    plan.selectionReasons = selected
      ? ["A bounded model-authored semantic assessment was scheduled over fresh completed evidence."]
      : ["No unreviewed completed evidence remained eligible for semantic assessment."];
    plan.operationTieBreak = "The model selects semantic meaning; JavaScript supplies structure and legal mechanics only.";
  }

  function operationOpportunityFrozen(plan) {
    return !!(plan && (plan.opportunityPrepared === true || plan.opportunityCounted === true));
  }

  function operationEligibilityField(kind) {
    return {
      name: "nameEligible",
      state: "stateEligible",
      relationship: "relationshipEligible",
      view: "viewEligible",
      turning: "turningEligible"
    }[keyOf(kind)] || "";
  }

  function operationEvidenceEligible(candidate, kind) {
    const field = operationEligibilityField(kind);
    if (!field || !candidate || !candidate.item || candidate[field] !== true) return false;
    const id = continuitySourceId(candidate.item.id);
    if (!id) return false;
    if (keyOf(kind) === "relationship") return ["E", "S", "X"].includes(id.charAt(0));
    if (keyOf(kind) === "view") return ["E", "R", "X"].includes(id.charAt(0));
    return id.charAt(0) === "E";
  }

  function operationEvidenceLimit(kind, selectedCandidate) {
    const normalized = keyOf(kind);
    if (normalized === ASSESSMENT_OPERATION_KIND) {
      return Math.max(1, Number(settings.MAX_ASSESSMENT_EVIDENCE_ITEMS) || 1);
    }
    const direct = selectedCandidate && selectedCandidate.direct === true;
    if (normalized === "name") return direct ? 1 : 3;
    if (["state", "relationship", "view", "turning"].includes(normalized)) return direct ? 1 : 2;
    return 1;
  }

  function operationPacketSourceIds(kind, selectedCandidate, frozenIds) {
    const normalized = keyOf(kind);
    const source = Array.isArray(frozenIds) && frozenIds.length
      ? frozenIds
      : (selectedCandidate && Array.isArray(selectedCandidate.sourceIds) ? selectedCandidate.sourceIds : []);
    return unique(source, 20)
      .map(value => textOf(value).toUpperCase())
      .filter(value => {
        const id = continuitySourceId(value);
        if (!id) return false;
        if (normalized === ASSESSMENT_OPERATION_KIND) return /^E\d+$/.test(id);
        if (normalized === "relationship") {
          return selectedCandidate && selectedCandidate.direct === true
            ? /^E\d+$/.test(id)
            : /^[SX]\d+$/.test(id);
        }
        if (normalized === "view") return /^[ERX]\d+$/.test(id);
        return /^E\d+$/.test(id);
      })
      .slice(0, operationEvidenceLimit(normalized, selectedCandidate));
  }

  function operationEvidenceCandidatesForKind(kind, candidates, selectedCandidate, frozenIds) {
    const normalizedKind = keyOf(kind);
    const directRelationship = normalizedKind === "relationship"
      && selectedCandidate && selectedCandidate.direct === true;
    const eligible = (Array.isArray(candidates) ? candidates : [])
      .filter(candidate => operationEvidenceEligible(candidate, kind))
      .filter(candidate => {
        if (normalizedKind !== "relationship") return true;
        const id = continuitySourceId(candidate && candidate.item && candidate.item.id);
        if (!id) return false;
        return directRelationship
          ? id.charAt(0) === "E"
          : ["S", "X"].includes(id.charAt(0));
      });
    const byId = {};
    eligible.forEach(candidate => { byId[candidate.item.id] = candidate; });
    const requested = operationPacketSourceIds(kind, selectedCandidate, frozenIds);
    const ordered = [];
    requested.forEach(id => {
      if (byId[id] && !ordered.includes(byId[id])) ordered.push(byId[id]);
    });
    return ordered;
  }

  function operationTargetsForKind(kind, targets) {
    const source = Array.isArray(targets) ? targets : [];
    if (kind === "name") return source.filter(target => target.nameSubject === true && target.mode === "known");
    if (kind === "state") return source.filter(target => target.mode === "known");
    if (kind === "relationship") return source.filter(target => target.relationship === true && target.key !== "self");
    if (kind === "view") return source.slice();
    if (kind === "turning") return source.filter(target => target.key === "self");
    return [];
  }

  function turningPointSnippetReference(owner, selectedCandidate) {
    if (!owner || !selectedCandidate) return "";
    refreshTurningPointsStore();
    const id = canonicalTurningPointId(selectedCandidate.field);
    const record = turningPointRecordFor(owner.key, id);
    if (!record) return "";
    const mode = ["Support", "Breakthrough", "Integration"].find(value =>
      keyOf(value) === keyOf(selectedCandidate.destination)
    ) || "";
    const comparisonStage = mode === "Breakthrough"
      ? TURNING_POINT_STAGES[3]
      : (mode === "Integration" ? TURNING_POINT_STAGES[4] : turningPointNextStage(record));
    const comparisonCard = turningPointStageCard(record, comparisonStage);
    const condition = mode === "Breakthrough" ? turningPointBreakthroughCondition(record) : null;
    return [comparisonCard ? entryOf(comparisonCard) : "", condition && condition.text || ""]
      .filter(Boolean).join(" ");
  }

  function centeredOperationEvidenceExcerpt(value, maximum, focusIndex) {
    const source = textOf(value);
    const max = Math.max(1, Math.floor(Number(maximum) || 1));
    if (source.length <= max) return source;
    const focus = Math.max(0, Math.min(source.length - 1, Math.floor(Number(focusIndex) || 0)));
    const prefixChars = Math.floor(max * 0.35);
    let start = Math.max(0, focus - prefixChars);
    let end = Math.min(source.length, start + max - 2);
    if (end === source.length) start = Math.max(0, end - max + 2);
    let excerpt = source.slice(start, end).trim();
    if (start > 0) excerpt = excerpt.replace(/^\S*\s+/, "");
    if (end < source.length) excerpt = excerpt.replace(/\s+\S*$/, "");
    return (start > 0 ? "…" : "") + excerpt + (end < source.length ? "…" : "");
  }

  function turningPointSnippetFocusIndex(value, reference, owner, maximum) {
    if (!reference) return -1;
    const ignored = turningPointIgnoredOverlapTerms(owner);
    const wanted = new Set(turningPointSemanticTerms(reference).filter(term => !ignored.has(term)));
    const source = textOf(value);
    const wordPattern = /[\p{L}\p{N}]+/gu;
    let match = null;
    let bestIndex = -1;
    let bestOverlap = -1;
    while ((match = wordPattern.exec(source))) {
      if (!wanted.has(experienceStem(match[0]))) continue;
      const index = Math.max(0, Number(match.index) || 0);
      const excerpt = centeredOperationEvidenceExcerpt(source, maximum, index);
      const overlap = turningPointTextOverlap(excerpt, reference, owner);
      if (overlap > bestOverlap || (overlap === bestOverlap && index > bestIndex)) {
        bestOverlap = overlap;
        bestIndex = index;
      }
    }
    return bestIndex;
  }

  function operationEvidenceSnippet(owner, target, kind, value, selectedCandidate) {
    const maximum = settings.MAX_OPERATION_EVIDENCE_CHARS;
    const source = canonicalOutput(value);
    if (source.length <= maximum) return source;
    const keywordPatterns = {
      name: /\b(?:name|alias|nickname|title|called|call me|known as|address|refer)\b/i,
      state: /\b(?:feel|felt|decide|choose|vow|fear|hope|hurt|angry|anxious|relieved|trapped|responsible|leaving|staying)\b/i,
      relationship: /\b(?:trust|distrust|close|distant|boundary|friend|partner|married|role|conflict|betray|permission|consent)\b/i,
      view: /\b(?:love|like|admire|respect|dislike|resent|hate|despise|judge|regard|remember|forget)\b/i,
      turning: /\b(?:begin|practice|change|learn|control|master|overcome|accept|integrate|habit|routine|breakthrough)\b/i
    };
    const turningReference = keyOf(kind) === "turning"
      ? turningPointSnippetReference(owner, selectedCandidate)
      : "";
    const sentences = (source.match(/[^.!?…]+[.!?…]+["'’”)*_`\]}]*|[^.!?…]+$/g) || [source])
      .map((text, index) => ({ text: text.trim(), index }))
      .filter(item => item.text)
      .map(item => {
        const turningFocus = turningReference
          ? turningPointSnippetFocusIndex(item.text, turningReference, owner, maximum)
          : -1;
        const genericMatch = !turningReference && keywordPatterns[keyOf(kind)]
          ? item.text.match(keywordPatterns[keyOf(kind)])
          : null;
        return {
          ...item,
          focusIndex: turningFocus >= 0
            ? turningFocus
            : (genericMatch && Number.isFinite(genericMatch.index) ? genericMatch.index : -1),
          score: (operationOwnerMentioned(owner, item.text) ? 4 : 0)
          + (target && operationTargetMentioned(owner, target, item.text) ? 4 : 0)
          + (keywordPatterns[keyOf(kind)] && keywordPatterns[keyOf(kind)].test(item.text) ? 3 : 0)
          + (turningReference
            ? Math.min(20, turningPointTextOverlap(item.text, turningReference, owner) * 5)
            : 0)
        };
      });
    const ranked = sentences.slice().sort((left, right) => right.score - left.score || left.index - right.index);
    const chosen = [];
    let used = 0;
    ranked.forEach(item => {
      if (used >= maximum || chosen.length >= 2) return;
      const remaining = maximum - used - (chosen.length ? 1 : 0);
      if (remaining <= 0) return;
      const text = item.text.length > remaining && item.focusIndex >= 0
        ? centeredOperationEvidenceExcerpt(item.text, remaining, item.focusIndex)
        : shortenProfileValue(item.text, remaining);
      if (!text) return;
      chosen.push({ index: item.index, text });
      used += text.length + (chosen.length > 1 ? 1 : 0);
    });
    return chosen.sort((left, right) => left.index - right.index).map(item => item.text).join(" ")
      || shortenProfileValue(source, maximum);
  }

  function evidencePacketForKind(owner, kind, candidates, currentInputId, recent, target, selectedCandidate) {
    const eligible = (Array.isArray(candidates) ? candidates : [])
      .filter(candidate => operationEvidenceEligible(candidate, kind));
    if (!eligible.length) return "";
    const rows = ["Evidence:"];
    eligible.forEach(candidate => {
      const snippet = operationEvidencePacketSnippet(owner, target, kind, candidate, selectedCandidate);
      if (candidate.item.source === "provenance") {
        if (keyOf(kind) === "relationship") {
          rows.push(candidate.item.id + "[A;" + (candidate.allowedFields || []).join(",") + "]: " + snippet);
        } else if (keyOf(kind) === "view") {
          rows.push(candidate.item.id + "[V;dest="
            + ((candidate.allowedDestinations || []).join(",") || "choose")
            + ";mode=" + ((candidate.allowedModes || []).join(",") || "choose") + "]: " + snippet);
        }
        return;
      }
      const source = candidate.item.source === "input"
        ? (candidate.item.id === currentInputId ? "input-now" : "input")
        : (candidate.item.source === "opening" ? "opening" : "story");
      rows.push(candidate.item.id + "[" + source + "]: " + snippet);
    });
    return rows.join("\n");
  }

  function operationEvidencePacketSnippet(owner, target, kind, candidate, selectedCandidate) {
    if (!candidate || !candidate.item) return "";
    const evidenceText = candidate.item.source === "provenance"
      ? candidate.item.text
      : textOf(candidate.item.text).replace(/\{/g, "⦃").replace(/\}/g, "⦄");
    return operationEvidenceSnippet(owner, target, kind, evidenceText, selectedCandidate);
  }

  const STATE_PRONOUN_FAMILIES = [
    { key: "she", label: "she/her", forms: ["she", "her", "hers", "herself"] },
    { key: "he", label: "he/him", forms: ["he", "him", "his", "himself"] },
    { key: "they", label: "they/them", forms: ["they", "them", "their", "theirs", "themself", "themselves"] }
  ];

  function statePronounProfileFromForms(forms) {
    const values = (Array.isArray(forms) ? forms : [])
      .map(value => line(value, 80))
      .filter(Boolean);
    if (!values.length) return null;
    const family = STATE_PRONOUN_FAMILIES.find(item => item.key === keyOf(values[0])) || null;
    return {
      forms: values,
      family: family ? family.key : "",
      display: values.slice(0, 2).join("/")
    };
  }

  function stateTargetPronounProfile(owner, target) {
    if (!target || target.key === "self") return null;
    if (target.key === "player") {
      return statePronounProfileFromForms([
        player.subject,
        player.object,
        player.possessiveAdjective,
        player.possessivePronoun,
        player.reflexive
      ]);
    }
    if (!target.key || !target.key.startsWith("npc:")) return null;
    const character = characters.find(item => "npc:" + item.key === target.key);
    const raw = line(character && character.pronouns && character.pronouns[0], 120);
    if (!raw) return null;
    const supplied = raw.split(/[\/|,;\s]+/).filter(Boolean);
    const subject = keyOf(supplied[0]);
    if (supplied.length >= 5) return statePronounProfileFromForms(supplied.slice(0, 5));
    if (subject === "she") return statePronounProfileFromForms(["she", "her", "her", "hers", "herself"]);
    if (subject === "he") return statePronounProfileFromForms(["he", "him", "his", "his", "himself"]);
    if (subject === "they") return statePronounProfileFromForms(["they", "them", "their", "theirs", "themselves"]);
    if (subject === "it") return statePronounProfileFromForms(["it", "it", "its", "its", "itself"]);
    return statePronounProfileFromForms(supplied);
  }

  function stateTargetPronounInstruction(owner, target) {
    if (target && target.key === "self" && owner) {
      return "Target reference: Self means " + owner.name
        + ". Thought uses direct first-person self-reference.";
    }
    const profile = stateTargetPronounProfile(owner, target);
    return profile && profile.display
      ? "Target reference: " + target.name + " uses " + profile.display
        + " pronouns. Plural references include an explicit group cue in the State record."
      : "";
  }

  function targetPacketForKind(owner, kind, targets) {
    const legal = operationTargetsForKind(kind, targets);
    if (!legal.length) return "";
    const rows = legal.map(target => target.code + "=" + target.name
      + (kind === "view" && target.mode === "buried" ? " (buried)" : "")
      + (kind === "view" && target.mode === "recovering" ? " (recovering)" : ""));
    if (kind === "name") {
      return "Subject: " + rows[0] + "\nUse codes: " + rows.join(", ");
    }
    const targetReference = kind === "state" ? stateTargetPronounInstruction(owner, legal[0]) : "";
    return ["Target: " + rows.join(", "), targetReference].filter(Boolean).join("\n");
  }

  function relationshipOperationDestinations(field, selectedCandidate) {
    const selected = line(selectedCandidate && selectedCandidate.destination, 120);
    if (selected) return [selected];
    const destinations = (RELATIONSHIP_STAGES[field] || []).map(stage => stage.label);
    if (field === "Role") destinations.push("Former");
    if (field === "Boundaries") destinations.push("Released");
    return unique(destinations, 120);
  }

  function relationshipFieldMeaning(field) {
    return {
      Role: "Role expresses an actual social status.",
      Trust: "Trust expresses reliance.",
      Closeness: "Closeness expresses interpersonal connection.",
      Boundaries: "Boundaries express the owner's established limits.",
      Conflict: "Conflict expresses active interpersonal friction."
    }[field] || "The selected field expresses its completed-event meaning.";
  }

  function viewOperationDestinations(target, selectedCandidate) {
    const selected = line(selectedCandidate && selectedCandidate.destination, 120);
    if (selected) return [selected];
    const allowed = unique(selectedCandidate && selectedCandidate.allowedDestinations || [], 120);
    if (allowed.length) return allowed;
    if (target && target.mode === "buried") return ["Recovered"];
    return VIEW_CATEGORIES.concat(target && target.mode === "known" ? ["Buried"] : []);
  }

  function turningPointOperationPacket(owner, selectedCandidate) {
    refreshTurningPointsStore();
    const id = canonicalTurningPointId(selectedCandidate && selectedCandidate.field);
    const record = turningPointRecordFor(owner && owner.key, id);
    if (!record) return "";
    const mode = line(selectedCandidate && selectedCandidate.destination, 40);
    const comparisonStage = mode === "Breakthrough"
      ? TURNING_POINT_STAGES[3]
      : (mode === "Integration" ? TURNING_POINT_STAGES[4] : turningPointNextStage(record));
    const currentResolution = turningPointStageCardResolution(record, owner, record.progress.stageRecord);
    const comparisonResolution = turningPointStageCardResolution(record, owner, comparisonStage);
    if (!currentResolution.ok || !comparisonResolution.ok) return "";
    const currentCard = currentResolution.card;
    const comparisonCard = comparisonResolution.card;
    const breakthrough = mode === "Breakthrough"
      ? turningPointBreakthroughCondition(record)
      : null;
    if (mode === "Breakthrough" && (!breakthrough || !breakthrough.text || breakthrough.invalid)) return "";
    const compact = card => shortenProfileValue(
      extractLine(entryOf(card), "Entry") || entryOf(card).replace(/[{}]/g, " "),
      150
    );
    return [
      "Turning Point: " + record.title + " [" + record.direction + "]",
      "Current progress: " + record.progress.normalized,
      "Current stage card — " + titleOf(currentCard) + ": " + compact(currentCard),
      "Comparison stage card — " + titleOf(comparisonCard) + ": " + compact(comparisonCard),
      breakthrough
        ? (breakthrough.explicit ? "Creator-written definitive breakthrough condition: " : "Legacy Achieved fallback condition: ")
          + breakthrough.text
        : ""
    ].filter(Boolean).join("\n");
  }

  function operationRecordTemplateForKind(kind, owner, target, evidenceCandidates, selectedCandidate) {
    // Freeze routing and every mechanically consequential field. The model
    // completes only the remaining narrative field; output validation checks
    // the frozen contract and storage safety, not lexical overlap.
    const normalized = keyOf(kind);
    const evidenceIds = unique((Array.isArray(evidenceCandidates) ? evidenceCandidates : [])
      .map(candidate => continuitySourceId(candidate && candidate.item && candidate.item.id))
      .filter(Boolean), 20);
    if (!owner || !target || !evidenceIds.length) return "";
    const evidenceField = evidenceIds.join(",");
    if (normalized === "state") {
      const triggers = triggerList(selectedCandidate && selectedCandidate.stateTriggers || []);
      if (!triggers.length) return "";
      const confirmation = keyOf(selectedCandidate && selectedCandidate.stateMode) === "confirm"
        && !!line(selectedCandidate && selectedCandidate.confirmSituation, settings.MAX_STATE_VALUE_CHARS);
      const situation = confirmation ? "KEEP" : "Situation";
      return "(CCO|S|" + target.code + "|" + evidenceField + "|" + triggers.join(",")
        + "|" + situation + "|Thought)";
    }
    if (normalized === "name") {
      const alias = line(selectedCandidate && selectedCandidate.nameAlias, 160);
      const transition = line(selectedCandidate && selectedCandidate.nameTransition, 40);
      const replacedAlias = line(selectedCandidate && selectedCandidate.nameReplacedAlias, 160);
      const use = line(selectedCandidate && selectedCandidate.nameUse, 1000);
      const transitionField = transition === "Replace" ? "Replace=" + replacedAlias : transition;
      if (!alias || !transitionField || !use) return "";
      return "(CCO|N|" + target.code + "|" + evidenceField + "|" + alias + "|"
        + transitionField + "|" + use + "|Explanation)";
    }
    if (normalized === "relationship") {
      const field = RELATIONSHIP_FIELDS.includes(selectedCandidate && selectedCandidate.field)
        ? selectedCandidate.field
        : "";
      const destination = line(selectedCandidate && selectedCandidate.destination, 120);
      const eventKind = selectedCandidate && selectedCandidate.direct === true ? "D" : "A";
      if (!field || !destination) return "";
      return "(CCO|R|" + target.code + "|" + evidenceField + "|" + field + "|"
        + eventKind + "|" + destination + "|Explanation)";
    }
    if (normalized === "view") {
      const destination = canonicalViewDestination(selectedCandidate && selectedCandidate.destination);
      const modes = unique(selectedCandidate && selectedCandidate.allowedModes || [], 20)
        .map(canonicalViewOperationMode)
        .filter(Boolean);
      if (!destination || modes.length !== 1) return "";
      return "(CCO|V|" + target.code + "|" + evidenceField + "|" + destination + "|"
        + modes[0] + "|Explanation)";
    }
    if (normalized === "turning") {
      const id = canonicalTurningPointId(selectedCandidate && selectedCandidate.field);
      const mode = ["Support", "Breakthrough", "Integration"].find(value =>
        keyOf(value) === keyOf(selectedCandidate && selectedCandidate.destination)
      ) || "";
      if (!id || !mode) return "";
      return "(CCO|T|" + target.code + "|" + evidenceField + "|" + id + "|"
        + mode + "|Explanation)";
    }
    return "";
  }

  function operationTaskForKind(kind, owner, targets, evidenceCandidates, currentInputId, recent, frozenPace, selectedCandidate) {
    const normalized = keyOf(kind);
    if (!MODEL_OPERATION_KINDS.includes(normalized)) return "";
    const target = operationTargetsForKind(normalized, targets)[0] || null;
    const evidenceIds = unique((Array.isArray(evidenceCandidates) ? evidenceCandidates : [])
      .map(candidate => continuitySourceId(candidate && candidate.item && candidate.item.id))
      .filter(Boolean), 20);
    if (!target || !evidenceIds.length) return "";
    const evidenceField = evidenceIds.join(",");
    const evidenceChoice = "Copy the Evidence IDs as " + evidenceField + " in that order.";
    const evidenceAuthority = "The labeled Evidence rows are the scheduled sources. Complete the remaining narrative field consistently with them and directly relevant scene context; ordinary paraphrase is allowed.";
    const evidence = evidencePacketForKind(
      owner, normalized, evidenceCandidates, currentInputId, recent, target, selectedCandidate
    );
    const targetMap = targetPacketForKind(owner, normalized, targets);
    const recordTemplate = operationRecordTemplateForKind(
      normalized, owner, target, evidenceCandidates, selectedCandidate
    );
    if (!recordTemplate) return "";
    const commonEnding = [
      selectedCandidate && selectedCandidate.pendingRetry === true
        ? "Retry output order:"
        : "Output order:",
      "1. Complete the CCO record template below as the first nonblank output line. Copy every supplied code and value exactly; replace each literal Situation, Thought, or Explanation placeholder present in the template with one concise completed value.",
      "2. Continue with complete story prose from the next line.",
      "Record template:",
      recordTemplate
    ];
    let rules = [];
    if (normalized === "state") {
      const state = normalizeState(CC.npcs[owner.key] && CC.npcs[owner.key].state, CC.stateClock);
      const frozenConfirmation = keyOf(selectedCandidate && selectedCandidate.stateMode) === "confirm"
        && !!line(selectedCandidate && selectedCandidate.confirmSituation, settings.MAX_STATE_VALUE_CHARS)
        && normalizedTargetKey(selectedCandidate && selectedCandidate.targetKey) === normalizedTargetKey(target.key);
      const currentSituation = situationPhrase(state.situation.value);
      const currentSituationMatchesTarget = !!currentSituation
        && normalizedTargetKey(state.situation.targetKey || state.target.key) === normalizedTargetKey(target.key);
      const frozenTriggers = triggerList(selectedCandidate && selectedCandidate.stateTriggers || []);
      if (!frozenTriggers.length) return "";
      const stateContinuityRules = frozenConfirmation
        ? [
          "Current accepted Situation for " + target.code + ": "
            + line(selectedCandidate.confirmSituation, settings.MAX_STATE_VALUE_CHARS) + ".",
          "The Situation field is the literal KEEP. KEEP confirms that supplied Current Situation verbatim."
        ]
        : (currentSituationMatchesTarget
          ? [
            "Current accepted Situation for " + target.code + ": " + currentSituation + ".",
            "The scheduled operation has already fixed whether the completed record confirms or changes that Situation."
          ]
          : []);
      rules = [
        "State operation — owner " + owner.name + ".",
        evidence,
        targetMap,
        evidenceChoice,
        evidenceAuthority,
        ...stateContinuityRules,
        frozenConfirmation
          ? "KEEP is fixed. Replace Thought with concise direct first-person inner speech consistent with the scheduled evidence."
          : "Replace Situation with a character-voiced clause of at most 100 characters and Thought with direct first-person inner speech. Keep both consistent with the scheduled evidence; natural paraphrase is allowed.",
        ...(selectedCandidate && selectedCandidate.pendingRetry === true
          ? ["This is the one carried retry of the earlier frozen evidence; the completed record remains unchanged."]
          : []),
        ...commonEnding
      ];
    } else if (normalized === "name") {
      const alias = line(selectedCandidate && selectedCandidate.nameAlias, 160);
      const transition = line(selectedCandidate && selectedCandidate.nameTransition, 40);
      const replacedAlias = line(selectedCandidate && selectedCandidate.nameReplacedAlias, 160);
      const use = line(selectedCandidate && selectedCandidate.nameUse, 1000);
      const transitionField = transition === "Replace" ? "Replace=" + replacedAlias : transition;
      if (!alias || !transitionField || !use) return "";
      rules = [
        "Name operation — owner " + owner.name + ".",
        evidence,
        targetMap,
        evidenceChoice,
        evidenceAuthority,
        "Alias, Transition, and Use are fixed. Replace Explanation with one short clause describing why the scheduled transition applies; natural paraphrase is allowed.",
        ...commonEnding
      ];
    } else if (normalized === "relationship") {
      const pace = frozenPace && typeof frozenPace === "object" ? frozenPace : runtime.relationshipPace;
      const field = RELATIONSHIP_FIELDS.includes(selectedCandidate && selectedCandidate.field)
        ? selectedCandidate.field
        : RELATIONSHIP_FIELDS[0];
      const direct = selectedCandidate && selectedCandidate.direct === true;
      const destinations = relationshipOperationDestinations(field, selectedCandidate);
      const destinationField = destinations.length === 1 ? destinations[0] : "Destination";
      rules = [
        "Relationship operation — owner " + owner.name + ".",
        evidence,
        targetMap,
        evidenceChoice,
        evidenceAuthority,
        "Target, field, " + (direct ? "direct" : "accumulated") + " event class, and destination "
          + destinationField + " are fixed. Replace Explanation with one short clause describing the scheduled relationship movement; natural paraphrase is allowed.",
        "Frozen " + pace.name + " pace: " + (direct ? "D " + pace.direct : "A " + pace.accumulated)
          + " per event, maximum " + pace.maxStages + " stage" + (pace.maxStages === 1 ? "" : "s") + ".",
        relationshipFieldMeaning(field),
        "Explanation describes the cited event and relationship meaning; the managed card supplies the resulting score and stage.",
        ...commonEnding
      ];
    } else if (normalized === "view") {
      const destinations = viewOperationDestinations(target, selectedCandidate);
      const modes = unique(selectedCandidate && selectedCandidate.allowedModes || [], 20);
      const legalModes = modes.length ? modes : ["O", "M"];
      const destinationField = destinations.length === 1 ? destinations[0] : "Destination";
      const modeField = legalModes.length === 1 ? legalModes[0] : "Mode";
      rules = [
        "View operation — owner " + owner.name + ".",
        evidence,
        targetMap,
        evidenceChoice,
        evidenceAuthority,
        "Target, destination " + destinationField + ", and mode " + modeField
          + " are fixed. Replace Explanation with one short clause describing the scheduled View movement; natural paraphrase is allowed.",
        ...commonEnding
      ];
    } else if (normalized === "turning") {
      const id = canonicalTurningPointId(selectedCandidate && selectedCandidate.field);
      const mode = ["Support", "Breakthrough", "Integration"].find(value =>
        keyOf(value) === keyOf(selectedCandidate && selectedCandidate.destination)
      ) || "Support";
      const turningPacket = turningPointOperationPacket(owner, selectedCandidate);
      if (!id || !turningPacket) return "";
      rules = [
        "Turning Point operation — owner " + owner.name + ".",
        evidence,
        turningPacket,
        evidenceChoice,
        evidenceAuthority,
        "The first six record fields are complete supplied data: CCO|T|" + target.code + "|"
          + evidenceField + "|" + id + "|" + mode
          + ". Fill the seventh field, Explanation, with one complete clause of at most "
          + settings.MODEL_OPERATION_EXPLANATION_CHARS
          + " characters describing the scheduled Turning Point movement; natural paraphrase is allowed.",
        mode === "Support"
          ? "Support records a completed, durable step toward the comparison stage while progress remains below Achieved."
          : (mode === "Breakthrough"
            ? "The scheduled Breakthrough records the cited completed event or connected completed sequence as satisfying the definitive condition and establishing Achieved as the owner's new baseline. Integration later records repetition and ease."
            : "Integration records completed evidence that the achieved change is sustained, habitual, or part of ordinary life."),
        ...commonEnding
      ];
    }
    return ["<SYSTEM>", ...currentOperationAuthorityLines(), ...rules.filter(Boolean), "</SYSTEM>"].join("\n");
  }

  function assessmentEvidenceCodes(candidate) {
    return candidate && candidate.item ? ["S", "N", "R", "V", "T"] : [];
  }

  function assessmentTurningPointChoices(owner) {
    if (!owner || runtime.turningPointMode === "disabled") return [];
    refreshTurningPointsStore();
    const ownerData = turningPointsForOwner(owner.key);
    if (!ownerData) return [];
    return ownerData.contextRecords.map(record => {
      if (!turningPointDirectionAllowed(record)) return null;
      const score = record.progress.score;
      const modes = [];
      const references = [];
      const nextStage = turningPointNextStage(record);
      if (score < 29 && turningPointStageCardValid(record, owner, nextStage)) {
        modes.push("Support");
        const card = turningPointStageCard(record, nextStage);
        references.push("Support=" + shortenProfileValue(
          extractLine(entryOf(card), "Entry") || entryOf(card).replace(/[{}]/g, " "), 110
        ));
      }
      const achieved = TURNING_POINT_STAGES[3];
      const breakthrough = turningPointBreakthroughCondition(record);
      if (score < 30 && turningPointStageCardValid(record, owner, achieved)
        && breakthrough && breakthrough.text && !breakthrough.invalid) {
        modes.push("Breakthrough");
        references.push("Breakthrough=" + shortenProfileValue(breakthrough.text, 110));
      }
      const integrating = TURNING_POINT_STAGES[4];
      if (score >= 30 && score < integrating.maximum
        && turningPointStageCardValid(record, owner, integrating)) {
        modes.push("Integration");
        const card = turningPointStageCard(record, integrating);
        references.push("Integration=" + shortenProfileValue(
          extractLine(entryOf(card), "Entry") || entryOf(card).replace(/[{}]/g, " "), 110
        ));
      }
      return modes.length ? {
        id: record.id,
        handle: turningPointContextHandle(owner, record),
        title: record.title,
        progress: record.progress.normalized,
        modes,
        references,
        managedSignature: turningPointManagedSignature(owner.key, record)
      } : null;
    }).filter(Boolean);
  }

  function semanticAssessmentTask(owner, targets, evidenceCandidates) {
    const evidence = (Array.isArray(evidenceCandidates) ? evidenceCandidates : [])
      .filter(candidate => candidate && candidate.item && /^E\d+$/.test(candidate.item.id))
      .slice(0, Math.max(1, Number(settings.MAX_ASSESSMENT_EVIDENCE_ITEMS) || 1));
    if (!owner || !evidence.length) return "";
    const evidenceIds = evidence.map(candidate => candidate.item.id);
    const evidenceField = evidenceIds.join(",");
    const rows = evidence.map(candidate => {
      const codes = assessmentEvidenceCodes(candidate);
      const snippet = operationEvidenceSnippet(owner, null, "", candidate.item.text, null);
      return candidate.item.id + "[" + codes.join("") + "]: " + snippet;
    });
    const stateTargets = operationTargetsForKind("state", targets);
    const nameTargets = operationTargetsForKind("name", targets);
    const relationshipTargets = operationTargetsForKind("relationship", targets);
    const viewTargets = operationTargetsForKind("view", targets);
    const turningChoices = evidence.some(candidate => candidate.turningEligible === true)
      ? assessmentTurningPointChoices(owner)
      : [];
    const forms = [
      "K unchanged: (CCO|K|S|" + evidenceField + "|Explanation)"
    ];
    if (stateTargets.length && evidence.some(candidate => candidate.stateEligible === true)) {
      forms.push("S State: (CCO|S|AboutCode|EvidenceIDs|TriggerList|Situation|Thought)");
    }
    if (nameTargets.length && evidence.some(candidate => candidate.nameEligible === true)) {
      forms.push("N Name: (CCO|N|SubjectCode|EvidenceIDs|Alias|Transition|Use|Explanation)");
    }
    if (relationshipTargets.length && evidence.some(candidate => candidate.relationshipEligible === true)) {
      forms.push("R Relationship: (CCO|R|TargetCode|EvidenceIDs|Field|D|Destination|Explanation)");
    }
    if (viewTargets.length && evidence.some(candidate => candidate.viewEligible === true)) {
      forms.push("V View: (CCO|V|TargetCode|EvidenceIDs|Destination|Mode|Explanation)");
    }
    if (turningChoices.length) {
      forms.push("T Turning Point: (CCO|T|S|EvidenceIDs|StableID|Movement|Explanation)");
    }
    const targetRows = targets.length ? ["Targets (S=State,N=Name,R=Relationship,V=View): "
      + targets.map(target => {
        const capabilities = [
          stateTargets.includes(target) ? "S" : "",
          nameTargets.includes(target) ? "N" : "",
          relationshipTargets.includes(target) ? "R" : "",
          viewTargets.includes(target) ? "V" : ""
        ].filter(Boolean).join("");
        const mode = target.mode === "buried" ? ";buried" : (target.mode === "recovering" ? ";recovering" : "");
        return target.code + "=" + target.name + "[" + capabilities + mode + "]";
      }).join(", ")] : [];
    const relationshipDestinations = RELATIONSHIP_FIELDS.map(field => field + "="
      + relationshipOperationDestinations(field, null).join("/")).join("; ");
    const turningRows = turningChoices.map(choice => "TP " + choice.id + " " + choice.title
      + " | current " + choice.progress + " | movements " + choice.modes.join("/")
      + " | " + choice.references.join("; "));
    const rules = [
      "CC CURRENT ASSESSMENT — CONTEXT PACKET",
      "Assess only the supplied completed evidence for " + owner.name + ". Choose its continuity meaning; fill every field.",
      "Use one or more supplied IDs in supplied order. K copies all supplied IDs and means assessed with no continuity change.",
      "Evidence:",
      ...rows,
      ...targetRows,
      "State: choose 1-3 triggers from " + TRIGGER_CODES.join(",")
        + "; Situation is a concise completed event; Thought is direct first-person private thought.",
      "Name Transition: Observed/Adopted/Retired/Rejected/Reactivated/Replace=OldAlias. Use: General/None/or comma-separated Name codes.",
      "Relationship D means a completed direct event. Fields/destinations: " + relationshipDestinations + ".",
      "View destination: " + VIEW_CATEGORIES.join("/")
        + "/Buried(active known view)/Recovered(buried view). Mode O=direct durable judgment; M=bounded movement.",
      ...turningRows,
      turningRows.length ? "For T, StableID is the ID after TP." : "",
      "Explanation: one grounded plain-text clause. Keep | separators distinct.",
      "Available record forms:",
      ...forms,
      "Output order:",
      "1. Complete exactly one available CCO record as the first nonblank line.",
      "2. Write complete story prose from the next line."
    ];
    return ["<SYSTEM>", ...rules.filter(Boolean), "</SYSTEM>"].join("\n");
  }

  function operationTaskUsesForcedContract(value) {
    const source = textOf(value);
    const assessmentContract = /(?:^|\n)CC CURRENT ASSESSMENT — (?:CONTEXT PACKET|FINAL RESPONSE SUFFIX)\b/i.test(source)
      && /K unchanged:\s*\(CCO\|K\|S\|[^\n]+\|Explanation\)/i.test(source)
      && /Available record forms:\s*[\s\S]*\(CCO\|[KSNRVT]\|/i.test(source)
      && /(?:Retry )?Output order:\s*\n1\. Complete exactly one available CCO record as the first nonblank(?: output)? line\.\s*\n2\. (?:Continue with|Write) complete story prose from the next line\./i.test(source);
    if (assessmentContract) return true;
    const legacyCompletionContract = source.includes(
      "Complete this scheduled continuity operation by replacing every capitalized placeholder with a concise completed value;"
    ) || source.includes(
      "Complete this scheduled continuity operation by replacing every capitalized placeholder from the labeled Evidence rows;"
    );
    const positiveOutputContract = /(?:^|\n)(?:Retry )?Output order:\s*\n1\. Complete the CCO record template below as the first nonblank output line\.[^\n]*\n2\. Continue with complete story prose from the next line\./i.test(source);
    const legacyOutputContract = legacyCompletionContract
      && /Put the completed CCO record on the first nonblank output line, then continue with complete story prose\./i.test(source);
    return (positiveOutputContract || legacyOutputContract)
      && /Record template:\s*\n\(CCO\|[SNRVT]\|[^\n]+\|(?:Situation|Thought|Explanation)\)\s*\n<\/SYSTEM>/i.test(source)
      && !/\(\s*CCO\s*\|\s*K\s*\|/i.test(source)
      && !/\b(?:no[- ]change result|no change result|if supplied evidence warrants|if (?:the )?record cannot be completed|use the exact decline record)\b/i.test(source);
  }

  function positiveOperationRetryTask(value) {
    let source = textOf(value).trim();
    if (!source) return "";
    if (!/(?:^|\n)CC CURRENT (?:OPERATION|ASSESSMENT)\b/i.test(source)) {
      source = source.replace(/<SYSTEM>\s*/i, match =>
        match + currentOperationAuthorityLines().join("\n") + "\n"
      );
    }
    const positiveLines = [
      "Output order:",
      "1. Complete the CCO record template below as the first nonblank output line. Copy every supplied code and value exactly; replace each literal Situation, Thought, or Explanation placeholder present in the template with one concise completed value.",
      "2. Continue with complete story prose from the next line."
    ].join("\n");
    const legacyBlocks = [
      [
        "Complete this scheduled continuity operation by replacing every capitalized placeholder with a concise completed value; keep supplied values unchanged.",
        "Put the completed CCO record on the first nonblank output line, then continue with complete story prose."
      ].join("\n"),
      [
        "Complete this scheduled continuity operation by replacing every capitalized placeholder from the labeled Evidence rows; keep supplied values unchanged.",
        "Put the completed CCO record on the first nonblank output line, then continue with complete story prose."
      ].join("\n")
    ];
    const legacy = legacyBlocks.find(block => source.includes(block));
    if (legacy) source = source.replace(legacy, positiveLines);
    return source.replace(/(?:^|\n)Output order:\s*(?=\n)/, match =>
      (match.startsWith("\n") ? "\n" : "") + "Retry output order:"
    );
  }

  function scrubLegacyOperationTaskText(plan) {
    if (!plan || typeof plan !== "object" || Array.isArray(plan)) return plan;
    ["operationTaskText", "retryOperationTaskText"].forEach(field => {
      if (textOf(plan[field]).trim() && !operationTaskUsesForcedContract(plan[field])) plan[field] = "";
    });
    clearIncompleteForcedOperationPlan(plan);
    return plan;
  }

  function recoveryTask() {
    return [
      "<SYSTEM>",
      "CC CURRENT RESPONSE — STORY RECOVERY",
      "Use this final CC CURRENT RESPONSE block as the output task for this response. Write a complete scene response in ordinary story prose.",
      "</SYSTEM>"
    ].join("\n");
  }

  function operationFrontMemoryInstruction() {
    return [
      "<SYSTEM>",
      "A Character Continuity operation is mandatory this response.",
      "Follow the final CC CURRENT ASSESSMENT/OPERATION block in Context.",
      "Output exactly one completed CCO record as the first nonblank line, then story prose.",
      "If the packet offers K and no change is supported, use K. Do not omit or refuse the record.",
      "</SYSTEM>"
    ].join("\n");
  }

  function currentOperationAuthorityLines() {
    return [
      "CC CURRENT OPERATION — CONTEXT PACKET",
      "Use this CC CURRENT OPERATION packet as the complete operation data for this response. Its Evidence rows, Output order, and Record template are the current supplied contract."
    ];
  }

  function turningPointPortrayalAuthorityRule() {
    return "CC PORTRAYAL: Each CURRENT TP handle and revision in the newest CC PORTRAYAL block selects the only active matching TP STAGE block. It replaces every earlier revision and untagged stage passage for that development. Use the selected block as that NPC's durable baseline, allowing uneven expression and setbacks; if no matching block is available, apply no stage guidance.";
  }

  function portrayalRules() {
    return [
      "Use each named NPC's supplied continuity to decide what that NPC notices, interprets, values, and chooses in the present moment. Select the few details relevant now; let the rest remain latent.",
      "Every named wrapper belongs to its named NPC. Outer and Inner remain creator-authored anchors. Read each Relationship and View in its owner-target direction. Situation and Experiences record established events. Use canonical names and permitted Active aliases exactly; Emerging aliases are tentative, Retired aliases are historical, and Rejected aliases are declined forms. Resolve a shared alias through one clear identity in context.",
      "Inner establishes enduring tendencies. Personality, mannerisms, wants, fears, mental wounds, and Principles may align or compete; circumstances determine which influence matters now and how the NPC acts on it.",
      "State supplies temporary pressure. Thought may remain wholly private; Feeling colors perception; Goal guides intention; Tension preserves competing pulls; Situation grounds the present concern. Let the NPC choose what to express, conceal, pursue, postpone, revise, or release.",
      "Relationships and Views establish directional baselines. Apply the few relevant parts in proportion to the scene, with Inner, State, established events, and present circumstances shaping how those baselines appear.",
      "Give each active NPC an independent perspective, limits, and initiative. Let the NPC act, refrain, disclose, evade, persist, or change course according to what they would actually choose in the moment.",
      turningPointPortrayalAuthorityRule(),
      "The Player defines their speech, actions, thoughts, feelings, memories, identity, attraction, consent, boundaries, commitments, names, and relationships through input. Treat player-entered speech, actions, choices, permissions, refusals, and boundaries as established current story facts. Continue from that established point through NPC choices and world consequences, leaving the Player's next response open.",
      "Player: " + player.name + " | "
        + [player.subject, player.object, player.possessiveAdjective, player.possessivePronoun, player.reflexive].join("/")
        + " | " + player.agreement
    ].join("\n");
  }

  function emergencyPortrayalRules() {
    return [
      "Focused NPC: use complete emergency Outer/Inner; preserve identity/traits/motives/limits/principles; choose independently.",
      turningPointPortrayalAuthorityRule(),
      "Only the Player controls: words/actions; thoughts/feelings/memories; identity/attraction; consent/boundaries/commitments; names/relationships. Honor input; leave the next response open.",
      "Player: " + player.name + " | " + player.subject + "/" + player.object + " | " + player.agreement
    ].join("\n");
  }

  function continuityCapacity(base, maxChars) {
    const source = textOf(base);
    const suppliedMaximum = Number(maxChars);
    const validMaximum = Number.isFinite(suppliedMaximum) && suppliedMaximum > 0;
    if (!validMaximum) {
      return {
        effectiveBudget: appendOnlyContext ? 0 : runtime.continuityBudget,
        baseChars: source.length,
        maxChars: 0,
        cacheOverflowActive: false,
        cacheOverflowUsedTokens: 0,
        cacheOverflowRemainingTokens: 0
      };
    }

    const normalizedMaximum = Math.max(1, Math.floor(suppliedMaximum));
    const ordinaryAvailableChars = Math.max(0, normalizedMaximum - source.length - 4);
    const ordinaryAvailableTokens = Math.max(0, Math.floor(ordinaryAvailableChars / 3.25));
    // info.maxChars remains a hard ceiling for text returned by the context modifier.
    // Optimized Context's internal overflow buffer is not safe append capacity: the
    // server can cut a returned suffix at info.maxChars. Constrained append turns use
    // complete compact portrayal tiers below rather than returning a partial packet.
    const cacheOverflowActive = false;
    const cacheOverflowUsedTokens = 0;
    const cacheOverflowRemainingTokens = 0;
    const availableTokens = ordinaryAvailableTokens;
    return {
      effectiveBudget: Math.min(runtime.continuityBudget, availableTokens),
      baseChars: source.length,
      maxChars: normalizedMaximum,
      cacheOverflowActive,
      cacheOverflowUsedTokens,
      cacheOverflowRemainingTokens
    };
  }

  function renderPortrayalComponents(components) {
    const body = components.map(component => component.text).filter(Boolean).join("\n");
    return body ? "<SYSTEM>\n" + body + "\n</SYSTEM>" : "";
  }

  function fitWithoutTrimming(base, prefix, tail, maxChars, recentChars, materialize, capacity) {
    const parts = (appendOnlyContext ? [base, prefix, tail] : [prefix, base, tail])
      .filter(Boolean)
      .map(textOf);
    const joinedLength = parts.reduce((total, part) => total + part.length, 0)
      + Math.max(0, parts.length - 1) * 2;
    if (!maxChars || joinedLength <= maxChars) {
      return {
        ok: true,
        text: materialize ? parts.join("\n\n") : "",
        recentChars
      };
    }
    return {
      ok: false,
      text: base,
      recentChars,
      reason: "The immutable platform context left insufficient room for this complete continuity packet."
    };
  }

  function assembleContext(base, active, focus, currentInput, recent, plan, controlOnly = false,
    externalFrontMemory = "") {
    const components = [];
    let tail = "";
    let frontInstruction = CC.recoveryPending ? recoveryTask() : "";
    const selectedNames = [];
    const omittedNames = [];
    const selectedRelationships = [];
    const omittedRelationships = [];
    const selectedTurningPoints = [];
    const omittedTurningPoints = [];
    const selectedViews = [];
    const omittedViews = [];
    const selectedExperiences = [];
    const omittedExperiences = [];
    const modelActive = [];
    const maxChars = Number(typeof info !== "undefined" && info ? info.maxChars : 0) || 0;
    const configuredBudget = runtime.continuityBudget;
    const capacity = continuityCapacity(base, maxChars);
    const effectiveBudget = capacity.effectiveBudget;
    const recentChars = textOf(recent).length;
    let compactFocusCoreUsed = false;
    let compactFocusRequiresTask = false;
    let compactPortrayalFallbackUsed = false;
    let emergencyPortrayalFallbackUsed = false;
    let cacheLimitedPortrayal = false;
    let portrayalTier = controlOnly ? "story-card" : "full";
    const operationCandidateReady = !!(
      plan && plan.opportunity && !CC.recoveryPending
      && TASK_OPERATION_KINDS.includes(keyOf(plan.selectedOperationKind))
      && plan.selectedCandidate
    );
    // The configured continuity budget is the sole script-side total context
    // limit. Operation turns do not impose a second, smaller turn ceiling.
    const continuityTurnBudget = configuredBudget;
    const continuityEffectiveBudget = Math.min(effectiveBudget, continuityTurnBudget);

    const composition = (candidateComponents = components, candidateTail = tail, materialize = false,
      candidateFrontInstruction = frontInstruction) => {
      const prefix = controlOnly ? "" : renderPortrayalComponents(candidateComponents);
      const contextPacket = ownedContextPacketBlock(candidateTail);
      const frontMemory = composedFrontMemory(externalFrontMemory, candidateFrontInstruction);
      const fittedTail = [contextPacket, frontMemory].filter(Boolean).join("\n\n");
      const tokens = estimateTokens([
        prefix,
        contextPacket,
        ownedFrontMemoryBlock(candidateFrontInstruction)
      ].filter(Boolean).join("\n"));
      if (tokens > continuityTurnBudget) return { ok: false, reason: "continuity turn budget" };
      if (tokens > continuityEffectiveBudget) return { ok: false, reason: "effective context allowance" };
      const fitted = fitWithoutTrimming(
        base, prefix, fittedTail, maxChars, recentChars, materialize, capacity
      );
      return fitted.ok ? { ok: true, tokens, fitted } : { ok: false, reason: fitted.reason };
    };
    const addGroup = group => {
      const usable = group.filter(component => component.text);
      if (!usable.length) return true;
      const candidate = components.concat(usable);
      const fit = composition(candidate, tail);
      if (!fit.ok) return false;
      components.push(...usable);
      return true;
    };
    const normalizedBaseBlocks = "\n" + textOf(base).replace(/\r/g, "") + "\n";
    const turningPointStageBlockAlreadyPresent = value => {
      const block = textOf(value).replace(/\r/g, "").trim();
      return !!(block && normalizedBaseBlocks.includes("\n" + block + "\n"));
    };
    const addSelectedTurningPoint = label => {
      if (label && !selectedTurningPoints.includes(label)) selectedTurningPoints.push(label);
    };
    const addOmittedTurningPoint = (label, reason = "", reserved = false) => {
      const omission = label + (reason ? " (" + reason + ")" : "");
      if (label && !omittedTurningPoints.includes(omission)) omittedTurningPoints.push(omission);
      const diagnostic = omission + (reserved ? " (reserved operation packet)" : "");
      if (label && !CC.last.modelOmitted.includes(diagnostic)) CC.last.modelOmitted.push(diagnostic);
    };
    const addTurningPointStages = owner => {
      const ownerData = turningPointsForOwner(owner && owner.key);
      const records = ownerData && Array.isArray(ownerData.contextRecords)
        ? ownerData.contextRecords
        : [];
      records.forEach(record => {
        const resolution = turningPointStageCardResolution(record, owner, record.progress.stageRecord);
        const title = resolution.title || turningPointStageCardTitle(
          record.stageCardPrefix, record.progress.stageRecord
        );
        const label = owner.name + "→" + title + " Turning Point stage";
        if (!resolution.ok) {
          addOmittedTurningPoint(label, resolution.reason || "invalid");
          return;
        }
        const marker = turningPointContextMarker(owner, record, resolution);
        if (!marker) {
          addOmittedTurningPoint(label, "invalid current-stage authority");
          return;
        }
        const authority = {
          text: marker,
          type: "turningPointAuthority",
          ownerKey: owner.key,
          order: 2.4,
          turningPointLabels: [label]
        };
        if (!addGroup([authority])) {
          addOmittedTurningPoint(label, "current-stage authority did not fit");
          return;
        }
        const stageBlock = turningPointContextStageBlock(owner, record, resolution);
        if (!stageBlock) {
          addOmittedTurningPoint(label, "invalid current stage block");
          return;
        }
        if (turningPointStageBlockAlreadyPresent(stageBlock)) {
          addSelectedTurningPoint(label);
          return;
        }
        const component = {
          text: stageBlock,
          type: "turningPoints",
          ownerKey: owner.key,
          order: 2.5,
          turningPointLabels: [label]
        };
        if (addGroup([component])) {
          addSelectedTurningPoint(label);
        } else {
          addOmittedTurningPoint(label, "current stage entry did not fit");
        }
      });
    };
    const addNamesProjection = (identity, ownerKey, limit, marker) => {
      const relevant = relevantNameRecords(identity, currentInput, recent, modelActive);
      const chosen = [];
      let blocked = false;
      relevant.forEach(selection => {
        const label = identity.canonical + "→" + selection.record.alias;
        if (blocked || chosen.length >= limit) {
          omittedNames.push(label);
          return;
        }
        const next = chosen.concat(selection);
        const block = renderRelevantNamesBlock(identity, next);
        const priorIndex = components.findIndex(component => component.namesMarker === marker);
        const candidate = components.slice();
        const component = {
          text: block, type: "names", ownerKey, order: identity.player ? -1 : 1, namesMarker: marker
        };
        if (priorIndex >= 0) candidate[priorIndex] = component;
        else candidate.push(component);
        const fit = composition(candidate, tail);
        if (fit.ok) {
          if (priorIndex >= 0) components[priorIndex] = component;
          else components.push(component);
          chosen.push(selection);
          selectedNames.push(label);
        } else {
          blocked = true;
          omittedNames.push(label);
        }
      });
      return chosen;
    };

    const core = [{ text: portrayalRules(), type: "rules", order: -1 }];
    const focusAnchors = [
      { text: outerAnchor(focus), type: "outer", ownerKey: focus.key, order: 0 },
      { text: innerAnchor(focus), type: "inner", ownerKey: focus.key, order: 2 }
    ];
    if (!addGroup(core.concat(focusAnchors))) {
      const compactAnchors = [
        { text: compactOperationOuterAnchor(focus), type: "outer", ownerKey: focus.key, order: 0 },
        { text: compactOperationInnerAnchor(focus), type: "inner", ownerKey: focus.key, order: 2 }
      ].filter(component => component.text);
      const compactCore = core.concat(compactAnchors);
      const completeCompactPair = compactAnchors.length === 2;
      const compactFit = completeCompactPair && (operationCandidateReady || appendOnlyContext)
        ? composition(compactCore, tail)
        : { ok: false };
      const emergencyAnchors = appendOnlyContext ? [
        { text: emergencyPortrayalOuterAnchor(focus), type: "outer", ownerKey: focus.key, order: 0 },
        { text: emergencyPortrayalInnerAnchor(focus), type: "inner", ownerKey: focus.key, order: 2 }
      ].filter(component => component.text) : [];
      const emergencyCore = [
        { text: emergencyPortrayalRules(), type: "rules", order: -1 }
      ].concat(emergencyAnchors);
      const completeEmergencyPair = emergencyAnchors.length === 2;
      const emergencyFit = !compactFit.ok && appendOnlyContext && completeEmergencyPair
        ? composition(emergencyCore, tail)
        : { ok: false };
      if (!compactFit.ok && !emergencyFit.ok) {
        return {
          ok: false,
          reason: "Neither the full nor a complete compact focused portrayal could fit safely.",
          ...capacity,
          effectiveBudget: continuityEffectiveBudget,
          recentChars
        };
      }
      const selectedCore = compactFit.ok ? compactCore : emergencyCore;
      portrayalTier = compactFit.ok ? "compact" : "emergency";
      components.push(...selectedCore);
      compactFocusCoreUsed = true;
      compactFocusRequiresTask = !appendOnlyContext;
      compactPortrayalFallbackUsed = appendOnlyContext && portrayalTier === "compact";
      emergencyPortrayalFallbackUsed = appendOnlyContext && portrayalTier === "emergency";
      cacheLimitedPortrayal = appendOnlyContext;
      CC.last.modelOmitted.push(focus.name + (portrayalTier === "emergency"
        ? " emergency portrayal core used for cache-limited portrayal"
        : (appendOnlyContext
          ? " compact Outer/Inner used for cache-limited portrayal"
          : " compact Outer/Inner reserved for the operation turn")));
    }
    modelActive.push(focus);
    addTurningPointStages(focus);

    active.filter(character => character.key !== focus.key).forEach(character => {
      const pair = [
        { text: outerAnchor(character), type: "outer", ownerKey: character.key, order: 0 },
        { text: innerAnchor(character), type: "inner", ownerKey: character.key, order: 2 }
      ];
      if (addGroup(pair)) {
        modelActive.push(character);
        addTurningPointStages(character);
      } else CC.last.modelOmitted.push(character.name + " Outer/Inner pair");
    });

    const playerNamesIdentity = nameIdentityForKey("player");
    if (playerNamesIdentity) addNamesProjection(playerNamesIdentity, focus.key, 3, "player");
    const focusNamesIdentity = nameIdentityForKey("npc:" + focus.key);
    if (focusNamesIdentity) addNamesProjection(focusNamesIdentity, focus.key, 3, "focus:" + focus.key);

    const focusState = temporaryStateLine(focus);
    if (focusState && !addGroup([{ text: focusState, type: "state", ownerKey: focus.key, order: 3 }])) {
      CC.last.modelOmitted.push(focus.name + " current State");
    }

    const frozenEvidenceIds = (plan.retry || plan.pendingOperationRetry)
      && Array.isArray(plan.retryEvidenceIds) && plan.retryEvidenceIds.length
      ? plan.retryEvidenceIds
      : (operationOpportunityFrozen(plan) && Array.isArray(plan.evidenceIds) ? plan.evidenceIds : []);
    const frozenEvidenceEligibility = (plan.retry || plan.pendingOperationRetry) && plan.retryEvidenceEligibility
      ? plan.retryEvidenceEligibility
      : (operationOpportunityFrozen(plan) && plan.evidenceEligibility ? plan.evidenceEligibility : null);
    const frozenOpportunity = operationOpportunityFrozen(plan) && Number.isFinite(Number(plan.ownerOpportunity))
      ? Math.max(0, Number(plan.ownerOpportunity) - 1)
      : null;
    const allEvidence = availableEvidence(
      focus,
      recent,
      plan.inputEvidenceId || "",
      frozenEvidenceIds,
      frozenOpportunity,
      frozenEvidenceEligibility
    );
    const focusRelationshipSelections = relevantRelationshipRecords(focus, modelActive, currentInput, recent);
    const selectedFocusRelationships = [];
    focusRelationshipSelections.forEach(selection => {
      if (selectedFocusRelationships.length >= 2) {
        omittedRelationships.push(focus.name + "→" + modelRelationshipTargetName(selection.record));
        return;
      }
      const next = selectedFocusRelationships.concat(selection);
      const block = renderRelevantRelationshipsBlock(focus, next);
      const priorIndex = components.findIndex(component => component.focusRelationships === true);
      const candidateComponents = components.slice();
      const component = {
        text: block,
        type: "relationships",
        ownerKey: focus.key,
        order: 4,
        focusRelationships: true
      };
      if (priorIndex >= 0) candidateComponents[priorIndex] = component;
      else candidateComponents.push(component);
      const fit = composition(candidateComponents, tail);
      if (fit.ok) {
        if (priorIndex >= 0) components[priorIndex] = component;
        else components.push(component);
        selectedFocusRelationships.push(selection);
        selectedRelationships.push(focus.name + "→" + modelRelationshipTargetName(selection.record));
      } else {
        omittedRelationships.push(focus.name + "→" + modelRelationshipTargetName(selection.record));
      }
    });
    const focusExperience = relevantExperienceRecords(focus, currentInput, recent, allEvidence)[0] || null;
    if (focusExperience) {
      const block = renderRelevantExperienceBlock(focus, focusExperience);
      if (addGroup([{ text: block, type: "experiences", ownerKey: focus.key, order: 6 }])) {
        selectedExperiences.push(focus.name + "→"
          + modelTargetName(focusExperience.record.targetKey, focusExperience.record.targetName));
      } else {
        omittedExperiences.push(focus.name + "→"
          + modelTargetName(focusExperience.record.targetKey, focusExperience.record.targetName));
      }
    }
    const focusActiveSelections = relevantViewRecords(focus, modelActive, currentInput, recent, allEvidence, false);
    const focusBuriedSelections = relevantViewRecords(focus, modelActive, currentInput, recent, allEvidence, true);
    const recoveredBlocks = relevantRecoveredBlocks(focus, focusActiveSelections, focusBuriedSelections);
    const selectedRecoveredTargets = new Set();
    let recoveredBlocked = false;
    recoveredBlocks.forEach(block => {
      if (!recoveredBlocked && addGroup([{ text: block.text, type: "views", ownerKey: focus.key, order: 5 }])) {
        selectedRecoveredTargets.add(block.targetKey);
        selectedViews.push(focus.name + " recovered " + block.targetKey);
      } else {
        recoveredBlocked = true;
        omittedViews.push(focus.name + " recovered " + block.targetKey);
      }
    });

    const normalFocusSelections = focusActiveSelections.filter(item => !recoveringMarker(focus.key, item.record.targetKey));
    const selectedFocusSelections = [];
    let focusViewsBlocked = false;
    normalFocusSelections.forEach(selection => {
      if (focusViewsBlocked) {
        omittedViews.push(focus.name + "→" + modelViewTargetName(selection.record));
        return;
      }
      const candidateSelections = selectedFocusSelections.concat(selection);
      const block = renderRelevantViewsBlock(focus, candidateSelections);
      const priorIndex = components.findIndex(component => component.focusViews === true);
      const candidateComponents = components.slice();
      const component = { text: block, type: "views", ownerKey: focus.key, order: 5, focusViews: true };
      if (priorIndex >= 0) candidateComponents[priorIndex] = component;
      else candidateComponents.push(component);
      const fit = composition(candidateComponents, tail);
      if (fit.ok) {
        if (priorIndex >= 0) components[priorIndex] = component;
        else components.push(component);
        selectedFocusSelections.push(selection);
        selectedViews.push(focus.name + "→" + modelViewTargetName(selection.record));
      } else {
        focusViewsBlocked = true;
        omittedViews.push(focus.name + "→" + modelViewTargetName(selection.record));
      }
    });

    const contextVisibleFocusSelections = selectedFocusSelections.concat(
      focusActiveSelections.filter(item => selectedRecoveredTargets.has(item.record.targetKey))
    );
    const contextVisibleKeys = new Set(contextVisibleFocusSelections.map(item => item.record.targetKey));
    const hiddenRelevantKeys = new Set(
      focusActiveSelections.map(item => item.record.targetKey).filter(key => !contextVisibleKeys.has(key))
    );
    const visibleRelationshipKeys = new Set(selectedFocusRelationships.map(item => item.record.targetKey));
    const hiddenRelationshipKeys = new Set(
      focusRelationshipSelections.map(item => item.record.targetKey).filter(key => !visibleRelationshipKeys.has(key))
    );
    let targets = operationTargetMap(
      focus,
      modelActive,
      contextVisibleFocusSelections,
      focusBuriedSelections,
      selectedFocusRelationships,
      currentInput,
      allEvidence,
      recent
    ).filter(target => !hiddenRelevantKeys.has(target.key))
      .filter(target => target.mode !== "recovering" || selectedRecoveredTargets.has(target.key))
      .map(target => hiddenRelationshipKeys.has(target.key) ? { ...target, relationship: false } : target);
    if ((plan.retry || plan.pendingOperationRetry)
      && Array.isArray(plan.retryTargets) && plan.retryTargets.length) targets = clone(plan.retryTargets);
    else if (operationOpportunityFrozen(plan) && Array.isArray(plan.targets) && plan.targets.length) targets = clone(plan.targets);
    else if (plan.operationSelectionFrozen === true
      && Array.isArray(plan.routingTargets) && plan.routingTargets.length) targets = clone(plan.routingTargets);
    const selectedOperationKind = TASK_OPERATION_KINDS.includes(keyOf(plan.selectedOperationKind))
      ? keyOf(plan.selectedOperationKind)
      : "";
    const operationTaskTokenBudget = Math.min(
      continuityEffectiveBudget,
      settings.MAX_OPERATION_TASK_TOKENS
    );
    if (selectedOperationKind !== ASSESSMENT_OPERATION_KIND) {
      targets = operationTargetsForKind(selectedOperationKind, targets);
    }
    const selectedOperationTargetKey = normalizedTargetKey(
      plan.selectedCandidate && plan.selectedCandidate.targetKey
    );
    if (selectedOperationTargetKey && selectedOperationKind !== ASSESSMENT_OPERATION_KIND) {
      if (selectedOperationKind === "name") {
        targets = targets.slice().sort((left, right) => {
          const leftSelected = normalizedTargetKey(left.key) === selectedOperationTargetKey ? 0 : 1;
          const rightSelected = normalizedTargetKey(right.key) === selectedOperationTargetKey ? 0 : 1;
          return leftSelected - rightSelected;
        });
      } else {
        targets = targets.filter(target => normalizedTargetKey(target.key) === selectedOperationTargetKey);
      }
    }
    const frozenDerivedPacket = (plan.retry || plan.pendingOperationRetry) && Array.isArray(plan.retrySourcePacket)
      ? plan.retrySourcePacket
      : (operationOpportunityFrozen(plan) && Array.isArray(plan.sourcePacket) ? plan.sourcePacket : null);
    const derivedRelationshipEvidence = selectedOperationKind === "relationship"
      ? relationshipDerivedEvidenceCandidates(focus, targets, frozenOpportunity, frozenDerivedPacket)
      : [];
    const derivedViewEvidence = selectedOperationKind === "view"
      ? viewDerivedEvidenceCandidates(focus, targets, frozenOpportunity, frozenDerivedPacket)
      : [];
    const assessmentSources = selectedOperationKind === ASSESSMENT_OPERATION_KIND
      ? semanticAssessmentEvidence(
        focus,
        recent,
        plan.inputEvidenceId || "",
        frozenEvidenceIds,
        frozenOpportunity
      )
      : [];
    const operationSources = selectedOperationKind === ASSESSMENT_OPERATION_KIND
      ? assessmentSources
      : allEvidence.concat(derivedRelationshipEvidence, derivedViewEvidence);
    const frozenTaskEvidenceIds = (plan.retry || plan.pendingOperationRetry)
      && Array.isArray(plan.retryEvidenceIds) && plan.retryEvidenceIds.length
      ? plan.retryEvidenceIds
      : (operationOpportunityFrozen(plan) && Array.isArray(plan.evidenceIds) ? plan.evidenceIds : []);
    const operationEvidence = selectedOperationKind === ASSESSMENT_OPERATION_KIND
      ? operationSources.filter(candidate => operationPacketSourceIds(
        selectedOperationKind,
        plan.selectedCandidate,
        frozenTaskEvidenceIds
      ).includes(candidate.item.id))
      : operationEvidenceCandidatesForKind(
        selectedOperationKind,
        operationSources,
        plan.selectedCandidate,
        frozenTaskEvidenceIds
      );

    const fitOperationByEvictingOptionalContext = proposedTail => {
      const proposedFrontInstruction = operationFrontMemoryInstruction();
      let working = components.slice();
      let fit = composition(working, proposedTail, false, proposedFrontInstruction);
      if (fit.ok) return fit;
      const groups = [];
      const grouped = new Set();
      const pushGroup = group => {
        const usable = group.filter(component => component && !grouped.has(component));
        if (!usable.length) return;
        usable.forEach(component => grouped.add(component));
        groups.push(usable);
      };
      modelActive.filter(character => character.key !== focus.key).slice().reverse().forEach(character => {
        pushGroup(working.filter(component => component.ownerKey === character.key
          && (component.type === "outer" || component.type === "inner"
            || component.type === "turningPoints" || component.type === "turningPointAuthority")));
      });
      const namesComponents = working.filter(component => component.type === "names");
      const componentAliases = component => (textOf(component.text).match(/^Alias:\s*(.+)$/gmi) || [])
        .map(value => line(value.replace(/^Alias:\s*/i, ""), 160));
      const namesMentioned = component => {
        return componentAliases(component).some(alias => aliasMentioned(currentInput, alias));
      };
      namesComponents.filter(component => !namesMentioned(component)).forEach(component => pushGroup([component]));
      working.filter(component => component.ownerKey === focus.key && component.type === "state")
        .forEach(component => pushGroup([component]));
      working.filter(component => component.ownerKey === focus.key && component.type === "experiences")
        .forEach(component => pushGroup([component]));
      working.filter(component => component.type === "relationships" || component.type === "views")
        .forEach(component => pushGroup([component]));
      namesComponents.filter(namesMentioned).forEach(component => pushGroup([component]));
      working.filter(component => component.type !== "rules" && component.type !== "turningPointAuthority"
        && !(component.ownerKey === focus.key && ["outer", "inner"].includes(component.type)))
        .forEach(component => pushGroup([component]));

      const commitWorking = (next, focusTier) => {
        const kept = new Set(next);
        const removed = components.filter(component => !kept.has(component));
        const removedProfileKeys = new Set(removed
          .filter(component => component.type === "outer" || component.type === "inner")
          .map(component => component.ownerKey));
        removedProfileKeys.forEach(ownerKey => {
          const character = modelActive.find(item => item.key === ownerKey);
          if (!character || character.key === focus.key) return;
          const index = modelActive.indexOf(character);
          if (index >= 0) modelActive.splice(index, 1);
          const turningPointPrefix = character.name + "→";
          selectedTurningPoints.slice().filter(label => label.startsWith(turningPointPrefix)).forEach(label => {
            const selectedIndex = selectedTurningPoints.indexOf(label);
            if (selectedIndex >= 0) selectedTurningPoints.splice(selectedIndex, 1);
            addOmittedTurningPoint(label, "", true);
          });
          const label = character.name + " Outer/Inner pair (reserved operation packet)";
          if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
        });
        removed.filter(component => component.type === "names").forEach(component => {
          const canonical = extractLine(component.text, "Canonical");
          componentAliases(component).forEach(alias => {
            const selected = selectedNames.find(label => label === canonical + "→" + alias);
            if (!selected) return;
            const index = selectedNames.indexOf(selected);
            if (index >= 0) selectedNames.splice(index, 1);
            if (!omittedNames.includes(selected)) omittedNames.push(selected);
          });
        });
        removed.filter(component => component.type === "state").forEach(component => {
          const character = characters.find(item => item.key === component.ownerKey);
          const label = (character ? character.name : component.ownerKey)
            + " current State (reserved operation packet)";
          if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
        });
        removed.filter(component => component.type === "turningPoints").forEach(component => {
          (Array.isArray(component.turningPointLabels) ? component.turningPointLabels : []).forEach(label => {
            const index = selectedTurningPoints.indexOf(label);
            if (index >= 0) selectedTurningPoints.splice(index, 1);
            addOmittedTurningPoint(label, "", true);
          });
        });
        removed.filter(component => component.type === "turningPointAuthority").forEach(component => {
          (Array.isArray(component.turningPointLabels) ? component.turningPointLabels : []).forEach(label => {
            const index = selectedTurningPoints.indexOf(label);
            if (index < 0) return;
            selectedTurningPoints.splice(index, 1);
            addOmittedTurningPoint(label, "current-stage authority removed", true);
          });
        });
        const moveOwnerLabels = (type, selectedList, omittedList, suffix) => {
          const ownerKeys = new Set(removed.filter(component => component.type === type)
            .map(component => component.ownerKey));
          ownerKeys.forEach(ownerKey => {
            const character = characters.find(item => item.key === ownerKey);
            const name = character ? character.name : ownerKey;
            selectedList.slice().filter(label => label.startsWith(name + "→")
              || label.startsWith(name + " recovered ")).forEach(label => {
              const index = selectedList.indexOf(label);
              if (index >= 0) selectedList.splice(index, 1);
              if (!omittedList.includes(label)) omittedList.push(label);
            });
            const diagnostic = name + " " + suffix + " (reserved operation packet)";
            if (!CC.last.modelOmitted.includes(diagnostic)) CC.last.modelOmitted.push(diagnostic);
          });
        };
        moveOwnerLabels("relationships", selectedRelationships, omittedRelationships, "Relationship projection");
        moveOwnerLabels("views", selectedViews, omittedViews, "View projection");
        removed.filter(component => component.type === "experiences").forEach(component => {
          const character = characters.find(item => item.key === component.ownerKey);
          const prefix = (character ? character.name : component.ownerKey) + "→";
          selectedExperiences.filter(label => label.startsWith(prefix)).forEach(label => {
            const index = selectedExperiences.indexOf(label);
            if (index >= 0) selectedExperiences.splice(index, 1);
            if (!omittedExperiences.includes(label)) omittedExperiences.push(label);
          });
        });
        if (focusTier) {
          if (!compactFocusCoreUsed) {
            const label = focus.name + (focusTier === "emergency"
              ? " emergency portrayal core used for the operation turn"
              : (appendOnlyContext
                ? " compact Outer/Inner used for cache-limited portrayal"
                : " compact Outer/Inner used for the operation turn"));
            if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
          }
          compactFocusCoreUsed = true;
          portrayalTier = focusTier;
          compactPortrayalFallbackUsed = appendOnlyContext && focusTier === "compact";
          emergencyPortrayalFallbackUsed = appendOnlyContext && focusTier === "emergency";
          if (!appendOnlyContext) compactFocusRequiresTask = true;
          if (appendOnlyContext) cacheLimitedPortrayal = true;
        }
        components.splice(0, components.length, ...next);
      };

      for (const group of groups) {
        const removable = new Set(group);
        working = working.filter(component => !removable.has(component));
        fit = composition(working, proposedTail, false, proposedFrontInstruction);
        if (!fit.ok) continue;
        commitWorking(working, "");
        return fit;
      }

      if (portrayalTier !== "emergency") {
        const compactPair = [
          { text: compactOperationOuterAnchor(focus), type: "outer", ownerKey: focus.key, order: 0 },
          { text: compactOperationInnerAnchor(focus), type: "inner", ownerKey: focus.key, order: 2 }
        ].filter(component => component.text);
        const compactWorking = working.filter(component => !(
          component.ownerKey === focus.key && ["outer", "inner"].includes(component.type)
        )).concat(compactPair);
        fit = compactPair.length === 2
          ? composition(compactWorking, proposedTail, false, proposedFrontInstruction)
          : { ok: false, reason: "complete compact Outer/Inner pair" };
        if (fit.ok) {
          commitWorking(compactWorking, "compact");
          return fit;
        }
      }

      if (appendOnlyContext) {
        const emergencyPair = [
          { text: emergencyPortrayalOuterAnchor(focus), type: "outer", ownerKey: focus.key, order: 0 },
          { text: emergencyPortrayalInnerAnchor(focus), type: "inner", ownerKey: focus.key, order: 2 }
        ].filter(component => component.text);
        const emergencyWorking = working.filter(component => component.type !== "rules" && !(
          component.ownerKey === focus.key && ["outer", "inner"].includes(component.type)
        )).concat(
          { text: emergencyPortrayalRules(), type: "rules", order: -1 },
          ...emergencyPair
        );
        fit = emergencyPair.length === 2
          ? composition(emergencyWorking, proposedTail, false, proposedFrontInstruction)
          : { ok: false, reason: "complete emergency Outer/Inner pair" };
        if (fit.ok) {
          commitWorking(emergencyWorking, "emergency");
          return fit;
        }
      }
      return fit;
    };

    let selectedEvidence = [];
    let taskDelivered = false;
    let taskDeferredReason = "";
    scrubLegacyOperationTaskText(plan);
    const retryTaskText = (plan.retry || plan.pendingOperationRetry) && textOf(plan.retryOperationTaskText).trim()
      ? positiveOperationRetryTask(plan.retryOperationTaskText)
      : "";
    const selectedSourceIds = operationPacketSourceIds(
      selectedOperationKind,
      plan.selectedCandidate,
      frozenTaskEvidenceIds
    );
    const requiredEvidence = operationEvidence.filter(candidate => selectedSourceIds.includes(candidate.item.id));
    const selectedTargetAvailable = !!(
      plan.selectedCandidate && targets.some(target =>
        normalizedTargetKey(target.key) === normalizedTargetKey(plan.selectedCandidate.targetKey)
      )
    );
    if (plan.opportunity && !CC.recoveryPending && selectedOperationKind && retryTaskText) {
      const retryEvidence = operationEvidence.slice();
      const retryWithinTaskBudget = estimateTokens(retryTaskText) <= operationTaskTokenBudget;
      if (!retryWithinTaskBudget) {
        taskDeferredReason = "The frozen Retry task exceeded the operation task budget.";
      } else if (!targets.length) {
        taskDeferredReason = "No legal target was available for the frozen Retry operation kind.";
      } else if (!selectedTargetAvailable) {
        taskDeferredReason = "The frozen Retry operation target was unavailable in the legal target map.";
      } else if (!retryEvidence.length || requiredEvidence.length !== selectedSourceIds.length) {
        taskDeferredReason = "The frozen Retry evidence is no longer available or eligible under the current rules.";
      } else {
        const fit = fitOperationByEvictingOptionalContext(retryTaskText);
        if (fit.ok) {
          selectedEvidence = retryEvidence;
          tail = retryTaskText;
          taskDelivered = true;
        } else {
          taskDeferredReason = "The frozen operation-specific Retry packet did not fit safely.";
        }
      }
    } else if (plan.opportunity && !CC.recoveryPending && selectedOperationKind
      && operationEvidence.length && targets.length && selectedTargetAvailable
      && requiredEvidence.length === selectedSourceIds.length) {
      let proposedEvidence = requiredEvidence.length ? requiredEvidence : [operationEvidence[0]];
      let proposedTail = selectedOperationKind === ASSESSMENT_OPERATION_KIND
        ? semanticAssessmentTask(focus, targets, proposedEvidence)
        : operationTaskForKind(
          selectedOperationKind, focus, targets, proposedEvidence, plan.inputEvidenceId || "", recent,
          plan.relationshipPace || runtime.relationshipPace, plan.selectedCandidate
        );
      const completeTaskAvailable = !!textOf(proposedTail).trim();
      const taskWithinBudget = completeTaskAvailable
        && estimateTokens(proposedTail) <= operationTaskTokenBudget;
      const fit = taskWithinBudget
        ? fitOperationByEvictingOptionalContext(proposedTail)
        : { ok: false, reason: "operation task budget" };
      if (fit.ok && taskWithinBudget) {
        selectedEvidence = proposedEvidence;
        tail = proposedTail;
        taskDelivered = true;
      } else taskDeferredReason = completeTaskAvailable
        ? "The complete " + (selectedOperationKind === ASSESSMENT_OPERATION_KIND
          ? "semantic assessment"
          : "operation-specific") + " packet did not fit safely."
        : (selectedOperationKind === ASSESSMENT_OPERATION_KIND
          ? "No complete semantic assessment contract could be constructed from the supplied mechanics."
          : "The selected candidate no longer matched an explicit scripted operation template.");
    } else if (plan.opportunity && !CC.recoveryPending && !selectedOperationKind) {
      taskDeferredReason = "No unreviewed completed evidence remained eligible for semantic assessment.";
    } else if (plan.opportunity && !CC.recoveryPending && selectedOperationKind && !targets.length) {
      taskDeferredReason = "No legal target was available for the frozen operation kind.";
    } else if (plan.opportunity && !CC.recoveryPending && selectedOperationKind && !selectedTargetAvailable) {
      taskDeferredReason = "The frozen operation target was unavailable in the legal target map.";
    } else if (plan.opportunity && !CC.recoveryPending && selectedOperationKind
      && requiredEvidence.length !== selectedSourceIds.length) {
      taskDeferredReason = "The frozen operation evidence was unavailable or ineligible.";
    } else if (plan.opportunity && !CC.recoveryPending) {
      taskDeferredReason = "No eligible completed evidence was available for the frozen operation kind.";
    }

    if (taskDelivered) frontInstruction = operationFrontMemoryInstruction();

    modelActive.filter(character => character.key !== focus.key).forEach(character => {
      const stateBlock = temporaryStateLine(character);
      if (stateBlock && !addGroup([{ text: stateBlock, type: "state", ownerKey: character.key, order: 3 }])) {
        CC.last.modelOmitted.push(character.name + " current State");
      }
      const namesIdentity = nameIdentityForKey("npc:" + character.key);
      if (namesIdentity) addNamesProjection(namesIdentity, character.key, 2, "other:" + character.key);
      const evidence = availableEvidence(character, recent, plan.inputEvidenceId || "");
      const relationships = relevantRelationshipRecords(character, modelActive, currentInput, recent);
      if (relationships.length) {
        const selection = relationships[0];
        const block = renderRelevantRelationshipsBlock(character, [selection]);
        if (addGroup([{
          text: block,
          type: "relationships",
          ownerKey: character.key,
          order: 4,
          otherRelationshipsOwner: character.key
        }])) {
          selectedRelationships.push(character.name + "→" + modelRelationshipTargetName(selection.record));
        } else {
          omittedRelationships.push(character.name + "→" + modelRelationshipTargetName(selection.record));
        }
        relationships.slice(1).forEach(item => omittedRelationships.push(
          character.name + "→" + modelRelationshipTargetName(item.record)
        ));
      }
      const experience = relevantExperienceRecords(character, currentInput, recent, evidence)[0] || null;
      if (experience) {
        const block = renderRelevantExperienceBlock(character, experience);
        if (addGroup([{ text: block, type: "experiences", ownerKey: character.key, order: 6 }])) {
          selectedExperiences.push(character.name + "→"
            + modelTargetName(experience.record.targetKey, experience.record.targetName));
        } else {
          omittedExperiences.push(character.name + "→"
            + modelTargetName(experience.record.targetKey, experience.record.targetName));
        }
      }
      const activeSelections = relevantViewRecords(character, modelActive, currentInput, recent, evidence, false);
      const buriedSelections = relevantViewRecords(character, modelActive, currentInput, recent, evidence, true);
      relevantRecoveredBlocks(character, activeSelections, buriedSelections).forEach(block => {
        if (addGroup([{ text: block.text, type: "views", ownerKey: character.key, order: 5 }])) selectedViews.push(character.name + " recovered " + block.targetKey);
        else omittedViews.push(character.name + " recovered " + block.targetKey);
      });
      const normal = activeSelections.filter(item => !recoveringMarker(character.key, item.record.targetKey));
      const chosen = [];
      let otherViewsBlocked = false;
      normal.forEach(selection => {
        if (otherViewsBlocked) {
          omittedViews.push(character.name + "→" + modelViewTargetName(selection.record));
          return;
        }
        const next = chosen.concat(selection);
        const block = renderRelevantViewsBlock(character, next);
        const index = components.findIndex(component => component.otherViewsOwner === character.key);
        const candidate = components.slice();
        const component = { text: block, type: "views", ownerKey: character.key, order: 5, otherViewsOwner: character.key };
        if (index >= 0) candidate[index] = component;
        else candidate.push(component);
        const fit = composition(candidate, tail);
        if (fit.ok) {
          if (index >= 0) components[index] = component;
          else components.push(component);
          chosen.push(selection);
          selectedViews.push(character.name + "→" + modelViewTargetName(selection.record));
        } else {
          otherViewsBlocked = true;
          omittedViews.push(character.name + "→" + modelViewTargetName(selection.record));
        }
      });
    });

    omittedNames.forEach(item => {
      const label = item + " Name projection";
      if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
    });
    omittedRelationships.forEach(item => {
      const label = item + " Relationship projection";
      if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
    });
    omittedViews.forEach(item => {
      const label = item + " View projection";
      if (!CC.last.modelOmitted.includes(label)) CC.last.modelOmitted.push(label);
    });

    if (compactFocusRequiresTask && !taskDelivered) {
      return {
        ok: false,
        reason: taskDeferredReason || "The compact operation packet was unavailable.",
        ...capacity,
        effectiveBudget: continuityEffectiveBudget,
        recentChars
      };
    }

    const ownerOrder = new Map(modelActive.map((character, index) => [character.key, index]));
    const orderedComponents = components.map((component, index) => ({ ...component, insertionOrder: index }))
      .sort((left, right) => {
        if (left.type === "rules" || right.type === "rules") {
          return left.type === right.type ? left.insertionOrder - right.insertionOrder : (left.type === "rules" ? -1 : 1);
        }
        const leftOwner = ownerOrder.has(left.ownerKey) ? ownerOrder.get(left.ownerKey) : Number.MAX_SAFE_INTEGER;
        const rightOwner = ownerOrder.has(right.ownerKey) ? ownerOrder.get(right.ownerKey) : Number.MAX_SAFE_INTEGER;
        return leftOwner - rightOwner || (left.order ?? 99) - (right.order ?? 99)
          || left.insertionOrder - right.insertionOrder;
      });
    const final = composition(orderedComponents, tail, true);
    if (!final.ok) return {
      ok: false,
      reason: final.reason,
      ...capacity,
      effectiveBudget: continuityEffectiveBudget,
      recentChars
    };
    const byType = type => estimateTokens(orderedComponents.filter(component => component.type === type)
      .map(component => component.text).join("\n"));
    return {
      ok: true,
      text: final.fitted.text,
      taskDelivered,
      taskDeferredReason,
      cacheLimitedPortrayal,
      compactPortrayalFallbackUsed,
      emergencyPortrayalFallbackUsed,
      portrayalTier,
      targets,
      evidenceCandidates: selectedEvidence,
      evidenceIds: selectedEvidence.map(candidate => candidate.item.id),
      modelActive,
      selectedNames,
      omittedNames,
      selectedRelationships,
      omittedRelationships,
      selectedTurningPoints,
      omittedTurningPoints,
      selectedViews,
      omittedViews,
      selectedExperiences,
      omittedExperiences,
      tokens: final.tokens,
      rulesTokens: controlOnly ? 0 : byType("rules"),
      outerTokens: controlOnly ? 0 : byType("outer"),
      namesTokens: controlOnly ? 0 : byType("names"),
      innerTokens: controlOnly ? 0 : byType("inner"),
      stateTokens: controlOnly ? 0 : byType("state"),
      relationshipsTokens: controlOnly ? 0 : byType("relationships"),
      turningPointsTokens: controlOnly ? 0 : byType("turningPoints") + byType("turningPointAuthority"),
      viewsTokens: controlOnly ? 0 : byType("views"),
      experiencesTokens: controlOnly ? 0 : byType("experiences"),
      evidenceTokens: taskDelivered ? estimateTokens(
        selectedOperationKind === ASSESSMENT_OPERATION_KIND
          ? selectedEvidence.map(candidate => candidate.item.id + "["
            + assessmentEvidenceCodes(candidate).join("") + "]: "
            + operationEvidenceSnippet(focus, null, "", candidate.item.text, null)).join("\n")
          : evidencePacketForKind(
            focus, selectedOperationKind, selectedEvidence, plan.inputEvidenceId || "", recent,
            targets[0] || null, plan.selectedCandidate
          )
      ) : 0,
      taskTokens: estimateTokens(tail),
      taskText: taskDelivered ? tail : "",
      frontTaskText: frontInstruction,
      taskKind: taskDelivered ? selectedOperationKind : "",
      operationEvidenceSignature: taskDelivered && plan.selectedCandidate
        ? operationEvidenceSignature(plan.selectedCandidate, selectedEvidence.map(candidate => candidate.item))
        : "",
      ...capacity,
      effectiveBudget: continuityEffectiveBudget,
      headroom: Math.max(0, continuityEffectiveBudget - final.tokens),
      recentChars: final.fitted.recentChars
    };
  }

  function modelProjectionTitle(character) {
    return settings.MODEL_CARD_TITLE_PREFIX + character.name;
  }

  function modelProjectionMarker(character) {
    return settings.MODEL_CARD_KEY_PREFIX
      + hashString("model-projection\u241f" + character.key).padStart(8, "0").toUpperCase();
  }

  function modelProjectionMarkerFromCard(card) {
    return textOf(card && card.keys).split(",").map(value => value.trim())
      .find(value => value.startsWith(settings.MODEL_CARD_KEY_PREFIX)) || "";
  }

  function modelProjectionTriggers(character, currentInput, recent) {
    const identity = nameIdentityForKey("npc:" + character.key);
    if (!identity) return [character.name];
    const identityData = namesForIdentity(identity.key);
    const records = identityData && identityData.contextRecords || [];
    const activeAliases = records
      .filter(record => record.status === "Active"
        && (record.use && record.use.permissions || []).some(permission => permission.key !== "none"))
      .map(record => record.alias);
    const mentionedManagedForms = records.filter(record =>
      aliasMentioned([currentInput, recent].filter(Boolean).join("\n"), record.alias)
    ).map(record => record.alias);
    const forms = uniqueNameForms(
      [character.name].concat(mentionedManagedForms, activeAliases),
      160
    ).filter(form => {
      if (!form || form.includes(",")) return false;
      const matches = identityReferenceMatches(form, false);
      return matches.length === 1 && matches[0].key === identity.key;
    });
    return unique(forms, 160)
      .filter(form => form && !form.includes(","))
      .slice(0, settings.MAX_MODEL_CARD_TRIGGERS);
  }

  function projectionNameSelections(character, currentInput, recent, active) {
    const identity = nameIdentityForKey("npc:" + character.key);
    const identityData = identity ? namesForIdentity(identity.key) : null;
    if (!identity || !identityData) return { identity, selections: [] };
    const ranked = relevantNameRecords(identity, currentInput, recent, active);
    const fallbackPriority = { Rejected: 0, Emerging: 1, Active: 2, Retired: 3 };
    const fallback = identityData.contextRecords.slice().sort((left, right) =>
      (fallbackPriority[left.status] ?? 9) - (fallbackPriority[right.status] ?? 9)
        || left.page - right.page || left.line - right.line
    ).map(record => ({ record, score: 0 }));
    const selections = [];
    ranked.concat(fallback).forEach(selection => {
      if (!selection || !selection.record || selections.length >= 3) return;
      if (!selections.some(item => item.record.aliasKey === selection.record.aliasKey)) selections.push(selection);
    });
    return { identity, selections };
  }

  function projectionRelationshipSelections(character, currentInput, recent, active) {
    const ownerData = relationshipsForOwner(character.key);
    const ranked = relevantRelationshipRecords(character, active, currentInput, recent);
    const fallback = (ownerData && ownerData.contextRecords || []).map(record => ({
      record,
      fields: modelRelationshipFields(record),
      score: record.targetKey === "player" ? 1 : 0
    })).filter(selection => selection.fields.length)
      .sort((left, right) => right.score - left.score || left.record.page - right.record.page
        || left.record.line - right.record.line);
    const selections = [];
    ranked.concat(fallback).forEach(selection => {
      if (!selection || !selection.record || selections.length >= 2) return;
      if (!selections.some(item => item.record.targetKey === selection.record.targetKey)) selections.push(selection);
    });
    return selections;
  }

  function projectionViewSelections(character, currentInput, recent, active) {
    const ownerData = viewsForOwner(character.key);
    const ranked = relevantViewRecords(character, active, currentInput, recent, [], false);
    const fallback = (ownerData && ownerData.activeRecords || []).slice()
      .sort((left, right) => Number(right.targetKey === "player") - Number(left.targetKey === "player")
        || left.page - right.page || left.line - right.line)
      .map(record => ({ record, score: 0 }));
    const selections = [];
    ranked.concat(fallback).forEach(selection => {
      if (!selection || !selection.record || selections.length >= 2) return;
      if (!selections.some(item => item.record.targetKey === selection.record.targetKey)) selections.push(selection);
    });
    return selections;
  }

  function projectionExperienceSelection(character, currentInput, recent) {
    const ownerData = experiencesForOwner(character.key);
    const ranked = relevantExperienceRecords(character, currentInput, recent, []);
    if (ranked.length) return ranked[0];
    const fallback = (ownerData && ownerData.contextRecords || []).slice()
      .sort((left, right) => right.page - left.page || right.line - left.line)[0] || null;
    return fallback ? { record: fallback, score: 0 } : null;
  }

  function projectionTurningPointBlocks(character) {
    const ownerData = turningPointsForOwner(character.key);
    return (ownerData && ownerData.contextRecords || []).map(record => {
      const resolution = turningPointStageCardResolution(record, character, record.progress.stageRecord);
      if (!resolution.ok) return "";
      const guidance = shortenProfileValue(
        extractLine(resolution.entry, "Entry") || resolution.entry.replace(/[{}]/g, " "),
        560
      );
      if (!guidance) return "";
      return [
        "{",
        character.name + "'s current Development:",
        "Arc: " + record.title,
        "Stage: " + record.progress.normalized,
        "Guidance: " + guidance,
        "}"
      ].join("\n");
    }).filter(Boolean).slice(0, 2);
  }

  function modelProjectionEntry(character, currentInput, recent, active) {
    const header = [
      "Character continuity reference for " + character.name + ".",
      "Use it only when " + character.name + " is already present or relevant; this card is not a reason to introduce the character.",
      "Portray an independent perspective and keep private thoughts private unless the character chooses to reveal them. The player alone controls the player's actions, speech, inner life, identity, consent, boundaries, and commitments."
    ].join("\n");
    let anchors = [compactOperationOuterAnchor(character), compactOperationInnerAnchor(character)].filter(Boolean);
    const compactCore = [header].concat(anchors).join("\n\n");
    if (compactCore.length > settings.MAX_MODEL_CARD_CHARS) {
      anchors = [emergencyPortrayalOuterAnchor(character), emergencyPortrayalInnerAnchor(character)].filter(Boolean);
    }
    const blocks = [header].concat(anchors);
    const optional = [];
    const stateBlock = temporaryStateLine(character);
    if (stateBlock) optional.push(stateBlock);
    optional.push(...projectionTurningPointBlocks(character));
    const relationships = projectionRelationshipSelections(character, currentInput, recent, active);
    const relationshipBlock = renderRelevantRelationshipsBlock(character, relationships);
    if (relationshipBlock) optional.push(relationshipBlock);
    const views = projectionViewSelections(character, currentInput, recent, active);
    const viewsBlock = renderRelevantViewsBlock(character, views);
    if (viewsBlock) optional.push(viewsBlock);
    const names = projectionNameSelections(character, currentInput, recent, active);
    const namesBlock = names.identity ? renderRelevantNamesBlock(names.identity, names.selections) : "";
    if (namesBlock) optional.push(namesBlock);
    const experience = projectionExperienceSelection(character, currentInput, recent);
    const experienceBlock = experience ? renderRelevantExperienceBlock(character, experience) : "";
    if (experienceBlock) optional.push(experienceBlock);
    optional.forEach(block => {
      const candidate = blocks.concat(block).join("\n\n");
      if (candidate.length <= settings.MAX_MODEL_CARD_CHARS) blocks.push(block);
    });
    return blocks.join("\n\n");
  }

  function writeModelProjectionCard(character, currentInput, recent, active) {
    const title = modelProjectionTitle(character);
    const marker = modelProjectionMarker(character);
    const triggers = modelProjectionTriggers(character, currentInput, recent);
    const keys = [marker].concat(triggers).join(", ");
    const entry = modelProjectionEntry(character, currentInput, recent, active);
    const markerMatches = currentCardCatalog().records
      .filter(record => modelProjectionMarkerFromCard(record.card) === marker)
      .map(record => record.card);
    const titleConflicts = catalogRecordsByTitle(title)
      .map(record => record.card)
      .filter(card => modelProjectionMarkerFromCard(card) !== marker);
    if (markerMatches.length !== 1 && markerMatches.length !== 0) {
      return { ok: false, label: character.name + " (duplicate generated cards)" };
    }
    if (titleConflicts.length) return { ok: false, label: character.name + " (title conflict)" };
    const current = markerMatches[0] || null;
    const saved = current
      ? updateCardAt(cardIndex(current), keys, entry, settings.MODEL_CARD_TYPE, title, true)
      : addCardExact(title, keys, entry, settings.MODEL_CARD_TYPE);
    if (!saved || !exactCardFieldsMatch(saved, keys, entry, settings.MODEL_CARD_TYPE, title)) {
      return { ok: false, label: character.name + " (write failed)" };
    }
    CC.cardHashes[title] = hashString(entry + "\u241f" + keys);
    return {
      ok: true,
      label: character.name + " " + estimateTokens(entry) + "t / " + triggers.length + " trigger"
        + (triggers.length === 1 ? "" : "s"),
      tokens: estimateTokens(entry)
    };
  }

  function refreshModelProjectionCards(currentInput = "", recent = "") {
    refreshViewsStore(false);
    refreshNamesStore();
    applyManagedNameForms();
    refreshRelationshipsStore();
    refreshTurningPointsStore();
    refreshExperiencesStore(false);
    const eligible = characters.filter(character => !character.onboardingPending);
    const desiredMarkers = new Set(eligible.map(modelProjectionMarker));
    currentCardCatalog().records.filter(record => {
      const marker = modelProjectionMarkerFromCard(record.card);
      return marker && !desiredMarkers.has(marker);
    }).map(record => record.card).sort((left, right) => cardIndex(right) - cardIndex(left))
      .forEach(removeCard);
    const active = (CC.activeKeys || []).map(key => characters.find(character => character.key === key))
      .filter(Boolean);
    const relevanceCast = active.length ? active : eligible.slice(0, runtime.maxActive);
    const results = eligible.map(character =>
      writeModelProjectionCard(character, currentInput, recent, relevanceCast)
    );
    CC.last.projectionCards = results.map(result => result.label);
    CC.last.projectionTokens = results.reduce((total, result) => total + (result.tokens || 0), 0);
    CC.last.portrayalTier = eligible.length ? "story-card" : "none";
    const failed = results.filter(result => !result.ok).map(result => result.label);
    if (failed.length) {
      CC.last.warning = [CC.last.warning, "Model Context card warning: " + failed.join("; ") + "."]
        .filter(Boolean).join(" ");
    }
    return results.every(result => result.ok);
  }

  function controlPresentationText(value) {
    let source = textOf(value).replace(/\r/g, "").trim();
    if (!source) return "";
    source = source
      .replace(/^(?:>\s*)+/, "")
      .replace(/^#{1,6}\s+/, "")
      .replace(/^(?:[-*+]\s+|\d+[.)]\s+)/, "")
      .trim();
    let prior = "";
    while (source && source !== prior) {
      prior = source;
      if ((source.startsWith("**") && source.endsWith("**"))
        || (source.startsWith("__") && source.endsWith("__"))) {
        source = source.slice(2, -2).trim();
      } else if (source.startsWith("`") && source.endsWith("`")
        && !source.startsWith("```") && source.length > 1) {
        source = source.slice(1, -1).trim();
      }
    }
    return source;
  }

  function ccoPresentation(value) {
    const original = textOf(value).replace(/\r/g, "").trim();
    let source = controlPresentationText(original);
    let changed = source !== original;
    const label = source.match(/^(?:Record|(?:Optional\s+)?Final record|Exact final-line State record|(?:State|Name|Relationship|View|Turning Point) record shape|State|Name|Relationship|View|Turning Point|CCO record)\s*:\s*(.+)$/i);
    if (label) {
      source = label[1].trim();
      changed = true;
    }
    const unwrapped = controlPresentationText(source);
    if (unwrapped !== source) changed = true;
    source = unwrapped;

    let numericAnnotation = "";
    const annotation = source.match(/\s+([+-]\d+)\s*$/);
    if (annotation) {
      numericAnnotation = annotation[1];
      source = source.slice(0, annotation.index).trimEnd();
      changed = true;
    }
    const annotationUnwrapped = controlPresentationText(source);
    if (annotationUnwrapped !== source) changed = true;
    source = annotationUnwrapped;

    const squareWrapped = source.match(/^\[\s*(CCO\|[^()[\]{}\r\n]*)\s*\]$/);
    const braceWrapped = source.match(/^\{\s*(CCO\|[^()[\]{}\r\n]*)\s*\}$/);
    if (squareWrapped || braceWrapped) {
      source = (squareWrapped || braceWrapped)[1].trim();
      changed = true;
    }

    const parenthesized = /^\(CCO\|[^()\r\n]*\)$/.test(source);
    const bare = /^CCO\|[^()\r\n]*$/.test(source);
    return {
      original,
      source,
      record: parenthesized ? source : (bare ? "(" + source + ")" : ""),
      bare,
      changed: changed || bare,
      numericAnnotation,
      protocolLike: /^(?:\(\s*)?CCO\s*\|/i.test(source)
        || /^(?:\(\s*)?[SNRVT]\s*\|/i.test(source)
    };
  }

  function bareCcoIndex(value) {
    const source = textOf(value);
    const pattern = /CCO\s*\|/gi;
    let match = pattern.exec(source);
    while (match) {
      let prior = match.index - 1;
      while (prior >= 0 && /\s/.test(source[prior])) prior -= 1;
      if (prior < 0 || source[prior] !== "(") return match.index;
      match = pattern.exec(source);
    }
    return -1;
  }

  function bareCcoOccurrences(value) {
    const source = textOf(value);
    const occurrences = [];
    const pattern = /CCO\s*\|/gi;
    let match = pattern.exec(source);
    while (match) {
      let prior = match.index - 1;
      while (prior >= 0 && /\s/.test(source[prior])) prior -= 1;
      if (prior < 0 || source[prior] !== "(") occurrences.push(match.index);
      match = pattern.exec(source);
    }
    return occurrences;
  }

  function protocolFragmentStart(value) {
    const source = textOf(value);
    const patterns = [
      /\(\s*CCO(?:\s*\||\b)/i,
      /\(\s*[SNRVT]\s*\|/i,
      /(?:^|[^A-Za-z0-9])CCO\s*\|/i
    ];
    let found = -1;
    patterns.forEach(pattern => {
      const match = pattern.exec(source);
      if (match && (found < 0 || match.index < found)) found = match.index;
    });
    return found;
  }

  function terminalPartialCcoPrefix(value) {
    const source = textOf(value).replace(/\r/g, "").trimEnd();
    if (!source) return "";
    const lineStart = source.lastIndexOf("\n") + 1;
    const terminalLine = source.slice(lineStart).trim();
    if (!terminalLine || terminalLine.includes(")")) return "";
    return /^\(\s*(?:C(?:C(?:O(?:\s*(?:\|[^)\r\n]*)?)?)?)?)?$/i.test(terminalLine)
      ? terminalLine
      : "";
  }

  function terminalPartialCcoPresentation(value) {
    const source = textOf(value).replace(/\r/g, "").trimEnd();
    if (!source) return "";
    const lineStart = source.lastIndexOf("\n") + 1;
    const terminalLine = source.slice(lineStart).trim();
    const labels = [
      "Exact final-line State record:", "Optional final record:", "Final record:",
      "State record shape:", "Name record shape:", "Relationship record shape:",
      "View record shape:", "Turning Point record shape:"
    ];
    return labels.some(label => terminalLine.toLowerCase() === label.toLowerCase()
      || (terminalLine.toLowerCase().startsWith(label.toLowerCase())
        && terminalPartialCcoPrefix(terminalLine.slice(label.length).trim())))
      ? terminalLine
      : "";
  }

  function ccoProtocolSpans(value) {
    const source = textOf(value).replace(/\r/g, "");
    const opener = /\(\s*(?:CCO\b|[SNRVT]\s*\|)/gi;
    const spans = [];
    let match = opener.exec(source);
    while (match) {
      const start = match.index;
      let depth = 0;
      let complete = false;
      let end = source.length;
      for (let index = start; index < source.length; index += 1) {
        if (source[index] === "(") depth += 1;
        else if (source[index] === ")") {
          depth -= 1;
          if (depth <= 0) {
            complete = true;
            end = index + 1;
            break;
          }
        }
      }
      spans.push({ start, end, complete, text: source.slice(start, end) });
      if (!complete) break;
      opener.lastIndex = end;
      match = opener.exec(source);
    }
    return spans;
  }

  function stripCcoProtocolSpans(value) {
    const source = textOf(value).replace(/\r/g, "").split("\n").map(rawLine => {
      const presented = ccoPresentation(rawLine);
      return presented.record ? presented.record : rawLine;
    }).join("\n");
    const spans = ccoProtocolSpans(source);
    let cursor = 0;
    let stripped = "";
    spans.forEach(span => {
      stripped += source.slice(cursor, span.start);
      cursor = span.end;
    });
    stripped += source.slice(cursor);
    if (!spans.length && (terminalPartialCcoPrefix(source) || terminalPartialCcoPresentation(source))) {
      const lineStart = stripped.lastIndexOf("\n") + 1;
      stripped = stripped.slice(0, lineStart);
    }
    const labelOnly = /^(?:Record|(?:Optional\s+)?Final record|Exact final-line State record|(?:State|Name|Relationship|View|Turning Point) record shape|State|Name|Relationship|View|Turning Point|CCO record)\s*:\s*$/i;
    return stripped.split("\n").map(rawLine => {
      let result = rawLine;
      const bareIndex = bareCcoIndex(result);
      if (bareIndex >= 0) result = result.slice(0, bareIndex);
      if (labelOnly.test(controlPresentationText(result))) result = "";
      return result.replace(/[ \t]{2,}/g, " ").trimEnd();
    }).join("\n").replace(/\n{3,}/g, "\n\n").trim();
  }

  function terminalProtocolCutoff(value) {
    const source = textOf(value).replace(/\r/g, "").trim();
    if (!source) return false;
    if (terminalPartialCcoPrefix(source) || terminalPartialCcoPresentation(source)) return true;
    const openers = source.match(/\(\s*(?:CCO\b|[SNRVT]\s*\|)/gi) || [];
    const spans = ccoProtocolSpans(source);
    return openers.length === 1 && spans.length === 1 && !spans[0].complete
      && spans[0].end === source.length;
  }

  function operationFallbackTerminalProtocolStart(lines, last) {
    if (!Array.isArray(lines) || last < 0) return -1;
    const source = lines.slice(0, last + 1).map(rawLine => {
      const presented = ccoPresentation(rawLine);
      return presented.record ? presented.record : rawLine;
    }).join("\n");
    const spans = ccoProtocolSpans(source);
    if (spans.length) {
      const finalSpan = spans[spans.length - 1];
      const reachesTail = finalSpan.complete
        ? !source.slice(finalSpan.end).trim()
        : finalSpan.end === source.length;
      if (reachesTail) {
        let suffixStart = spans.length - 1;
        while (suffixStart > 0
          && !source.slice(spans[suffixStart - 1].end, spans[suffixStart].start).trim()) {
          suffixStart -= 1;
        }
        return source.slice(0, spans[suffixStart].start).split("\n").length - 1;
      }
    }
    return terminalPartialCcoPrefix(source) || terminalPartialCcoPresentation(source)
      ? last
      : -1;
  }

  function injectedControlReferenceLines(plan) {
