  }

  function buildContext() {
    resetLastForContext();
    const frontMemory = beginFrontMemoryContext(originalText);
    const commitFrontMemory = (taskText, preparedContext = frontMemory.baseText) => {
      const committed = frontMemory.commit(taskText, preparedContext);
      CC.last.frontMemoryVerified = committed.ok;
      CC.last.frontMemoryMode = committed.delivered
        ? (/STORY RECOVERY/i.test(textOf(taskText)) ? "recovery" : "operation")
        : "clear";
      return committed;
    };
    if (!frontMemory.ok) {
      CC.last.context = "Front Memory suffix could not be identified safely; Character Continuity made no context change.";
      CC.last.error = "The current state.memory.frontMemory value was not found as the actual context suffix.";
      return originalText;
    }
    refreshViewsStore(false);
    refreshNamesStore();
    applyManagedNameForms();
    refreshRelationshipsStore();
    refreshTurningPointsStore();
    refreshExperiencesStore(false);
    const plan = beginContinueIfNeeded(originalText);
    const observedActionCount = platformActionCount();
    if (plan.opportunity === true && !plan.retry && observedActionCount !== null) {
      plan.actionCount = observedActionCount;
    }
    if (!plan.relationshipPace || typeof plan.relationshipPace !== "object") {
      plan.relationshipPace = clone(runtime.relationshipPace);
    }
    const recent = recentStoryFromContext(originalText);
    const currentInput = plan.kind === "input" || plan.retry ? CC.lastInput : "";
    const source = [currentInput, recent].filter(Boolean).join("\n").slice(-16000);
    if (plan.opening) {
      plan.task = "none";
      plan.taskDelivered = false;
      plan.activeKeys = [];
      CC.last.context = "Opening prompt retained; only its immediate automatic output will be suppressed.";
      return commitFrontMemory("").text;
    }
    expireTemporaryState(CC.stateClock);
    if (!plan.retry && plan.inputEvidenceId && plan.inputEvidenceId !== CC.lastTimeJumpEvidenceId && TIME_JUMP.test(currentInput)) {
      resetSceneForTimeJump(plan.inputEvidenceId);
      CC.lastTimeJumpEvidenceId = plan.inputEvidenceId;
    }
    let active = selectActive(source, currentInput, plan);
    if (plan.retry && Array.isArray(plan.retryActiveKeys) && plan.retryActiveKeys.length) {
      const repeated = plan.retryActiveKeys
        .map(key => characters.find(character => character.key === key))
        .filter(Boolean)
        .slice(0, runtime.maxActive);
      if (repeated.length) active = repeated;
    }
    let focus = selectFocus(active, currentInput);
    if (plan.pendingOperationRetry === true
      && (!focus || focus.key !== plan.retryFocusKey
        || !active.some(character => character.key === plan.retryFocusKey))) {
      cancelPendingOperationRetry(plan);
    }
    if (plan.pendingOperationRetry === true && !pendingOperationRetryStillEligible(plan)) {
      cancelPendingOperationRetry(plan);
      CC.last.warning = [CC.last.warning,
        "A queued operation retry was canceled because its frozen owner, evidence, or model-answer template was no longer valid; this action was rescored normally."
      ].filter(Boolean).join(" ");
    }
    if (plan.retry && plan.retryFocusKey) {
      const frozenFocus = active.find(character => character.key === plan.retryFocusKey)
        || characters.find(character => character.key === plan.retryFocusKey) || null;
      if (frozenFocus) {
        focus = frozenFocus;
        if (!active.some(character => character.key === frozenFocus.key)) {
