  function onboardingInsertControls(source, includeReady) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    if (!onboardingMarkerPresent(source)) {
      const profileHeader = rows.findIndex(row =>
        /^.*?['’]s[ \t]+(?:Outer|Inner)[ \t]*:[ \t]*$/i.test(row.trim())
      );
      const opening = rows.findIndex(row => row.trim());
      const insertion = profileHeader >= 0 ? profileHeader + 1 : Math.max(0, opening + 1);
      rows.splice(insertion, 0, "Onboarding: Pending");
    }
    if (includeReady && !onboardingFieldRows(rows.join("\n"), "Ready").length) {
      const marker = rows.findIndex(row => /^[ \t]*Onboarding[ \t]*:/i.test(row));
      rows.splice(Math.max(0, marker + 1), 0, "Ready: No");
    }
    return rows.join("\n");
  }

  function onboardingWithoutControls(source) {
    return textOf(source).replace(/\r/g, "").split("\n")
      .filter(row => !/^[ \t]*(?:Onboarding|Ready)[ \t]*:/i.test(row))
      .join("\n");
  }

  function onboardingOuterNames() {
    return catalogNamedOwners(settings.OUTER_CHARACTER_LABEL);
  }

  function onboardingCanonicalPermission(value) {
    const supplied = line(value, 160);
    const normalized = nameKeyOf(supplied);
    if (normalized === "general") return "General";
    if (normalized === "none") return "None";
    if (["player", "the player", "you", nameKeyOf(player.name)].includes(normalized)) return "Player";
    const matches = onboardingOuterNames().filter(name => sameNameForm(name, supplied));
    return matches.length === 1 ? matches[0] : "";
  }

  function onboardingCanonicalTarget(ownerName, value, allowSelf, allowUnknown) {
    const supplied = line(value, 160);
    const normalized = nameKeyOf(supplied);
    if (!normalized) return "";
    if (allowSelf && (normalized === "self" || sameNameForm(supplied, ownerName))) return "Self";
    if (["player", "the player", "you", nameKeyOf(player.name)].includes(normalized)) return "Player";
    const matches = onboardingOuterNames().filter(name => sameNameForm(name, supplied));
    if (matches.length === 1 && !sameNameForm(matches[0], ownerName)) return matches[0];
    return allowUnknown && !/[{}\[\]|\r\n]/.test(supplied) ? supplied : "";
  }

  function onboardingValidateProfile(name, label, source, maximum) {
    const errors = [];
    if (!onboardingProfileHeaderValid(source, name, label)) {
      errors.push(label + " wrapper or owner header is invalid");
    }
    const required = label === "Outer"
      ? ["Name, age, gender, pronouns", "Race/Species", "Physical attributes", "Clothing style", "Starting status"]
      : ["Personality", "Mannerisms", "Wants", "Fears", "Mental wounds", "Principles"];
    required.forEach(field => {
      const matches = onboardingFieldRows(source, field);
      if (matches.length !== 1 || !matches[0].value) {
        errors.push(label + " requires one filled " + field + " line");
      }
    });
    if (label === "Outer") {
      const identity = onboardingFieldRows(source, "Name, age, gender, pronouns");
      const parts = identity.length === 1
        ? identity[0].value.split(",").map(value => value.trim())
        : [];
      if (parts.length < 4 || parts.slice(0, 4).some(value => !value)) {
        errors.push("Outer identity needs name, age, gender, and pronouns");
      } else if (!sameNameForm(parts[0], name)) {
        errors.push("Outer identity name must match the canonical owner " + name);
      }
      const status = onboardingFieldRows(source, "Starting status");
      if (status.length === 1 && !normalizeCastStatus(status[0].value, "")) {
        errors.push("Outer Starting status must be Main or Side");
      }
      if (onboardingFieldRows(source, "Ready").length !== 1 || !onboardingReadyValue(source)) {
        errors.push("Outer requires exactly one Ready: No or Ready: Yes line");
      }
    } else if (onboardingFieldRows(source, "Ready").length) {
      errors.push("Ready belongs only in Outer");
    }
    const markerRows = onboardingFieldRows(source, "Onboarding");
    if (markerRows.length !== 1 || keyOf(markerRows[0].value) !== "pending") {
      errors.push(label + " requires exactly one Onboarding: Pending line");
    }
    const entry = onboardingWithoutControls(source);
    if (entry.length > maximum) errors.push(label + " exceeds its character limit");
    return { entry, errors };
  }

  function onboardingCanonicalProgress(value) {
    const raw = line(value, 2000);
    if (!raw) return { ok: true, value: "" };
    const segments = raw.split(/\s*;\s*/).filter(Boolean);
    const normalized = [];
    for (const segment of segments) {
      const bare = segment.match(/^(\d+)\s*\/\s*(\d+)$/);
      const named = segment.match(/^(.+?)\s+(\d+)\s*\/\s*(\d+)$/);
      const permission = onboardingCanonicalPermission(bare ? "General" : (named ? named[1] : ""));
      const count = Number(bare ? bare[1] : (named && named[2]));
      const threshold = Number(bare ? bare[2] : (named && named[3]));
      if (!permission || permission === "None" || !Number.isSafeInteger(count)
        || count < 1 || count >= settings.NAME_ESTABLISHMENT_CONFIRMATIONS
        || threshold !== settings.NAME_ESTABLISHMENT_CONFIRMATIONS) {
        return { ok: false, value: raw };
      }
      normalized.push(permission + " " + count + "/" + threshold);
    }
    return { ok: true, value: unique(normalized, 200).join("; ") };
  }

  function onboardingPageEnvelope(source, expectedHeader) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    const nonempty = rows.map((value, index) => ({ value: value.trim(), index }))
      .filter(item => item.value);
    const closingValid = nonempty.length > 0
      && nonempty[nonempty.length - 1].value === "}";
    const split = nonempty.length >= 2
      && nonempty[0].value === "{"
      && nameKeyOf(nonempty[1].value) === nameKeyOf(expectedHeader);
    const combinedHeader = nonempty.length
      && nonempty[0].value.startsWith("{")
      ? nonempty[0].value.slice(1).trim()
      : "";
    const combined = !!combinedHeader
      && nameKeyOf(combinedHeader) === nameKeyOf(expectedHeader);
    const headerIndex = split
      ? nonempty[1].index
      : (combined ? nonempty[0].index : -1);
    return {
      rows,
      nonempty,
      recognized: closingValid && (split || combined),
      canonical: closingValid && split,
      combined,
      headerIndex,
      bodyStart: headerIndex >= 0 ? headerIndex + 1 : 0,
      closingIndex: nonempty.length ? nonempty[nonempty.length - 1].index : rows.length
    };
  }

  function onboardingCanonicalNames(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Names:");
    const rows = envelope.rows;
    const nonempty = envelope.nonempty;
    const errors = [];
    if (nonempty.length < 3 || !envelope.recognized) {
      errors.push("Names wrapper or owner header is invalid");
    }
    const canonicalRows = onboardingFieldRows(source, "Canonical");
    if (canonicalRows.length !== 1 || !sameNameForm(canonicalRows[0].value, name)) {
      errors.push("Names requires Canonical: " + name);
    }
    const canonicalIndex = canonicalRows.length ? canonicalRows[0].index : envelope.headerIndex;
    const closingIndex = envelope.closingIndex;
    const starts = [];
    for (let index = canonicalIndex + 1; index < closingIndex; index++) {
      if (/^[ \t]*Alias[ \t]*:/i.test(rows[index])) starts.push(index);
    }
    const firstStart = starts.length ? starts[0] : closingIndex;
    for (let index = canonicalIndex + 1; index < firstStart; index++) {
      if (rows[index].trim()) errors.push("Names has content outside an Alias record");
    }
    const records = [];
    const seen = new Set();
    starts.forEach((start, recordIndex) => {
      const end = recordIndex + 1 < starts.length ? starts[recordIndex + 1] : closingIndex;
      const recordRows = rows.slice(start, end).filter(row => row.trim());
      const aliasMatch = recordRows[0] && recordRows[0].match(
        /^[ \t]*Alias[ \t]*:[ \t]*(.*?)[ \t]*$/i
      );
      const alias = aliasMatch ? line(aliasMatch[1], 160) : "";
      if (ONBOARDING_NAME_PLACEHOLDERS.some(value => sameNameForm(value, alias))) return;
      const labels = ["Alias", "Status", "Use", "Progress", "Reason"];
      const values = {};
      if (recordRows.length !== labels.length) {
        errors.push("Names Alias " + (alias || "record") + " must contain exactly five fields");
        return;
      }
      labels.forEach((label, index) => {
        const match = recordRows[index].match(
          new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i")
        );
        if (!match) {
          errors.push("Names Alias " + (alias || "record")
            + " has a missing or reordered " + label + " field");
        }
        values[label] = match ? line(match[1], 4000) : "";
      });
      if (labels.every(label => !values[label])) return;
      if (!alias || sameNameForm(alias, name) || /[{}\[\]|\r\n]/.test(alias)) {
        errors.push("Names contains an empty, canonical, or structurally unsafe Alias");
        return;
      }
      const aliasKey = nameKeyOf(alias);
      if (seen.has(aliasKey)) errors.push("Names repeats Alias " + alias);
      seen.add(aliasKey);
      const status = ["Emerging", "Active", "Retired", "Rejected"]
        .find(value => sameNameForm(value, values.Status));
      if (!status) errors.push("Names Alias " + alias + " has an unsupported Status");
      const uses = values.Use.split(/\s*,\s*/).filter(Boolean)
        .map(onboardingCanonicalPermission);
      if (!uses.length || uses.some(value => !value)
        || ((uses.includes("General") || uses.includes("None")) && new Set(uses).size > 1)) {
        errors.push("Names Alias " + alias + " has an invalid Use permission");
      }
      const use = unique(uses.filter(Boolean), 160).join(", ");
      const progress = onboardingCanonicalProgress(values.Progress);
      if (!progress.ok) errors.push("Names Alias " + alias + " has invalid Progress");
      const suppliedReason = wholeLine(values.Reason, 0);
      const baselineReasons = {
        "replace with an accepted first name form or delete this record": "Creator-approved first-name form.",
        "replace with an accepted surname or delete this record": "Creator-approved surname.",
        "replace with an accepted title or delete this record": "Creator-approved title.",
        "replace with a nickname accepted from the player or delete this record":
          "Creator-approved nickname accepted from the Player.",
        [keyOf("Replace with a nickname " + name + " rejects, or delete this record.")]:
          "Creator-marked nickname that " + name + " rejects."
      };
      const reason = baselineReasons[keyOf(suppliedReason)] || suppliedReason;
      if (!reason || /[{}\[\]]/.test(reason)) {
        errors.push("Names Alias " + alias + " needs a safe Reason");
      }
      records.push({
        alias,
        status: status || values.Status,
        use: status === "Retired" || status === "Rejected" ? "None" : use,
        progress: status === "Retired" || status === "Rejected" ? "" : progress.value,
        reason
      });
    });
    const entryRows = ["{", name + "'s Names:", "Canonical: " + name];
    records.forEach(record => {
      entryRows.push(
        "",
        "Alias: " + record.alias,
        "Status: " + record.status,
        "Use: " + record.use,
        "Progress: " + record.progress,
        "Reason: " + record.reason
      );
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_NAMES_CARD_CHARS) {
      errors.push("Names exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalViews(name, source) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    const nonempty = rows.map((value, index) => ({ value: value.trim(), index }))
      .filter(item => item.value);
    const errors = [];
    if (nonempty.length < 7 || nonempty[0].value !== "{"
      || nameKeyOf(nonempty[1].value) !== nameKeyOf(name + "'s Views:")
      || nonempty[nonempty.length - 1].value !== "}") {
      errors.push("Views wrapper or owner header is invalid");
    }
    const grouped = {};
    ONBOARDING_VIEW_CATEGORIES.forEach(category => { grouped[category] = []; });
    let current = "";
    const headings = [];
    const seenTargets = new Set();
    const bodyStart = nonempty.length >= 2 ? nonempty[1].index + 1 : 0;
    const closingIndex = nonempty.length ? nonempty[nonempty.length - 1].index : rows.length;
    for (let index = bodyStart; index < closingIndex; index++) {
      const row = rows[index].trim();
      if (!row) continue;
      const category = ONBOARDING_VIEW_CATEGORIES.find(
        value => keyOf(value + ":") === keyOf(row)
      );
      if (category) {
        current = category;
        headings.push(category);
        continue;
      }
      const match = row.match(/^(.+?)\s+(?:—|–|-)\s+(.+)$/);
      if (!current || !match) {
        errors.push("Views line " + (index + 1) + " is not under a valid category");
        continue;
      }
      const target = onboardingCanonicalTarget(name, match[1], true, true);
      const explanation = wholeLine(match[2], 0);
      if (!target || !explanation || /[{}\[\]]/.test(explanation)) {
        errors.push("Views line " + (index + 1) + " needs a safe target and explanation");
        continue;
      }
      const targetKey = nameKeyOf(target);
      if (seenTargets.has(targetKey)) errors.push("Views repeats target " + target);
      seenTargets.add(targetKey);
      grouped[current].push({ target, explanation });
    }
    if (headings.length !== ONBOARDING_VIEW_CATEGORIES.length
      || headings.some((value, index) => value !== ONBOARDING_VIEW_CATEGORIES[index])) {
      errors.push("Views requires Loves, Likes, Neutrals, Dislikes, and Hates once, in order");
    }
    const entryRows = ["{", name + "'s Views:"];
    ONBOARDING_VIEW_CATEGORIES.forEach(category => {
      entryRows.push(category + ":");
      grouped[category].forEach(record => {
        entryRows.push(record.target + " — " + record.explanation);
      });
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_VIEWS_CARD_CHARS) {
      errors.push("Views exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalRelationshipField(field, value) {
    const raw = line(value, 4000);
    if (!raw) return { ok: true, value: "" };
    const former = raw.match(/^Former(?:\s+(?:—|–|-)\s+(.+))?$/i);
    if (field === "Role" && former) {
      const description = line(former[1], 2000);
      return /[{}\[\]]/.test(description)
        ? { ok: false, value: raw }
        : { ok: true, value: "Former" + (description ? " — " + description : "") };
    }
    const stages = ONBOARDING_RELATIONSHIP_STAGES[field] || [];
    const numeric = raw.match(/^(-?\d+)\s*\(([^)]+)\)(?:\s+(?:—|–|-)\s+(.+))?$/);
    let stage;
    let score;
    let description;
    if (numeric) {
      const suppliedScore = Number(numeric[1]);
      if (!Number.isSafeInteger(suppliedScore) || !stages.length) {
        return { ok: false, value: raw };
      }
      score = Math.max(
        stages[0].minimum,
        Math.min(stages[stages.length - 1].maximum, suppliedScore)
      );
      stage = stages.find(item => score >= item.minimum && score <= item.maximum);
      description = line(numeric[3], 2000);
    } else {
      const stageOnly = raw.match(/^(.+?)(?:\s+(?:—|–|-)\s+(.+))?$/);
      stage = stageOnly && stages.find(item => sameNameForm(item.label, stageOnly[1]));
      if (!stage) return { ok: false, value: raw };
      score = stage.midpoint;
      description = line(stageOnly[2], 2000);
    }
    if (!stage || /[{}\[\]]/.test(description)) return { ok: false, value: raw };
    return {
      ok: true,
      value: score + " (" + stage.label + ")" + (description ? " — " + description : "")
    };
  }

  function onboardingCanonicalRelationships(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Relationships:");
    const rows = envelope.rows;
    const nonempty = envelope.nonempty;
    const errors = [];
    if (nonempty.length < 2 || !envelope.recognized) {
      errors.push("Relationships wrapper or owner header is invalid");
    }
    const bodyStart = envelope.bodyStart;
    const closingIndex = envelope.closingIndex;
    const starts = [];
    for (let index = bodyStart; index < closingIndex; index++) {
      if (/^[ \t]*About[ \t]*:/i.test(rows[index])) starts.push(index);
    }
    const firstStart = starts.length ? starts[0] : closingIndex;
    const leadingRows = rows.slice(bodyStart, firstStart)
      .map((value, offset) => ({ value, index: bodyStart + offset }))
      .filter(item => item.value.trim());
    const legacyPlayerFields = leadingRows.length === ONBOARDING_RELATIONSHIP_FIELDS.length
      && leadingRows.every((item, index) => new RegExp(
        "^[ \\t]*" + escapeRegExp(ONBOARDING_RELATIONSHIP_FIELDS[index]) + "[ \\t]*:",
        "i"
      ).test(item.value));
    if (leadingRows.length && !legacyPlayerFields) {
      errors.push("Relationships has content outside an About record");
    }
    const records = [];
    const seenTargets = new Set();
    const blocks = [];
    if (legacyPlayerFields) {
      blocks.push({
        start: leadingRows[0].index,
        rows: ["About: Player"].concat(leadingRows.map(item => item.value))
      });
    }
    starts.forEach((start, recordIndex) => {
      const end = recordIndex + 1 < starts.length ? starts[recordIndex + 1] : closingIndex;
      blocks.push({ start, rows: rows.slice(start, end).filter(row => row.trim()) });
    });
    blocks.forEach(block => {
      const start = block.start;
      const recordRows = block.rows;
      const labels = ["About"].concat(ONBOARDING_RELATIONSHIP_FIELDS);
      const values = {};
      if (recordRows.length !== labels.length) {
        errors.push("Relationships record at line " + (start + 1)
          + " must contain exactly six fields");
        return;
      }
      labels.forEach((label, index) => {
        const match = recordRows[index].match(
          new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i")
        );
        if (!match) {
          errors.push("Relationships record at line " + (start + 1)
            + " has a missing or reordered " + label + " field");
        }
        values[label] = match ? line(match[1], 4000) : "";
      });
      if (labels.every(label => !values[label])) return;
      const target = onboardingCanonicalTarget(name, values.About, false, false);
      if (!target) {
        errors.push("Relationships record at line " + (start + 1)
          + " has an unknown or self About target");
        return;
      }
      const targetKey = nameKeyOf(target);
      if (seenTargets.has(targetKey)) errors.push("Relationships repeats target " + target);
      seenTargets.add(targetKey);
      const fields = {};
      ONBOARDING_RELATIONSHIP_FIELDS.forEach(field => {
        const parsed = onboardingCanonicalRelationshipField(field, values[field]);
        if (!parsed.ok) {
          errors.push("Relationships " + target + " " + field
            + " needs a supported stage or score-stage value");
        }
        fields[field] = parsed.value;
      });
      records.push({ target, fields });
    });
    const entryRows = ["{", name + "'s Relationships:"];
    records.forEach((record, index) => {
      if (index > 0) entryRows.push("");
      entryRows.push("About: " + record.target);
      ONBOARDING_RELATIONSHIP_FIELDS.forEach(field => {
        entryRows.push(field + ": " + record.fields[field]);
      });
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_RELATIONSHIPS_CARD_CHARS) {
      errors.push("Relationships exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalExperiences(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Experiences:");
    const rows = envelope.rows;
    const errors = [];
    if (!envelope.recognized) {
      errors.push("Experiences wrapper or owner header is invalid");
    }
    const pattern = new RegExp(
      "^- \\[About:\\s*([^\\]\\r\\n]+)\\]\\s*" + escapeRegExp(name)
        + "\\s+experienced:\\s*(.+)\\.$",
      "i"
    );
    const records = [];
    const seen = new Set();
    const addRecord = (rawTarget, rawSituation, lineNumber) => {
      const target = onboardingCanonicalTarget(name, rawTarget, true, true);
      const suppliedSituation = wholeLine(rawSituation, 0);
      const situation = line(suppliedSituation, settings.MAX_EXPERIENCES_CARD_CHARS)
        .replace(/[.!?]+$/g, "").trim();
      if (!target || !situation || /[{}|\r\n]/.test(target + situation)
        || situation !== suppliedSituation.replace(/[.!?]+$/g, "").trim()) {
        errors.push("Experiences line " + lineNumber
          + " has an unsafe or overlong target or event");
        return;
      }
      const signature = nameKeyOf(target) + "|" + keyOf(situation);
      if (seen.has(signature)) errors.push("Experiences repeats the same target and event");
      seen.add(signature);
      records.push({ target, situation });
    };
    for (let index = envelope.bodyStart; index < envelope.closingIndex; index++) {
      const row = rows[index].trim();
      if (!row) continue;
      const match = row.match(pattern);
      if (match) {
        addRecord(match[1], match[2], index + 1);
        continue;
      }
      const about = row.match(/^About\s*:\s*(.*?)\s*$/i);
      if (!about) {
        errors.push("Experiences line " + (index + 1) + " is malformed");
        continue;
      }
      const next = rows[index + 1] && rows[index + 1].trim();
      const experience = next && next.match(/^Experience\s*:\s*(.*?)\s*$/i);
      if (!experience || index + 1 >= envelope.closingIndex) {
        errors.push("Experiences About at line " + (index + 1)
          + " requires the next Experience field");
        continue;
      }
      index += 1;
      if (!about[1] && !experience[1]) continue;
      if (!about[1] || !experience[1]) {
        errors.push("Experiences fields at lines " + index + "-" + (index + 1)
          + " must both be filled or both be blank");
        continue;
      }
      addRecord(about[1], experience[1], index);
    }
    const entryRows = ["{", name + "'s Experiences:"];
    records.forEach((record, index) => {
      if (index > 0) entryRows.push("");
      entryRows.push("About: " + record.target, "Experience: " + record.situation);
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_EXPERIENCES_CARD_CHARS) {
      errors.push("Experiences exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCommitPack(name, pack) {
    const outer = onboardingValidateProfile(
      name,
      "Outer",
      entryOf(pack.outer),
      settings.MAX_OUTER_CARD_CHARS
    );
    const inner = onboardingValidateProfile(
      name,
      "Inner",
      entryOf(pack.inner),
      settings.MAX_INNER_CARD_CHARS
    );
    const names = onboardingCanonicalNames(name, entryOf(pack.names));
    const views = onboardingCanonicalViews(name, entryOf(pack.views));
    const relationships = onboardingCanonicalRelationships(name, entryOf(pack.relationships));
    const experiences = onboardingCanonicalExperiences(name, entryOf(pack.experiences));
    const errors = outer.errors.concat(
      inner.errors,
      names.errors,
      views.errors,
      relationships.errors,
      experiences.errors
    );
    if (onboardingReadyValue(entryOf(pack.outer)) !== "yes") {
      errors.unshift("Outer Ready must be Yes before activation");
    }
    if (errors.length) return { ok: false, error: errors[0] };
    const changes = [
      { card: pack.names, title: namedTitle(name, settings.NAMES_LABEL), entry: names.entry },
      { card: pack.views, title: namedTitle(name, settings.VIEWS_LABEL), entry: views.entry },
      {
        card: pack.relationships,
        title: namedTitle(name, settings.RELATIONSHIPS_LABEL),
        entry: relationships.entry
      },
      {
        card: pack.experiences,
        title: onboardingExperiencesTitle(name),
        entry: experiences.entry
      },
      {
        card: pack.inner,
        title: namedTitle(name, settings.INNER_CHARACTER_LABEL),
        entry: inner.entry
      },
      {
        card: pack.outer,
        title: namedTitle(name, settings.OUTER_CHARACTER_LABEL),
        entry: outer.entry
      }
    ];
    const snapshots = changes.map(change => ({
      index: cardIndex(change.card),
      title: titleOf(change.card),
      keys: change.card.keys,
      entry: entryOf(change.card),
      type: change.card.type
    }));
    try {
      changes.forEach(change => {
        const saved = saveCard(change.card, change.entry, change.title);
        if (!saved || entryOf(saved) !== change.entry
          || !managedCardIdentityMatches(saved, change.title)) {
          throw new Error("could not verify " + change.title);
        }
        change.card = saved;
      });
    } catch (error) {
      let restored = true;
      snapshots.slice().reverse().forEach(snapshot => {
        if (!updateCardAt(
          snapshot.index,
          snapshot.keys,
          snapshot.entry,
          snapshot.type,
          snapshot.title
        )) restored = false;
      });
      return {
        ok: false,
        error: "activation transaction failed at " + (error.message || "an unknown card")
          + (restored ? "" : "; rollback was incomplete")
      };
    }
    return { ok: true };
  }

  function onboardingExactCards(title) {
    return catalogRecordsByTitle(title).map(record => record.card);
  }

  function ensureOnboardingPackCard(name, title, template, label) {
    let matching = onboardingExactCards(title);
    if (!matching.length) {
      const created = addCard(title, template(name));
      if (created) matching = [created];
    }
    if (matching.length !== 1) {
      activeRosterDiagnostics.push(
        name + " has conflicting " + label + " cards and remains pending."
      );
      return null;
    }
    return matching[0];
  }

  function storedAliasOwners(alias) {
    const owners = [];
    catalogPagedLabel(settings.NAMES_LABEL).records.forEach(item => {
      const card = item.card;
      const owner = item.owner;
      if (!owner) return;
      const pendingOwner = namedCards(owner, settings.OUTER_CHARACTER_LABEL)
        .some(outer => onboardingMarkerPresent(entryOf(outer)));
      const aliases = textOf(entryOf(card)).replace(/\r/g, "").split("\n")
        .map(row => {
          const match = row.match(/^[ \\t]*Alias[ \\t]*:[ \\t]*(.*?)[ \\t]*$/i);
          return match ? line(match[1], 160) : "";
        })
        .filter(value => value && !(pendingOwner
          && ONBOARDING_NAME_PLACEHOLDERS.some(placeholder => sameNameForm(placeholder, value))));
      if (aliases.some(value => sameNameForm(value, alias))
        && !owners.some(value => sameNameForm(value, owner))) owners.push(owner);
    });
    return owners;
  }

  function ensureConfirmedOnboarding(slot) {
    if (!slot || !slot.valid || !slot.name) return;
    const reserved = ["self", "player", "the player"].includes(nameKeyOf(slot.name));
    if (reserved || sameNameForm(slot.name, player.name)) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.code + " named the Player or Self and was ignored as an NPC slot.");
      return;
    }
    let outerCards = namedCards(slot.name, settings.OUTER_CHARACTER_LABEL);
    let innerCards = namedCards(slot.name, settings.INNER_CHARACTER_LABEL);
    let createdOuter = false;
    if (!outerCards.length) {
      const aliasOwners = storedAliasOwners(slot.name);
      if (aliasOwners.length) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " matched an existing Alias for "
          + aliasOwners.join(", ") + "; enter that identity's canonical name instead.");
        return;
      }
      const created = addCard(
        namedTitle(slot.name, settings.OUTER_CHARACTER_LABEL),
        onboardingOuterTemplate(slot.name)
      );
      if (created) {
        outerCards = [created];
        createdOuter = true;
        activeRosterDiagnostics.push(
          slot.name + " confirmed; the six-card creator template was initialized."
        );
      } else {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.name + " could not be onboarded because its Outer template could not be created.");
        return;
      }
    }
    if (outerCards.length !== 1) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.name + " has conflicting Outer cards and remains unavailable for onboarding.");
      return;
    }
    if (!innerCards.length) {
      const created = addCard(
        namedTitle(slot.name, settings.INNER_CHARACTER_LABEL),
        onboardingInnerTemplate(slot.name)
      );
      if (created) {
        innerCards = [created];
        activeRosterDiagnostics.push(slot.name + " received a blank Inner template.");
      } else {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.name + " remains pending because its Inner template could not be created.");
        return;
      }
    }
    if (innerCards.length !== 1) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.name + " has conflicting Inner cards and remains unavailable for onboarding.");
      return;
    }
    const onboarding = createdOuter
      || onboardingMarkerPresent(entryOf(outerCards[0]))
      || onboardingMarkerPresent(entryOf(innerCards[0]));
    if (!onboarding) return;

    const outerControlled = onboardingInsertControls(entryOf(outerCards[0]), true);
    if (outerControlled !== entryOf(outerCards[0])) {
      const saved = saveCard(
        outerCards[0],
        outerControlled,
        namedTitle(slot.name, settings.OUTER_CHARACTER_LABEL)
      );
      if (!saved) {
        slot.valid = false;
        activeRosterDiagnostics.push(
          slot.name + " remains pending because its Outer onboarding controls could not be restored."
        );
        return;
      }
      outerCards[0] = saved;
    }
    const innerControlled = onboardingInsertControls(entryOf(innerCards[0]), false);
    if (innerControlled !== entryOf(innerCards[0])) {
      const saved = saveCard(
        innerCards[0],
        innerControlled,
        namedTitle(slot.name, settings.INNER_CHARACTER_LABEL)
      );
      if (!saved) {
        slot.valid = false;
        activeRosterDiagnostics.push(
          slot.name + " remains pending because its Inner onboarding marker could not be restored."
        );
        return;
      }
      innerCards[0] = saved;
    }

    const pack = {
      outer: outerCards[0],
      inner: innerCards[0],
      names: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.NAMES_LABEL),
        onboardingNamesTemplate,
        "Names"
      ),
      views: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.VIEWS_LABEL),
        onboardingViewsTemplate,
        "Views"
      ),
      relationships: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.RELATIONSHIPS_LABEL),
        onboardingRelationshipsTemplate,
        "Relationships"
      ),
      experiences: ensureOnboardingPackCard(
        slot.name,
        onboardingExperiencesTitle(slot.name),
        onboardingExperiencesTemplate,
        "Experiences"
      )
    };
    if (Object.values(pack).some(card => !card)) {
      slot.valid = false;
      return;
    }
    const readyRows = onboardingFieldRows(entryOf(pack.outer), "Ready");
    if (readyRows.length !== 1 || !onboardingReadyValue(entryOf(pack.outer))) {
      activeRosterDiagnostics.push(
        slot.name + " remains pending: Outer needs exactly one Ready: No or Ready: Yes line."
      );
      return;
    }
    if (onboardingReadyValue(entryOf(pack.outer)) !== "yes") {
      activeRosterDiagnostics.push(
        slot.name + " onboarding is pending; complete the six setup cards, then change Outer Ready to Yes."
      );
      return;
    }
    const committed = onboardingCommitPack(slot.name, pack);
    if (committed.ok) {
      activeRosterDiagnostics.push(
        slot.name + " onboarding completed; all six creator cards were validated and activated."
      );
    } else {
      activeRosterDiagnostics.push(slot.name + " remains pending: " + committed.error + ".");
    }
  }

  const activeNpcRoster = readActiveNpcRoster();
  activeNpcRoster.slots.forEach(ensureConfirmedOnboarding);

  const characterDiscoveryDiagnostics = [];
  let preparedProfileCount = 0;
  let rosterSkippedProfileCount = 0;

  function discoverCharacters() {
    const label = settings.OUTER_CHARACTER_LABEL;
    const prepared = catalogNamedLabel(label).records;
    preparedProfileCount = new Set(prepared.map(item => item.ownerKey).filter(Boolean)).size;
    const rosterKeys = activeNpcRoster.card
      ? new Set(activeNpcRoster.slots
        .filter(slot => slot && slot.valid && slot.name)
        .map(slot => nameKeyOf(slot.name)))
      : null;
    const candidates = prepared.map(item => {
      if (rosterKeys && !rosterKeys.has(item.ownerKey)) return null;
      return {
        card: item.card,
        index: item.index,
        name: item.owner,
        key: item.ownerKey,
        source: entryOf(item.card),
        duplicateCount: 0
      };
    }).filter(candidate => candidate && candidate.key);
    rosterSkippedProfileCount = Math.max(
      0,
      preparedProfileCount - new Set(candidates.map(candidate => candidate.key)).size
    );
    const groups = new Map();
    candidates.forEach(candidate => {
      if (!groups.has(candidate.key)) groups.set(candidate.key, []);
      groups.get(candidate.key).push(candidate);
    });
    const accepted = [];
    groups.forEach(group => {
      const first = group[0];
      if (group.length === 1) {
        accepted.push(first);
        return;
      }
      const signatures = new Set(group.map(candidate => duplicateCardEntrySignature(candidate.card)));
      if (signatures.size === 1) {
        first.duplicateCount = group.length - 1;
        accepted.push(first);
        characterDiscoveryDiagnostics.push(
          first.name + " has " + group.length + " exact Outer cards; using the first and excluding "
            + first.duplicateCount + " duplicate" + (first.duplicateCount === 1 ? "" : "s") + "."
        );
        return;
      }
      characterDiscoveryDiagnostics.push(
        first.name + " has " + group.length
          + " conflicting Outer cards; excluded this identity until only one remains."
      );
    });

    return accepted.map(candidate => {
      const { index, name, duplicateCount } = candidate;
      let outerCard = candidate.card;
      outerCard = saveCard(
        outerCard,
        entryOf(outerCard),
        namedTitle(name, settings.OUTER_CHARACTER_LABEL)
      ) || outerCard;
      const source = entryOf(outerCard);
      const pronouns = parseOuterPronouns(source);
      const rawStartingStatus = extractLine(source, "Starting status");
      const parsedStartingStatus = normalizeCastStatus(rawStartingStatus, "");
      const outerProfile = buildOuterProfile(name, source);
      const wrapper = outerWrapperStatus(source);
      const matchingInnerCards = namedCards(name, settings.INNER_CHARACTER_LABEL);
      let innerCard = matchingInnerCards[0] || null;
      let innerConflict = false;
      let duplicateInnerCount = 0;
      if (matchingInnerCards.length > 1) {
        const signatures = new Set(matchingInnerCards.map(duplicateCardEntrySignature));
        if (signatures.size === 1) {
          duplicateInnerCount = matchingInnerCards.length - 1;
          characterDiscoveryDiagnostics.push(
            name + " has " + matchingInnerCards.length + " exact Inner cards; using the first and excluding "
              + duplicateInnerCount + " duplicate" + (duplicateInnerCount === 1 ? "" : "s") + "."
          );
        } else {
          innerCard = null;
          innerConflict = true;
          characterDiscoveryDiagnostics.push(
            name + " has " + matchingInnerCards.length
              + " conflicting Inner cards; omitted Inner until only one remains."
          );
        }
      }
      if (innerCard) {
        innerCard = saveCard(
          innerCard,
          entryOf(innerCard),
          namedTitle(name, settings.INNER_CHARACTER_LABEL)
        ) || innerCard;
      }
      const innerSource = innerCard ? entryOf(innerCard) : "";
      const innerProfile = innerCard ? buildInnerProfile(name, innerSource) : null;
      const onboardingGenerated = onboardingMarkerPresent(source) || onboardingMarkerPresent(innerSource);
      const onboardingMissing = onboardingGenerated
        ? onboardingMissingDetails(source, innerSource, innerConflict)
        : [];
      if (onboardingGenerated) {
        if (onboardingReadyValue(source) === "yes") {
          onboardingMissing.push("resolve the onboarding validation diagnostic");
        } else {
          onboardingMissing.push("review all six setup cards, then set Outer Ready to Yes");
        }
      }
      const onboardingPending = onboardingGenerated;
      const outerWarnings = [];
      const innerWarnings = [];
      if (duplicateCount) {
        outerWarnings.push("Using the first Outer card; excluded " + duplicateCount + " exact duplicate"
          + (duplicateCount === 1 ? "" : "s") + ".");
      }
      if (!wrapper.opening && !wrapper.closing) outerWarnings.push("Outer wrapper { } missing.");
      else if (!wrapper.opening) outerWarnings.push("Opening Outer wrapper { missing.");
      else if (!wrapper.closing) outerWarnings.push("Closing Outer wrapper } missing.");
      if (!parsedStartingStatus) outerWarnings.push("Starting status missing or invalid; defaulted to Side.");
      if (onboardingPending) {
        outerWarnings.push("Confirmed onboarding pending: complete " + onboardingMissing.join(", ") + ".");
      } else if (outerProfile.missing.length) {
        outerWarnings.push("Missing: " + outerProfile.missing.join(", ") + ".");
      }
      if (outerProfile.truncated) {
        outerWarnings.push("Shortened " + outerProfile.originalChars + " → " + outerProfile.retainedChars + " characters.");
      }
      if (innerConflict) {
        innerWarnings.push("Conflicting Inner cards; Inner omitted until only one remains.");
      } else if (!innerCard) {
        innerWarnings.push("Inner card missing.");
      } else {
        if (duplicateInnerCount) {
          innerWarnings.push("Using the first Inner card; excluded " + duplicateInnerCount + " exact duplicate"
            + (duplicateInnerCount === 1 ? "" : "s") + ".");
        }
        const innerWrapper = outerWrapperStatus(innerSource);
        if (!innerWrapper.opening && !innerWrapper.closing) innerWarnings.push("Inner wrapper { } missing.");
        else if (!innerWrapper.opening) innerWarnings.push("Opening Inner wrapper { missing.");
        else if (!innerWrapper.closing) innerWarnings.push("Closing Inner wrapper } missing.");
        if (!onboardingPending && innerProfile.missing.length) {
          innerWarnings.push("Missing: " + innerProfile.missing.join(", ") + ".");
        }
        if (innerProfile.truncated) {
          innerWarnings.push("Shortened " + innerProfile.originalChars + " → " + innerProfile.retainedChars + " characters.");
        }
