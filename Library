function CharacterContinuity(hook, incomingText) {
  const settings = CHARACTER_CONTINUITY_STABLE_SETTINGS;
  const originalText = incomingText;
  const appendOnlyContext = hook === "contextAppend";
  const inputHook = hook === "input";
  const contextHook = hook === "context" || hook === "contextAppend";
  const outputHook = hook === "output";
  const rootState = state;
  const historyList = history;
  const cards = storyCards;
  const STORE_KINDS = ["names", "views", "relationships", "turningpoints", "experiences"];
  const storeSession = STORE_KINDS.reduce((result, kind) => {
    result[kind] = {
      loaded: false,
      dirty: false,
      repaired: false,
      projected: false,
      parses: 0,
      writes: 0,
      invalidations: 0,
      lastWrite: "",
      verifying: false,
      verificationFailed: false
    };
    return result;
  }, {});
  const cardTitleCache = new Map();
  const namedTitlePartsCache = new Map();
  const namedCardOwnerCache = new Map();
  const canonicalOutputCache = new Map();
  const canonicalHashCache = new Map();
  const recentStoryCache = new Map();
  const anchorMatchCache = new WeakMap();
  const maintenanceSession = {
    mode: contextHook ? "context-pending" : (inputHook ? "state-sync" : (outputHook ? "lazy-output" : "status-only")),
    structure: "deferred",
    stores: "deferred",
    stateSync: false,
    repaired: [],
    recorded: false
  };
  let cardCatalog = null;

  function finish(value) {
    return typeof value === "string" && value.length ? value : " ";
  }

  function debug(message) {
    if (settings.DEBUG_LOGS === true) {
      log("[Character Continuity Stable] " + message);
    }
  }

  function textOf(value) {
    return value === null || value === undefined ? "" : String(value);
  }

  function frontMemoryStore() {
    if (!rootState.memory || typeof rootState.memory !== "object" || Array.isArray(rootState.memory)) {
      rootState.memory = {};
    }
    return rootState.memory;
  }

  function currentFrontMemory() {
    return textOf(frontMemoryStore().frontMemory);
  }

  function stripOwnedFrontMemory(value) {
    const begin = escapeRegExp(settings.FRONT_MEMORY_BEGIN);
    const end = escapeRegExp(settings.FRONT_MEMORY_END);
    return textOf(value)
      .replace(new RegExp(begin + "[\\s\\S]*?" + end, "g"), "");
  }

  function ownedFrontMemoryBlock(taskText) {
    const task = textOf(taskText).replace(/\r/g, "").trim();
    return task
      ? [settings.FRONT_MEMORY_BEGIN, task, settings.FRONT_MEMORY_END].join("\n")
      : "";
  }

  function ownedContextPacketBlock(packetText) {
    const packet = textOf(packetText).replace(/\r/g, "").trim();
    return packet
      ? [settings.CONTEXT_PACKET_BEGIN, packet, settings.CONTEXT_PACKET_END].join("\n")
      : "";
  }

  function stripOwnedContextPacket(value) {
    const begin = escapeRegExp(settings.CONTEXT_PACKET_BEGIN);
    const end = escapeRegExp(settings.CONTEXT_PACKET_END);
    return textOf(value).replace(new RegExp("(?:\\r?\\n\\s*)?" + begin
      + "[\\s\\S]*?" + end + "(?:\\s*\\r?\\n)?", "g"), "");
  }

  function composedFrontMemory(externalMemory, taskText) {
    const external = textOf(externalMemory);
    const block = ownedFrontMemoryBlock(taskText);
    if (!block) return external;
    if (!external) return block;
    return external + (/\r?\n$/.test(external) ? "" : "\n\n") + block;
  }

  function stableFrontMemoryTracking() {
    const stable = rootState.characterContinuityStableV1;
    return stable && typeof stable === "object" && !Array.isArray(stable) ? stable : null;
  }

  function trackedExternalFrontMemory(currentValue) {
    const current = textOf(currentValue);
    const stable = stableFrontMemoryTracking();
    if (!stable || stable.frontMemoryOwnsBlock !== true
      || typeof stable.frontMemoryExternal !== "string") return stripOwnedFrontMemory(current);
    const external = stable.frontMemoryExternal;
    const prefix = external + (external && !/\r?\n$/.test(external) ? "\n\n" : "");
    const remainder = current.slice(prefix.length);
    return current.startsWith(prefix)
      && remainder.startsWith(settings.FRONT_MEMORY_BEGIN)
      && remainder.trimEnd().endsWith(settings.FRONT_MEMORY_END)
      ? external
      : stripOwnedFrontMemory(current);
  }

  function rememberFrontMemory(externalMemory, ownsBlock) {
    const stable = stableFrontMemoryTracking();
    if (!stable) return;
    stable.frontMemoryExternal = textOf(externalMemory);
    stable.frontMemoryOwnsBlock = ownsBlock === true;
  }

  function replaceFrontMemorySuffix(contextValue, oldFrontMemory, nextFrontMemory) {
    const context = textOf(contextValue);
    const oldFront = textOf(oldFrontMemory);
    const nextFront = textOf(nextFrontMemory);
    if (!oldFront) {
      if (!nextFront) return { ok: true, text: context };
      const separator = context && !/\n\s*$/.test(context) ? "\n\n" : "";
      return { ok: true, text: context + separator + nextFront };
    }
    const index = context.lastIndexOf(oldFront);
    if (index < 0 || context.slice(index + oldFront.length).trim()) {
      return { ok: false, text: context };
    }
    return {
      ok: true,
      text: context.slice(0, index) + nextFront + context.slice(index + oldFront.length)
    };
  }

  function clearOwnedFrontMemoryState() {
    const memory = frontMemoryStore();
    const current = textOf(memory.frontMemory);
    const external = trackedExternalFrontMemory(current);
    if (external === current) {
      rememberFrontMemory(external, false);
      return false;
    }
    memory.frontMemory = external;
    const cleared = textOf(memory.frontMemory) === external;
    if (cleared) rememberFrontMemory(external, false);
    return cleared;
  }

  function beginFrontMemoryContext(contextValue) {
    const oldFrontMemory = currentFrontMemory();
    const externalFrontMemory = trackedExternalFrontMemory(oldFrontMemory);
    const cleared = replaceFrontMemorySuffix(contextValue, oldFrontMemory, "");
    const baseText = cleared.ok ? stripOwnedContextPacket(cleared.text) : textOf(contextValue);
    return {
      ok: cleared.ok,
      originalText: textOf(contextValue),
      baseText,
      externalFrontMemory,
      commit(taskText, preparedContext = baseText) {
        if (!cleared.ok) return { ok: false, delivered: false, text: textOf(contextValue), frontMemory: oldFrontMemory };
        const nextFrontMemory = composedFrontMemory(externalFrontMemory, taskText);
        const prepared = textOf(preparedContext);
        const alreadyEndsWithFrontMemory = !!nextFrontMemory
          && prepared.trimEnd().endsWith(nextFrontMemory.trimEnd());
        const separator = nextFrontMemory && prepared && !/\n\s*$/.test(prepared) ? "\n\n" : "";
        const returnedText = alreadyEndsWithFrontMemory
          ? prepared
          : prepared + separator + nextFrontMemory;
        const memory = frontMemoryStore();
        memory.frontMemory = nextFrontMemory;
        const stateMatches = textOf(memory.frontMemory) === nextFrontMemory;
        const returnedSuffixMatches = nextFrontMemory
          ? returnedText.trimEnd().endsWith(nextFrontMemory.trimEnd())
          : returnedText === prepared;
        const ok = stateMatches && returnedSuffixMatches;
        if (ok) rememberFrontMemory(externalFrontMemory, !!textOf(taskText).trim());
        return {
          ok,
          delivered: ok && !!textOf(taskText).trim(),
          text: ok ? returnedText : textOf(contextValue),
          frontMemory: ok ? nextFrontMemory : oldFrontMemory
        };
      }
    };
  }

  function platformActionCount() {
    const value = Number(typeof info !== "undefined" && info ? info.actionCount : NaN);
    return Number.isFinite(value) && value >= 0 ? Math.floor(value) : null;
  }

  function clean(value, limit) {
    const result = textOf(value)
      .replace(/\r/g, "")
      .replace(/[ \t]+/g, " ")
      .replace(/\n{3,}/g, "\n\n")
      .trim()
      .slice(0, Math.max(1, Number(limit) || 10000));
    return /[\uD800-\uDBFF]$/.test(result) ? result.slice(0, -1) : result;
  }

  function line(value, limit) {
    const result = clean(value, Math.max(limit * 3, limit))
      .replace(/\s*\n\s*/g, " ")
      .trim()
      .slice(0, Math.max(1, Number(limit) || 500));
    return /[\uD800-\uDBFF]$/.test(result) ? result.slice(0, -1) : result;
  }

  function wrappedLine(value, limit) {
    const max = Math.max(4, Number(limit) || 500);
    const source = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (source.length <= max) return source;
    const closing = source[0] === "{" && source.endsWith("}")
      ? "}"
      : (source[0] === "[" && source.endsWith("]") ? "]" : "");
    return closing
      ? source.slice(0, max - 2).trimEnd() + " " + closing
      : source.slice(0, max);
  }

  function wholeLine(value, max) {
    const result = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (!result) return "";
    const limit = Math.max(0, Number(max) || 0);
    return limit > 0 && result.length > limit ? "" : result;
  }

  function compactLineAtBoundary(value, limit) {
    const supplied = Math.floor(Number(limit) || 0);
    if (supplied <= 0) return "";
    const maximum = Math.max(1, supplied);
    const source = clean(value, 20000).replace(/\s*\n\s*/g, " ").trim();
    if (!source || source.length <= maximum) return source;
    if (maximum === 1) return "…";
    const contentLimit = maximum - 1;
    let clipped = "";
    let segmenterUsed = false;
    try {
      if (typeof Intl === "object" && typeof Intl.Segmenter === "function") {
        segmenterUsed = true;
        const segmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" });
        for (const item of segmenter.segment(source)) {
          if (clipped.length + item.segment.length > contentLimit) break;
          clipped += item.segment;
        }
      }
    } catch { segmenterUsed = false; }
    if (!clipped && !segmenterUsed) {
      for (const point of Array.from(source)) {
        if (clipped.length + point.length > contentLimit) break;
        clipped += point;
      }
    }
    if (!clipped) return "…";
    const minimumBoundary = Math.max(1, Math.floor(contentLimit * 0.55));
    let boundary = -1;
    for (let index = clipped.length - 1; index >= minimumBoundary; index -= 1) {
      if (/\s/.test(clipped[index])) {
        boundary = index;
        break;
      }
    }
    if (boundary > 0) clipped = clipped.slice(0, boundary);
    clipped = clipped.replace(/[\s,;:–—-]+$/g, "").trim();
    return clipped + "…";
  }

  function keyOf(value) {
    return textOf(value)
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function nameKeyOf(value) {
    return textOf(value)
      .normalize("NFKC")
      .toLowerCase()
      .replace(/[‘’‛]/g, "'")
      .replace(/[‐‑‒–—―]/g, "-")
      .replace(/[ \t\r\n]+/g, " ")
      .trim();
  }

  function sameNameForm(left, right) {
    const leftKey = nameKeyOf(left);
    return !!leftKey && leftKey === nameKeyOf(right);
  }

  function escapeRegExp(value) {
    return textOf(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function clone(value) {
    try { return JSON.parse(JSON.stringify(value)); } catch { return null; }
  }

  function unique(values, limit) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(value => {
      const item = line(value, limit);
      if (item && !result.some(existing => keyOf(existing) === keyOf(item))) result.push(item);
    });
    return result;
  }

  function uniqueNameForms(values, limit) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(value => {
      const item = line(value, limit);
      if (item && !result.some(existing => sameNameForm(existing, item))) result.push(item);
    });
    return result;
  }

  function boolValue(value, fallback) {
    const normalized = keyOf(value);
    if (["true", "yes", "on", "1", "enabled"].includes(normalized)) return true;
    if (["false", "no", "off", "0", "disabled"].includes(normalized)) return false;
    return fallback;
  }

  function numberValue(value, fallback, min, max) {
    const parsed = parseInt(value, 10);
    if (!Number.isFinite(parsed)) return fallback;
    return Math.max(min, Math.min(max, parsed));
  }

  function positiveWhole(value, fallback) {
    const source = textOf(value).trim();
    if (!/^\d+$/.test(source)) return fallback;
    const parsed = Number(source);
    return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback;
  }

  function estimateTokens(value) {
    const source = textOf(value).trim();
    if (!source) return 0;
    const structural = (source.match(/[{}[\]<>\":,\\]/g) || []).length;
    return Math.ceil((Math.max(0, source.length - structural) / 3.25) + (structural / 1.8));
  }

  function hashString(value) {
    const source = textOf(value);
    let hash = 2166136261;
    for (let index = 0; index < source.length; index++) {
      hash ^= source.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return (hash >>> 0).toString(16);
  }

  function storeSessionFor(kind) {
    return storeSession[keyOf(kind)] || null;
  }

  function storeIsFresh(kind, value) {
    const session = storeSessionFor(kind);
    return !!(session && session.loaded && !session.dirty && value);
  }

  function recordStoreParse(kind, writesAtStart) {
    const session = storeSessionFor(kind);
    if (!session) return;
    session.loaded = true;
    session.parses += 1;
    session.dirty = session.writes > Math.max(0, Number(writesAtStart) || 0);
  }

  function verifiedStoreAfterParse(kind, currentStore, refresh) {
    const session = storeSessionFor(kind);
    if (!session || !session.dirty || typeof refresh !== "function") return currentStore;
    if (session.verifying) {
      session.verificationFailed = true;
      session.dirty = false;
      return currentStore;
    }
    session.verifying = true;
    const verified = refresh() || currentStore;
    session.verifying = false;
    return verified;
  }

  function markStoreDirty(kind, reason) {
    const session = storeSessionFor(kind);
    if (!session) return;
    session.dirty = true;
    session.repaired = false;
    session.projected = false;
    session.writes += 1;
    session.invalidations += 1;
    session.lastWrite = line(reason, 240);
  }

  function storeKindForManagedTitle(value) {
    const parts = ownedCardTitleParts(value);
    if (!parts) return "";
    if (keyOf(parts.label) === keyOf(settings.NAMES_LABEL)) return "names";
    if ([settings.BURIED_VIEWS_LABEL, settings.VIEWS_LABEL]
      .some(label => keyOf(parts.label) === keyOf(label))) return "views";
    if (keyOf(parts.label) === keyOf(settings.RELATIONSHIPS_LABEL)) return "relationships";
    if (keyOf(parts.label) === keyOf(settings.TURNING_POINTS_LABEL)) return "turningpoints";
    if (keyOf(parts.label) === keyOf(settings.EXPERIENCES_LABEL)) return "experiences";
    return "";
  }

  function markManagedTitlesDirty(values, reason) {
    const kinds = new Set((Array.isArray(values) ? values : [values])
      .map(storeKindForManagedTitle)
      .filter(Boolean));
    kinds.forEach(kind => markStoreDirty(kind, reason));
  }

  function storeSessionSummary() {
    return STORE_KINDS.map(kind => {
      const session = storeSession[kind];
      const unexpected = session.parses > session.writes + 1;
      return kind.charAt(0).toUpperCase() + ":" + session.parses + "p/"
        + session.writes + "w" + (unexpected ? "!" : (session.verificationFailed ? "?" : ""));
    }).join(", ");
  }

  function storeSessionWarnings() {
    return STORE_KINDS.flatMap(kind => {
      const session = storeSession[kind];
      const warnings = [];
      if (session.parses > session.writes + 1) {
        warnings.push(kind + " parsed " + session.parses + " times after " + session.writes
          + " managed write" + (session.writes === 1 ? "" : "s") + " in one " + hook + " hook");
      }
      if (session.verificationFailed) {
        warnings.push(kind + " could not settle its latest managed write after one verification reread; "
          + "the reread state was used for the rest of this " + hook + " hook");
      }
      return warnings;
    }).filter(Boolean);
  }

  function visibleTitleOf(card) {
    if (!card) return "";
    return line(typeof card.title === "string" ? card.title : "", 220);
  }

  function rawVisibleTitleOf(card) {
    return card && typeof card.title === "string" ? card.title : "";
  }

  function entryOf(card) {
    return card && typeof card.entry === "string" ? card.entry : "";
  }

  function encodedManagedTitle(value) {
    return line(value, 220)
      .replace(/%/g, "%25")
      .replace(/,/g, "%2C");
  }

  function decodedManagedTitle(value) {
    return line(value, 1000)
      .replace(/%2C/gi, ",")
      .replace(/%25/gi, "%")
      .slice(0, 220);
  }

  function managedCardKey(title) {
    const logicalTitle = line(title, 220);
    return logicalTitle ? settings.CARD_KEY_PREFIX + encodedManagedTitle(logicalTitle) : "";
  }

  function managedTitleFromKey(value) {
    const source = textOf(value).trim();
    if (!source.startsWith(settings.CARD_KEY_PREFIX)) return "";
    return decodedManagedTitle(source.slice(settings.CARD_KEY_PREFIX.length));
  }

  function defaultScriptCardTitle(value) {
    return keyOf(value) === keyOf(settings.SCRIPT_CARD_TITLE);
  }

  const OWNED_CARD_LABELS = [
    settings.OUTER_CHARACTER_LABEL,
    settings.INNER_CHARACTER_LABEL,
    settings.NAMES_LABEL,
    settings.STATE_LABEL,
    settings.RELATIONSHIPS_LABEL,
    settings.TURNING_POINTS_LABEL,
    settings.BURIED_VIEWS_LABEL,
    settings.VIEWS_LABEL,
    settings.EXPERIENCES_LABEL,
    "Identity"
  ];
  const PAGED_OWNED_CARD_LABELS = new Set([
    settings.NAMES_LABEL,
    settings.RELATIONSHIPS_LABEL,
    settings.TURNING_POINTS_LABEL,
    settings.BURIED_VIEWS_LABEL,
    settings.VIEWS_LABEL,
    settings.EXPERIENCES_LABEL
  ].map(keyOf));
  const OWNED_CARD_LABEL_PATTERN = OWNED_CARD_LABELS
    .slice()
    .sort((left, right) => right.length - left.length)
    .map(escapeRegExp)
    .join("|");
  const POSSESSIVE_OWNED_TITLE = new RegExp(
    "^(.+?)['’]s\\s+(" + OWNED_CARD_LABEL_PATTERN + ")(?:\\s+(\\d+))?$",
    "i"
  );
  const LEGACY_OWNED_TITLE = new RegExp(
    "^(.+?)\\s+(?:—|–|-)\\s+(" + OWNED_CARD_LABEL_PATTERN + ")(?:\\s+(\\d+))?$",
    "i"
  );

  function canonicalOwnedLabel(value) {
    const normalized = keyOf(value);
    return OWNED_CARD_LABELS.find(label => keyOf(label) === normalized) || "";
  }

  function ownedCardTitle(name, label, page = 1) {
    const owner = line(name, 120);
    const canonicalLabel = canonicalOwnedLabel(label);
    const pageNumber = Number(page) || 1;
    if (!owner || !canonicalLabel || !Number.isSafeInteger(pageNumber) || pageNumber < 1) return "";
    if (pageNumber > 1 && !PAGED_OWNED_CARD_LABELS.has(keyOf(canonicalLabel))) return "";
    if (keyOf(canonicalLabel) === "identity" && !sameNameForm(owner, "Player")) return "";
    return owner + "'s " + canonicalLabel + (pageNumber > 1 ? " " + pageNumber : "");
  }

  function ownedCardTitleParts(value) {
    const source = line(value, 260);
    const possessive = source.match(POSSESSIVE_OWNED_TITLE);
    const legacy = possessive ? null : source.match(LEGACY_OWNED_TITLE);
    const match = possessive || legacy;
    if (!match) return null;
    const owner = line(match[1], 120);
    const label = canonicalOwnedLabel(match[2]);
    const suppliedPage = !!match[3];
    const page = suppliedPage ? Number(match[3]) : 1;
    if (!owner || !label || !Number.isSafeInteger(page) || page < 1
      || (suppliedPage && page === 1)
      || (suppliedPage && !PAGED_OWNED_CARD_LABELS.has(keyOf(label)))
      || (keyOf(label) === "identity" && !sameNameForm(owner, "Player"))) {
      return null;
    }
    return {
      owner,
      label,
      page,
      legacy: !!legacy,
      title: ownedCardTitle(owner, label, page)
    };
  }

  function canonicalOwnedCardTitle(value) {
    const parts = ownedCardTitleParts(value);
    return parts ? parts.title : "";
  }

  function managedTitleFromEntry(card) {
    const source = entryOf(card).replace(/\r/g, "");
    if (!source.trim()) return "";

    const profile = source.match(
      /^\s*\{\s*(.+?)['’]s\s+(Outer|Inner)\s*:/i
    );
    if (profile) {
      const label = keyOf(profile[2]) === "outer"
        ? settings.OUTER_CHARACTER_LABEL
        : settings.INNER_CHARACTER_LABEL;
      return ownedCardTitle(profile[1], label);
    }

    const stateProfile = source.match(
      /^\s*\{\s*(.+?)['’]s\s+current\s+private\s+State\s*:/i
    );
    if (stateProfile) {
      return ownedCardTitle(stateProfile[1], settings.STATE_LABEL);
    }

    const headers = source.split("\n")
      .map(row => row.trim())
      .filter(row => row && row !== "{" && row !== "}")
      .slice(0, 4);
    if (headers.includes("Active NPC slots:")) return settings.ACTIVE_NPCS_TITLE;

    for (const header of headers) {
      const paged = header.match(
        /^(.+?)['’]s\s+(Buried Views|Views|Names|Relationships|Turning Points)(?:\s+(\d+))?\s*:\s*$/i
      );
      if (paged) {
        const owner = line(paged[1], 120);
        const normalizedLabel = keyOf(paged[2]);
        const label = normalizedLabel === "buried views"
          ? settings.BURIED_VIEWS_LABEL
          : (normalizedLabel === "views"
            ? settings.VIEWS_LABEL
            : (normalizedLabel === "names"
              ? settings.NAMES_LABEL
              : (normalizedLabel === "turning points"
                ? settings.TURNING_POINTS_LABEL
                : settings.RELATIONSHIPS_LABEL)));
        const page = paged[3] ? Number(paged[3]) : 1;
        return ownedCardTitle(owner, label, page);
      }

      const experiences = header.match(
        /^(.+?)['’]s\s+Experiences(?:\s+(\d+))?\s*:\s*$/i
      );
      if (experiences) {
        const page = experiences[2] ? Number(experiences[2]) : 1;
        return ownedCardTitle(experiences[1], settings.EXPERIENCES_LABEL, page);
      }
    }

    if (hasSettingsField(source, "Enabled")
      && hasSettingsField(source, "Continuity budget")
      && hasSettingsField(source, "State lifetime")) {
      return settings.SETTINGS_TITLE;
    }
    return "";
  }

  function titleOf(card) {
    if (!card) return "";
    const rawKeys = card.keys;
    const rawTitle = card.title;
    const rawEntry = card.entry;
    const cached = cardTitleCache.get(card);
    if (cached
      && cached.keys === rawKeys
      && cached.title === rawTitle
      && cached.entry === rawEntry) {
      return cached.value;
    }
    const managedTitle = managedTitleFromKey(card.keys);
    const visibleTitle = managedTitle ? "" : visibleTitleOf(card);
    const entryTitle = managedTitle || (visibleTitle && !defaultScriptCardTitle(visibleTitle))
      ? ""
      : managedTitleFromEntry(card);
    const resolved = managedTitle
      || (visibleTitle && !defaultScriptCardTitle(visibleTitle) ? visibleTitle : "")
      || entryTitle
      || line(card.keys, 220)
      || visibleTitle;
    const value = canonicalOwnedCardTitle(resolved) || resolved;
    cardTitleCache.set(card, {
      keys: rawKeys,
      title: rawTitle,
      entry: rawEntry,
      value
    });
    return value;
  }

  function invalidateCardCatalog() {
    cardCatalog = null;
  }

  function catalogAppend(map, key, value) {
    if (!key) return;
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(value);
  }

  function currentCardCatalog() {
    if (cardCatalog) return cardCatalog;
    const catalog = {
      records: [],
      indexByCard: new Map(),
      byTitle: new Map(),
      byRawKey: new Map(),
      byId: new Map(),
      namedLabels: new Map(),
      pagedLabels: new Map(),
      experienceOwners: null
    };
    cards.forEach((card, index) => {
      if (!card) return;
      const title = titleOf(card);
      const record = {
        card,
        index,
        title,
        titleKey: keyOf(title),
        rawKey: textOf(card.keys).trim(),
        id: card.id === null || card.id === undefined ? "" : textOf(card.id)
      };
      catalog.records.push(record);
      catalog.indexByCard.set(card, index);
      catalogAppend(catalog.byTitle, record.titleKey, record);
      catalogAppend(catalog.byRawKey, record.rawKey, record);
      catalogAppend(catalog.byId, record.id, record);
    });
    cardCatalog = catalog;
    return catalog;
  }

  function catalogRecordsByTitle(title) {
    return (currentCardCatalog().byTitle.get(keyOf(title)) || []).slice();
  }

  function catalogRecordsByRawKey(value) {
    return (currentCardCatalog().byRawKey.get(textOf(value).trim()) || []).slice();
  }

  function firstCatalogCard(records) {
    const ordered = (Array.isArray(records) ? records : [])
      .filter(record => record && record.card)
      .sort((left, right) => left.index - right.index);
    return ordered.length ? ordered[0].card : null;
  }

  function catalogNamedLabel(label) {
    const catalog = currentCardCatalog();
    const labelKey = keyOf(label);
    if (catalog.namedLabels.has(labelKey)) return catalog.namedLabels.get(labelKey);
    const index = { records: [], byOwner: new Map() };
    catalog.records.forEach(record => {
      const owner = nameFromNamedTitle(record.title, label);
      if (!owner) return;
      const item = { ...record, owner, ownerKey: nameKeyOf(owner) };
      index.records.push(item);
      catalogAppend(index.byOwner, item.ownerKey, item);
    });
    catalog.namedLabels.set(labelKey, index);
    return index;
  }

  function catalogNamedCards(name, label) {
    const records = catalogNamedLabel(label).byOwner.get(nameKeyOf(name)) || [];
    return records.map(record => record.card);
  }

  function catalogNamedOwners(label) {
    return catalogNamedLabel(label).records.map(record => record.owner);
  }

  function catalogPagedLabel(label) {
    const catalog = currentCardCatalog();
    const labelKey = keyOf(label);
    if (catalog.pagedLabels.has(labelKey)) return catalog.pagedLabels.get(labelKey);
    const index = { records: [], byOwner: new Map() };
    catalog.records.forEach(record => {
      const parts = numberedNamedTitleParts(record.title, label);
      if (!parts) return;
      const item = {
        ...record,
        owner: parts.owner,
        ownerKey: nameKeyOf(parts.owner),
        page: parts.page
      };
      index.records.push(item);
      catalogAppend(index.byOwner, item.ownerKey, item);
    });
    index.records.sort((left, right) => left.index - right.index);
    index.byOwner.forEach(records => records.sort((left, right) =>
      left.page - right.page || left.index - right.index
    ));
    catalog.pagedLabels.set(labelKey, index);
    return index;
  }

  function catalogPagedCards(name, label) {
    return (catalogPagedLabel(label).byOwner.get(nameKeyOf(name)) || [])
      .map(record => ({ card: record.card, page: record.page }));
  }

  function catalogCardOrder(card) {
    const index = currentCardCatalog().indexByCard.get(card);
    return Number.isInteger(index) ? index : -1;
  }

  function restoreVisibleCardTitle(card, intendedTitle) {
    const logicalTitle = line(intendedTitle, 220);
    if (!card || !logicalTitle) return card;
    try {
      const priorTitle = card.title;
      card.title = logicalTitle;
      if (priorTitle !== card.title) invalidateCardCatalog();
    } catch (error) {
      debug("Could not restore the visible Story Card title " + logicalTitle + ": " + error.message);
    }
    return card;
  }

  function restoreRawVisibleCardTitle(card, intendedTitle) {
    if (!card) return card;
    const exactTitle = textOf(intendedTitle);
    try {
      const priorTitle = rawVisibleTitleOf(card);
      card.title = exactTitle;
      if (priorTitle !== rawVisibleTitleOf(card)) invalidateCardCatalog();
    } catch (error) {
      debug("Could not restore the exact visible Story Card title: " + error.message);
    }
    return card;
  }

  function managedCardIdentityMatches(card, intendedTitle) {
    const logicalTitle = line(intendedTitle || titleOf(card), 220);
    return !!(card && logicalTitle
      && textOf(card.keys).trim() === managedCardKey(logicalTitle)
      && keyOf(visibleTitleOf(card)) === keyOf(logicalTitle));
  }

  function exactCardFieldsMatch(card, keys, entry, type, intendedTitle, exactVisibleTitle = false) {
    const suppliedTitle = textOf(intendedTitle);
    const logicalTitle = line(suppliedTitle, 220);
    return !!(card
      && textOf(card.keys) === textOf(keys)
      && entryOf(card) === textOf(entry)
      && textOf(card.type) === textOf(type)
      && (exactVisibleTitle
        ? rawVisibleTitleOf(card) === suppliedTitle
        : (!logicalTitle || keyOf(visibleTitleOf(card)) === keyOf(logicalTitle))));
  }

  function physicalCardPresent(card) {
    if (!card) return false;
    if (cards.includes(card)) return true;
    const id = card.id === null || card.id === undefined ? "" : textOf(card.id);
    return !!(id && cards.some(candidate => candidate
      && candidate.id !== null && candidate.id !== undefined
      && textOf(candidate.id) === id));
  }

  function uniqueCards(values) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(card => {
      if (card && !result.includes(card)) result.push(card);
    });
    return result;
  }

  function physicalCardId(card) {
    return card && card.id !== null && card.id !== undefined
      ? textOf(card.id)
      : "";
  }

  function exactCardImage(card, index, idOccurrence, imageOccurrence) {
    return {
      card,
      index,
      id: physicalCardId(card),
      idOccurrence,
      imageOccurrence,
      visibleTitle: rawVisibleTitleOf(card),
      keys: textOf(card && card.keys),
      entry: entryOf(card),
      type: textOf(card && card.type)
    };
  }

  function exactCardImageKey(value) {
    const card = value && value.card ? value.card : value;
    return JSON.stringify([
      physicalCardId(card),
      rawVisibleTitleOf(card),
      textOf(card && card.keys),
      entryOf(card),
      textOf(card && card.type)
    ]);
  }

  function capturePhysicalCardDeck() {
    const idCounts = {};
    const imageCounts = {};
    return cards.map((card, index) => {
      const id = physicalCardId(card);
      const imageKey = exactCardImageKey(card);
      const idOccurrence = idCounts[id] || 0;
      const imageOccurrence = imageCounts[imageKey] || 0;
      idCounts[id] = idOccurrence + 1;
      imageCounts[imageKey] = imageOccurrence + 1;
      return exactCardImage(card, index, idOccurrence, imageOccurrence);
    });
  }

  function exactCardMatchesImage(card, image) {
    return !!(card && image
      && physicalCardId(card) === image.id
      && rawVisibleTitleOf(card) === image.visibleTitle
      && textOf(card.keys) === image.keys
      && entryOf(card) === image.entry
      && textOf(card.type) === image.type);
  }

  function resolvePhysicalCardImage(image, used, allowIndexFallback = false) {
    if (!image) return null;
    const unavailable = used instanceof Set ? used : new Set();
    if (image.card && cards.includes(image.card) && !unavailable.has(image.card)) {
      return image.card;
    }
    if (image.id) {
      const matches = cards.filter(card => physicalCardId(card) === image.id
        && !unavailable.has(card));
      if (matches.length === 1) return matches[0];
      const exactMatches = matches.filter(card => exactCardMatchesImage(card, image));
      if (exactMatches.length === 1) return exactMatches[0];
      if (exactMatches[image.idOccurrence]) return exactMatches[image.idOccurrence];
      return null;
    }
    const imageKey = JSON.stringify([
      image.id, image.visibleTitle, image.keys, image.entry, image.type
    ]);
    const exactMatches = cards.filter(card => exactCardImageKey(card) === imageKey
      && !unavailable.has(card));
    if (exactMatches[image.imageOccurrence]) return exactMatches[image.imageOccurrence];
    if (exactMatches.length === 1) return exactMatches[0];
    if (allowIndexFallback) {
      const indexed = cards[image.index] || null;
      if (indexed && !unavailable.has(indexed)) return indexed;
    }
    return null;
  }

  function mapPhysicalCardImages(images, allowIndexFallback = false) {
    const used = new Set();
    const mapped = (Array.isArray(images) ? images : []).map(image => {
      const card = resolvePhysicalCardImage(image, used, allowIndexFallback);
      if (card) used.add(card);
      return { image, card };
    });
    const unresolvedById = {};
    mapped.forEach(item => {
      if (item.card) return;
      const id = item.image.id;
      if (!unresolvedById[id]) unresolvedById[id] = [];
      unresolvedById[id].push(item);
    });
    Object.keys(unresolvedById).forEach(id => {
      const desired = unresolvedById[id];
      const candidates = cards.filter(card => physicalCardId(card) === id && !used.has(card));
      if (desired.length !== candidates.length) return;
      desired.sort((left, right) => left.image.index - right.image.index);
      candidates.sort((left, right) => cards.indexOf(left) - cards.indexOf(right));
      desired.forEach((item, index) => {
        item.card = candidates[index];
        used.add(candidates[index]);
      });
    });
    return { mapped, used, complete: mapped.every(item => !!item.card) };
  }

  function physicalDeckImageMultisetMatches(images) {
    const expected = (Array.isArray(images) ? images : []).map(image => JSON.stringify([
      image.id, image.visibleTitle, image.keys, image.entry, image.type
    ])).sort();
    const actual = cards.map(card => exactCardImageKey(card)).sort();
    return expected.length === actual.length
      && expected.every((value, index) => value === actual[index]);
  }

  function createExactCardImage(image) {
    const prior = capturePhysicalCardDeck();
    const cleanup = () => {
      const mapping = mapPhysicalCardImages(prior, false);
      if (!mapping.complete) return false;
      const additions = cards.filter(card => !mapping.used.has(card));
      additions.slice().sort((left, right) => cardIndex(right) - cardIndex(left))
        .forEach(card => { removeCard(card); });
      return physicalDeckImageMultisetMatches(prior);
    };
    try {
      addStoryCard(image.keys, image.entry, image.type);
      invalidateCardCatalog();
      const mapping = mapPhysicalCardImages(prior, true);
      if (!mapping.complete) {
        cleanup();
        return null;
      }
      const additions = cards.filter(card => !mapping.used.has(card));
      if (cards.length !== prior.length + 1 || additions.length !== 1) {
        cleanup();
        return null;
      }
      const created = restoreRawVisibleCardTitle(additions[0], image.visibleTitle);
      if (exactCardMatchesImage(created, image)) return created;
      cleanup();
      return null;
    } catch (error) {
      debug("Could not recreate an exact Story Card image: " + error.message);
      cleanup();
      return null;
    }
  }

  function restorePhysicalCardDeck(images) {
    const desired = Array.isArray(images) ? images : [];
    let mapping = mapPhysicalCardImages(desired, false);
    let extras = cards.filter(card => !mapping.used.has(card));
    if (mapping.complete) {
      extras.slice().sort((left, right) => cardIndex(right) - cardIndex(left))
        .forEach(card => { removeCard(card); });
    }
    mapping = mapPhysicalCardImages(desired, false);
    for (const item of mapping.mapped) {
      let card = item.card;
      if (!card) {
        if (item.image.id) continue;
        card = createExactCardImage(item.image);
        if (!card) continue;
      }
      if (!exactCardMatchesImage(card, item.image)) {
        const index = cardIndex(card);
        if (index < 0) continue;
        try {
          updateStoryCard(index, item.image.keys, item.image.entry, item.image.type);
          invalidateCardCatalog();
        } catch (error) {
          debug("Could not restore an exact Story Card image: " + error.message);
        }
        const used = new Set();
        card = resolvePhysicalCardImage(item.image, used, false) || card;
      }
      restoreRawVisibleCardTitle(card, item.image.visibleTitle);
    }
    invalidateCardCatalog();
    return physicalDeckImageMultisetMatches(desired);
  }

  function managedCardMatches(title) {
    const logicalTitle = line(title, 220);
    const wantedKey = managedCardKey(logicalTitle);
    return uniqueCards(
      catalogRecordsByTitle(logicalTitle).map(record => record.card)
        .concat(wantedKey ? catalogRecordsByRawKey(wantedKey).map(record => record.card) : [])
    );
  }

  function findCard(title) {
    const wantedKey = managedCardKey(title);
    const matches = catalogRecordsByTitle(title)
      .concat(wantedKey ? catalogRecordsByRawKey(wantedKey) : []);
    return firstCatalogCard(matches);
  }

  function cardIndex(card) {
    if (!card) return -1;
    const catalog = currentCardCatalog();
    const direct = catalog.indexByCard.get(card);
    if (Number.isInteger(direct)) return direct;
    const id = card.id === null || card.id === undefined ? "" : textOf(card.id);
    const idMatches = id ? (catalog.byId.get(id) || []) : [];
    const candidate = idMatches.length === 1 ? firstCatalogCard(idMatches) : null;
    const match = candidate && exactCardImageKey(candidate) === exactCardImageKey(card)
      ? candidate
      : null;
    return match ? catalog.indexByCard.get(match) : -1;
  }

  function extractLine(source, label) {
    const match = textOf(source).match(new RegExp(
      "^[ \\t]*(?:[\\{\\[][ \\t]*)?" + escapeRegExp(label)
      + "[ \\t]*:[ \\t]*([^\\r\\n]*?)[ \\t]*(?:[\\}\\]][ \\t]*)?$",
      "im"
    ));
    return match ? line(match[1], 2000) : "";
  }

  function updateCardAt(index, keys, entry, type, intendedTitle, preserveExactFields = false) {
    if (!Number.isInteger(index) || index < 0 || index >= cards.length) return null;
    const current = cards[index];
    const priorDeck = capturePhysicalCardDeck();
    const targetImage = priorDeck[index];
    const priorTitle = line(titleOf(current), 220);
    const logicalTitle = line(intendedTitle || priorTitle, 220);
    const nextKeys = preserveExactFields
      ? textOf(keys)
      : (textOf(keys).trim()
        ? textOf(keys)
        : (textOf(current && current.keys).trim()
          ? textOf(current.keys)
          : managedCardKey(logicalTitle)));
    const nextEntry = typeof entry === "string" ? entry : entryOf(current);
    const nextType = preserveExactFields
      ? textOf(type)
      : (textOf(type).trim()
        ? textOf(type)
        : (textOf(current && current.type).trim() ? textOf(current.type) : settings.CARD_TYPE));
    if (textOf(current && current.keys) === nextKeys
      && entryOf(current) === nextEntry
      && textOf(current && current.type) === nextType) {
      const unchanged = restoreVisibleCardTitle(current, logicalTitle);
      return exactCardFieldsMatch(unchanged, nextKeys, nextEntry, nextType, logicalTitle)
        ? unchanged
        : null;
    }
    const restorePrior = () => restorePhysicalCardDeck(priorDeck);
    const verifiedUpdatedCard = () => {
      if (cards.length !== priorDeck.length) return null;
      const mapping = mapPhysicalCardImages(priorDeck, false);
      let updated = mapping.mapped[index] && mapping.mapped[index].card;
      if (!updated) {
        const fallback = mapPhysicalCardImages(priorDeck, true);
        updated = fallback.mapped[index] && fallback.mapped[index].card;
        if (!fallback.complete) return null;
      } else if (!mapping.complete) {
        return null;
      }
      for (let position = 0; position < priorDeck.length; position += 1) {
        const item = mapping.mapped[position];
        if (position === index) continue;
        if (!item || !exactCardMatchesImage(item.card, item.image)) return null;
      }
      return exactCardFieldsMatch(updated, nextKeys, nextEntry, nextType, logicalTitle)
        ? updated
        : null;
    };
    try {
      updateStoryCard(index, nextKeys, nextEntry, nextType);
      invalidateCardCatalog();
      const resolved = resolvePhysicalCardImage(targetImage, new Set(), false);
      const updated = restoreVisibleCardTitle(resolved, logicalTitle);
      const verified = updated && verifiedUpdatedCard();
      if (!verified) {
        const restored = restorePrior();
        if (!restored) {
          markManagedTitlesDirty(
            [priorTitle, logicalTitle],
            "Incomplete write and rollback for " + (logicalTitle || priorTitle || "managed Story Card")
          );
        }
        debug("Rejected an incomplete Story Card write for "
          + (logicalTitle || priorTitle || nextKeys) + (restored ? "." : "; rollback was incomplete."));
        return null;
      }
      markManagedTitlesDirty(
        [priorTitle, logicalTitle],
        "Updated " + (logicalTitle || priorTitle || "managed Story Card")
      );
      return verified;
    } catch (error) {
      const restored = restorePrior();
      if (!restored) {
        markManagedTitlesDirty(
          [priorTitle, logicalTitle],
          "Failed write and rollback for " + (logicalTitle || priorTitle || "managed Story Card")
        );
      }
      debug("Could not update " + (titleOf(current) || nextKeys) + " through the Story Card API: " + error.message);
      return null;
    }
  }

  function saveCard(card, entry, intendedTitle) {
    const index = cardIndex(card);
    if (index < 0) return null;
    const current = cards[index] || card;
    const logicalTitle = line(intendedTitle || titleOf(current), 220);
    if (!logicalTitle) return null;
    return updateCardAt(
      index,
      managedCardKey(logicalTitle),
      entry,
      settings.CARD_TYPE,
      logicalTitle
    );
  }

  function addCardExact(title, keys, entry, type) {
    const cardTitle = line(title, 220);
    if (!cardTitle) return null;
    const cardKey = textOf(keys);
    const cardEntry = typeof entry === "string" ? entry : "";
    const cardType = textOf(type);
    const priorDeck = capturePhysicalCardDeck();
    const before = priorDeck.length;
    let created = null;
    try {
      addStoryCard(
        cardKey,
        cardEntry,
        cardType
      );
      invalidateCardCatalog();
      const mapping = mapPhysicalCardImages(priorDeck, false);
      const additions = cards.filter(card => card && !mapping.used.has(card));
      if (mapping.complete && additions.length === 1) created = additions[0];
      created = restoreVisibleCardTitle(created, cardTitle);
      if (cards.length !== before + 1
        || !mapping.complete
        || mapping.mapped.some(item => !exactCardMatchesImage(item.card, item.image))
        || !exactCardFieldsMatch(created, cardKey, cardEntry, cardType, cardTitle)) {
        const restored = restorePhysicalCardDeck(priorDeck);
        debug("Rejected an incomplete Story Card creation for " + cardTitle
          + (restored ? "." : "; cleanup was incomplete."));
        return null;
      }
    } catch (error) {
      debug("Could not create " + cardTitle + ": " + error.message);
      const restored = restorePhysicalCardDeck(priorDeck);
      if (!restored) debug("Creation cleanup was incomplete for " + cardTitle + ".");
      return null;
    }
    markManagedTitlesDirty(cardTitle, "Added " + cardTitle);
    return created;
  }

  function addCard(title, entry) {
    const cardTitle = line(title, 220);
    if (!cardTitle) return null;
    const cardKey = managedCardKey(cardTitle);
    const cardEntry = typeof entry === "string" ? entry : "";
    const matching = managedCardMatches(cardTitle);
    if (matching.length > 1) return null;
    if (matching.length === 1) {
      const existing = matching[0];
      if (textOf(existing.keys) !== cardKey || entryOf(existing) !== cardEntry
        || textOf(existing.type) !== settings.CARD_TYPE) return null;
      const restored = restoreVisibleCardTitle(existing, cardTitle);
      return exactCardFieldsMatch(
        restored, cardKey, cardEntry, settings.CARD_TYPE, cardTitle
      ) ? restored : null;
    }
    return addCardExact(cardTitle, cardKey, cardEntry, settings.CARD_TYPE);
  }

  function upsertCard(title, entry) {
    const matching = managedCardMatches(title);
    if (matching.length > 1) return null;
    const card = matching[0] || null;
    return card ? saveCard(card, entry) : addCard(title, entry);
  }

  function removeCard(card) {
    const index = cardIndex(card);
    if (index < 0) return false;
    const priorDeck = capturePhysicalCardDeck();
    const target = cards[index] || card;
    const removedTitle = titleOf(target);
    const before = cards.length;
    try {
      removeStoryCard(index);
      invalidateCardCatalog();
      const expected = priorDeck.filter((item, position) => position !== index);
      if (cards.length !== before - 1 || cards.includes(target)
        || !physicalDeckImageMultisetMatches(expected)) {
        const restored = restorePhysicalCardDeck(priorDeck);
        debug("Story Card removal could not be verified for "
          + (removedTitle || "the requested card")
          + (restored ? "." : "; rollback was incomplete."));
        return false;
      }
      markManagedTitlesDirty(removedTitle, "Removed " + (removedTitle || "managed Story Card"));
      return true;
    } catch (error) {
      const restored = restorePhysicalCardDeck(priorDeck);
      debug("Could not remove " + (titleOf(card) || "Story Card") + ": " + error.message);
      if (!restored) debug("Removal rollback was incomplete for " + (removedTitle || "Story Card") + ".");
      return false;
    }
  }

  function removeCards(cardList) {
    const targets = [];
    (Array.isArray(cardList) ? cardList : []).forEach(card => {
      if (card && cardIndex(card) >= 0 && !targets.includes(card)) targets.push(card);
    });
    targets.sort((left, right) => cardIndex(right) - cardIndex(left));
    if (!targets.length) return true;
    let removed = true;
    targets.forEach(card => { if (!removeCard(card)) removed = false; });
    return removed;
  }

  function namedTitle(name, label) {
    return ownedCardTitle(name, label);
  }

  function nameFromNamedTitle(title, label) {
    const cacheKey = textOf(label) + "\u241f" + textOf(title);
    if (namedCardOwnerCache.has(cacheKey)) return namedCardOwnerCache.get(cacheKey);
    const parts = ownedCardTitleParts(title);
    const owner = parts && parts.page === 1 && keyOf(parts.label) === keyOf(label)
      ? parts.owner
      : "";
    namedCardOwnerCache.set(cacheKey, owner);
    return owner;
  }

  function namedCards(name, label) {
    return catalogNamedCards(name, label);
  }

  function namedCard(name, label) {
    return catalogNamedCards(name, label)[0] || null;
  }

  const titleMigrationDiagnostics = [];
  const wrapperMigrationDiagnostics = [];

  function ownedEntryWrapperInfo(value, owner, headerLabel) {
    const source = textOf(value).replace(/\r/g, "");
    const rows = source.split("\n");
    const nonempty = rows.map((row, index) => ({ index, value: row.trim() }))
      .filter(item => item.value);
    const result = {
      source,
      rows,
      valid: false,
      combined: false,
      openingIndex: -1,
      headerIndex: -1,
      closingIndex: -1
    };
    if (nonempty.length < 3 || nonempty[nonempty.length - 1].value !== "}") return result;
    const wantedOwner = line(owner, 120);
    const wantedLabel = line(headerLabel, 120);
    if (!wantedOwner || !wantedLabel) return result;
    const combined = nonempty[0].value.match(
      /^\{\s*(.+?)['’]s\s+(.+?)\s*:\s*$/i
    );
    if (combined
      && sameNameForm(combined[1], wantedOwner)
      && keyOf(combined[2]) === keyOf(wantedLabel)) {
      return {
        ...result,
        valid: true,
        combined: true,
        openingIndex: nonempty[0].index,
        headerIndex: nonempty[0].index,
        closingIndex: nonempty[nonempty.length - 1].index
      };
    }
    if (nonempty[0].value !== "{") return result;
    const split = nonempty[1].value.match(
      /^(.+?)['’]s\s+(.+?)\s*:\s*$/i
    );
    if (!split
      || !sameNameForm(split[1], wantedOwner)
      || keyOf(split[2]) !== keyOf(wantedLabel)) {
      return result;
    }
    return {
      ...result,
      valid: true,
      combined: false,
      openingIndex: nonempty[0].index,
      headerIndex: nonempty[1].index,
      closingIndex: nonempty[nonempty.length - 1].index
    };
  }

  function canonicalOwnedEntryWrapper(value, owner, headerLabel) {
    const info = ownedEntryWrapperInfo(value, owner, headerLabel);
    if (!info.valid) {
      return { valid: false, changed: false, entry: info.source };
    }
    const bodyStart = info.combined ? info.openingIndex + 1 : info.headerIndex + 1;
    const body = info.rows.slice(bodyStart, info.closingIndex);
    const entry = [
      "{",
      line(owner, 120) + "'s " + line(headerLabel, 120) + ":",
      ...body,
      "}"
    ].join("\n");
    return {
      valid: true,
      changed: entry !== info.source,
      entry
    };
  }

  function physicalLogicalCardTitle(card) {
    const managed = managedTitleFromKey(card && card.keys);
    if (managed) return managed;
    const visible = visibleTitleOf(card);
    if (visible && !defaultScriptCardTitle(visible)) return visible;
    return managedTitleFromEntry(card);
  }

  function migrateOwnedCardTitles() {
    let migrated = 0;
    let failed = 0;
    cards.slice().forEach(card => {
      const physical = physicalLogicalCardTitle(card);
      const intended = canonicalOwnedCardTitle(physical);
      const intendedParts = ownedCardTitleParts(intended);
      // Turning Point routers intentionally retain creator-authored trigger keys
      // and card types. Their exact possessive titles are required instead of
      // converting them into ordinary non-triggered CC cards.
      if (intendedParts && keyOf(intendedParts.label) === keyOf(settings.TURNING_POINTS_LABEL)) return;
      if (!intended || managedCardIdentityMatches(card, intended)) return;
      const saved = saveCard(card, entryOf(card), intended);
      if (saved && managedCardIdentityMatches(saved, intended)) migrated += 1;
      else failed += 1;
    });
    if (migrated) {
      titleMigrationDiagnostics.push(
        "Migrated " + migrated + " character-owned card title"
          + (migrated === 1 ? "" : "s") + " to the possessive format in place."
      );
    }
    if (failed) {
      titleMigrationDiagnostics.push(
        failed + " character-owned card title" + (failed === 1 ? "" : "s")
          + " could not be migrated and remains readable through legacy-title compatibility."
      );
    }
  }

  function migrateOwnedEntryWrappers() {
    let migrated = 0;
    let failed = 0;
    cards.slice().forEach(card => {
      const parts = ownedCardTitleParts(physicalLogicalCardTitle(card));
      if (!parts || parts.page !== 1) return;
      const labelKey = keyOf(parts.label);
      const headerLabel = labelKey === keyOf(settings.OUTER_CHARACTER_LABEL)
        ? settings.OUTER_CHARACTER_LABEL
        : (labelKey === keyOf(settings.INNER_CHARACTER_LABEL)
          ? settings.INNER_CHARACTER_LABEL
          : (labelKey === keyOf(settings.STATE_LABEL) ? "current private State" : ""));
      if (!headerLabel) return;
      const normalized = canonicalOwnedEntryWrapper(entryOf(card), parts.owner, headerLabel);
      if (!normalized.valid || !normalized.changed) return;
      const saved = saveCard(card, normalized.entry, parts.title);
      if (saved && entryOf(saved) === normalized.entry) migrated += 1;
      else failed += 1;
    });
    if (migrated) {
      wrapperMigrationDiagnostics.push(
        "Migrated " + migrated + " Outer, Inner, or State entry wrapper"
          + (migrated === 1 ? "" : "s") + " to the split format in place."
      );
    }
    if (failed) {
      wrapperMigrationDiagnostics.push(
        failed + " legacy entry wrapper" + (failed === 1 ? "" : "s")
          + " could not be migrated and remains readable through compatibility parsing."
      );
    }
  }

  function ownedStructureMaintenanceSignature() {
    const rows = [];
    cards.forEach((card, index) => {
      if (!card) return;
      const physical = physicalLogicalCardTitle(card);
      const intended = canonicalOwnedCardTitle(physical);
      const parts = ownedCardTitleParts(intended);
      if (!intended || !parts) return;
      const label = keyOf(parts.label);
      let boundary = "";
      if ([settings.OUTER_CHARACTER_LABEL, settings.INNER_CHARACTER_LABEL, settings.STATE_LABEL]
        .some(value => keyOf(value) === label)) {
        const nonempty = entryOf(card).replace(/\r/g, "").split("\n")
          .map(row => row.trim()).filter(Boolean);
        boundary = hashString([
          nonempty[0] || "",
          nonempty[1] || "",
          nonempty[nonempty.length - 1] || ""
        ].join("\n"));
      }
      rows.push([
        index,
        intended,
        textOf(card.keys).trim(),
        visibleTitleOf(card),
        textOf(card.type).trim(),
        boundary
      ].join("\u241f"));
    });
    const joined = rows.join("\u241e");
    return rows.length + ":" + joined.length + ":" + hashString(joined)
      + ":" + hashString(rows.slice().reverse().join("\u241e"));
  }

  function managedStoreMaintenanceSignature() {
    const rows = currentCardCatalog().records.map(record => {
      const kind = storeKindForManagedTitle(record.title);
      if (!kind) return "";
      const entry = entryOf(record.card);
      return [
        record.index,
        kind,
        record.title,
        record.rawKey,
        textOf(record.card.type).trim(),
        entry.length,
        hashString(entry)
      ].join("\u241f");
    }).filter(Boolean);
    const joined = rows.join("\u241e");
    return rows.length + ":" + joined.length + ":" + hashString(joined)
      + ":" + hashString(rows.slice().reverse().join("\u241e"));
  }

  function duplicateCardEntrySignature(card) {
    return entryOf(card)
      .replace(/\r/g, "")
      .replace(/[ \t]+$/gm, "")
      .trim();
  }

  function strictBoundedWhole(value, fallback, minimum, maximum) {
    const source = textOf(value).trim();
    if (!/^\d+$/.test(source)) return { value: fallback, valid: false };
    const parsed = Number(source);
    if (!Number.isSafeInteger(parsed) || parsed < minimum || parsed > maximum) {
      return { value: fallback, valid: false };
    }
    return { value: parsed, valid: true };
  }

  function relationshipPaceSettings(source) {
    const presets = {
      slowburn: { name: "Slowburn", accumulated: 1, direct: 10, maxStages: 1 },
      balanced: { name: "Balanced", accumulated: 2, direct: 10, maxStages: 1 },
      fast: { name: "Fast", accumulated: 6, direct: 20, maxStages: 2 }
    };
    const rawPace = extractLine(source, "Relationship pace");
    const paceKey = keyOf(rawPace || settings.DEFAULT_RELATIONSHIP_PACE);
    const customAccumulated = strictBoundedWhole(
      extractLine(source, "Custom accumulated event value"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED,
      0,
      50
    );
    const customDirect = strictBoundedWhole(
      extractLine(source, "Custom direct event value"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT,
      0,
      50
    );
    const customMaxStages = strictBoundedWhole(
      extractLine(source, "Custom maximum stages per operation"),
      settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES,
      1,
      6
    );
    const warnings = [];
    let pace;
    if (paceKey === "custom") {
      if (!customAccumulated.valid || !customDirect.valid || !customMaxStages.valid) {
        pace = { ...presets.balanced };
        warnings.push("Invalid Custom relationship values fell back to Balanced.");
      } else {
        pace = {
          name: "Custom",
          accumulated: customAccumulated.value,
          direct: customDirect.value,
          maxStages: customMaxStages.value
        };
      }
    } else if (presets[paceKey]) {
      pace = { ...presets[paceKey] };
    } else {
      pace = { ...presets.balanced };
      warnings.push("Relationship pace was missing or invalid and fell back to Balanced.");
    }
    return { pace, warning: warnings.join(" ") };
  }

  function turningPointModeSetting(source) {
    const supplied = keyOf(extractLine(source, "Turning Point mode") || settings.DEFAULT_TURNING_POINT_MODE);
    if (["growth only", "growthonly"].includes(supplied)) {
      return { mode: "growth-only", warning: "" };
    }
    if (["all directions", "all direction", "all"].includes(supplied)) {
      return { mode: "all-directions", warning: "" };
    }
    if (["disabled", "off", "none"].includes(supplied)) {
      return { mode: "disabled", warning: "" };
    }
    return {
      mode: "growth-only",
      warning: "Turning Point mode was missing or invalid and fell back to Growth-only."
    };
  }

  function settingsTemplate() {
    return [
      "Enabled: " + (settings.DEFAULT_ENABLED !== false),
      "Continuity budget: " + settings.DEFAULT_CONTINUITY_BUDGET,
      "State lifetime: " + settings.DEFAULT_STATE_LIFETIME,
      "Maximum active NPCs: " + settings.DEFAULT_MAX_ACTIVE_NPCS,
      "Dynamic cast: " + (settings.DEFAULT_DYNAMIC_CAST !== false),
      "Side promotion interactions: " + settings.DEFAULT_SIDE_PROMOTION_INTERACTIONS,
      "Main inactivity limit: " + settings.DEFAULT_MAIN_INACTIVITY_LIMIT,
      "Relationship pace: " + settings.DEFAULT_RELATIONSHIP_PACE,
      "Custom accumulated event value: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED,
      "Custom direct event value: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT,
      "Custom maximum stages per operation: " + settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES,
      "Turning Point mode: " + settings.DEFAULT_TURNING_POINT_MODE,
      "Debug: " + (settings.DEFAULT_DEBUG === true)
    ].join("\n");
  }

  function hasSettingsField(source, label) {
    return new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:", "im").test(textOf(source));
  }

  function ensureRelationshipSettings(card) {
    if (!card) return { card: null, warning: "" };
    const source = entryOf(card);
    const additions = [
      ["Relationship pace", settings.DEFAULT_RELATIONSHIP_PACE],
      ["Custom accumulated event value", settings.DEFAULT_CUSTOM_RELATIONSHIP_ACCUMULATED],
      ["Custom direct event value", settings.DEFAULT_CUSTOM_RELATIONSHIP_DIRECT],
      ["Custom maximum stages per operation", settings.DEFAULT_CUSTOM_RELATIONSHIP_MAX_STAGES],
      ["Turning Point mode", settings.DEFAULT_TURNING_POINT_MODE]
    ].filter(([label]) => !hasSettingsField(source, label))
      .map(([label, value]) => label + ": " + value);
    if (!additions.length) return { card, warning: "" };
    const entry = [source.trimEnd(), additions.join("\n")].filter(Boolean).join("\n");
    const saved = saveCard(card, entry);
    return saved
      ? { card: saved, warning: "Added the missing Relationship and Turning Point controls to CC — Settings." }
      : { card, warning: "The missing Relationship or Turning Point controls could not be added to CC — Settings." };
  }

  function readRuntime() {
    const title = settings.SETTINGS_TITLE;
    let card = findCard(title);
    if (!card) {
      card = addCard(title, settingsTemplate());
    }
    if (card) card = saveCard(card, entryOf(card), title) || card;
    const settingsUpgrade = ensureRelationshipSettings(card);
    card = settingsUpgrade.card || card;
    const source = card ? entryOf(card) : "";
    const rawContinuityBudget = extractLine(source, "Continuity budget");
    const defaultContinuityBudget = settings.DEFAULT_CONTINUITY_BUDGET;
    const minimumContinuityBudget = settings.MIN_CONTINUITY_BUDGET;
    const parsedContinuityBudget = positiveWhole(rawContinuityBudget, defaultContinuityBudget);
    const continuityBudget = Math.max(minimumContinuityBudget, parsedContinuityBudget);
    const budgetWarning = rawContinuityBudget && parsedContinuityBudget !== Number(rawContinuityBudget)
      ? "Continuity budget was invalid and defaulted to " + defaultContinuityBudget + "."
      : (rawContinuityBudget && parsedContinuityBudget < minimumContinuityBudget
        ? "Continuity budget was raised to the required " + minimumContinuityBudget + "-token minimum."
      : (!rawContinuityBudget && card
        ? "Continuity budget was missing and defaulted to " + defaultContinuityBudget + "."
        : ""));
    const relationshipPace = relationshipPaceSettings(source);
    const turningPointMode = turningPointModeSetting(source);
    return {
      enabled: boolValue(extractLine(source, "Enabled"), settings.DEFAULT_ENABLED !== false),
      continuityBudget,
      stateLifetime: numberValue(
        extractLine(source, "State lifetime"),
        settings.DEFAULT_STATE_LIFETIME,
        1,
        12
      ),
      maxActive: numberValue(
        extractLine(source, "Maximum active NPCs"),
        settings.DEFAULT_MAX_ACTIVE_NPCS,
        1,
        settings.MAX_ACTIVE_NPCS
      ),
      dynamicCast: boolValue(
        extractLine(source, "Dynamic cast"),
        settings.DEFAULT_DYNAMIC_CAST !== false
      ),
      sidePromotionInteractions: numberValue(
        extractLine(source, "Side promotion interactions"),
        settings.DEFAULT_SIDE_PROMOTION_INTERACTIONS,
        1,
        999
      ),
      mainInactivityLimit: numberValue(
        extractLine(source, "Main inactivity limit"),
        settings.DEFAULT_MAIN_INACTIVITY_LIMIT,
        1,
        999
      ),
      debug: boolValue(extractLine(source, "Debug"), settings.DEFAULT_DEBUG === true),
      relationshipPace: relationshipPace.pace,
      turningPointMode: turningPointMode.mode,
      warning: [card ? "" : "The Settings card could not be created.", settingsUpgrade.warning, budgetWarning, relationshipPace.warning, turningPointMode.warning]
        .filter(Boolean).join(" ")
    };
  }

  const runtime = readRuntime();
  if (!runtime.enabled) {
    currentCardCatalog().records.filter(record => !!modelProjectionMarkerFromCard(record.card))
      .map(record => record.card)
      .sort((left, right) => cardIndex(right) - cardIndex(left))
      .forEach(removeCard);
    if (contextHook) {
      const frontMemory = beginFrontMemoryContext(originalText);
      const cleared = frontMemory.commit("");
      return finish(cleared.ok ? cleared.text : originalText);
    }
    clearOwnedFrontMemoryState();
    return finish(originalText);
  }

  function playerProfile() {
    let card = findCard(settings.PLAYER_TITLE);
    if (card) card = saveCard(card, entryOf(card), settings.PLAYER_TITLE) || card;
    const source = card ? entryOf(card) : "";
    const name = extractLine(source, "Name") || "the player";
    const raw = (extractLine(source, "Pronouns") || "they/them").split(/[\/|,;\s]+/).filter(Boolean);
    let forms;
    if (raw.length >= 5) forms = raw.slice(0, 5);
    else {
      const subject = keyOf(raw[0] || "they");
      if (subject === "she") forms = ["she", "her", "her", "hers", "herself"];
      else if (subject === "he") forms = ["he", "him", "his", "his", "himself"];
      else forms = ["they", "them", "their", "theirs", "themselves"];
    }
    return {
      name,
      aliases: [name],
      emergingAliases: [],
      subject: forms[0], object: forms[1], possessiveAdjective: forms[2],
      possessivePronoun: forms[3], reflexive: forms[4],
      agreement: keyOf(forms[0]) === "they" ? "plural" : "singular"
    };
  }

  const player = playerProfile();

  function resolvePlayerTokens(value) {
    const forms = {
      name: player.name,
      subject: player.subject,
      object: player.object,
      possessive_adjective: player.possessiveAdjective,
      possessiveadjective: player.possessiveAdjective,
      possessive_pronoun: player.possessivePronoun,
      possessivepronoun: player.possessivePronoun,
      reflexive: player.reflexive,
      is: player.agreement === "plural" ? "are" : "is",
      has: player.agreement === "plural" ? "have" : "has",
      does: player.agreement === "plural" ? "do" : "does",
      was: player.agreement === "plural" ? "were" : "was",
      s: player.agreement === "plural" ? "" : "s"
    };
    return textOf(value).replace(/{{\s*(player|Player|PLAYER)\.([a-zA-Z_]+)\s*}}/g, (match, owner, field) => {
      const replacement = forms[keyOf(field).replace(/\s+/g, "_")];
      if (replacement === undefined) return match;
      if (owner === "PLAYER") return textOf(replacement).toUpperCase();
      if (owner === "Player") return replacement ? replacement.charAt(0).toUpperCase() + replacement.slice(1) : replacement;
      return replacement;
    });
  }

  function normalizeCastStatus(value, fallback) {
    const normalized = keyOf(value);
    if (normalized === "main" || normalized === "side") return normalized;
    return fallback;
  }

  function parseOuterPronouns(source) {
    const parts = textOf(extractLine(source, "Name, age, gender, pronouns"))
      .split(",")
      .map(value => value.trim());
    let pronouns = "";
    if (parts.length >= 4) {
      pronouns = line(parts.pop(), 120);
    } else {
      parts.shift();
      parts.shift();
      parts.shift();
      pronouns = line(parts.join(","), 120);
    }
    return pronouns;
  }

  function shortenProfileValue(value, maximum) {
    const source = line(value, 20000);
    const max = Math.max(1, Number(maximum) || 1);
    if (source.length <= max) return source;
    if (max === 1) return "…";
    const candidate = source.slice(0, max - 1).trimEnd();
    const wordBreak = candidate.lastIndexOf(" ");
    const kept = wordBreak >= Math.floor(max * 0.55)
      ? candidate.slice(0, wordBreak)
      : candidate;
    return kept.replace(/[,:;\-/]+$/g, "").trimEnd() + "…";
  }

  function renderOuterBlock(name, fields) {
    return [
      "{",
      name + "'s Outer:",
      ...fields.map(field => field.label + ": " + field.value),
      "}"
    ].join("\n");
  }

  function outerWrapperStatus(source) {
    const trimmed = textOf(source).replace(/\r/g, "").trim();
    return {
      opening: trimmed.startsWith("{"),
      closing: trimmed.endsWith("}")
    };
  }

  function buildOuterProfile(name, source) {
    const resolved = resolvePlayerTokens(source);
    const fields = [
      { label: "Name, age, gender, pronouns", value: extractLine(resolved, "Name, age, gender, pronouns") },
      { label: "Race/Species", value: extractLine(resolved, "Race/Species") },
      { label: "Physical attributes", value: extractLine(resolved, "Physical attributes") },
      { label: "Clothing style", value: extractLine(resolved, "Clothing style") }
    ].map(field => ({ label: field.label, value: line(field.value, 20000) }));
    const original = renderOuterBlock(name, fields);
    const maximum = settings.MAX_OUTER_CARD_CHARS;
    const fitted = fields.map(field => ({ label: field.label, value: field.value }));
    let rendered = original;
    let guard = 0;
    while (rendered.length > maximum && guard < 40) {
      guard += 1;
      const candidates = fitted.map((field, index) => ({
        index,
        reducible: Math.max(0, field.value.length - 24)
      })).filter(item => item.reducible > 0)
        .sort((left, right) => right.reducible - left.reducible || left.index - right.index);
      if (!candidates.length) break;
      const selected = candidates[0];
      const overflow = rendered.length - maximum;
      const reduction = Math.min(selected.reducible, Math.max(1, overflow));
      fitted[selected.index].value = shortenProfileValue(
        fitted[selected.index].value,
        fitted[selected.index].value.length - reduction
      );
      rendered = renderOuterBlock(name, fitted);
    }
    if (rendered.length > maximum) rendered = wrappedLine(rendered, maximum);
    return {
      text: rendered,
      originalChars: original.length,
      retainedChars: rendered.length,
      truncated: original.length > rendered.length,
      missing: fields.filter(field => !field.value).map(field => field.label)
    };
  }

  function renderInnerBlock(name, fields) {
    return [
      "{",
      name + "'s Inner:",
      ...fields.map(field => field.label + ": " + field.value),
      "}"
    ].join("\n");
  }

  function buildInnerProfile(name, source) {
    const resolved = resolvePlayerTokens(source);

    const fields = [
      { label: "Personality", value: extractLine(resolved, "Personality") },
      { label: "Mannerisms", value: extractLine(resolved, "Mannerisms") },
      { label: "Wants", value: extractLine(resolved, "Wants") },
      { label: "Fears", value: extractLine(resolved, "Fears") },
      { label: "Mental wounds", value: extractLine(resolved, "Mental wounds") },
      { label: "Principles", value: extractLine(resolved, "Principles") }
    ].map(field => ({ label: field.label, value: line(field.value, 20000) }));
    const original = renderInnerBlock(name, fields);
    const maximum = settings.MAX_INNER_CARD_CHARS;
    const fitted = fields.map(field => ({ label: field.label, value: field.value }));
    let rendered = original;
    let guard = 0;
    while (rendered.length > maximum && guard < 60) {
      guard += 1;
      const candidates = fitted.map((field, index) => ({
        index,
        reducible: Math.max(0, field.value.length - 24)
      })).filter(item => item.reducible > 0)
        .sort((left, right) => right.reducible - left.reducible || left.index - right.index);
      if (!candidates.length) break;
      const selected = candidates[0];
      const overflow = rendered.length - maximum;
      const reduction = Math.min(selected.reducible, Math.max(1, overflow));
      fitted[selected.index].value = shortenProfileValue(
        fitted[selected.index].value,
        fitted[selected.index].value.length - reduction
      );
      rendered = renderInnerBlock(name, fitted);
    }
    if (rendered.length > maximum) rendered = wrappedLine(rendered, maximum);
    return {
      text: rendered,
      originalChars: original.length,
      retainedChars: rendered.length,
      truncated: original.length > rendered.length,
      missing: fields.filter(field => !field.value).map(field => field.label)
    };
  }

  const activeRosterDiagnostics = [];

  function activeNpcSlotCode(number) {
    const slot = Number(number);
    return Number.isSafeInteger(slot) && slot >= 1 && slot <= settings.MAX_ACTIVE_NPCS
      ? "N" + slot
      : "";
  }

  function activeNpcRosterEntry(slotNames) {
    const names = Array.isArray(slotNames) ? slotNames : [];
    const rows = ["{", "Active NPC slots:"];
    for (let index = 0; index < settings.MAX_ACTIVE_NPCS; index++) {
      rows.push(activeNpcSlotCode(index + 1) + ": " + line(names[index], 120));
    }
    rows.push("}");
    return rows.join("\n");
  }

  function activeNpcRosterName(value) {
    const source = textOf(value).trim();
    if (!source || source.length > 120 || /[{}\[\]|\r\n]/.test(source)) return "";
    return line(source, 120);
  }

  function readActiveNpcRoster() {
    const matching = catalogRecordsByTitle(settings.ACTIVE_NPCS_TITLE)
      .map(record => record.card);
    let card = matching[0] || null;
    const slots = Array.from({ length: settings.MAX_ACTIVE_NPCS }, (_, index) => ({
      number: index + 1,
      code: activeNpcSlotCode(index + 1),
      name: "",
      valid: true
    }));
    if (!card) return { card: null, slots, source: "", wrapperValid: true };
    if (matching.length > 1) {
      activeRosterDiagnostics.push("Multiple CC — Active NPCs cards were found; only the first is authoritative.");
    }
    if (textOf(card.type) !== settings.CARD_TYPE
      || !managedCardIdentityMatches(card, settings.ACTIVE_NPCS_TITLE)) {
      const updated = saveCard(card, entryOf(card), settings.ACTIVE_NPCS_TITLE);
      if (updated) card = updated;
      else activeRosterDiagnostics.push("CC — Active NPCs could not be internalized as a Continuity card.");
    }
    const source = entryOf(card);
    const trimmed = textOf(source).replace(/\r/g, "").trim();
    const wrapperValid = trimmed.startsWith("{") && trimmed.endsWith("}");
    if (!wrapperValid) activeRosterDiagnostics.push("CC — Active NPCs wrapper { } is incomplete.");
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    slots.forEach(slot => {
      const pattern = new RegExp("^[ \\t]*" + escapeRegExp(slot.code) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i");
      const matches = rows.map(row => row.match(pattern)).filter(Boolean);
      if (matches.length !== 1) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " must appear exactly once in CC — Active NPCs.");
        return;
      }
      const supplied = textOf(matches[0][1]).trim();
      if (!supplied) return;
      const name = activeNpcRosterName(supplied);
      if (!name || name !== supplied) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " contained an invalid or overlong canonical NPC name.");
        return;
      }
      slot.name = name;
    });
    rows.forEach(row => {
      const match = row.match(/^[ \\t]*N(\d+)[ \\t]*:/i);
      if (match && !activeNpcSlotCode(Number(match[1]))) {
        activeRosterDiagnostics.push("Unsupported active NPC slot N" + Number(match[1]) + " was ignored.");
      }
    });
    const seen = {};
    slots.forEach(slot => {
      if (!slot.valid || !slot.name) return;
      const key = nameKeyOf(slot.name);
      if (seen[key]) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " duplicated " + seen[key] + " and was ignored without compacting the roster.");
      } else seen[key] = slot.code;
    });
    return { card, slots, source, wrapperValid };
  }

  function onboardingMarkerPresent(source) {
    return /^[ \\t]*Onboarding[ \\t]*:[ \\t]*Pending[ \\t]*$/im.test(textOf(source));
  }

  const ONBOARDING_VIEW_CATEGORIES = ["Loves", "Likes", "Neutrals", "Dislikes", "Hates"];
  const ONBOARDING_RELATIONSHIP_FIELDS = ["Role", "Trust", "Closeness", "Boundaries", "Conflict"];
  const ONBOARDING_RELATIONSHIP_STAGES = {
    Role: [
      { label: "Emerging", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Established", minimum: 10, maximum: 19, midpoint: 15 }
    ],
    Trust: [
      { label: "Severe distrust", minimum: -20, maximum: -11, midpoint: -15 },
      { label: "Distrust", minimum: -10, maximum: -1, midpoint: -5 },
      { label: "Guarded", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Unproven", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Cautious trust", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Trust", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Deep trust", minimum: 40, maximum: 49, midpoint: 45 }
    ],
    Closeness: [
      { label: "Disconnected", minimum: -20, maximum: -11, midpoint: -15 },
      { label: "Distant", minimum: -10, maximum: -1, midpoint: -5 },
      { label: "Acquainted", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Familiar", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Close", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Deeply close", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Intimate", minimum: 40, maximum: 49, midpoint: 45 }
    ],
    Boundaries: [
      { label: "Implied", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Explicit", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Reinforced", minimum: 20, maximum: 29, midpoint: 25 }
    ],
    Conflict: [
      { label: "Clear", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Friction", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Strain", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Open conflict", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Rupture", minimum: 40, maximum: 49, midpoint: 45 }
    ]
  };
  const ONBOARDING_NAME_PLACEHOLDERS = [
    "First Name",
    "Surname",
    "Title",
    "Accepted Nickname",
    "Rejected Nickname"
  ];

  function onboardingFieldRows(source, label) {
    const pattern = new RegExp(
      "^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$",
      "i"
    );
    return textOf(source).replace(/\r/g, "").split("\n")
      .map((row, index) => {
        const match = row.match(pattern);
        return match ? { index, value: line(match[1], 4000) } : null;
      })
      .filter(Boolean);
  }

  function onboardingReadyValue(source) {
    const matches = onboardingFieldRows(source, "Ready");
    if (matches.length !== 1) return "";
    const normalized = keyOf(matches[0].value);
    return normalized === "yes" || normalized === "no" ? normalized : "";
  }

  function onboardingProfileHeaderValid(source, name, label) {
    return ownedEntryWrapperInfo(source, name, label).valid;
  }

  function onboardingMissingDetails(outerSource, innerSource, innerConflict) {
    const missing = [];
    const outerWrapper = outerWrapperStatus(outerSource);
    if (!outerWrapper.opening || !outerWrapper.closing) missing.push("Outer wrapper { }");
    const identityParts = textOf(extractLine(outerSource, "Name, age, gender, pronouns"))
      .split(",").map(value => value.trim());
    if (identityParts.length < 4 || identityParts.slice(0, 4).some(value => !value)) {
      missing.push("Name, age, gender, pronouns");
    }
    ["Race/Species", "Physical attributes", "Clothing style"].forEach(label => {
      if (!extractLine(outerSource, label)) missing.push(label);
    });
    if (!normalizeCastStatus(extractLine(outerSource, "Starting status"), "")) {
      missing.push("Starting status");
    }
    if (innerConflict) missing.push("one unambiguous Inner card");
    else if (!innerSource) missing.push("Inner card");
    else {
      const innerWrapper = outerWrapperStatus(innerSource);
      if (!innerWrapper.opening || !innerWrapper.closing) missing.push("Inner wrapper { }");
      ["Personality", "Mannerisms", "Wants", "Fears", "Mental wounds", "Principles"].forEach(label => {
        if (!extractLine(innerSource, label)) missing.push(label);
      });
    }
    return missing;
  }

  function onboardingOuterTemplate(name) {
    return [
      "{",
      name + "'s Outer:",
      "Onboarding: Pending",
      "Ready: No",
      "Name, age, gender, pronouns: ",
      "Race/Species: ",
      "Physical attributes: ",
      "Clothing style: ",
      "Starting status: ",
      "}"
    ].join("\n");
  }

  function onboardingInnerTemplate(name) {
    return [
      "{",
      name + "'s Inner:",
      "Onboarding: Pending",
      "Personality: ",
      "Mannerisms: ",
      "Wants: ",
      "Fears: ",
      "Mental wounds: ",
      "Principles: ",
      "}"
    ].join("\n");
  }

  function onboardingNamesTemplate(name) {
    return [
      "{",
      name + "'s Names:",
      "Canonical: " + name,
      "",
      "Alias: ",
      "Status: ",
      "Use: ",
      "Progress: ",
      "Reason: ",
      "}"
    ].join("\n");
  }

  function onboardingViewsTemplate(name) {
    return [
      "{",
      name + "'s Views:",
      "Loves:",
      "Likes:",
      "Neutrals:",
      "Dislikes:",
      "Hates:",
      "}"
    ].join("\n");
  }

  function onboardingRelationshipsTemplate(name) {
    return [
      "{",
      name + "'s Relationships:",
      "About: ",
      "Role: ",
      "Trust: ",
      "Closeness: ",
      "Boundaries: ",
      "Conflict: ",
      "}"
    ].join("\n");
  }

  function onboardingExperiencesTitle(name) {
    return ownedCardTitle(name, settings.EXPERIENCES_LABEL);
  }

  function onboardingExperiencesTemplate(name) {
    return [
      "{",
      name + "'s Experiences:",
      "About: ",
      "Experience: ",
      "}"
    ].join("\n");
  }

  function onboardingInsertControls(source, includeReady) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    if (!onboardingMarkerPresent(source)) {
      const profileHeader = rows.findIndex(row =>
        /^.*?['’]s[ \t]+(?:Outer|Inner)[ \t]*:[ \t]*$/i.test(row.trim())
      );
      const opening = rows.findIndex(row => row.trim());
      const insertion = profileHeader >= 0 ? profileHeader + 1 : Math.max(0, opening + 1);
      rows.splice(insertion, 0, "Onboarding: Pending");
    }
    if (includeReady && !onboardingFieldRows(rows.join("\n"), "Ready").length) {
      const marker = rows.findIndex(row => /^[ \t]*Onboarding[ \t]*:/i.test(row));
      rows.splice(Math.max(0, marker + 1), 0, "Ready: No");
    }
    return rows.join("\n");
  }

  function onboardingWithoutControls(source) {
    return textOf(source).replace(/\r/g, "").split("\n")
      .filter(row => !/^[ \t]*(?:Onboarding|Ready)[ \t]*:/i.test(row))
      .join("\n");
  }

  function onboardingOuterNames() {
    return catalogNamedOwners(settings.OUTER_CHARACTER_LABEL);
  }

  function onboardingCanonicalPermission(value) {
    const supplied = line(value, 160);
    const normalized = nameKeyOf(supplied);
    if (normalized === "general") return "General";
    if (normalized === "none") return "None";
    if (["player", "the player", "you", nameKeyOf(player.name)].includes(normalized)) return "Player";
    const matches = onboardingOuterNames().filter(name => sameNameForm(name, supplied));
    return matches.length === 1 ? matches[0] : "";
  }

  function onboardingCanonicalTarget(ownerName, value, allowSelf, allowUnknown) {
    const supplied = line(value, 160);
    const normalized = nameKeyOf(supplied);
    if (!normalized) return "";
    if (allowSelf && (normalized === "self" || sameNameForm(supplied, ownerName))) return "Self";
    if (["player", "the player", "you", nameKeyOf(player.name)].includes(normalized)) return "Player";
    const matches = onboardingOuterNames().filter(name => sameNameForm(name, supplied));
    if (matches.length === 1 && !sameNameForm(matches[0], ownerName)) return matches[0];
    return allowUnknown && !/[{}\[\]|\r\n]/.test(supplied) ? supplied : "";
  }

  function onboardingValidateProfile(name, label, source, maximum) {
    const errors = [];
    if (!onboardingProfileHeaderValid(source, name, label)) {
      errors.push(label + " wrapper or owner header is invalid");
    }
    const required = label === "Outer"
      ? ["Name, age, gender, pronouns", "Race/Species", "Physical attributes", "Clothing style", "Starting status"]
      : ["Personality", "Mannerisms", "Wants", "Fears", "Mental wounds", "Principles"];
    required.forEach(field => {
      const matches = onboardingFieldRows(source, field);
      if (matches.length !== 1 || !matches[0].value) {
        errors.push(label + " requires one filled " + field + " line");
      }
    });
    if (label === "Outer") {
      const identity = onboardingFieldRows(source, "Name, age, gender, pronouns");
      const parts = identity.length === 1
        ? identity[0].value.split(",").map(value => value.trim())
        : [];
      if (parts.length < 4 || parts.slice(0, 4).some(value => !value)) {
        errors.push("Outer identity needs name, age, gender, and pronouns");
      } else if (!sameNameForm(parts[0], name)) {
        errors.push("Outer identity name must match the canonical owner " + name);
      }
      const status = onboardingFieldRows(source, "Starting status");
      if (status.length === 1 && !normalizeCastStatus(status[0].value, "")) {
        errors.push("Outer Starting status must be Main or Side");
      }
      if (onboardingFieldRows(source, "Ready").length !== 1 || !onboardingReadyValue(source)) {
        errors.push("Outer requires exactly one Ready: No or Ready: Yes line");
      }
    } else if (onboardingFieldRows(source, "Ready").length) {
      errors.push("Ready belongs only in Outer");
    }
    const markerRows = onboardingFieldRows(source, "Onboarding");
    if (markerRows.length !== 1 || keyOf(markerRows[0].value) !== "pending") {
      errors.push(label + " requires exactly one Onboarding: Pending line");
    }
    const entry = onboardingWithoutControls(source);
    if (entry.length > maximum) errors.push(label + " exceeds its character limit");
    return { entry, errors };
  }

  function onboardingCanonicalProgress(value) {
    const raw = line(value, 2000);
    if (!raw) return { ok: true, value: "" };
    const segments = raw.split(/\s*;\s*/).filter(Boolean);
    const normalized = [];
    for (const segment of segments) {
      const bare = segment.match(/^(\d+)\s*\/\s*(\d+)$/);
      const named = segment.match(/^(.+?)\s+(\d+)\s*\/\s*(\d+)$/);
      const permission = onboardingCanonicalPermission(bare ? "General" : (named ? named[1] : ""));
      const count = Number(bare ? bare[1] : (named && named[2]));
      const threshold = Number(bare ? bare[2] : (named && named[3]));
      if (!permission || permission === "None" || !Number.isSafeInteger(count)
        || count < 1 || count >= settings.NAME_ESTABLISHMENT_CONFIRMATIONS
        || threshold !== settings.NAME_ESTABLISHMENT_CONFIRMATIONS) {
        return { ok: false, value: raw };
      }
      normalized.push(permission + " " + count + "/" + threshold);
    }
    return { ok: true, value: unique(normalized, 200).join("; ") };
  }

  function onboardingPageEnvelope(source, expectedHeader) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    const nonempty = rows.map((value, index) => ({ value: value.trim(), index }))
      .filter(item => item.value);
    const closingValid = nonempty.length > 0
      && nonempty[nonempty.length - 1].value === "}";
    const split = nonempty.length >= 2
      && nonempty[0].value === "{"
      && nameKeyOf(nonempty[1].value) === nameKeyOf(expectedHeader);
    const combinedHeader = nonempty.length
      && nonempty[0].value.startsWith("{")
      ? nonempty[0].value.slice(1).trim()
      : "";
    const combined = !!combinedHeader
      && nameKeyOf(combinedHeader) === nameKeyOf(expectedHeader);
    const headerIndex = split
      ? nonempty[1].index
      : (combined ? nonempty[0].index : -1);
    return {
      rows,
      nonempty,
      recognized: closingValid && (split || combined),
      canonical: closingValid && split,
      combined,
      headerIndex,
      bodyStart: headerIndex >= 0 ? headerIndex + 1 : 0,
      closingIndex: nonempty.length ? nonempty[nonempty.length - 1].index : rows.length
    };
  }

  function onboardingCanonicalNames(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Names:");
    const rows = envelope.rows;
    const nonempty = envelope.nonempty;
    const errors = [];
    if (nonempty.length < 3 || !envelope.recognized) {
      errors.push("Names wrapper or owner header is invalid");
    }
    const canonicalRows = onboardingFieldRows(source, "Canonical");
    if (canonicalRows.length !== 1 || !sameNameForm(canonicalRows[0].value, name)) {
      errors.push("Names requires Canonical: " + name);
    }
    const canonicalIndex = canonicalRows.length ? canonicalRows[0].index : envelope.headerIndex;
    const closingIndex = envelope.closingIndex;
    const starts = [];
    for (let index = canonicalIndex + 1; index < closingIndex; index++) {
      if (/^[ \t]*Alias[ \t]*:/i.test(rows[index])) starts.push(index);
    }
    const firstStart = starts.length ? starts[0] : closingIndex;
    for (let index = canonicalIndex + 1; index < firstStart; index++) {
      if (rows[index].trim()) errors.push("Names has content outside an Alias record");
    }
    const records = [];
    const seen = new Set();
    starts.forEach((start, recordIndex) => {
      const end = recordIndex + 1 < starts.length ? starts[recordIndex + 1] : closingIndex;
      const recordRows = rows.slice(start, end).filter(row => row.trim());
      const aliasMatch = recordRows[0] && recordRows[0].match(
        /^[ \t]*Alias[ \t]*:[ \t]*(.*?)[ \t]*$/i
      );
      const alias = aliasMatch ? line(aliasMatch[1], 160) : "";
      if (ONBOARDING_NAME_PLACEHOLDERS.some(value => sameNameForm(value, alias))) return;
      const labels = ["Alias", "Status", "Use", "Progress", "Reason"];
      const values = {};
      if (recordRows.length !== labels.length) {
        errors.push("Names Alias " + (alias || "record") + " must contain exactly five fields");
        return;
      }
      labels.forEach((label, index) => {
        const match = recordRows[index].match(
          new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i")
        );
        if (!match) {
          errors.push("Names Alias " + (alias || "record")
            + " has a missing or reordered " + label + " field");
        }
        values[label] = match ? line(match[1], 4000) : "";
      });
      if (labels.every(label => !values[label])) return;
      if (!alias || sameNameForm(alias, name) || /[{}\[\]|\r\n]/.test(alias)) {
        errors.push("Names contains an empty, canonical, or structurally unsafe Alias");
        return;
      }
      const aliasKey = nameKeyOf(alias);
      if (seen.has(aliasKey)) errors.push("Names repeats Alias " + alias);
      seen.add(aliasKey);
      const status = ["Emerging", "Active", "Retired", "Rejected"]
        .find(value => sameNameForm(value, values.Status));
      if (!status) errors.push("Names Alias " + alias + " has an unsupported Status");
      const uses = values.Use.split(/\s*,\s*/).filter(Boolean)
        .map(onboardingCanonicalPermission);
      if (!uses.length || uses.some(value => !value)
        || ((uses.includes("General") || uses.includes("None")) && new Set(uses).size > 1)) {
        errors.push("Names Alias " + alias + " has an invalid Use permission");
      }
      const use = unique(uses.filter(Boolean), 160).join(", ");
      const progress = onboardingCanonicalProgress(values.Progress);
      if (!progress.ok) errors.push("Names Alias " + alias + " has invalid Progress");
      const suppliedReason = wholeLine(values.Reason, 0);
      const baselineReasons = {
        "replace with an accepted first name form or delete this record": "Creator-approved first-name form.",
        "replace with an accepted surname or delete this record": "Creator-approved surname.",
        "replace with an accepted title or delete this record": "Creator-approved title.",
        "replace with a nickname accepted from the player or delete this record":
          "Creator-approved nickname accepted from the Player.",
        [keyOf("Replace with a nickname " + name + " rejects, or delete this record.")]:
          "Creator-marked nickname that " + name + " rejects."
      };
      const reason = baselineReasons[keyOf(suppliedReason)] || suppliedReason;
      if (!reason || /[{}\[\]]/.test(reason)) {
        errors.push("Names Alias " + alias + " needs a safe Reason");
      }
      records.push({
        alias,
        status: status || values.Status,
        use: status === "Retired" || status === "Rejected" ? "None" : use,
        progress: status === "Retired" || status === "Rejected" ? "" : progress.value,
        reason
      });
    });
    const entryRows = ["{", name + "'s Names:", "Canonical: " + name];
    records.forEach(record => {
      entryRows.push(
        "",
        "Alias: " + record.alias,
        "Status: " + record.status,
        "Use: " + record.use,
        "Progress: " + record.progress,
        "Reason: " + record.reason
      );
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_NAMES_CARD_CHARS) {
      errors.push("Names exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalViews(name, source) {
    const rows = textOf(source).replace(/\r/g, "").split("\n");
    const nonempty = rows.map((value, index) => ({ value: value.trim(), index }))
      .filter(item => item.value);
    const errors = [];
    if (nonempty.length < 7 || nonempty[0].value !== "{"
      || nameKeyOf(nonempty[1].value) !== nameKeyOf(name + "'s Views:")
      || nonempty[nonempty.length - 1].value !== "}") {
      errors.push("Views wrapper or owner header is invalid");
    }
    const grouped = {};
    ONBOARDING_VIEW_CATEGORIES.forEach(category => { grouped[category] = []; });
    let current = "";
    const headings = [];
    const seenTargets = new Set();
    const bodyStart = nonempty.length >= 2 ? nonempty[1].index + 1 : 0;
    const closingIndex = nonempty.length ? nonempty[nonempty.length - 1].index : rows.length;
    for (let index = bodyStart; index < closingIndex; index++) {
      const row = rows[index].trim();
      if (!row) continue;
      const category = ONBOARDING_VIEW_CATEGORIES.find(
        value => keyOf(value + ":") === keyOf(row)
      );
      if (category) {
        current = category;
        headings.push(category);
        continue;
      }
      const match = row.match(/^(.+?)\s+(?:—|–|-)\s+(.+)$/);
      if (!current || !match) {
        errors.push("Views line " + (index + 1) + " is not under a valid category");
        continue;
      }
      const target = onboardingCanonicalTarget(name, match[1], true, true);
      const explanation = wholeLine(match[2], 0);
      if (!target || !explanation || /[{}\[\]]/.test(explanation)) {
        errors.push("Views line " + (index + 1) + " needs a safe target and explanation");
        continue;
      }
      const targetKey = nameKeyOf(target);
      if (seenTargets.has(targetKey)) errors.push("Views repeats target " + target);
      seenTargets.add(targetKey);
      grouped[current].push({ target, explanation });
    }
    if (headings.length !== ONBOARDING_VIEW_CATEGORIES.length
      || headings.some((value, index) => value !== ONBOARDING_VIEW_CATEGORIES[index])) {
      errors.push("Views requires Loves, Likes, Neutrals, Dislikes, and Hates once, in order");
    }
    const entryRows = ["{", name + "'s Views:"];
    ONBOARDING_VIEW_CATEGORIES.forEach(category => {
      entryRows.push(category + ":");
      grouped[category].forEach(record => {
        entryRows.push(record.target + " — " + record.explanation);
      });
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_VIEWS_CARD_CHARS) {
      errors.push("Views exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalRelationshipField(field, value) {
    const raw = line(value, 4000);
    if (!raw) return { ok: true, value: "" };
    const former = raw.match(/^Former(?:\s+(?:—|–|-)\s+(.+))?$/i);
    if (field === "Role" && former) {
      const description = line(former[1], 2000);
      return /[{}\[\]]/.test(description)
        ? { ok: false, value: raw }
        : { ok: true, value: "Former" + (description ? " — " + description : "") };
    }
    const stages = ONBOARDING_RELATIONSHIP_STAGES[field] || [];
    const numeric = raw.match(/^(-?\d+)\s*\(([^)]+)\)(?:\s+(?:—|–|-)\s+(.+))?$/);
    let stage;
    let score;
    let description;
    if (numeric) {
      const suppliedScore = Number(numeric[1]);
      if (!Number.isSafeInteger(suppliedScore) || !stages.length) {
        return { ok: false, value: raw };
      }
      score = Math.max(
        stages[0].minimum,
        Math.min(stages[stages.length - 1].maximum, suppliedScore)
      );
      stage = stages.find(item => score >= item.minimum && score <= item.maximum);
      description = line(numeric[3], 2000);
    } else {
      const stageOnly = raw.match(/^(.+?)(?:\s+(?:—|–|-)\s+(.+))?$/);
      stage = stageOnly && stages.find(item => sameNameForm(item.label, stageOnly[1]));
      if (!stage) return { ok: false, value: raw };
      score = stage.midpoint;
      description = line(stageOnly[2], 2000);
    }
    if (!stage || /[{}\[\]]/.test(description)) return { ok: false, value: raw };
    return {
      ok: true,
      value: score + " (" + stage.label + ")" + (description ? " — " + description : "")
    };
  }

  function onboardingCanonicalRelationships(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Relationships:");
    const rows = envelope.rows;
    const nonempty = envelope.nonempty;
    const errors = [];
    if (nonempty.length < 2 || !envelope.recognized) {
      errors.push("Relationships wrapper or owner header is invalid");
    }
    const bodyStart = envelope.bodyStart;
    const closingIndex = envelope.closingIndex;
    const starts = [];
    for (let index = bodyStart; index < closingIndex; index++) {
      if (/^[ \t]*About[ \t]*:/i.test(rows[index])) starts.push(index);
    }
    const firstStart = starts.length ? starts[0] : closingIndex;
    const leadingRows = rows.slice(bodyStart, firstStart)
      .map((value, offset) => ({ value, index: bodyStart + offset }))
      .filter(item => item.value.trim());
    const legacyPlayerFields = leadingRows.length === ONBOARDING_RELATIONSHIP_FIELDS.length
      && leadingRows.every((item, index) => new RegExp(
        "^[ \\t]*" + escapeRegExp(ONBOARDING_RELATIONSHIP_FIELDS[index]) + "[ \\t]*:",
        "i"
      ).test(item.value));
    if (leadingRows.length && !legacyPlayerFields) {
      errors.push("Relationships has content outside an About record");
    }
    const records = [];
    const seenTargets = new Set();
    const blocks = [];
    if (legacyPlayerFields) {
      blocks.push({
        start: leadingRows[0].index,
        rows: ["About: Player"].concat(leadingRows.map(item => item.value))
      });
    }
    starts.forEach((start, recordIndex) => {
      const end = recordIndex + 1 < starts.length ? starts[recordIndex + 1] : closingIndex;
      blocks.push({ start, rows: rows.slice(start, end).filter(row => row.trim()) });
    });
    blocks.forEach(block => {
      const start = block.start;
      const recordRows = block.rows;
      const labels = ["About"].concat(ONBOARDING_RELATIONSHIP_FIELDS);
      const values = {};
      if (recordRows.length !== labels.length) {
        errors.push("Relationships record at line " + (start + 1)
          + " must contain exactly six fields");
        return;
      }
      labels.forEach((label, index) => {
        const match = recordRows[index].match(
          new RegExp("^[ \\t]*" + escapeRegExp(label) + "[ \\t]*:[ \\t]*(.*?)[ \\t]*$", "i")
        );
        if (!match) {
          errors.push("Relationships record at line " + (start + 1)
            + " has a missing or reordered " + label + " field");
        }
        values[label] = match ? line(match[1], 4000) : "";
      });
      if (labels.every(label => !values[label])) return;
      const target = onboardingCanonicalTarget(name, values.About, false, false);
      if (!target) {
        errors.push("Relationships record at line " + (start + 1)
          + " has an unknown or self About target");
        return;
      }
      const targetKey = nameKeyOf(target);
      if (seenTargets.has(targetKey)) errors.push("Relationships repeats target " + target);
      seenTargets.add(targetKey);
      const fields = {};
      ONBOARDING_RELATIONSHIP_FIELDS.forEach(field => {
        const parsed = onboardingCanonicalRelationshipField(field, values[field]);
        if (!parsed.ok) {
          errors.push("Relationships " + target + " " + field
            + " needs a supported stage or score-stage value");
        }
        fields[field] = parsed.value;
      });
      records.push({ target, fields });
    });
    const entryRows = ["{", name + "'s Relationships:"];
    records.forEach((record, index) => {
      if (index > 0) entryRows.push("");
      entryRows.push("About: " + record.target);
      ONBOARDING_RELATIONSHIP_FIELDS.forEach(field => {
        entryRows.push(field + ": " + record.fields[field]);
      });
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_RELATIONSHIPS_CARD_CHARS) {
      errors.push("Relationships exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCanonicalExperiences(name, source) {
    const envelope = onboardingPageEnvelope(source, name + "'s Experiences:");
    const rows = envelope.rows;
    const errors = [];
    if (!envelope.recognized) {
      errors.push("Experiences wrapper or owner header is invalid");
    }
    const pattern = new RegExp(
      "^- \\[About:\\s*([^\\]\\r\\n]+)\\]\\s*" + escapeRegExp(name)
        + "\\s+experienced:\\s*(.+)\\.$",
      "i"
    );
    const records = [];
    const seen = new Set();
    const addRecord = (rawTarget, rawSituation, lineNumber) => {
      const target = onboardingCanonicalTarget(name, rawTarget, true, true);
      const suppliedSituation = wholeLine(rawSituation, 0);
      const situation = line(suppliedSituation, settings.MAX_EXPERIENCES_CARD_CHARS)
        .replace(/[.!?]+$/g, "").trim();
      if (!target || !situation || /[{}|\r\n]/.test(target + situation)
        || situation !== suppliedSituation.replace(/[.!?]+$/g, "").trim()) {
        errors.push("Experiences line " + lineNumber
          + " has an unsafe or overlong target or event");
        return;
      }
      const signature = nameKeyOf(target) + "|" + keyOf(situation);
      if (seen.has(signature)) errors.push("Experiences repeats the same target and event");
      seen.add(signature);
      records.push({ target, situation });
    };
    for (let index = envelope.bodyStart; index < envelope.closingIndex; index++) {
      const row = rows[index].trim();
      if (!row) continue;
      const match = row.match(pattern);
      if (match) {
        addRecord(match[1], match[2], index + 1);
        continue;
      }
      const about = row.match(/^About\s*:\s*(.*?)\s*$/i);
      if (!about) {
        errors.push("Experiences line " + (index + 1) + " is malformed");
        continue;
      }
      const next = rows[index + 1] && rows[index + 1].trim();
      const experience = next && next.match(/^Experience\s*:\s*(.*?)\s*$/i);
      if (!experience || index + 1 >= envelope.closingIndex) {
        errors.push("Experiences About at line " + (index + 1)
          + " requires the next Experience field");
        continue;
      }
      index += 1;
      if (!about[1] && !experience[1]) continue;
      if (!about[1] || !experience[1]) {
        errors.push("Experiences fields at lines " + index + "-" + (index + 1)
          + " must both be filled or both be blank");
        continue;
      }
      addRecord(about[1], experience[1], index);
    }
    const entryRows = ["{", name + "'s Experiences:"];
    records.forEach((record, index) => {
      if (index > 0) entryRows.push("");
      entryRows.push("About: " + record.target, "Experience: " + record.situation);
    });
    entryRows.push("}");
    const entry = entryRows.join("\n");
    if (entry.length > settings.MAX_EXPERIENCES_CARD_CHARS) {
      errors.push("Experiences exceeds its 1,000-character limit");
    }
    return { entry, errors };
  }

  function onboardingCommitPack(name, pack) {
    const outer = onboardingValidateProfile(
      name,
      "Outer",
      entryOf(pack.outer),
      settings.MAX_OUTER_CARD_CHARS
    );
    const inner = onboardingValidateProfile(
      name,
      "Inner",
      entryOf(pack.inner),
      settings.MAX_INNER_CARD_CHARS
    );
    const names = onboardingCanonicalNames(name, entryOf(pack.names));
    const views = onboardingCanonicalViews(name, entryOf(pack.views));
    const relationships = onboardingCanonicalRelationships(name, entryOf(pack.relationships));
    const experiences = onboardingCanonicalExperiences(name, entryOf(pack.experiences));
    const errors = outer.errors.concat(
      inner.errors,
      names.errors,
      views.errors,
      relationships.errors,
      experiences.errors
    );
    if (onboardingReadyValue(entryOf(pack.outer)) !== "yes") {
      errors.unshift("Outer Ready must be Yes before activation");
    }
    if (errors.length) return { ok: false, error: errors[0] };
    const changes = [
      { card: pack.names, title: namedTitle(name, settings.NAMES_LABEL), entry: names.entry },
      { card: pack.views, title: namedTitle(name, settings.VIEWS_LABEL), entry: views.entry },
      {
        card: pack.relationships,
        title: namedTitle(name, settings.RELATIONSHIPS_LABEL),
        entry: relationships.entry
      },
      {
        card: pack.experiences,
        title: onboardingExperiencesTitle(name),
        entry: experiences.entry
      },
      {
        card: pack.inner,
        title: namedTitle(name, settings.INNER_CHARACTER_LABEL),
        entry: inner.entry
      },
      {
        card: pack.outer,
        title: namedTitle(name, settings.OUTER_CHARACTER_LABEL),
        entry: outer.entry
      }
    ];
    const priorDeck = capturePhysicalCardDeck();
    try {
      changes.forEach(change => {
        const saved = saveCard(change.card, change.entry, change.title);
        if (!saved || entryOf(saved) !== change.entry
          || !managedCardIdentityMatches(saved, change.title)) {
          throw new Error("could not verify " + change.title);
        }
        change.card = saved;
      });
    } catch (error) {
      const restored = restorePhysicalCardDeck(priorDeck);
      return {
        ok: false,
        error: "activation transaction failed at " + (error.message || "an unknown card")
          + (restored ? "" : "; rollback was incomplete")
      };
    }
    return { ok: true };
  }

  function onboardingExactCards(title) {
    return catalogRecordsByTitle(title).map(record => record.card);
  }

  function ensureOnboardingPackCard(name, title, template, label) {
    let matching = onboardingExactCards(title);
    if (!matching.length) {
      const created = addCard(title, template(name));
      if (created) matching = [created];
    }
    if (matching.length !== 1) {
      activeRosterDiagnostics.push(
        name + " has conflicting " + label + " cards and remains pending."
      );
      return null;
    }
    return matching[0];
  }

  function storedAliasOwners(alias) {
    const owners = [];
    catalogPagedLabel(settings.NAMES_LABEL).records.forEach(item => {
      const card = item.card;
      const owner = item.owner;
      if (!owner) return;
      const pendingOwner = namedCards(owner, settings.OUTER_CHARACTER_LABEL)
        .some(outer => onboardingMarkerPresent(entryOf(outer)));
      const aliases = textOf(entryOf(card)).replace(/\r/g, "").split("\n")
        .map(row => {
          const match = row.match(/^[ \\t]*Alias[ \\t]*:[ \\t]*(.*?)[ \\t]*$/i);
          return match ? line(match[1], 160) : "";
        })
        .filter(value => value && !(pendingOwner
          && ONBOARDING_NAME_PLACEHOLDERS.some(placeholder => sameNameForm(placeholder, value))));
      if (aliases.some(value => sameNameForm(value, alias))
        && !owners.some(value => sameNameForm(value, owner))) owners.push(owner);
    });
    return owners;
  }

  function ensureConfirmedOnboarding(slot) {
    if (!slot || !slot.valid || !slot.name) return;
    const reserved = ["self", "player", "the player"].includes(nameKeyOf(slot.name));
    if (reserved || sameNameForm(slot.name, player.name)) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.code + " named the Player or Self and was ignored as an NPC slot.");
      return;
    }
    let outerCards = namedCards(slot.name, settings.OUTER_CHARACTER_LABEL);
    let innerCards = namedCards(slot.name, settings.INNER_CHARACTER_LABEL);
    let createdOuter = false;
    if (!outerCards.length) {
      const aliasOwners = storedAliasOwners(slot.name);
      if (aliasOwners.length) {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.code + " matched an existing Alias for "
          + aliasOwners.join(", ") + "; enter that identity's canonical name instead.");
        return;
      }
      const created = addCard(
        namedTitle(slot.name, settings.OUTER_CHARACTER_LABEL),
        onboardingOuterTemplate(slot.name)
      );
      if (created) {
        outerCards = [created];
        createdOuter = true;
        activeRosterDiagnostics.push(
          slot.name + " confirmed; the six-card creator template was initialized."
        );
      } else {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.name + " could not be onboarded because its Outer template could not be created.");
        return;
      }
    }
    if (outerCards.length !== 1) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.name + " has conflicting Outer cards and remains unavailable for onboarding.");
      return;
    }
    if (!innerCards.length) {
      const created = addCard(
        namedTitle(slot.name, settings.INNER_CHARACTER_LABEL),
        onboardingInnerTemplate(slot.name)
      );
      if (created) {
        innerCards = [created];
        activeRosterDiagnostics.push(slot.name + " received a blank Inner template.");
      } else {
        slot.valid = false;
        activeRosterDiagnostics.push(slot.name + " remains pending because its Inner template could not be created.");
        return;
      }
    }
    if (innerCards.length !== 1) {
      slot.valid = false;
      activeRosterDiagnostics.push(slot.name + " has conflicting Inner cards and remains unavailable for onboarding.");
      return;
    }
    const onboarding = createdOuter
      || onboardingMarkerPresent(entryOf(outerCards[0]))
      || onboardingMarkerPresent(entryOf(innerCards[0]));
    if (!onboarding) return;

    const outerControlled = onboardingInsertControls(entryOf(outerCards[0]), true);
    if (outerControlled !== entryOf(outerCards[0])) {
      const saved = saveCard(
        outerCards[0],
        outerControlled,
        namedTitle(slot.name, settings.OUTER_CHARACTER_LABEL)
      );
      if (!saved) {
        slot.valid = false;
        activeRosterDiagnostics.push(
          slot.name + " remains pending because its Outer onboarding controls could not be restored."
        );
        return;
      }
      outerCards[0] = saved;
    }
    const innerControlled = onboardingInsertControls(entryOf(innerCards[0]), false);
    if (innerControlled !== entryOf(innerCards[0])) {
      const saved = saveCard(
        innerCards[0],
        innerControlled,
        namedTitle(slot.name, settings.INNER_CHARACTER_LABEL)
      );
      if (!saved) {
        slot.valid = false;
        activeRosterDiagnostics.push(
          slot.name + " remains pending because its Inner onboarding marker could not be restored."
        );
        return;
      }
      innerCards[0] = saved;
    }

    const pack = {
      outer: outerCards[0],
      inner: innerCards[0],
      names: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.NAMES_LABEL),
        onboardingNamesTemplate,
        "Names"
      ),
      views: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.VIEWS_LABEL),
        onboardingViewsTemplate,
        "Views"
      ),
      relationships: ensureOnboardingPackCard(
        slot.name,
        namedTitle(slot.name, settings.RELATIONSHIPS_LABEL),
        onboardingRelationshipsTemplate,
        "Relationships"
      ),
      experiences: ensureOnboardingPackCard(
        slot.name,
        onboardingExperiencesTitle(slot.name),
        onboardingExperiencesTemplate,
        "Experiences"
      )
    };
    if (Object.values(pack).some(card => !card)) {
      slot.valid = false;
      return;
    }
    const readyRows = onboardingFieldRows(entryOf(pack.outer), "Ready");
    if (readyRows.length !== 1 || !onboardingReadyValue(entryOf(pack.outer))) {
      activeRosterDiagnostics.push(
        slot.name + " remains pending: Outer needs exactly one Ready: No or Ready: Yes line."
      );
      return;
    }
    if (onboardingReadyValue(entryOf(pack.outer)) !== "yes") {
      activeRosterDiagnostics.push(
        slot.name + " onboarding is pending; complete the six setup cards, then change Outer Ready to Yes."
      );
      return;
    }
    const committed = onboardingCommitPack(slot.name, pack);
    if (committed.ok) {
      activeRosterDiagnostics.push(
        slot.name + " onboarding completed; all six creator cards were validated and activated."
      );
    } else {
      activeRosterDiagnostics.push(slot.name + " remains pending: " + committed.error + ".");
    }
  }

  const activeNpcRoster = readActiveNpcRoster();
  activeNpcRoster.slots.forEach(ensureConfirmedOnboarding);

  const characterDiscoveryDiagnostics = [];
  let preparedProfileCount = 0;
  let rosterSkippedProfileCount = 0;

  function discoverCharacters() {
    const label = settings.OUTER_CHARACTER_LABEL;
    const prepared = catalogNamedLabel(label).records;
    preparedProfileCount = new Set(prepared.map(item => item.ownerKey).filter(Boolean)).size;
    const rosterKeys = activeNpcRoster.card
      ? new Set(activeNpcRoster.slots
        .filter(slot => slot && slot.valid && slot.name)
        .map(slot => nameKeyOf(slot.name)))
      : null;
    const candidates = prepared.map(item => {
      if (rosterKeys && !rosterKeys.has(item.ownerKey)) return null;
      return {
        card: item.card,
        index: item.index,
        name: item.owner,
        key: item.ownerKey,
        source: entryOf(item.card),
        duplicateCount: 0
      };
    }).filter(candidate => candidate && candidate.key);
    rosterSkippedProfileCount = Math.max(
      0,
      preparedProfileCount - new Set(candidates.map(candidate => candidate.key)).size
    );
    const groups = new Map();
    candidates.forEach(candidate => {
      if (!groups.has(candidate.key)) groups.set(candidate.key, []);
      groups.get(candidate.key).push(candidate);
    });
    const accepted = [];
    groups.forEach(group => {
      const first = group[0];
      if (group.length === 1) {
        accepted.push(first);
        return;
      }
      const signatures = new Set(group.map(candidate => duplicateCardEntrySignature(candidate.card)));
      if (signatures.size === 1) {
        first.duplicateCount = group.length - 1;
        accepted.push(first);
        characterDiscoveryDiagnostics.push(
          first.name + " has " + group.length + " exact Outer cards; using the first and excluding "
            + first.duplicateCount + " duplicate" + (first.duplicateCount === 1 ? "" : "s") + "."
        );
        return;
      }
      characterDiscoveryDiagnostics.push(
        first.name + " has " + group.length
          + " conflicting Outer cards; excluded this identity until only one remains."
      );
    });

    return accepted.map(candidate => {
      const { index, name, duplicateCount } = candidate;
      let outerCard = candidate.card;
      outerCard = saveCard(
        outerCard,
        entryOf(outerCard),
        namedTitle(name, settings.OUTER_CHARACTER_LABEL)
      ) || outerCard;
      const source = entryOf(outerCard);
      const pronouns = parseOuterPronouns(source);
      const rawStartingStatus = extractLine(source, "Starting status");
      const parsedStartingStatus = normalizeCastStatus(rawStartingStatus, "");
      const outerProfile = buildOuterProfile(name, source);
      const wrapper = outerWrapperStatus(source);
      const matchingInnerCards = namedCards(name, settings.INNER_CHARACTER_LABEL);
      let innerCard = matchingInnerCards[0] || null;
      let innerConflict = false;
      let duplicateInnerCount = 0;
      if (matchingInnerCards.length > 1) {
        const signatures = new Set(matchingInnerCards.map(duplicateCardEntrySignature));
        if (signatures.size === 1) {
          duplicateInnerCount = matchingInnerCards.length - 1;
          characterDiscoveryDiagnostics.push(
            name + " has " + matchingInnerCards.length + " exact Inner cards; using the first and excluding "
              + duplicateInnerCount + " duplicate" + (duplicateInnerCount === 1 ? "" : "s") + "."
          );
        } else {
          innerCard = null;
          innerConflict = true;
          characterDiscoveryDiagnostics.push(
            name + " has " + matchingInnerCards.length
              + " conflicting Inner cards; omitted Inner until only one remains."
          );
        }
      }
      if (innerCard) {
        innerCard = saveCard(
          innerCard,
          entryOf(innerCard),
          namedTitle(name, settings.INNER_CHARACTER_LABEL)
        ) || innerCard;
      }
      const innerSource = innerCard ? entryOf(innerCard) : "";
      const innerProfile = innerCard ? buildInnerProfile(name, innerSource) : null;
      const onboardingGenerated = onboardingMarkerPresent(source) || onboardingMarkerPresent(innerSource);
      const onboardingMissing = onboardingGenerated
        ? onboardingMissingDetails(source, innerSource, innerConflict)
        : [];
      if (onboardingGenerated) {
        if (onboardingReadyValue(source) === "yes") {
          onboardingMissing.push("resolve the onboarding validation diagnostic");
        } else {
          onboardingMissing.push("review all six setup cards, then set Outer Ready to Yes");
        }
      }
      const onboardingPending = onboardingGenerated;
      const outerWarnings = [];
      const innerWarnings = [];
      if (duplicateCount) {
        outerWarnings.push("Using the first Outer card; excluded " + duplicateCount + " exact duplicate"
          + (duplicateCount === 1 ? "" : "s") + ".");
      }
      if (!wrapper.opening && !wrapper.closing) outerWarnings.push("Outer wrapper { } missing.");
      else if (!wrapper.opening) outerWarnings.push("Opening Outer wrapper { missing.");
      else if (!wrapper.closing) outerWarnings.push("Closing Outer wrapper } missing.");
      if (!parsedStartingStatus) outerWarnings.push("Starting status missing or invalid; defaulted to Side.");
      if (onboardingPending) {
        outerWarnings.push("Confirmed onboarding pending: complete " + onboardingMissing.join(", ") + ".");
      } else if (outerProfile.missing.length) {
        outerWarnings.push("Missing: " + outerProfile.missing.join(", ") + ".");
      }
      if (outerProfile.truncated) {
        outerWarnings.push("Shortened " + outerProfile.originalChars + " → " + outerProfile.retainedChars + " characters.");
      }
      if (innerConflict) {
        innerWarnings.push("Conflicting Inner cards; Inner omitted until only one remains.");
      } else if (!innerCard) {
        innerWarnings.push("Inner card missing.");
      } else {
        if (duplicateInnerCount) {
          innerWarnings.push("Using the first Inner card; excluded " + duplicateInnerCount + " exact duplicate"
            + (duplicateInnerCount === 1 ? "" : "s") + ".");
        }
        const innerWrapper = outerWrapperStatus(innerSource);
        if (!innerWrapper.opening && !innerWrapper.closing) innerWarnings.push("Inner wrapper { } missing.");
        else if (!innerWrapper.opening) innerWarnings.push("Opening Inner wrapper { missing.");
        else if (!innerWrapper.closing) innerWarnings.push("Closing Inner wrapper } missing.");
        if (!onboardingPending && innerProfile.missing.length) {
          innerWarnings.push("Missing: " + innerProfile.missing.join(", ") + ".");
        }
        if (innerProfile.truncated) {
          innerWarnings.push("Shortened " + innerProfile.originalChars + " → " + innerProfile.retainedChars + " characters.");
        }
      }
      return {
        key: nameKeyOf(name),
        legacyKey: keyOf(name),
        name,
        aliases: [name],
        emergingAliases: [],
        nameRecords: [],
        pronouns: pronouns ? [pronouns] : [],
        startingStatus: parsedStartingStatus || "side",
        outer: outerProfile.text,
        outerRetainedChars: outerProfile.retainedChars,
        outerWarnings,
        inner: innerProfile ? innerProfile.text : "",
        innerRetainedChars: innerProfile ? innerProfile.retainedChars : 0,
        innerWarnings,
        outerCard,
        innerCard,
        onboardingGenerated,
        onboardingPending,
        onboardingMissing,
        index
      };
    });
  }

  const characters = discoverCharacters();
  const VIEW_CATEGORIES = ["Loves", "Likes", "Neutrals", "Dislikes", "Hates"];
  const VIEW_CATEGORY_INDEX = VIEW_CATEGORIES.reduce((result, category, index) => {
    result[keyOf(category)] = index;
    return result;
  }, {});
  const RELATIONSHIP_FIELDS = ["Role", "Trust", "Closeness", "Boundaries", "Conflict"];
  const RELATIONSHIP_STAGES = {
    Role: [
      { label: "Emerging", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Established", minimum: 10, maximum: 19, midpoint: 15 }
    ],
    Trust: [
      { label: "Severe distrust", minimum: -20, maximum: -11, midpoint: -15 },
      { label: "Distrust", minimum: -10, maximum: -1, midpoint: -5 },
      { label: "Guarded", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Unproven", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Cautious trust", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Trust", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Deep trust", minimum: 40, maximum: 49, midpoint: 45 }
    ],
    Closeness: [
      { label: "Disconnected", minimum: -20, maximum: -11, midpoint: -15 },
      { label: "Distant", minimum: -10, maximum: -1, midpoint: -5 },
      { label: "Acquainted", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Familiar", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Close", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Deeply close", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Intimate", minimum: 40, maximum: 49, midpoint: 45 }
    ],
    Boundaries: [
      { label: "Implied", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Explicit", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Reinforced", minimum: 20, maximum: 29, midpoint: 25 }
    ],
    Conflict: [
      { label: "Clear", minimum: 0, maximum: 9, midpoint: 5 },
      { label: "Friction", minimum: 10, maximum: 19, midpoint: 15 },
      { label: "Strain", minimum: 20, maximum: 29, midpoint: 25 },
      { label: "Open conflict", minimum: 30, maximum: 39, midpoint: 35 },
      { label: "Rupture", minimum: 40, maximum: 49, midpoint: 45 }
    ]
  };

  function relationshipStage(field, score) {
    const stages = RELATIONSHIP_STAGES[field] || [];
    return stages.find(stage => score >= stage.minimum && score <= stage.maximum) || null;
  }

  function relationshipDestination(field, value) {
    const wanted = keyOf(value);
    if (field === "Role" && wanted === "former") return { special: "Former", label: "Former" };
    if (field === "Boundaries" && wanted === "released") return { special: "Released", label: "Released" };
    return (RELATIONSHIP_STAGES[field] || []).find(stage => keyOf(stage.label) === wanted) || null;
  }

  function relationshipRange(field) {
    const stages = RELATIONSHIP_STAGES[field] || [];
    return stages.length
      ? { minimum: stages[0].minimum, maximum: stages[stages.length - 1].maximum }
      : { minimum: 0, maximum: 0 };
  }

  const TURNING_POINT_STAGES = [
    { label: "Dormant", cardLabel: "Dormant", minimum: 0, maximum: 9, midpoint: 5 },
    { label: "Emerging", cardLabel: "Emerging", minimum: 10, maximum: 19, midpoint: 15 },
    { label: "Near breakthrough", cardLabel: "Near Breakthrough", minimum: 20, maximum: 29, midpoint: 25 },
    { label: "Achieved", cardLabel: "Achieved", minimum: 30, maximum: 39, midpoint: 35 },
    { label: "Integrating", cardLabel: "Integrating", minimum: 40, maximum: 49, midpoint: 45 }
  ];
  const TURNING_POINT_DIRECTIONS = ["Growth", "Decline", "Mixed", "Neutral"];

  function turningPointStage(value) {
    const score = Math.max(0, Math.min(49, Math.trunc(Number(value) || 0)));
    return TURNING_POINT_STAGES.find(stage => score >= stage.minimum && score <= stage.maximum) || TURNING_POINT_STAGES[0];
  }

  function canonicalTurningPointDirection(value) {
    return TURNING_POINT_DIRECTIONS.find(direction => keyOf(direction) === keyOf(value)) || "";
  }

  function canonicalTurningPointId(value) {
    const source = line(value, 80).toLowerCase().replace(/[^a-z0-9_]+/g, "_").replace(/^_+|_+$/g, "");
    return /^[a-z0-9][a-z0-9_]{0,79}$/.test(source) ? source : "";
  }

  function turningPointStageCardTitle(prefix, stage) {
    const base = line(prefix, 180);
    const resolved = typeof stage === "object" ? stage : turningPointStage(stage);
    return base && resolved ? base + " — " + resolved.cardLabel : "";
  }

  function turningPointStageTrigger(owner, id, stage) {
    const ownerSlug = keyOf(owner && owner.name || owner).replace(/\s+/g, "_").toUpperCase();
    const idSlug = canonicalTurningPointId(id).toUpperCase();
    const resolved = typeof stage === "object" ? stage : turningPointStage(stage);
    const stageSlug = keyOf(resolved && resolved.label).replace(/\s+/g, "_").toUpperCase();
    return ownerSlug && idSlug && stageSlug
      ? "__CC_TP_" + ownerSlug + "_" + idSlug + "_" + stageSlug + "__"
      : "";
  }

  const TRIGGER_RULES = {
    affection: { feeling: "affectionate", goal: "show care" },
    anger: { feeling: "angry", goal: "confront the cause", tension: "anger strains restraint" },
    anxiety: { feeling: "anxious", goal: "seek reassurance or control", tension: "fear complicates action" },
    curiosity: { feeling: "curious", goal: "learn more" },
    grief: { feeling: "grieving", goal: "process the loss", tension: "grief pulls against moving forward" },
    hope: { feeling: "hopeful", goal: "pursue the possibility" },
    hurt: { feeling: "hurt", goal: "protect themself", tension: "hurt complicates connection" },
    relief: { feeling: "relieved", goal: "preserve the new stability" },
    resolve: { feeling: "determined", goal: "follow through" },
    uncertainty: { feeling: "uncertain", goal: "seek clarity", tension: "wants certainty but does not yet have it" },
    nostalgia: { feeling: "nostalgic", goal: "revisit shared history" },
    protect: { feeling: "protective", goal: "keep the target safe" },
    reconnect: { feeling: "cautiously warm", goal: "rebuild connection" },
    withdraw: { feeling: "guarded", goal: "create distance", tension: "self-protection competes with connection" },
    responsibility: { feeling: "focused", goal: "carry out the responsibility" },
    conflict: { feeling: "tense", goal: "resolve or withstand the conflict", tension: "active conflict remains unresolved" },
    trust_gain: { feeling: "encouraged", goal: "risk greater reliance" },
    trust_loss: { feeling: "wary", goal: "reduce reliance", tension: "trust has been shaken" },
    closeness_gain: { feeling: "connected", goal: "deepen the connection" },
    closeness_loss: { feeling: "distant", goal: "reassess the connection", tension: "distance strains the relationship" },
    boundary_respected: { feeling: "safer", goal: "maintain clear boundaries" },
    boundary_crossed: { feeling: "unsafe and angry", goal: "reassert the boundary", tension: "a crossed boundary remains unresolved" },
    repair: { feeling: "cautiously relieved", goal: "continue repairing the relationship" },
    betrayal: { feeling: "betrayed", goal: "protect themself from further harm", tension: "betrayal ruptures trust" }
  };

  const TRIGGER_CODES = Object.keys(TRIGGER_RULES);
  const TIME_JUMP = /\b(?:(?:a|an|one|two|three|four|five|six|seven|eight|nine|ten|several|many|\d+)\s+(?:days?|weeks?|months?|years?|decades?)\s+later|(?:days?|weeks?|months?|years?|decades?)\s+(?:passed|went by)|after\s+(?:a|an|one|two|three|four|five|six|seven|eight|nine|ten|several|many|\d+)\s+(?:days?|weeks?|months?|years?|decades?)|the next (?:morning|day|week|month|year)|by the following (?:week|month|year))\b/i;

  function normalizeTriggerCode(value) {
    const code = keyOf(value).replace(/\s+/g, "_");
    return Object.prototype.hasOwnProperty.call(TRIGGER_RULES, code) ? code : "";
  }

  function triggerList(value) {
    const raw = Array.isArray(value) ? value : textOf(value).split(/[,;\s]+/);
    return unique(raw.map(normalizeTriggerCode).filter(Boolean), 40)
      .slice(0, settings.MAX_STATE_TRIGGERS);
  }

  function normalizedTargetKey(value) {
    const source = line(value, 240).toLowerCase();
    if (source === "self" || source === "player") return source;
    const prefixed = source.match(/^(npc|target):(.*)$/);
    if (prefixed) {
      const suffix = prefixed[1] === "npc" ? nameKeyOf(prefixed[2]) : keyOf(prefixed[2]);
      return suffix ? prefixed[1] + ":" + suffix : "";
    }
    return keyOf(source);
  }

  const PROVENANCE_KINDS = { S: "state", X: "experience", R: "relationship", V: "view" };
  const OPERATION_KINDS = ["name", "state", "relationship", "view", "turning", "experience"];
  const MODEL_OPERATION_KINDS = ["name", "state", "relationship", "view", "turning"];
  const ASSESSMENT_OPERATION_KIND = "assessment";
  const TASK_OPERATION_KINDS = MODEL_OPERATION_KINDS.concat([ASSESSMENT_OPERATION_KIND]);

  function provenanceId(value) {
    const id = textOf(value).trim().toUpperCase();
    return /^[SXRV]\d+$/.test(id) ? id : "";
  }

  function provenanceSourceIds(values) {
    return unique(Array.isArray(values) ? values : [], 40)
      .map(value => textOf(value).trim().toUpperCase())
      .filter(value => /^[ESXRV]\d+$/.test(value));
  }

  function canonicalRelationshipFieldName(value) {
    return RELATIONSHIP_FIELDS.find(field => keyOf(field) === keyOf(value)) || "";
  }

  function canonicalRelationshipUseSignature(ownerKey, targetKey, sourceId, sourceIdentity, field) {
    const canonicalField = canonicalRelationshipFieldName(field);
    const canonicalSourceId = provenanceId(sourceId);
    const normalizedOwner = line(ownerKey, 160);
    const normalizedTarget = normalizedTargetKey(targetKey);
    const normalizedIdentity = line(sourceIdentity, 500);
    if (!normalizedOwner || !normalizedTarget || !/^[SX]\d+$/.test(canonicalSourceId)
      || !normalizedIdentity || !canonicalField) return "";
    return line(JSON.stringify([
      "relationship",
      normalizedOwner,
      normalizedTarget,
      canonicalSourceId,
      normalizedIdentity,
      canonicalField
    ]), 500);
  }

  function parseRelationshipUseSignature(value) {
    let parsed;
    try { parsed = JSON.parse(textOf(value)); } catch { return null; }
    if (!Array.isArray(parsed) || parsed.length !== 6 || parsed[0] !== "relationship") return null;
    const signature = canonicalRelationshipUseSignature(
      parsed[1], parsed[2], parsed[3], parsed[4], parsed[5]
    );
    if (!signature) return null;
    return {
      kind: "relationship",
      ownerKey: line(parsed[1], 160),
      targetKey: normalizedTargetKey(parsed[2]),
      sourceId: provenanceId(parsed[3]),
      sourceIdentity: line(parsed[4], 500),
      field: canonicalRelationshipFieldName(parsed[5]),
      signature
    };
  }

  function canonicalViewDestination(value) {
    const category = VIEW_CATEGORIES.find(item => keyOf(item) === keyOf(value));
    if (category) return category;
    const normalized = keyOf(value);
    if (normalized === "buried") return "Buried";
    if (normalized === "recovered") return "Recovered";
    return "";
  }

  function canonicalViewOperationMode(value) {
    const normalized = keyOf(value);
    if (normalized === "o" || normalized === "ordinary") return "O";
    if (normalized === "m" || normalized === "major") return "M";
    if (normalized === "buried" || normalized === "bury" || normalized === "burial") return "Buried";
    if (normalized === "recovered" || normalized === "recover" || normalized === "recovery") return "Recovered";
    if (normalized === "reconciled" || normalized === "reconcile" || normalized === "reconciliation") return "Reconciled";
    return "";
  }

  function canonicalViewUseSignature(ownerKey, targetKey, sourceId, sourceIdentity, destination, operationMode) {
    const canonicalSourceId = provenanceId(sourceId);
    const normalizedOwner = line(ownerKey, 160);
    const normalizedTarget = normalizedTargetKey(targetKey);
    const normalizedIdentity = line(sourceIdentity, 500);
    const canonicalDestination = canonicalViewDestination(destination);
    const canonicalMode = canonicalViewOperationMode(operationMode);
    if (!normalizedOwner || !normalizedTarget || !/^[RX]\d+$/.test(canonicalSourceId)
      || !normalizedIdentity || !canonicalDestination) return "";
    return line(JSON.stringify([
      "view",
      normalizedOwner,
      normalizedTarget,
      canonicalSourceId,
      normalizedIdentity,
      canonicalDestination,
      canonicalMode
    ]), 500);
  }

  function parseViewUseSignature(value) {
    let parsed;
    try { parsed = JSON.parse(textOf(value)); } catch { return null; }
    if (!Array.isArray(parsed) || parsed.length !== 7 || parsed[0] !== "view") return null;
    const signature = canonicalViewUseSignature(
      parsed[1], parsed[2], parsed[3], parsed[4], parsed[5], parsed[6]
    );
    if (!signature) return null;
    return {
      kind: "view",
      ownerKey: line(parsed[1], 160),
      targetKey: normalizedTargetKey(parsed[2]),
      sourceId: provenanceId(parsed[3]),
      sourceIdentity: line(parsed[4], 500),
      destination: canonicalViewDestination(parsed[5]),
      operationMode: canonicalViewOperationMode(parsed[6]),
      signature
    };
  }

  function parseProvenanceUseSignature(value) {
    return parseRelationshipUseSignature(value) || parseViewUseSignature(value);
  }

  function provenanceUseSignatures(values) {
    const result = [];
    (Array.isArray(values) ? values : []).forEach(value => {
      const parsed = parseProvenanceUseSignature(value);
      if (parsed && !result.includes(parsed.signature)) result.push(parsed.signature);
    });
    return result;
  }

  function relationshipUseSignatureForRecord(record, ownerKey, targetKey, field) {
    if (!record || (record.kind !== "state" && record.kind !== "experience")) return "";
    return canonicalRelationshipUseSignature(
      ownerKey,
      targetKey,
      record.id,
      record.managedSignature || record.signature || record.id,
      field
    );
  }

  function viewUseSignatureForRecord(record, ownerKey, targetKey, destination, operationMode) {
    if (!record || (record.kind !== "relationship" && record.kind !== "experience")) return "";
    return canonicalViewUseSignature(
      ownerKey,
      targetKey,
      record.id,
      record.managedSignature || record.signature || record.id,
      destination,
      operationMode
    );
  }

  function provenanceUseCommitted(record, signature) {
    const parsed = parseProvenanceUseSignature(signature);
    return !!(record && parsed && parsed.sourceId === record.id
      && provenanceUseSignatures(record.uses).includes(parsed.signature));
  }

  function commitProvenanceUse(record, signature) {
    const parsed = parseProvenanceUseSignature(signature);
    const legalSource = parsed && (
      (parsed.kind === "relationship" && (record && (record.kind === "state" || record.kind === "experience")))
      || (parsed.kind === "view" && (record && (record.kind === "relationship" || record.kind === "experience")))
    );
    if (!record || !parsed || parsed.sourceId !== record.id || !legalSource) {
      return { ok: false, error: "The narrow provenance use signature was not canonical for its source record." };
    }
    const prior = provenanceUseSignatures(record.uses);
    if (prior.includes(parsed.signature)) return { ok: true, duplicate: true, signature: parsed.signature };
    record.uses = prior.concat(parsed.signature);
    return { ok: true, duplicate: false, signature: parsed.signature };
  }

  function blankProvenanceLedger() {
    return {
      records: [],
      nextNumbers: { S: 1, X: 1, R: 1, V: 1 }
    };
  }

  function normalizeProvenanceRecord(raw) {
    const source = raw && typeof raw === "object" && !Array.isArray(raw) ? raw : {};
    const id = provenanceId(source.id);
    if (!id) return null;
    const prefix = id.charAt(0);
    const sourceIds = provenanceSourceIds(source.sourceIds);
    const storyEvidenceIds = unique(
      (Array.isArray(source.storyEvidenceIds) ? source.storyEvidenceIds : [])
        .concat(sourceIds.filter(value => /^E\d+$/.test(value))),
      40
    ).map(value => textOf(value).trim().toUpperCase()).filter(value => /^E\d+$/.test(value));
    const targetKey = normalizedTargetKey(source.targetKey);
    const rawPace = source.pace && typeof source.pace === "object" && !Array.isArray(source.pace)
      ? source.pace
      : {};
    const rawActualChange = Number.isFinite(Number(source.actualChange))
      ? Number(source.actualChange)
      : Number(source.numericChange);
    const normalizedActualChange = Number.isFinite(rawActualChange)
      ? Math.trunc(rawActualChange)
      : 0;
    const normalizedPaceValue = Number.isFinite(Number(source.paceValue))
      ? Math.max(0, Math.trunc(Number(source.paceValue)))
      : Math.max(0, Math.trunc(Number(rawPace.value) || 0));
    const normalizedPace = {
      name: line(source.paceName || rawPace.name, 80),
      value: normalizedPaceValue,
      maxStages: Math.max(0, Math.floor(Number(source.paceMaxStages ?? rawPace.maxStages) || 0))
    };
    return {
      id,
      kind: PROVENANCE_KINDS[prefix],
      ownerKey: line(source.ownerKey, 160),
      targetKey,
      targetName: storedTargetName(targetKey, source.targetName),
      field: line(source.field, 80),
      destination: line(source.destination, 120),
      eventKind: ["A", "D"].includes(textOf(source.eventKind).trim().toUpperCase())
        ? textOf(source.eventKind).trim().toUpperCase()
        : "",
      actualChange: normalizedActualChange,
      numericChange: normalizedActualChange,
      priorValue: line(source.priorValue, 240),
      resultingValue: line(source.resultingValue, 240),
      resultingStage: line(source.resultingStage, 120),
      priorCategory: canonicalViewDestination(source.priorCategory),
      resultingCategory: canonicalViewDestination(source.resultingCategory),
      priorViewState: line(source.priorViewState, 500),
      resultingViewState: line(source.resultingViewState, 500),
      viewOperationMode: canonicalViewOperationMode(source.viewOperationMode || source.operationMode),
      viewSeverity: canonicalViewOperationMode(source.viewSeverity || source.severity),
      paceValue: normalizedPaceValue,
      pace: normalizedPace,
      signature: line(source.signature, 500),
      managedSignature: line(source.managedSignature, 500),
      uses: provenanceUseSignatures(source.uses),
      confirmation: Math.max(0, Math.floor(Number(source.confirmation) || 0)),
      sourceIds,
      storyEvidenceIds,
      triggers: triggerList(source.triggers),
      value: line(source.value, 240),
      thought: line(source.thought, settings.MAX_STATE_VALUE_CHARS),
      explanation: line(source.explanation, 500),
      createdClock: Math.max(0, Number(source.createdClock) || 0),
      ownerOpportunity: Math.max(0, Number(source.ownerOpportunity) || 0),
      active: source.active !== false
    };
  }

  function normalizeProvenanceLedger(raw) {
    const source = raw && typeof raw === "object" && !Array.isArray(raw) ? raw : {};
    const fallback = blankProvenanceLedger();
    const records = boundedProvenanceRecords(
      (Array.isArray(source.records) ? source.records : [])
        .map(normalizeProvenanceRecord)
        .filter(Boolean)
    );
    const nextNumbers = { ...fallback.nextNumbers };
    Object.keys(PROVENANCE_KINDS).forEach(prefix => {
      const supplied = source.nextNumbers && Number(source.nextNumbers[prefix]);
      const highest = Math.max(0, ...records
        .filter(record => record.id.charAt(0) === prefix)
        .map(record => Number(record.id.slice(1)) || 0));
      nextNumbers[prefix] = Math.max(1, Number.isSafeInteger(supplied) ? supplied : 1, highest + 1);
    });
    return { records, nextNumbers };
  }

  function continuitySourceId(value) {
    const id = textOf(value).trim().toUpperCase();
    return /^[ESXRV]\d+$/.test(id) ? id : "";
  }

  function legalSourcePrefixes(kind) {
    return {
      name: ["E"],
      state: ["E"],
      relationship: ["E", "S", "X"],
      view: ["E", "R", "X"],
      turning: ["E"]
    }[keyOf(kind)] || [];
  }

  function sourceIdLegalForOperation(kind, id) {
    const sourceId = continuitySourceId(id);
    return !!(sourceId && legalSourcePrefixes(kind).includes(sourceId.charAt(0)));
  }

  function provenanceRecordById(id) {
    const wanted = provenanceId(id);
    return wanted ? CC.provenance.records.find(record => record.id === wanted) || null : null;
  }

  function allocateProvenanceId(prefixValue) {
    const prefix = textOf(prefixValue).trim().toUpperCase();
    if (!Object.prototype.hasOwnProperty.call(PROVENANCE_KINDS, prefix)) return "";
    const number = Math.max(1, Number(CC.provenance.nextNumbers[prefix]) || 1);
    CC.provenance.nextNumbers[prefix] = number + 1;
    return prefix + number;
  }

  function stateSituationSignature(ownerKey, targetKey, situation) {
    return line([
      "state",
      ownerKey,
      normalizedTargetKey(targetKey),
      keyOf(situationPhrase(situation))
    ].join("|"), 500);
  }

  function managedSignatureStillValid(record) {
    if (!record || !record.managedSignature) return false;
    if (record.kind === "state") {
      const npc = CC.npcs[record.ownerKey];
      const current = normalizeState(npc && npc.state, CC.stateClock);
      return !!current.situation.value
        && record.managedSignature === stateSituationSignature(
          record.ownerKey,
          current.situation.targetKey,
          current.situation.value
        );
    }
    if (record.kind === "experience") {
      refreshExperiencesStore(false);
      const ownerData = experiencesForOwner(record.ownerKey);
      return !!ownerData && ownerData.contextRecords.some(item =>
        item.signature === record.managedSignature
        && item.signature === record.signature
      );
    }
    if (record.kind === "relationship") {
      const current = currentRelationshipManagedSignature(
        record.ownerKey,
        record.targetKey,
        record.field
      );
      return !!current && current === record.managedSignature;
    }
    if (record.kind === "view") {
      const current = currentViewManagedSignature(record.ownerKey, record.targetKey);
      return !!current && current === record.managedSignature;
    }
    return record.active !== false;
  }

  function rebindRelationshipExplanationProvenance(
    ownerKey,
    targetKey,
    field,
    priorManagedSignature,
    nextManagedSignature,
    actualStage,
    correctedExplanation
  ) {
    const canonicalField = canonicalRelationshipFieldName(field);
    const normalizedTarget = normalizedTargetKey(targetKey);
    if (!ownerKey || !normalizedTarget || !canonicalField || !priorManagedSignature
      || !nextManagedSignature || priorManagedSignature === nextManagedSignature) return 0;
    const useReplacements = {};
    let rebound = 0;
    CC.provenance.records.forEach(record => {
      if (record.kind !== "relationship" || record.ownerKey !== ownerKey
        || record.targetKey !== normalizedTarget || record.field !== canonicalField
        || record.managedSignature !== priorManagedSignature) return;
      record.managedSignature = nextManagedSignature;
      record.explanation = line(correctedExplanation, 500);
      const nextEventSignature = relationshipEventSignature({ key: ownerKey }, {
        targetKey: normalizedTarget,
        field: canonicalField,
        eventKind: record.eventKind,
        priorValue: record.priorValue,
        resultingValue: record.resultingValue,
        actualStage: record.resultingStage || record.destination || actualStage,
        actualChange: record.actualChange,
        sourceIds: record.sourceIds,
        managedSignature: nextManagedSignature
      });
      if (nextEventSignature) record.signature = nextEventSignature;
      record.uses = provenanceUseSignatures((record.uses || []).map(use => {
        const parsed = parseViewUseSignature(use);
        if (!parsed || parsed.sourceId !== record.id
          || parsed.sourceIdentity !== priorManagedSignature) return use;
        const migrated = canonicalViewUseSignature(
          parsed.ownerKey,
          parsed.targetKey,
          parsed.sourceId,
          nextManagedSignature,
          parsed.destination,
          parsed.operationMode
        );
        if (migrated) useReplacements[parsed.signature] = migrated;
        return migrated || use;
      }));
      record.active = true;
      rebound += 1;
    });
    if (Object.keys(useReplacements).length) {
      CC.provenance.records.forEach(record => {
        record.uses = provenanceUseSignatures((record.uses || []).map(use => useReplacements[use] || use));
      });
    }
    return rebound;
  }

  function rebindViewExplanationProvenance(
    ownerKey,
    targetKey,
    priorManagedSignature,
    nextManagedSignature,
    actualCategory
  ) {
    const normalizedTarget = normalizedTargetKey(targetKey);
    if (!ownerKey || !normalizedTarget || !priorManagedSignature || !nextManagedSignature
      || priorManagedSignature === nextManagedSignature) return 0;
    let rebound = 0;
    CC.provenance.records.forEach(record => {
      if (record.kind !== "view" || record.ownerKey !== ownerKey
        || record.targetKey !== normalizedTarget
        || record.managedSignature !== priorManagedSignature) return;
      record.managedSignature = nextManagedSignature;
      const category = record.resultingCategory || actualCategory;
      if (record.explanation && category) {
        record.explanation = line(correctedViewExplanation(record.explanation, category), 500);
      }
      const nextEventSignature = viewEventSignature({ key: ownerKey }, {
        targetKey: normalizedTarget,
        destination: record.destination,
        operationMode: record.viewOperationMode,
        severity: record.viewSeverity,
        priorCategory: record.priorCategory,
        resultingCategory: record.resultingCategory,
        priorViewState: record.priorViewState,
        resultingViewState: record.resultingViewState,
        sourceIds: record.sourceIds,
        managedSignature: nextManagedSignature
      });
      if (nextEventSignature) record.signature = nextEventSignature;
      record.active = true;
      rebound += 1;
    });
    return rebound;
  }

  function refreshProvenanceActivity() {
    if (CC.provenance.records.some(record => record.kind === "relationship")) {
      refreshRelationshipsStore();
    }
    if (CC.provenance.records.some(record => record.kind === "view")) {
      refreshViewsStore(false);
    }
    CC.provenance.records.forEach(record => {
      if (record.kind === "state" || record.kind === "experience"
        || record.kind === "relationship" || record.kind === "view") {
        record.active = managedSignatureStillValid(record);
      }
    });
    return CC.provenance.records;
  }

  function activeProvenanceRecords(filters = {}) {
    refreshProvenanceActivity();
    return CC.provenance.records.filter(record => {
      if (!record.active) return false;
      if (filters.ownerKey && record.ownerKey !== filters.ownerKey) return false;
      if (filters.targetKey && record.targetKey !== normalizedTargetKey(filters.targetKey)) return false;
      if (filters.kind && record.kind !== keyOf(filters.kind)) return false;
      if (filters.prefix && record.id.charAt(0) !== textOf(filters.prefix).toUpperCase()) return false;
      return true;
    });
  }

  function storyLineageForSources(sourceIds, seen = new Set()) {
    const rawIds = [];
    provenanceSourceIds(sourceIds).forEach(id => {
      if (/^E\d+$/.test(id)) {
        if (!rawIds.includes(id)) rawIds.push(id);
        return;
      }
      if (seen.has(id)) return;
      seen.add(id);
      const record = provenanceRecordById(id);
      if (!record) return;
      storyLineageForSources(record.sourceIds.concat(record.storyEvidenceIds || []), seen)
        .forEach(storyId => { if (!rawIds.includes(storyId)) rawIds.push(storyId); });
    });
    return rawIds;
  }

  function provenanceDependencyClosure(record, byId, seen = new Set()) {
    if (!record || seen.has(record.id)) return seen;
    seen.add(record.id);
    (Array.isArray(record.sourceIds) ? record.sourceIds : [])
      .filter(sourceId => !/^E\d+$/.test(sourceId))
      .forEach(sourceId => provenanceDependencyClosure(byId[sourceId], byId, seen));
    return seen;
  }

  function boundedProvenanceRecords(records) {
    const normalized = (Array.isArray(records) ? records : [])
      .map(normalizeProvenanceRecord)
      .filter(Boolean);
    const maximum = Math.max(1, Number(settings.MAX_PROVENANCE_RECORDS) || 1);
    if (normalized.length <= maximum) return normalized;

    const byId = {};
    normalized.forEach(record => { byId[record.id] = record; });
    const selected = new Set();
    const candidates = normalized.map((record, index) => ({ record, index }))
      .sort((left, right) => Number(right.record.active) - Number(left.record.active)
        || right.index - left.index);

    candidates.forEach(({ record }) => {
      if (selected.has(record.id)) return;
      const closure = provenanceDependencyClosure(record, byId, new Set());
      const additions = Array.from(closure).filter(id => !selected.has(id));
      if (selected.size + additions.length > maximum) return;
      additions.forEach(id => selected.add(id));
    });

    if (!selected.size) normalized.slice(-maximum).forEach(record => selected.add(record.id));
    return normalized.filter(record => selected.has(record.id));
  }

  function appendProvenanceRecord(rawRecord) {
    const source = rawRecord && typeof rawRecord === "object" && !Array.isArray(rawRecord)
      ? { ...rawRecord }
      : {};
    const prefix = textOf(source.prefix || source.id).trim().toUpperCase().charAt(0);
    if (!source.id) source.id = allocateProvenanceId(prefix);
    const record = normalizeProvenanceRecord(source);
    if (!record) return { ok: false, error: "The provenance record could not be normalized." };
    if (CC.provenance.records.some(item => item.id === record.id)) {
      return { ok: false, error: "The allocated provenance ID already existed." };
    }
    CC.provenance.records = boundedProvenanceRecords(CC.provenance.records.concat(record));
    if (!CC.provenance.records.some(item => item.id === record.id)) {
      return { ok: false, error: "The bounded provenance ledger could not retain the new record." };
    }
    CC.last.provenanceCreated = record.id + " " + record.kind + " from "
      + (record.sourceIds.join(",") || "no sources");
    return { ok: true, record: provenanceRecordById(record.id) };
  }

